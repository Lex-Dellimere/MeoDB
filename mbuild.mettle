// MeoSQL: a database written in Mettle, reached by flux_orm over TCP.
//
//   mbuild build          debug, target linux -> build/linux/debug/
//   mbuild build -r       release
//   mbuild check          type-check every bin
//   mbuild test           @test functions in the compile-time interpreter
//   mbuild run meosql     the server (see --help)
//   mbuild run smoke      the whole storage stack in one run
//   mbuild run <test>     one test program; each prints PASS or FAIL
//
// Needs the head compiler, not the v0.17.0 release (MeoSQL uses syscall()):
//   export MBUILD_METTLE_LINUX=/home/nox/Projects/mettle/Mettle/bin/mettle

import "mbuild/api";

fn project() {
  mb_package("meosql", "0.1.0");
  mb_targets("linux");

  // The server: owns one database file and serves the wire protocol.
  mb_bin("meosql", "src/server/main.mettle");

  // The whole storage stack in one run.
  mb_bin("smoke", "src/main.mettle");

  // Status codes, bytes, varints, CRC, page format.
  mb_bin("s0_self", "tests/s0_self.mettle");

  mb_bin("a_self", "tests/a_self.mettle");

  // Files and the arena.
  mb_bin("b_self", "tests/b_self.mettle");

  // The pager: cache, eviction, flush, reopen.
  mb_bin("c_self", "tests/c_self.mettle");

  mb_bin("phase1", "tests/phase1.mettle");

  mb_bin("freelist_self", "tests/freelist_self.mettle");

  // The rollback journal and recovery.
  mb_bin("j_self", "tests/j_self.mettle");

  mb_bin("journal_self", "tests/journal_self.mettle");

  // The whole-file lock a pager takes at open, in-process and across a fork.
  mb_bin("flock_self", "tests/flock_self.mettle");

  // Order-preserving keys.
  mb_bin("key_self", "tests/key_self.mettle");

  // B-tree insert and scan.
  mb_bin("btree_self", "tests/btree_self.mettle");

  // B-tree delete, byte-balanced splits and float/blob keys, checked against a
  // sorted-array oracle.
  mb_bin("btdel_self", "tests/btdel_self.mettle");

  // Pager, freelist and b-tree together.
  mb_bin("phase2", "tests/phase2.mettle");

  // B-tree commit, rollback, a killed process, a crash mid-split, journal limit.
  // phase3_child is the process the crash cases kill.
  mb_bin("phase3", "tests/phase3.mettle");

  mb_bin("phase3_child", "tests/phase3_child.mettle");

  // The change feed and the persisted commit counter.
  mb_bin("feed_self", "tests/feed_self.mettle");

  // Table writes reaching the feed.
  mb_bin("feed_table", "tests/feed_table.mettle");

  // Shared value types and status codes.
  mb_bin("ws0_self", "tests/ws0_self.mettle");

  // Record codec round trips and corrupt-input checks.
  mb_bin("record_self", "tests/record_self.mettle");

  // The db lock under 64 threads.
  mb_bin("lock_self", "tests/lock_self.mettle");

  // Catalog persistence, rollback reload and the db transaction API.
  mb_bin("catalog_self", "tests/catalog_self.mettle");

  // Table rows, unique indexes, delete and update.
  mb_bin("table_self", "tests/table_self.mettle");

  // Imports only meo_core.mettle, proving tables work without the query layer.
  mb_bin("core_only", "tests/core_only.mettle");

  // Create, insert and select through the typed query API, with reopen.
  mb_bin("draft", "tests/draft.mettle");

  // Typed queries: filters, access paths, ordering, limits, update, delete, count.
  mb_bin("query_self", "tests/query_self.mettle");

  // Dropping tables and adding columns, including rollback.
  mb_bin("schema_self", "tests/schema_self.mettle");

  // End to end through the typed API: every type, transactions, reopen.
  mb_bin("query_e2e", "tests/query_e2e.mettle");

  // A process killed mid-transaction, and a corrupted file.
  mb_bin("query_crash", "tests/query_crash.mettle");

  // 64 threads sharing one database.
  mb_bin("query_mt", "tests/query_mt.mettle");

  // Every statement shape flux_orm produces, run through the typed API.
  mb_bin("flux_shapes", "tests/flux_shapes.mettle");

  // Wire codec: every frame kind, truncation and random corruption.
  mb_bin("wire_self", "tests/wire_self.mettle");

  // Sockets: loopback echo, receive timeouts, shutdown wake-ups.
  mb_bin("sock_self", "tests/sock_self.mettle");

  // The client library against a scripted fake server.
  mb_bin("cli_self", "tests/cli_self.mettle");

  // The server over loopback with raw frames: handshake, queries, errors.
  mb_bin("srv_smoke", "tests/srv_smoke.mettle");

  // The full query suite through the client, compared with embedded results.
  mb_bin("srv_e2e", "tests/srv_e2e.mettle");

  // 64 clients over TCP at once.
  mb_bin("srv_mt", "tests/srv_mt.mettle");

  // A client killed or hung mid-transaction.
  mb_bin("srv_kill", "tests/srv_kill.mettle");

  // Protocol limits: sizes, versions, tokens, connection cap.
  mb_bin("srv_limits", "tests/srv_limits.mettle");

  // Stopping the server with open transactions.
  mb_bin("srv_stop", "tests/srv_stop.mettle");
}
