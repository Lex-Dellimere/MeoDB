// conc/lock: the database-wide, owner re-entrant lock.
// A std/thread mutex (non-recursive) plus an owner thread id and a depth.

import "std/thread";
import "../error/status.mettle";

export struct MeoLock {
  mtx: int64;     // std/thread mutex handle, 0 when not initialised
  owner: int32;   // thread id of the holder, 0 = free
  depth: int32;   // nested enters by the owner
}

// Linux gettid: distinct and non-zero for every live thread.
fn lock_self_id() -> int32 {
  return (int32)GetCurrentThreadId();
}

// owner is read without the mutex. That is safe: only the holder writes its
// own id there, and clears it before unlocking, so a thread can only ever see
// its own id while it really holds the lock. Writes are atomic swaps so a
// reader never sees a torn value.
fn lock_is_mine(l: MeoLock*, me: int32) -> bool {
  return l->owner == me;
}

// Prepare a lock. MEO_OK, -MEO_ERR_USAGE for a null lock, -MEO_ERR_NOMEM when
// the mutex cannot be made.
export fn meo_lock_init(l: MeoLock*) -> int32 {
  if (l == 0) { return -MEO_ERR_USAGE; }
  l->owner = 0;
  l->depth = 0;
  l->mtx = mutex_create();
  if (l->mtx == 0) { return -MEO_ERR_NOMEM; }
  return MEO_OK;
}

// Take the lock, or re-enter it as its owner. MEO_OK, -MEO_ERR_BUSY after
// timeout_ms (negative waits forever), -MEO_ERR_USAGE for a null lock.
export fn meo_lock_enter(l: MeoLock*, timeout_ms: int32) -> int32 {
  if (l == 0 || l->mtx == 0) { return -MEO_ERR_USAGE; }
  var me: int32 = lock_self_id();
  if (lock_is_mine(l, me)) {
    l->depth += 1;
    return MEO_OK;
  }
  var wait: uint32 = INFINITE();
  if (timeout_ms >= 0) { wait = (uint32)timeout_ms; }
  if (mutex_lock(l->mtx, wait) == 0) { return -MEO_ERR_BUSY; }
  atomic_exchange_i32(&l->owner, me);
  l->depth = 1;
  return MEO_OK;
}

// Undo one enter. MEO_OK, -MEO_ERR_USAGE when the caller does not hold it.
export fn meo_lock_leave(l: MeoLock*) -> int32 {
  if (l == 0) { return -MEO_ERR_USAGE; }
  if (!lock_is_mine(l, lock_self_id()) || l->depth <= 0) {
    return -MEO_ERR_USAGE;
  }
  l->depth -= 1;
  if (l->depth == 0) {
    atomic_exchange_i32(&l->owner, 0);
    mutex_unlock(l->mtx);
  }
  return MEO_OK;
}

// True when the CALLING thread holds the lock.
export fn meo_lock_held(l: MeoLock*) -> bool {
  if (l == 0) { return false; }
  return lock_is_mine(l, lock_self_id()) && l->depth > 0;
}

// Release the lock's resources. -MEO_ERR_BUSY while it is held.
export fn meo_lock_destroy(l: MeoLock*) -> int32 {
  if (l == 0) { return -MEO_ERR_USAGE; }
  if (l->owner != 0 || l->depth > 0) { return -MEO_ERR_BUSY; }
  if (l->mtx != 0 && mutex_close(l->mtx) == 0) { return -MEO_ERR_BUSY; }
  l->mtx = 0;
  return MEO_OK;
}
