// pager/pager: the frame table, the page-number hash, clock eviction, pin
// accounting, page allocation and the flush that makes those pages durable.
//
// PHASE1.md sections 5.9, 6, 6b and 7. This module sits on platform/file.mettle
// for I/O and format/{page,meta}.mettle for bytes; it knows nothing about
// errnos, about what a page means, or about any layer above it.
//
// NO ATOMICITY IN PHASE 1. Eviction writes a dirty page back in place, so a
// torn write leaves a page half old and half new, and a crash between writing a
// page and writing the meta leaves the file with more pages than page_count
// records. Nothing above this layer may assume that a flush, a write-back or a
// crash leaves the database consistent; the page-level journal that fixes it is
// phase 3. The one ordering guarantee phase 1 does give -- page 0 last, then
// fsync -- is the one that stops a durable page_count from running ahead of the
// pages it counts.
//
// journal and lock stay 0: no journal, no locking, no threads.
//
// PHASE2.md section 2C adds the freelist: a freed page becomes reusable, and
// the chain of MEO_PAGE_FREELIST pages lives entirely on disk (meta.freelist_root
// is the head, 0 = none), so it survives close/reopen with no in-memory state.
// The page format and the chain algorithm over page bytes are in
// pager/freelist.mettle; the frame pinning, the meta root and the error matrix
// are here, because meo_pager_alloc has to consult the freelist before it
// extends the file and this module cannot import a module that imports it.
// meo_free_init/take/put/count are therefore defined here rather than in
// freelist.mettle; every program that imports the pager sees them either way.
//
// Five things PHASE1.md 5.9 does not spell out, and why each is what it is:
//
// * `meta_dirty` and `closed` are documented fields of MeoPager in PHASE1.md
//   5.9 and 6b.12 states the rule they serve. Page 0 is an ordinary evictable
//   frame (section 6b and test T4 require it: with n_frames frames a caller may
//   hold n_frames-1 pages pinned and still expect a successful get, so page 0
//   cannot be permanently pinned), but an `alloc` must make the new page_count
//   durable and `get(0)` must never hand back what the disk still said when
//   p->meta has moved on. `meta_dirty` carries both obligations while page 0 is
//   not resident; meo_pager_meta_refresh encodes p->meta into the frame every
//   time page 0 is installed while the flag is set. flush_plan reports page 0
//   exactly once: from this flag, or from the meta frame's dirty bit when page
//   0 is resident and was written through.
// * `meo_pager_close` frees every buffer and array and sets `closed`, but not
//   the MeoPager itself; meo_pager_free releases the block. PHASE1.md section 7
//   requires a second close of the same handle to answer MEO_OK, which is only
//   definable while the handle is still allocated, so the struct outlives the
//   close and `closed` is what makes it not live. The cost is one small struct
//   per open/close cycle; phase 1 accepts it rather than trade a defined double
//   close for a use-after-free.
// * open validates identity before integrity: meo_meta_check runs before
//   meo_page_verify, which is the reverse of 5.9's step 5 then 6. Section 7 and
//   T6 require a foreign file and a flipped magic byte at offset 16 to be
//   NOT_A_DB, and either also breaks the CRC, so checksum-first would answer
//   CORRUPT to a test that is written for NOT_A_DB. A bad checksum on a
//   structurally sound page 0 is still CORRUPT, so section 7's checksum row is
//   reachable either way.
// * get verifies a page's checksum as it enters the cache (5.9 only says to
//   read the page). This is the one place page bytes come off the disk, so it
//   is the one place corruption can be caught before a caller reads it; a page
//   that fails is not installed. Section 6b.11 makes the other half of that
//   promise: everything this pager writes is sealed first, so a page that came
//   through the pager always verifies.
// * a failed open has no pager to record the code in, so meo_pager_err(0) and
//   meo_pager_err_arg(0) answer for the last failed meo_pager_open. Section 7 and
//   T6 ask for the specific code after a refused open, and that is the only
//   channel a null return leaves. Phase 1 has no threads, so one slot is
//   enough. A MEO_PAGER_CREATE|MEO_PAGER_READONLY open is treated as "no create"
//   for the same reason it is refused nothing else: a read-only pager could not
//   initialise the file, so a zero-byte one is NOT_A_DB.
//
// COMMIT COUNTER AND COMMIT HOOK (the change feed, src/feed/feed.mettle).
//
// * meta.commit_seq is bumped by exactly 1 inside every successful commit:
//   meo_pager_commit_prepare raises it and re-encodes page 0 BEFORE the flush,
//   so page 0 gets a before-image in the journal like any other page and a
//   rollback or a crash before the journal is removed puts the old value back.
//   A failed flush/sync restores the in-memory value, so a retried commit still
//   bumps by exactly 1.
// * Autocommit rule: a successful meo_pager_flush with no transaction open that
//   writes modifications made outside a transaction (tracked by `unflushed`,
//   set by every dirtying path while no journal is attached) also bumps
//   commit_seq and fires the commit hook. meo_pager_close's flush is the same
//   call. This is NOT atomic -- an autocommit flush is the phase-1 in-place
//   write, an eviction may already have written some of the pages, and a crash
//   can leave any mix -- it only makes autocommit writers visible to
//   meo_peek_commit_seq and to an attached feed. Internal flushes (commit, the
//   new-file init) use meo_pager_flush_raw and never count.
// * The hook is three fields (ctx and two function pointers), not an import of
//   the feed: feed/ imports pager/ and btree/, so the pager calling feed/ by
//   name would close a cycle. The pager calls hook_commit(ctx, commit_seq,
//   time_us) after the journal is gone (the commit is durable), with a
//   CLOCK_REALTIME timestamp from platform/clock_linux.mettle, and calls
//   hook_rollback(ctx, ok) on every rollback path (explicit, close and free
//   with an open transaction; free with unflushed autocommit changes). ok =
//   false means the outcome is uncertain (the rollback itself failed, or
//   pages may have reached the disk), so the feed reports a gap instead of
//   silently dropping. Recovery at open calls nothing: there is no hook before
//   open returns, and a recovered transaction was never committed, so it was
//   never published by anyone.
// * One writer thread per pager. The pager is not thread-safe; the hook runs on
//   the writer's thread. Only the feed's reader side is meant for other
//   threads.

import "std/mem";
import "../error/status.mettle";
import "../format/bytes.mettle";
import "../format/page.mettle";
import "../format/meta.mettle";
import "../platform/file.mettle";
import "../platform/file_linux.mettle" if linux;
import "../platform/clock_linux.mettle" if linux;
import "freelist.mettle";
import "journal.mettle";

// --- constants (PHASE1.md section 2) ---------------------------------------

export const MEO_PAGER_CREATE: int32 = 1;
export const MEO_PAGER_READONLY: int32 = 2;
export const MEO_MIN_FRAMES: int32 = 8;
export const MEO_MAX_PAGES: uint32 = 1048576; // 4 GiB at 4096; the phase-1 cap

// --- types (PHASE1.md section 5.9) -----------------------------------------

export struct MeoFrame {
  data: uint8*;      // MEO_PAGE_SIZE bytes, owned by the pager
  page_no: uint32;   // meaningful while in_use
  pin: int32;
  in_use: bool;
  dirty: bool;
  referenced: bool;  // clock second-chance bit
}

export struct MeoPager {
  file: MeoFile;
  page_size: int32;
  page_count: uint32;
  frames: MeoFrame*;
  n_frames: int32;
  index: int32*;     // open addressing; value = frame_index + 1, 0 = empty
  index_cap: int32;  // power of two, >= 2 * n_frames
  hand: int32;       // clock hand
  n_dirty: int32;
  write_count: int64; // pages written through meo_pager_write_page
  err: int32;        // positive MEO_ERR_* of the last failure, MEO_OK otherwise
  err_arg: int64;
  read_only: bool;
  closed: bool;      // set by meo_pager_close; makes a second close a no-op
  meta_dirty: bool;  // p->meta differs from the bytes in the page-0 frame
  meta: MeoMeta;      // page 0, kept in sync with the frame
  path: string;      // owned copy of the db path, for the journal name
  journal: rawptr;   // MeoJournal* while a transaction is open, else 0
  journal_cap: int32; // meo_pager_set_journal_cap; default MEO_JRN_MAX_RECORDS
  lock: rawptr;      // phase 9; always 0 in phase 1
  // Commit hook (see the header note). 0 = none.
  hook_ctx: rawptr;
  hook_commit: fn(rawptr, uint64, int64) -> void;
  hook_rollback: fn(rawptr, bool) -> void;
  prepared: bool;    // commit_prepare has bumped commit_seq for this txn
  unflushed: bool;   // modified with no transaction open since the last flush
}

// The open-failure channel. meo_pager_open answers 0, so there is no pager to
// record the code in; PHASE1.md section 7 and T6 still require the specific
// code to be readable, so meo_pager_err(0) and meo_pager_err_arg(0) report the
// last failed open. Two opens must not interleave -- phase 1 is single-threaded
// by construction (no locking, no threads).
var meo_pager_last_open_err: int32 = MEO_OK;
var meo_pager_last_open_err_arg: int64 = 0;

// --- status helpers --------------------------------------------------------

// Record a failure. `rc` is the negative form a meo_* function returns;
// meo_pager_err reports the positive MEO_ERR_* constant that section 7's table is
// written in. Returns `rc` so a caller can `return meo_pager_fail(...)`.
fn meo_pager_fail(p: MeoPager*, rc: int32, arg: int64) -> int32 {
  var code: int32 = rc;
  if (code > 0) { code = 0 - code; }
  p->err = 0 - code;
  p->err_arg = arg;
  return code;
}

// Same recording, for the functions that answer a MeoFrame* and so have no
// int32 return channel of their own.
fn meo_pager_fail_ptr(p: MeoPager*, rc: int32, arg: int64) -> MeoFrame* {
  var code: int32 = rc;
  if (code > 0) { code = 0 - code; }
  p->err = 0 - code;
  p->err_arg = arg;
  return 0;
}

fn meo_pager_clear_err(p: MeoPager*) {
  p->err = MEO_OK;
  p->err_arg = 0;
}

// A pager is live until meo_pager_close runs on it. After that every buffer is
// gone and only `closed` and the recorded error are meaningful (see the header
// note); meo_pager_free is what ends the block.
fn meo_pager_is_live(p: MeoPager*) -> bool {
  return !p->closed;
}

// An owned copy of `s`, for the pager's own copy of the database path. The
// caller frees out.chars. A zero-length result has chars == 0.
fn meo_pager_copy_string(s: string) -> string {
  var out: string;
  var n: int64 = (int64)s.length;
  out.chars = malloc(n + 1);
  if (out.chars == 0) {
    out.length = 0;
    return out;
  }
  var i: int64 = 0;
  while (i < n) {
    out.chars[i] = s.chars[i];
    i += 1;
  }
  out.chars[n] = 0;
  out.length = (uint64)n;
  return out;
}

// --- frame table internals -------------------------------------------------

// Frame i. Written as an address-of an element rather than by scaling the
// pointer, because struct-pointer arithmetic is not part of the contract.
fn meo_pager_frame_at(p: MeoPager*, i: int32) -> MeoFrame* {
  return &p->frames[i];
}

// Table size: the next power of two at or above 2 * n_frames, so the open
// addressed table is never more than half full and the probe loops always
// terminate on an empty slot.
fn meo_pager_index_cap(n_frames: int32) -> int32 {
  var want: int64 = 2 * (int64)n_frames;
  var cap: int64 = 1;
  while (cap < want) { cap = cap * 2; }
  // An int32 table of slots; anything larger is a request we cannot serve.
  if (cap > (int64)1073741824) { return -MEO_ERR_NOMEM; }
  return (int32)cap;
}

// Multiplicative hash into a slot. The multiplier is odd and the table size is
// a power of two, so distinct page numbers below the table size never collide
// and clustered page numbers still spread.
fn meo_pager_slot_of(page_no: uint32, mask: int32) -> int32 {
  var h: uint32 = page_no * (uint32)0x9E3779B1;
  return (int32)(h & (uint32)mask);
}

// Is slot k inside the cyclic interval [lo, hi]?
fn meo_pager_slot_in_range(lo: int32, k: int32, hi: int32) -> bool {
  if (lo <= hi) { return (k >= lo) && (k <= hi); }
  return (k >= lo) || (k <= hi);
}

// Frame index holding page_no, or -1 when it is not cached.
fn meo_pager_find(p: MeoPager*, page_no: uint32) -> int32 {
  var mask: int32 = p->index_cap - 1;
  var slot: int32 = meo_pager_slot_of(page_no, mask);
  var probes: int32 = 0;
  while (probes < p->index_cap) {
    var v: int32 = p->index[slot];
    if (v == 0) { return -1; }
    if (p->frames[v - 1].page_no == page_no) { return v - 1; }
    slot = (slot + 1) & mask;
    probes += 1;
  }
  return -1;
}

fn meo_pager_index_insert(p: MeoPager*, page_no: uint32, fi: int32) {
  var mask: int32 = p->index_cap - 1;
  var slot: int32 = meo_pager_slot_of(page_no, mask);
  while (p->index[slot] != 0) { slot = (slot + 1) & mask; }
  p->index[slot] = fi + 1;
}

// Backward-shift deletion (PHASE1.md section 6): empty the slot, then re-seat
// every entry of the probe cluster that lost its path to its home slot. No
// tombstone is ever left, and none is needed: the table is fixed at
// index_cap >= 2 * n_frames, so tombstones could fill it permanently.
fn meo_pager_index_remove(p: MeoPager*, page_no: uint32) {
  var mask: int32 = p->index_cap - 1;
  var i: int32 = meo_pager_slot_of(page_no, mask);
  var probes: int32 = 0;
  while (probes < p->index_cap) {
    if (p->index[i] == 0) { return; }
    if (p->frames[p->index[i] - 1].page_no == page_no) { break; }
    i = (i + 1) & mask;
    probes += 1;
  }
  if (probes >= p->index_cap) { return; }

  var j: int32 = i;
  while (true) {
    p->index[i] = 0;
    while (true) {
      j = (j + 1) & mask;
      if (p->index[j] == 0) { return; }
      var home: int32 = meo_pager_slot_of(p->frames[p->index[j] - 1].page_no,
        mask);
      // Move the entry at j down into the hole at i only when the hole is on
      // its probe path, i.e. when i lies in the cyclic interval [home, j].
      // Otherwise the entry is still reachable where it is and the hole is
      // left for the next entry that does need it.
      if (meo_pager_slot_in_range(home, i, j)) { break; }
    }
    p->index[i] = p->index[j];
    i = j;
  }
}

// --- dirty accounting ------------------------------------------------------

fn meo_pager_mark_dirty(p: MeoPager*, f: MeoFrame*) {
  if (p->journal == 0) { p->unflushed = true; }
  if (!f->dirty) {
    f->dirty = true;
    p->n_dirty += 1;
  }
}

// What the next flush owes for page 0: the pager's own copy is stale, or the
// caller wrote page 0 through its frame.
fn meo_pager_meta_pending(p: MeoPager*) -> bool {
  if (p->meta_dirty) { return true; }
  var fi: int32 = meo_pager_find(p, 0);
  if (fi < 0) { return false; }
  return p->frames[fi].dirty;
}

// Page 0 is never allowed to go stale (PHASE1.md 5.9 and 6b.12). Whenever a
// frame is about to hold page 0 and p->meta is ahead of the bytes in it, encode
// p->meta before the caller can decode the frame: the disk copy left behind by
// an eviction carries whatever page_count, roots and txn_id it had at that
// moment, and handing that back would silently answer for an older database.
fn meo_pager_meta_refresh(p: MeoPager*, f: MeoFrame*) -> int32 {
  if (f->page_no != 0 || !p->meta_dirty) { return MEO_OK; }
  var rc: int32 = meo_meta_write(f->data, p->meta);
  if (rc != MEO_OK) { return rc; }
  // The frame now differs from the disk, so it owes a write-back as well.
  meo_pager_mark_dirty(p, f);
  return MEO_OK;
}

// Record that page 0 must be rewritten. When the meta frame happens to be
// resident it is re-encoded from p->meta at once, so a `get(0)` can never hand
// back a body that disagrees with the pager's own copy.
fn meo_pager_meta_touch(p: MeoPager*) {
  p->meta_dirty = true;
  if (p->journal == 0) { p->unflushed = true; }
  var fi: int32 = meo_pager_find(p, 0);
  if (fi < 0) { return; }
  meo_pager_meta_refresh(p, meo_pager_frame_at(p, fi));
}

// How many pages the next flush would write: every dirty page above 0, plus
// page 0 when the meta is pending.
fn meo_pager_plan_count(p: MeoPager*) -> int32 {
  var n: int32 = 0;
  var i: int32 = 0;
  while (i < p->n_frames) {
    var f: MeoFrame* = meo_pager_frame_at(p, i);
    if (f->in_use && f->dirty && f->page_no > 0) { n += 1; }
    i += 1;
  }
  if (meo_pager_meta_pending(p)) { n += 1; }
  return n;
}

// --- eviction --------------------------------------------------------------

// Clock second-chance scan (PHASE1.md section 6), bounded by 2 * n_frames. An
// unused frame is taken at once; a pinned frame is NEVER a candidate; a
// referenced frame loses its second chance and is looked at again next pass.
// Returns -1 when everything in reach is pinned.
fn meo_pager_pick_victim(p: MeoPager*) -> int32 {
  var n: int32 = p->n_frames;
  var scanned: int32 = 0;
  while (scanned < 2 * n) {
    var fi: int32 = p->hand;
    p->hand = (p->hand + 1) % n;
    var f: MeoFrame* = meo_pager_frame_at(p, fi);
    scanned += 1;
    if (!f->in_use) { return fi; }
    if (f->pin > 0) { continue; }
    if (f->referenced) {
      f->referenced = false;
      continue;
    }
    return fi;
  }
  return -1;
}

// The one place a page reaches the disk (PHASE3.md 3A). Sealing happens here,
// so no caller can write an unsealed page, and 3B's before-image append hangs
// off the journal hook below. Exactly MEO_PAGE_SIZE bytes at
// page_no * MEO_PAGE_SIZE, all-or-error: the file write primitive writes all of
// len or fails. Every writer -- eviction, flush, and anything added later -- goes
// through this function and nothing else.
fn meo_pager_write_page(p: MeoPager*, page_no: uint32, page: uint8*) -> int32 {
  meo_page_seal(page);
  // The before-image is appended and fsynced before the page it protects is
  // written (PHASE3.md 3B). The old bytes come from the disk, not from the
  // frame: the frame already holds the new content. meo_jrn_needs is false for
  // a page allocated after begin and for a page already journaled, so a page
  // that is evicted, re-read and written again keeps its first before-image.
  if (p->journal != 0) {
    var j: MeoJournal* = (MeoJournal*)p->journal;
    if (meo_jrn_needs(j, page_no)) {
      var before: uint8* = malloc((int64)MEO_PAGE_SIZE);
      if (before == 0) { return -MEO_ERR_NOMEM; }
      var boff: int64 = (int64)page_no * (int64)MEO_PAGE_SIZE;
      var brc: int32 = meo_file_read_at(p->file, boff, before,
        (int64)MEO_PAGE_SIZE);
      if (brc != MEO_PAGE_SIZE) {
        free(before);
        return -MEO_ERR_CORRUPT;
      }
      var arc: int32 = meo_jrn_append(j, page_no, before);
      free(before);
      if (arc != MEO_OK) { return arc; }
    }
  }
  var off: int64 = (int64)page_no * (int64)MEO_PAGE_SIZE;
  var rc: int32 = meo_file_write_at(p->file, off, page, (int64)MEO_PAGE_SIZE);
  if (rc != MEO_OK) { return rc; }
  p->write_count += 1;
  return MEO_OK;
}

// Write a dirty frame back to its page and clear the dirty bit. The page is
// sealed by meo_pager_write_page immediately before the write, never after, so
// the bytes on disk are exactly the frame's bytes and they pass
// meo_page_verify. A failed write changes nothing: the caller abandons the
// eviction and the frame stays valid and dirty.
fn meo_pager_write_back(p: MeoPager*, f: MeoFrame*) -> int32 {
  var rc: int32 = meo_pager_write_page(p, f->page_no, f->data);
  if (rc != MEO_OK) { return rc; }
  if (f->dirty) {
    f->dirty = false;
    p->n_dirty -= 1;
  }
  // A resident meta frame that has just been written carries the durable
  // page_count, so the pending rewrite is satisfied.
  if (f->page_no == 0) { p->meta_dirty = false; }
  return MEO_OK;
}

// Take frame `fi` for `page_no`: write it back when it is dirty, unlink the
// page it used to hold, then leave it in_use, pinned once, clean and
// unreferenced-by-the-index. The page's bytes are the caller's next step: get
// reads them, alloc zeroes them.
fn meo_pager_take_frame(p: MeoPager*, fi: int32, page_no: uint32) -> int32 {
  var f: MeoFrame* = meo_pager_frame_at(p, fi);
  if (f->in_use) {
    if (f->dirty) {
      var rc: int32 = meo_pager_write_back(p, f);
      if (rc != MEO_OK) { return rc; }
    }
    meo_pager_index_remove(p, f->page_no);
    f->in_use = false;
  }
  f->page_no = page_no;
  f->in_use = true;
  f->pin = 1;
  f->dirty = false;
  f->referenced = true;
  return MEO_OK;
}

// Read page_no into frame fi and verify it. get is the one path by which page
// bytes enter the cache, so it is the one place a corrupt page can be caught
// before a caller sees it.
fn meo_pager_load_page(p: MeoPager*, fi: int32, page_no: uint32) -> int32 {
  var f: MeoFrame* = meo_pager_frame_at(p, fi);
  var off: int64 = (int64)page_no * (int64)MEO_PAGE_SIZE;
  var rc: int32 = meo_file_read_at(p->file, off, f->data, (int64)MEO_PAGE_SIZE);
  if (rc < 0) { return rc; }
  // A short read means the file is shorter than page_count claims: a torn
  // write or a file touched underneath us, never a page we may hand out.
  if (rc != MEO_PAGE_SIZE) { return -MEO_ERR_CORRUPT; }
  if (meo_page_verify(f->data) != MEO_OK) { return -MEO_ERR_CORRUPT; }
  // Page 0 has just been installed after an eviction: replace the bytes the
  // disk still has with p->meta before the caller can decode them.
  if (page_no == 0) { return meo_pager_meta_refresh(p, f); }
  return MEO_OK;
}

// --- flush internals -------------------------------------------------------

// Write one page of the flush plan. A resident frame is written from its own
// buffer (page 0 first re-encoded when p->meta is the authority). Page 0 that
// is not resident -- the only plan entry that can be absent from the table --
// is encoded from p->meta into a scratch buffer; meo_page_init gives it the
// same header every meta page has, so the bytes are the ones a resident frame
// would have produced.
fn meo_pager_write_planned(p: MeoPager*, page_no: uint32) -> int32 {
  var fi: int32 = meo_pager_find(p, page_no);
  if (fi >= 0) {
    var f: MeoFrame* = meo_pager_frame_at(p, fi);
    if (page_no == 0 && p->meta_dirty) { meo_meta_write(f->data, p->meta); }
    return meo_pager_write_page(p, page_no, f->data);
  }
  var buf: uint8* = malloc((int64)MEO_PAGE_SIZE);
  if (buf == 0) { return -MEO_ERR_NOMEM; }
  var rc: int32 = meo_page_init(buf, MEO_PAGE_META);
  if (rc == MEO_OK) { rc = meo_meta_write(buf, p->meta); }
  if (rc == MEO_OK) { rc = meo_pager_write_page(p, page_no, buf); }
  free(buf);
  return rc;
}

// After a successful sync the plan's pages are durable: drop their dirty bits.
fn meo_pager_mark_written(p: MeoPager*, page_no: uint32) {
  if (page_no == 0) { p->meta_dirty = false; }
  var fi: int32 = meo_pager_find(p, page_no);
  if (fi < 0) { return; }
  var f: MeoFrame* = meo_pager_frame_at(p, fi);
  if (f->dirty) {
    f->dirty = false;
    p->n_dirty -= 1;
  }
}

// --- lifecycle internals ---------------------------------------------------

// Free every frame buffer and both arrays, then close the file. Returns the
// close code; the pager is closed afterwards (closed = true, see the header
// note). Safe on a pager whose buffers were only partly allocated, which is why
// it guards data == 0.
fn meo_pager_release_all(p: MeoPager*) -> int32 {
  var i: int32 = 0;
  while (i < p->n_frames) {
    var f: MeoFrame* = meo_pager_frame_at(p, i);
    if (f->data != 0) {
      free(f->data);
      f->data = 0;
    }
    i += 1;
  }
  if (p->frames != 0) {
    free(p->frames);
    p->frames = 0;
  }
  if (p->index != 0) {
    free(p->index);
    p->index = 0;
  }
  // A journal still attached here means the caller freed a pager without
  // closing it (close rolls back). Remove the file so the descriptor and the
  // journal do not outlive the pager; the transaction is lost, which is the
  // documented cost of freeing without closing.
  if (p->journal != 0) {
    meo_jrn_destroy((MeoJournal*)p->journal);
    p->journal = 0;
  }
  if (p->path.chars != 0) {
    free(p->path.chars);
    p->path.chars = 0;
    p->path.length = 0;
  }
  var rc: int32 = meo_file_close(p->file);
  p->file.is_open = false;
  p->n_frames = 0;
  p->n_dirty = 0;
  p->meta_dirty = false;
  // The hook's ctx may outlive the pager (a feed is freed separately); a closed
  // pager never calls it again.
  p->hook_ctx = 0;
  p->hook_commit = 0;
  p->hook_rollback = 0;
  p->prepared = false;
  p->unflushed = false;
  p->closed = true;
  return rc;
}

// Read and validate page 0 of an existing file and leave it resident, unpinned.
//
// Identity before integrity: a foreign file and a flipped magic byte both break
// the CRC as well, and PHASE1.md section 7 (and T6) require NOT_A_DB for
// exactly those two cases, so meo_meta_check runs before meo_page_verify. A bad
// checksum on a structurally sound page 0 is still CORRUPT.
fn meo_pager_load_page_zero(p: MeoPager*) -> int32 {
  var f: MeoFrame* = meo_pager_frame_at(p, 0);
  var rc: int32 = meo_file_read_at(p->file, 0, f->data, (int64)MEO_PAGE_SIZE);
  if (rc < 0) { return rc; }
  if (rc != MEO_PAGE_SIZE) { return -MEO_ERR_CORRUPT; }
  var mrc: int32 = meo_meta_check(f->data);
  if (mrc != MEO_OK) { return mrc; }
  var m: MeoMeta = meo_meta_read(f->data);
  if (!m.valid) { return -MEO_ERR_CORRUPT; }
  if (meo_page_verify(f->data) != MEO_OK) { return -MEO_ERR_CORRUPT; }

  p->meta = m;
  p->page_count = m.page_count;
  f->page_no = 0;
  f->in_use = true;
  f->pin = 0;
  f->dirty = false;
  // Second chance: page 0 is the page every alloc has to rewrite, so it earns
  // its way past the first clock pass instead of being evicted by the first
  // miss.
  f->referenced = true;
  meo_pager_index_insert(p, 0, 0);
  p->hand = 0;
  return MEO_OK;
}

// A zero-byte file opened with MEO_PAGER_CREATE: page 0 only, on disk before
// open returns (PHASE1.md section 5.9 step 2).
fn meo_pager_init_new(p: MeoPager*) -> int32 {
  var f: MeoFrame* = meo_pager_frame_at(p, 0);
  var rc: int32 = meo_page_init(f->data, MEO_PAGE_META);
  if (rc != MEO_OK) { return rc; }

  var m: MeoMeta;
  m.valid = true;
  m.magic = MEO_MAGIC;
  m.version = MEO_FORMAT_VERSION;
  m.page_size = MEO_PAGE_SIZE;
  m.page_count = 1;
  m.freelist_root = 0;
  m.catalog_root = 0;
  m.btree_root = 0;
  m.txn_id = 0;
  m.write_version = 1;
  m.commit_seq = 0;
  p->meta = m;
  p->page_count = 1;

  rc = meo_meta_write(f->data, m);
  if (rc != MEO_OK) { return rc; }
  f->page_no = 0;
  f->in_use = true;
  f->pin = 1;
  f->dirty = true;
  f->referenced = true;
  meo_pager_index_insert(p, 0, 0);
  p->n_dirty = 1;
  p->meta_dirty = true;

  // Creating the file is not a commit: the raw flush never counts.
  rc = meo_pager_flush_raw(p);
  if (rc != MEO_OK) { return rc; }
  f->pin = 0;
  return MEO_OK;
}

// --- open / close ----------------------------------------------------------

fn meo_pager_open_failed(code: int32, arg: int64) -> MeoPager* {
  meo_pager_last_open_err = code;
  meo_pager_last_open_err_arg = arg;
  return 0;
}

export fn meo_pager_open(path: string, n_frames: int32, flags: int32) -> MeoPager* {
  meo_pager_last_open_err = MEO_OK;
  meo_pager_last_open_err_arg = 0;
  if (n_frames < MEO_MIN_FRAMES) {
    return meo_pager_open_failed(MEO_ERR_USAGE, (int64)n_frames);
  }
  var cap: int32 = meo_pager_index_cap(n_frames);
  if (cap < 0) {
    return meo_pager_open_failed(MEO_ERR_NOMEM, (int64)n_frames);
  }

  var read_only: bool = (flags & MEO_PAGER_READONLY) != 0;
  var want_create: bool = (flags & MEO_PAGER_CREATE) != 0;
  // A read-only pager is opened read-only: it must not create a file it could
  // never initialise, so a zero-byte file is NOT_A_DB to it, not a new db.
  var oflags: int32 = MEO_OPEN_READ;
  if (!read_only) {
    oflags = MEO_OPEN_READ | MEO_OPEN_WRITE;
    if (want_create) { oflags = oflags | MEO_OPEN_CREATE; }
  }
  var file: MeoFile = meo_file_open(path, oflags);
  if (!file.is_open) {
    return meo_pager_open_failed((int32)(0 - file.handle), 0);
  }

  var p: MeoPager* = new MeoPager;
  if (p == 0) {
    meo_file_close(file);
    return meo_pager_open_failed(MEO_ERR_NOMEM, 0);
  }
  p->file = file;
  p->page_size = MEO_PAGE_SIZE;
  p->page_count = 0;
  p->n_frames = n_frames;
  p->index_cap = cap;
  p->hand = 0;
  p->n_dirty = 0;
  p->write_count = 0;
  p->err = MEO_OK;
  p->err_arg = 0;
  p->read_only = read_only;
  p->closed = false;
  p->journal = 0;
  p->journal_cap = MEO_JRN_MAX_RECORDS;
  p->lock = 0;
  p->hook_ctx = 0;
  p->hook_commit = 0;
  p->hook_rollback = 0;
  p->prepared = false;
  p->unflushed = false;
  p->meta_dirty = false;
  p->path = meo_pager_copy_string(path);
  if (p->path.chars == 0) {
    meo_pager_release_all(p);
    free(p);
    return meo_pager_open_failed(MEO_ERR_NOMEM, 0);
  }

  // new T[n] is zeroed, so an unprepared frame has data == 0 and in_use false.
  var frames: MeoFrame[] = new MeoFrame[n_frames];
  var index: int32[] = new int32[cap];
  p->frames = frames.data;
  p->index = index.data;

  // One page buffer per frame, allocated up front: the get and alloc paths must
  // not have to allocate in the middle of an eviction, where a failure would
  // leave the table half changed.
  var i: int32 = 0;
  while (i < n_frames) {
    var buf: uint8* = malloc((int64)MEO_PAGE_SIZE);
    if (buf == 0) {
      meo_pager_release_all(p);
      free(p);
      return meo_pager_open_failed(MEO_ERR_NOMEM, 0);
    }
    frames[i].data = buf;
    i += 1;
  }

  // A hot journal is replayed before anything else (PHASE3.md 3B): before
  // page 0 is read, before the size is trusted, before a new database is
  // created. Recovery may truncate the file back to the journal's page count.
  var jrc: int32 = meo_jrn_recover(path, p->file, read_only, MEO_MAX_PAGES);
  if (jrc != MEO_OK) {
    meo_pager_release_all(p);
    free(p);
    return meo_pager_open_failed(0 - jrc, 0);
  }

  var size: int64 = meo_file_size(p->file);
  if (size < 0) {
    var code: int32 = (int32)(0 - size);
    meo_pager_release_all(p);
    free(p);
    return meo_pager_open_failed(code, size);
  }
  if (size == 0) {
    // A read-only pager never creates: it could not write page 0 even if the
    // file were ours to initialise, so CREATE is ignored and a zero-byte file
    // is simply not a database yet.
    if (!want_create || read_only) {
      meo_pager_release_all(p);
      free(p);
      return meo_pager_open_failed(MEO_ERR_NOT_A_DB, size);
    }
    var irc: int32 = meo_pager_init_new(p);
    if (irc != MEO_OK) {
      meo_pager_release_all(p);
      free(p);
      return meo_pager_open_failed(0 - irc, size);
    }
    return p;
  }
  // Phase 1 never truncates the file, so a partial page is never ours.
  if (size % (int64)MEO_PAGE_SIZE != 0) {
    meo_pager_release_all(p);
    free(p);
    return meo_pager_open_failed(MEO_ERR_CORRUPT, size);
  }
  var rc: int32 = meo_pager_load_page_zero(p);
  if (rc != MEO_OK) {
    meo_pager_release_all(p);
    free(p);
    return meo_pager_open_failed(0 - rc, size);
  }
  // A page_count that disagrees with the file's length is a torn write or a
  // foreign file. Trusting either number would be a repair, and repairing is
  // not this layer's job.
  if (size / (int64)MEO_PAGE_SIZE != (int64)p->meta.page_count) {
    meo_pager_release_all(p);
    free(p);
    return meo_pager_open_failed(MEO_ERR_CORRUPT, size);
  }
  return p;
}

// Flush, sync, close the file and free every buffer and array. The MeoPager
// block survives so a second close can be answered MEO_OK (PHASE1.md section 7);
// meo_pager_free is what releases it.
export fn meo_pager_close(p: MeoPager*) -> int32 {
  if (p == 0) { return -MEO_ERR_USAGE; }
  // Second close is MEO_OK (PHASE1.md section 7); the handle outlives it.
  if (!meo_pager_is_live(p)) { return MEO_OK; }

  var first: int32 = MEO_OK;
  // A close with an open transaction rolls it back: closing is not committing,
  // and leaving a hot journal behind would make the next open undo a
  // transaction the caller never committed.
  if (p->journal != 0) {
    var rrc: int32 = meo_pager_rollback(p);
    if (rrc != MEO_OK) { first = rrc; }
  }
  // The public flush: unflushed autocommit changes are counted and published
  // here, exactly as an explicit flush would.
  var rc: int32 = meo_pager_flush(p);
  if (rc != MEO_OK && p->unflushed) { meo_pager_notify_rollback(p, false); }
  if (rc != MEO_OK && first == MEO_OK) { first = rc; }
  rc = meo_pager_sync(p);
  if (rc != MEO_OK && first == MEO_OK) { first = rc; }
  // Everything is freed on the error path too: a failed flush must not leak a
  // frame buffer or an array.
  rc = meo_pager_release_all(p);
  if (rc != MEO_OK && first == MEO_OK) { first = rc; }
  p->err = 0 - first;
  p->err_arg = 0;
  return first;
}

// Release the MeoPager block itself, after close (even a failed close). It does
// not flush: freeing is not closing, so a caller that never closed gets its
// buffers and file handle back and nothing is written.
export fn meo_pager_free(p: MeoPager*) {
  if (p == 0) { return; }
  if (!p->closed) {
    // Freeing without closing is a caller error, but it must not leave a hot
    // journal that would undo the next open. Roll back first, then release.
    if (p->journal != 0) {
      meo_pager_rollback(p);
    } else if (p->unflushed) {
      // Changes made outside a transaction are dropped here, but an eviction
      // may already have written some of them: the outcome is uncertain.
      meo_pager_notify_rollback(p, false);
    }
    meo_pager_release_all(p);
  }
  free(p);
}

// --- roots -----------------------------------------------------------------

// Write a MEO_ROOT_* slot. The pager's meta is authoritative in memory and page
// 0 is rewritten by the next flush, exactly like page_count (see the header
// note on meta_dirty).
export fn meo_pager_set_root(p: MeoPager*, which: int32, page_no: uint32) -> int32 {
  if (p == 0) { return -MEO_ERR_USAGE; }
  meo_pager_clear_err(p);
  if (!meo_pager_is_live(p)) { return meo_pager_fail(p, -MEO_ERR_USAGE, 0); }
  if (p->read_only) {
    return meo_pager_fail(p, -MEO_ERR_READONLY, (int64)which);
  }
  var rc: int32 = meo_meta_set_root(&p->meta, which, page_no);
  if (rc != MEO_OK) { return meo_pager_fail(p, rc, (int64)which); }
  meo_pager_meta_touch(p);
  return MEO_OK;
}

// --- page access -----------------------------------------------------------

export fn meo_pager_get(p: MeoPager*, page_no: uint32, write: bool) -> MeoFrame* {
  if (p == 0) { return 0; }
  meo_pager_clear_err(p);
  if (!meo_pager_is_live(p)) { return meo_pager_fail_ptr(p, -MEO_ERR_USAGE, 0); }
  // A write intent on a read-only pager is refused before anything is pinned.
  if (write && p->read_only) {
    return meo_pager_fail_ptr(p, -MEO_ERR_READONLY, (int64)page_no);
  }

  var fi: int32 = meo_pager_find(p, page_no);
  if (fi >= 0) {
    var hit: MeoFrame* = meo_pager_frame_at(p, fi);
    var mrc: int32 = meo_pager_meta_refresh(p, hit);
    if (mrc != MEO_OK) { return meo_pager_fail_ptr(p, mrc, (int64)page_no); }
    hit->pin += 1;
    hit->referenced = true;
    return hit;
  }

  // A cached page is reachable even before the meta that counts it is durable
  // (PHASE1.md section 5.9: alloc caches first, flushes later).
  if ((int64)page_no >= (int64)p->page_count) {
    return meo_pager_fail_ptr(p, -MEO_ERR_RANGE, (int64)page_no);
  }

  fi = meo_pager_pick_victim(p);
  if (fi < 0) {
    // Every frame in reach is pinned: refuse rather than evict a page a caller
    // still holds. No frame is touched.
    return meo_pager_fail_ptr(p, -MEO_ERR_BUSY, (int64)page_no);
  }
  var rc: int32 = meo_pager_take_frame(p, fi, page_no);
  if (rc != MEO_OK) {
    // A failed write-back abandons the eviction; the frame stays as it was.
    return meo_pager_fail_ptr(p, rc, (int64)page_no);
  }
  rc = meo_pager_load_page(p, fi, page_no);
  if (rc != MEO_OK) {
    // Nothing references the frame and its old contents are gone, so hand it
    // back to the clock as a free frame rather than leave it half installed.
    var f: MeoFrame* = meo_pager_frame_at(p, fi);
    f->in_use = false;
    f->pin = 0;
    f->page_no = 0;
    f->dirty = false;
    f->referenced = false;
    return meo_pager_fail_ptr(p, rc, (int64)page_no);
  }
  meo_pager_index_insert(p, page_no, fi);
  return meo_pager_frame_at(p, fi);
}

export fn meo_pager_release(p: MeoPager*, f: MeoFrame*, dirty: bool) -> int32 {
  if (p == 0 || f == 0) { return -MEO_ERR_USAGE; }
  meo_pager_clear_err(p);
  if (!meo_pager_is_live(p)) { return meo_pager_fail(p, -MEO_ERR_USAGE, 0); }
  if (f->pin <= 0) {
    // The bug this catches is a caller releasing a page it does not hold: the
    // pin count would go negative and the frame would become evictable while
    // somebody still reads it.
    return meo_pager_fail(p, -MEO_ERR_USAGE, (int64)f->page_no);
  }
  if (dirty && p->read_only) {
    return meo_pager_fail(p, -MEO_ERR_READONLY, (int64)f->page_no);
  }
  f->pin -= 1;
  if (dirty) { meo_pager_mark_dirty(p, f); }
  return MEO_OK;
}

// --- freelist (PHASE2.md section 2C) ---------------------------------------
//
// The chain lives on disk: meta.freelist_root is the head, every freelist page
// links to the next, and every page the chain names is reusable. There is no
// in-memory index, so take/put/count walk the chain through the pager and the
// chain survives close/reopen by construction.
//
// Two consequences worth naming:
// * a take that finds a head page holding only its link hands that whole page
//   out and advances the root. An emptied chain page is therefore never
//   leaked; draining the freelist yields its chain pages too.
// * a push that finds the head full makes a new head, and meo_pager_alloc may
//   supply it FROM the freelist (one free page becomes a chain page) instead
//   of growing the file. That is why the old root is re-read after the alloc.

// Pin the freelist page `page_no` and prove it is one: inside the file, of
// type MEO_PAGE_FREELIST, structurally sound. Every walk goes through here, so
// a chain that loops or names a data page is CORRUPT rather than an infinite
// scan or a silently empty list. Answers 0 with meo_pager_err set on failure.
fn meo_pager_free_get(p: MeoPager*, page_no: uint32, write: bool) -> MeoFrame* {
  if ((int64)page_no >= (int64)p->page_count) {
    return meo_pager_fail_ptr(p, -MEO_ERR_CORRUPT, (int64)page_no);
  }
  var f: MeoFrame* = meo_pager_get(p, page_no, write);
  if (f == 0) { return 0; }
  var rc: int32 = meo_page_check(f->data);
  if (rc == MEO_OK && meo_page_type(f->data) != MEO_PAGE_FREELIST) {
    rc = -MEO_ERR_CORRUPT;
  }
  if (rc != MEO_OK) {
    meo_pager_release(p, f, false);
    return meo_pager_fail_ptr(p, rc, (int64)page_no);
  }
  return f;
}

// What the freelist can see of `page_no`: 0 = nothing, 1 = it is listed as
// free, 2 = it is one of the chain's own pages, negative = failure. Freeing a
// listed page twice and freeing a chain page are both CORRUPT (PHASE2.md
// section 2C); telling them apart here keeps the walk in one place.
fn meo_pager_free_probe(p: MeoPager*, page_no: uint32) -> int32 {
  var root: uint32 = p->meta.freelist_root;
  var walked: uint32 = 0;
  while (root != 0) {
    if (root == page_no) { return 2; }
    var f: MeoFrame* = meo_pager_free_get(p, root, false);
    if (f == 0) { return 0 - p->err; }
    var listed: bool = meo_free_page_has(f->data, page_no);
    var next: uint32 = meo_free_page_next(f->data);
    meo_pager_release(p, f, false);
    if (listed) { return 1; }
    root = next;
    walked += 1;
    // A chain that loops names more pages than the file holds; stop instead of
    // spinning. The bound is the file itself, not an arbitrary constant.
    if ((int64)walked > (int64)p->page_count) { return -MEO_ERR_CORRUPT; }
  }
  return 0;
}

// Validate the whole chain without changing it. Phase 2C keeps no in-memory
// freelist state, so this is not how take/put start up: it is the check a
// caller (or a test) runs before trusting a file, and it is what proves the
// chain read back after a reopen is sound. -MEO_ERR_CORRUPT for a chain that
// loops, names a page outside the file, is not a freelist page, or holds a
// cell that is not a 4-byte page number or not a live page number.
export fn meo_free_init(p: MeoPager*) -> int32 {
  if (p == 0) { return -MEO_ERR_USAGE; }
  meo_pager_clear_err(p);
  if (!meo_pager_is_live(p)) { return meo_pager_fail(p, -MEO_ERR_USAGE, 0); }
  var root: uint32 = p->meta.freelist_root;
  var walked: uint32 = 0;
  while (root != 0) {
    var f: MeoFrame* = meo_pager_free_get(p, root, false);
    if (f == 0) { return 0 - p->err; }
    var n: int32 = meo_page_n_cells(f->data);
    var bad: bool = false;
    var i: int32 = 0;
    while (i < n) {
      if (meo_page_cell_len(f->data, i) != MEO_FREE_CELL_BODY) { bad = true; }
      i += 1;
    }
    // Cell 0 is the link; cells 1..n-1 must be pages this file really has.
    // Page 0 is never free, so a 0 here is corruption too.
    i = 1;
    while (i < n) {
      var v: uint32 = meo_free_page_at(f->data, i);
      if (v == 0 || (int64)v >= (int64)p->page_count) { bad = true; }
      i += 1;
    }
    var next: uint32 = meo_free_page_next(f->data);
    meo_pager_release(p, f, false);
    if (bad) { return meo_pager_fail(p, -MEO_ERR_CORRUPT, (int64)root); }
    root = next;
    walked += 1;
    if ((int64)walked > (int64)p->page_count) {
      return meo_pager_fail(p, -MEO_ERR_CORRUPT, (int64)root);
    }
  }
  return MEO_OK;
}

// Take the newest free page number, or 0 when the freelist is empty. LIFO, so
// a reuse returns the pages in the order they were freed, newest first.
// 0 is both the empty answer and the failure answer (PHASE2.md names the
// return uint32), so a caller checks meo_pager_err: it is MEO_OK for an empty
// freelist and the failure code otherwise.
export fn meo_free_take(p: MeoPager*) -> uint32 {
  if (p == 0) { return 0; }
  meo_pager_clear_err(p);
  if (!meo_pager_is_live(p)) {
    meo_pager_fail(p, -MEO_ERR_USAGE, 0);
    return 0;
  }
  if (p->read_only) {
    meo_pager_fail(p, -MEO_ERR_READONLY, (int64)p->meta.freelist_root);
    return 0;
  }
  var root: uint32 = p->meta.freelist_root;
  if (root == 0) { return 0; }
  var f: MeoFrame* = meo_pager_free_get(p, root, true);
  if (f == 0) { return 0; }
  if (meo_free_page_count(f->data) >= 1) {
    var v: uint32 = meo_free_page_pop(f->data);
    meo_pager_release(p, f, true);
    return v;
  }
  // Only the link is left: the head page is entirely reusable, so hand the
  // page itself out and move the head to its successor.
  var next: uint32 = meo_free_page_next(f->data);
  meo_pager_release(p, f, false);
  var rc: int32 = meo_pager_set_root(p, MEO_ROOT_FREELIST, next);
  if (rc != MEO_OK) { return 0; }
  return root;
}

// Is `page_no` in the frame table with a pin on it? An index lookup, not a
// read: a page that is not resident is not pinned, and asking must not fault
// it in.
fn meo_pager_page_pinned(p: MeoPager*, page_no: uint32) -> bool {
  var fi: int32 = meo_pager_find(p, page_no);
  if (fi < 0) { return false; }
  return p->frames[fi].pin > 0;
}

// Push `page_no` onto the freelist. -MEO_ERR_USAGE for page 0 (PHASE2.md 2C),
// -MEO_ERR_RANGE for a page the file does not have, -MEO_ERR_USAGE for a page the
// caller still has pinned, -MEO_ERR_CORRUPT for a page the freelist can already
// see (a double free, or a freelist page itself).
export fn meo_free_put(p: MeoPager*, page_no: uint32) -> int32 {
  if (p == 0) { return -MEO_ERR_USAGE; }
  meo_pager_clear_err(p);
  if (!meo_pager_is_live(p)) {
    return meo_pager_fail(p, -MEO_ERR_USAGE, (int64)page_no);
  }
  if (p->read_only) {
    return meo_pager_fail(p, -MEO_ERR_READONLY, (int64)page_no);
  }
  if (page_no == 0) { return meo_pager_fail(p, -MEO_ERR_USAGE, 0); }
  if ((int64)page_no >= (int64)p->page_count) {
    return meo_pager_fail(p, -MEO_ERR_RANGE, (int64)page_no);
  }
  // A page the caller still has pinned is refused (PHASE2.md section 2C). The
  // frame table is the only record of who owns a buffer: the next alloc hands
  // this page to a new owner and zeroes it under the stale frame pointer, and
  // nothing later can tell that it happened.
  if (meo_pager_page_pinned(p, page_no)) {
    return meo_pager_fail(p, -MEO_ERR_USAGE, (int64)page_no);
  }
  var probe: int32 = meo_pager_free_probe(p, page_no);
  if (probe == 1 || probe == 2) {
    return meo_pager_fail(p, -MEO_ERR_CORRUPT, (int64)page_no);
  }
  if (probe < 0) { return meo_pager_fail(p, probe, (int64)page_no); }

  var root: uint32 = p->meta.freelist_root;
  if (root == 0) {
    // No chain yet: the head is a new page at the end of the file. The
    // freelist is empty, so this alloc cannot come back out of it.
    var nf: MeoFrame* = meo_pager_alloc(p);
    if (nf == 0) { return 0 - p->err; }
    var new_root: uint32 = nf->page_no;
    var irc: int32 = meo_free_page_init(nf->data, 0);
    var prc: int32 = irc;
    if (irc == MEO_OK) { prc = meo_free_page_push(nf->data, page_no); }
    meo_pager_release(p, nf, prc == MEO_OK);
    if (prc != MEO_OK) { return meo_pager_fail(p, prc, (int64)new_root); }
    return meo_pager_set_root(p, MEO_ROOT_FREELIST, new_root);
  }

  var f: MeoFrame* = meo_pager_free_get(p, root, true);
  if (f == 0) { return 0 - p->err; }
  var rc: int32 = meo_free_page_push(f->data, page_no);
  if (rc != -MEO_ERR_FULL) {
    meo_pager_release(p, f, rc == MEO_OK);
    if (rc != MEO_OK) { return meo_pager_fail(p, rc, (int64)page_no); }
    return MEO_OK;
  }
  meo_pager_release(p, f, false);

  // The head is full: a new page becomes the head and links to the old one.
  var hf: MeoFrame* = meo_pager_alloc(p);
  if (hf == 0) { return 0 - p->err; }
  var head: uint32 = hf->page_no;
  var hrc: int32 = meo_free_page_init(hf->data, p->meta.freelist_root);
  if (hrc == MEO_OK) { hrc = meo_free_page_push(hf->data, page_no); }
  meo_pager_release(p, hf, hrc == MEO_OK);
  if (hrc != MEO_OK) { return meo_pager_fail(p, hrc, (int64)head); }
  return meo_pager_set_root(p, MEO_ROOT_FREELIST, head);
}

// How many pages the freelist holds, across the whole chain. 0 with
// meo_pager_err set when the chain cannot be read.
export fn meo_free_count(p: MeoPager*) -> int64 {
  if (p == 0) { return 0; }
  meo_pager_clear_err(p);
  if (!meo_pager_is_live(p)) {
    meo_pager_fail(p, -MEO_ERR_USAGE, 0);
    return 0;
  }
  var root: uint32 = p->meta.freelist_root;
  var total: int64 = 0;
  var walked: uint32 = 0;
  while (root != 0) {
    var f: MeoFrame* = meo_pager_free_get(p, root, false);
    if (f == 0) { return 0; }
    total += (int64)meo_free_page_count(f->data);
    var next: uint32 = meo_free_page_next(f->data);
    meo_pager_release(p, f, false);
    root = next;
    walked += 1;
    if ((int64)walked > (int64)p->page_count) {
      meo_pager_fail(p, -MEO_ERR_CORRUPT, (int64)root);
      return 0;
    }
  }
  return total;
}

// --- page allocation -------------------------------------------------------

export fn meo_pager_alloc(p: MeoPager*) -> MeoFrame* {
  if (p == 0) { return 0; }
  meo_pager_clear_err(p);
  if (!meo_pager_is_live(p)) { return meo_pager_fail_ptr(p, -MEO_ERR_USAGE, 0); }
  if (p->read_only) {
    return meo_pager_fail_ptr(p, -MEO_ERR_READONLY, (int64)p->page_count);
  }
  // A free page is reused before the file grows (PHASE2.md section 2C).
  // meo_free_take answers 0 both for an empty freelist and for a failure, so
  // the recorded error is what tells the two apart.
  var reuse: uint32 = meo_free_take(p);
  if (p->err != MEO_OK) {
    return meo_pager_fail_ptr(p, 0 - p->err, p->err_arg);
  }
  if (reuse != 0) {
    var r: MeoFrame* = meo_pager_get(p, reuse, true);
    if (r == 0) { return 0; }
    // Every byte, for the same reason the extend path below zeroes: the page
    // still holds whatever its last owner left there (PHASE1.md 6b.9).
    meo_bytes_zero(r->data, (int64)MEO_PAGE_SIZE);
    meo_pager_mark_dirty(p, r);
    return r;
  }
  // The hard cap of PHASE1.md section 2: the page number is uint32 and the file
  // is page_count * 4096, so 4 GiB is the phase-1 ceiling.
  if (p->page_count >= MEO_MAX_PAGES) {
    return meo_pager_fail_ptr(p, -MEO_ERR_NOSPC, (int64)p->page_count);
  }

  var fi: int32 = meo_pager_pick_victim(p);
  if (fi < 0) { return meo_pager_fail_ptr(p, -MEO_ERR_BUSY, 0); }
  var page_no: uint32 = p->page_count;
  var rc: int32 = meo_pager_take_frame(p, fi, page_no);
  if (rc != MEO_OK) {
    // page_count has not moved, so the page number is not burned.
    return meo_pager_fail_ptr(p, rc, (int64)page_no);
  }
  var f: MeoFrame* = meo_pager_frame_at(p, fi);
  // Every one of the 4096 bytes, whatever this frame held before: stale bytes
  // are an information leak (PHASE1.md section 6b.9).
  meo_bytes_zero(f->data, (int64)MEO_PAGE_SIZE);
  meo_pager_index_insert(p, page_no, fi);
  p->page_count += 1;
  meo_pager_mark_dirty(p, f);
  // The new page_count only becomes durable with page 0.
  p->meta.page_count = p->page_count;
  meo_pager_meta_touch(p);
  return f;
}

// PHASE2.md section 2C: a freed page is pushed onto the persistent freelist,
// and the validation (page 0, a page the file does not have, a page the caller
// still has pinned, a double free, a read-only pager) lives in meo_free_put so
// there is exactly one copy of it. Refusing a pinned page is what keeps the
// next alloc from zeroing a buffer a live frame pointer still names.
export fn meo_pager_free_page(p: MeoPager*, page_no: uint32) -> int32 {
  return meo_free_put(p, page_no);
}

// --- durability ------------------------------------------------------------

export fn meo_pager_flush_plan(p: MeoPager*, out: uint32*, cap: int32) -> int32 {
  if (p == 0) { return -MEO_ERR_USAGE; }
  meo_pager_clear_err(p);
  if (!meo_pager_is_live(p)) { return meo_pager_fail(p, -MEO_ERR_USAGE, 0); }
  var need: int32 = meo_pager_plan_count(p);
  if (cap < need) { return meo_pager_fail(p, -MEO_ERR_FULL, (int64)need); }
  if (need > 0 && out == 0) { return meo_pager_fail(p, -MEO_ERR_USAGE, 0); }

  // Ascending selection: repeatedly take the smallest page number above the
  // last one written. n_frames is small and the plan is inspected, not hot.
  var n: int32 = 0;
  var last: uint32 = 0;
  var more: bool = true;
  while (more) {
    var best: uint32 = 0;
    var found: bool = false;
    var i: int32 = 0;
    while (i < p->n_frames) {
      var f: MeoFrame* = meo_pager_frame_at(p, i);
      // page_no > last >= 0, so page 0 is never selected here; it goes last.
      if (f->in_use && f->dirty && f->page_no > last) {
        if (!found || f->page_no < best) {
          best = f->page_no;
          found = true;
        }
      }
      i += 1;
    }
    if (found) {
      out[n] = best;
      n += 1;
      last = best;
    }
    more = found;
  }
  // The meta last: a durable page_count that runs ahead of the durable pages it
  // counts is a corrupt database.
  if (meo_pager_meta_pending(p)) {
    out[n] = 0;
    n += 1;
  }
  return n;
}

// The flush itself: write every dirty page, page 0 last, then fsync. It never
// touches commit_seq or the hook; commit and the new-file init call it.
fn meo_pager_flush_raw(p: MeoPager*) -> int32 {
  meo_pager_clear_err(p);
  if (!meo_pager_is_live(p)) { return meo_pager_fail(p, -MEO_ERR_USAGE, 0); }
  var need: int32 = meo_pager_plan_count(p);
  if (p->read_only && need > 0) {
    return meo_pager_fail(p, -MEO_ERR_READONLY, (int64)need);
  }
  if (need == 0) {
    // Nothing to write. A flush still means "make what is on the disk durable",
    // and a read-only pager can reach here (an fsync on a read-only file is
    // legal), which is what lets close() work for one.
    var zrc: int32 = meo_file_sync(p->file);
    if (zrc != MEO_OK) { return meo_pager_fail(p, zrc, 0); }
    return MEO_OK;
  }

  var plan: uint32[] = new uint32[need];
  var got: int32 = meo_pager_flush_plan(p, plan.data, need);
  if (got < 0) {
    free(plan.data);
    return meo_pager_fail(p, got, (int64)need);
  }
  var i: int32 = 0;
  while (i < got) {
    var rc: int32 = meo_pager_write_planned(p, plan[i]);
    if (rc != MEO_OK) {
      free(plan.data);
      // Nothing is marked clean: the pages were not all written, so the next
      // flush must try again.
      return meo_pager_fail(p, rc, (int64)plan[i]);
    }
    i += 1;
  }
  // Page 0 is already in the plan, last, so this one sync covers the whole
  // write set. Only after it succeeds are the pages clean.
  var src: int32 = meo_file_sync(p->file);
  if (src != MEO_OK) {
    free(plan.data);
    return meo_pager_fail(p, src, 0);
  }
  var k: int32 = 0;
  while (k < got) {
    meo_pager_mark_written(p, plan[k]);
    k += 1;
  }
  free(plan.data);
  return MEO_OK;
}

// The public flush. Inside a transaction it is a plain write-out (a commit is
// what counts). Outside one, with modifications made since the last flush
// (`unflushed`), it is an autocommit: commit_seq is bumped into page 0 before
// the write and the commit hook fires after the fsync. NOT atomic -- see the
// header note. A failed flush restores the in-memory commit_seq.
export fn meo_pager_flush(p: MeoPager*) -> int32 {
  if (p == 0) { return -MEO_ERR_USAGE; }
  meo_pager_clear_err(p);
  if (!meo_pager_is_live(p)) { return meo_pager_fail(p, -MEO_ERR_USAGE, 0); }
  if (p->journal != 0 || p->read_only || !p->unflushed) {
    return meo_pager_flush_raw(p);
  }
  var old_seq: uint64 = p->meta.commit_seq;
  var rc: int32 = meo_pager_meta_set_commit_seq(p, old_seq + 1);
  if (rc != MEO_OK) {
    p->meta.commit_seq = old_seq;
    return meo_pager_fail(p, rc, 0);
  }
  rc = meo_pager_flush_raw(p);
  if (rc != MEO_OK) {
    var err_arg: int64 = p->err_arg;
    meo_pager_meta_set_commit_seq(p, old_seq);
    return meo_pager_fail(p, rc, err_arg);
  }
  p->unflushed = false;
  meo_pager_notify_commit(p);
  return MEO_OK;
}

export fn meo_pager_sync(p: MeoPager*) -> int32 {
  if (p == 0) { return -MEO_ERR_USAGE; }
  meo_pager_clear_err(p);
  if (!meo_pager_is_live(p)) { return meo_pager_fail(p, -MEO_ERR_USAGE, 0); }
  var rc: int32 = meo_file_sync(p->file);
  if (rc != MEO_OK) { return meo_pager_fail(p, rc, 0); }
  return MEO_OK;
}

// --- transactions (PHASE3.md 3B) -------------------------------------------
//
// A transaction is a rollback journal attached to the pager. begin writes and
// fsyncs the journal header; every page write through meo_pager_write_page
// appends the page's before-image and fsyncs it before the new bytes reach the
// disk; commit flushes the database, fsyncs it, and only then removes the
// journal; rollback writes the before-images back, truncates the file to the
// journal's page count, fsyncs, and removes the journal.
//
// The journal is attached to the pager, not to a frame, so an eviction, a
// flush and the non-resident page-0 path all reach it through the one write
// chokepoint. The journal's own bitmap decides "first touch", which is what
// keeps a page that is evicted and re-read from getting a second before-image.

export fn meo_pager_begin(p: MeoPager*) -> int32 {
  if (p == 0) { return -MEO_ERR_USAGE; }
  meo_pager_clear_err(p);
  if (!meo_pager_is_live(p)) { return meo_pager_fail(p, -MEO_ERR_USAGE, 0); }
  if (p->read_only) {
    return meo_pager_fail(p, -MEO_ERR_READONLY, 0);
  }
  if (p->journal != 0) {
    return meo_pager_fail(p, -MEO_ERR_USAGE, 0);
  }
  var j: MeoJournal* = meo_jrn_create(p->path, p->page_count,
    (uint32)p->meta.write_version, p->journal_cap);
  if (j == 0) {
    return meo_pager_fail(p, meo_jrn_last_error(), (int64)p->page_count);
  }
  p->journal = (rawptr)j;
  return MEO_OK;
}

// The first half of a commit: bump commit_seq into page 0, write every dirty
// page (each before-image is appended by the chokepoint before its page, page
// 0 included), and fsync the database. The journal is NOT removed, so the
// transaction is still undoable: a rollback or a crash from here restores the
// pre-transaction pages and commit_seq. meo_pager_commit is prepare + the
// journal removal; prepare is exported for two-phase coordination and so a
// test can crash a process between the two halves. Calling it twice bumps
// once. A failure restores the in-memory commit_seq; the transaction stays
// open.
export fn meo_pager_commit_prepare(p: MeoPager*) -> int32 {
  if (p == 0) { return -MEO_ERR_USAGE; }
  meo_pager_clear_err(p);
  if (!meo_pager_is_live(p)) { return meo_pager_fail(p, -MEO_ERR_USAGE, 0); }
  if (p->journal == 0) {
    return meo_pager_fail(p, -MEO_ERR_USAGE, 0);
  }
  var bumped: bool = false;
  var old_seq: uint64 = p->meta.commit_seq;
  if (!p->prepared) {
    var brc: int32 = meo_pager_meta_set_commit_seq(p, old_seq + 1);
    if (brc != MEO_OK) {
      p->meta.commit_seq = old_seq;
      return meo_pager_fail(p, brc, 0);
    }
    bumped = true;
  }
  var rc: int32 = meo_pager_flush_raw(p);
  if (rc == MEO_OK) { rc = meo_pager_sync(p); }
  if (rc != MEO_OK) {
    if (bumped) { meo_pager_meta_set_commit_seq(p, old_seq); }
    return meo_pager_fail(p, rc, 0);
  }
  p->prepared = true;
  return MEO_OK;
}

export fn meo_pager_commit(p: MeoPager*) -> int32 {
  if (p == 0) { return -MEO_ERR_USAGE; }
  meo_pager_clear_err(p);
  if (!meo_pager_is_live(p)) { return meo_pager_fail(p, -MEO_ERR_USAGE, 0); }
  if (p->journal == 0) {
    return meo_pager_fail(p, -MEO_ERR_USAGE, 0);
  }
  // Write and fsync every dirty page first. Only after that is the journal
  // removed: a commit that deleted the journal first would lose the undo log
  // for pages that were not yet durable.
  var rc: int32 = meo_pager_commit_prepare(p);
  if (rc != MEO_OK) { return rc; }
  meo_jrn_destroy((MeoJournal*)p->journal);
  p->journal = 0;
  p->prepared = false;
  p->unflushed = false;
  // Durable now: the journal is gone. Only now may anyone hear about it.
  meo_pager_notify_commit(p);
  return MEO_OK;
}

export fn meo_pager_rollback(p: MeoPager*) -> int32 {
  if (p == 0) { return -MEO_ERR_USAGE; }
  meo_pager_clear_err(p);
  if (!meo_pager_is_live(p)) { return meo_pager_fail(p, -MEO_ERR_USAGE, 0); }
  if (p->journal == 0) {
    return meo_pager_fail(p, -MEO_ERR_USAGE, 0);
  }
  // A pinned frame is a caller still reading a page this rollback is about to
  // invalidate. Refuse rather than hand back a stale pointer.
  var i: int32 = 0;
  while (i < p->n_frames) {
    if (p->frames[i].in_use && p->frames[i].pin > 0) {
      return meo_pager_fail(p, -MEO_ERR_BUSY, (int64)p->frames[i].page_no);
    }
    i += 1;
  }
  var j: MeoJournal* = (MeoJournal*)p->journal;
  var rc: int32 = meo_jrn_rollback(j, p->file);
  if (rc != MEO_OK) {
    // The file may be half restored and the transaction is still open: the
    // feed must not trust anything it captured, so the outcome is uncertain.
    meo_pager_notify_rollback(p, false);
    return meo_pager_fail(p, rc, 0);
  }
  meo_jrn_destroy(j);
  p->journal = 0;
  p->prepared = false;
  p->unflushed = false;
  meo_pager_notify_rollback(p, true);
  // The cache still holds the new content. Drop every frame and reload page 0
  // from the restored file, which also restores p->meta and p->page_count.
  i = 0;
  while (i < p->n_frames) {
    var f: MeoFrame* = meo_pager_frame_at(p, i);
    f->in_use = false;
    f->pin = 0;
    f->page_no = 0;
    f->dirty = false;
    f->referenced = false;
    i += 1;
  }
  i = 0;
  while (i < p->index_cap) {
    p->index[i] = 0;
    i += 1;
  }
  p->n_dirty = 0;
  p->meta_dirty = false;
  p->hand = 0;
  rc = meo_pager_load_page_zero(p);
  if (rc != MEO_OK) { return meo_pager_fail(p, rc, 0); }
  return MEO_OK;
}

export fn meo_pager_journal_attached(p: MeoPager*) -> bool {
  if (p == 0) { return false; }
  return p->journal != 0;
}

// Lower the journal's record cap for this pager. It exists so a test can prove
// NOSPC on a small database instead of allocating 65536 pages, and so an
// embedder can bound the journal. The cap is read at begin; changing it while
// a transaction is open is refused.
export fn meo_pager_set_journal_cap(p: MeoPager*, records: int32) -> int32 {
  if (p == 0) { return -MEO_ERR_USAGE; }
  meo_pager_clear_err(p);
  if (!meo_pager_is_live(p)) { return meo_pager_fail(p, -MEO_ERR_USAGE, 0); }
  if (records < 1) { return meo_pager_fail(p, -MEO_ERR_USAGE, (int64)records); }
  if (p->journal != 0) {
    return meo_pager_fail(p, -MEO_ERR_USAGE, (int64)records);
  }
  p->journal_cap = records;
  return MEO_OK;
}

// Store `value` as commit_seq in p->meta AND in page 0, without re-encoding
// the rest of page 0 from p->meta when nothing else asked for that. A caller
// may write page 0 through its frame (meo_meta_write into get(0)); a full
// re-encode here would silently undo those bytes. So: when a re-encode is
// already pending (meta_dirty), p->meta is the authority and the counter rides
// along; otherwise only the eight counter bytes of the frame are patched,
// faulting page 0 in when it is not resident.
fn meo_pager_meta_set_commit_seq(p: MeoPager*, value: uint64) -> int32 {
  p->meta.commit_seq = value;
  if (p->meta_dirty) {
    meo_pager_meta_touch(p);
    return MEO_OK;
  }
  var f: MeoFrame* = meo_pager_get(p, 0, true);
  if (f == 0) { return 0 - p->err; }
  meo_meta_put_commit_seq(f->data, value);
  return meo_pager_release(p, f, true);
}

// --- commit hook -----------------------------------------------------------

fn meo_pager_notify_commit(p: MeoPager*) {
  if (p->hook_commit == 0) { return; }
  var now_us: int64 = meo_clock_realtime_us();
  p->hook_commit(p->hook_ctx, p->meta.commit_seq, now_us);
}

fn meo_pager_notify_rollback(p: MeoPager*, ok: bool) {
  if (p->hook_rollback == 0) { return; }
  p->hook_rollback(p->hook_ctx, ok);
}

// Install (or, with all three 0, remove) the commit hook. Refused with
// -MEO_ERR_USAGE while a transaction is open: a hook attached halfway through
// would publish a transaction it saw only part of. Answers MEO_OK, or 1 when
// the pager already holds modifications made outside a transaction that the
// next flush will count -- the new hook did not see them, so its owner should
// treat the next commit as a gap. Removing the hook is always allowed.
export fn meo_pager_set_hook(p: MeoPager*, ctx: rawptr,
    meo_commit_cb: fn(rawptr, uint64, int64) -> void,
    meo_rollback_cb: fn(rawptr, bool) -> void) -> int32 {
  if (p == 0) { return -MEO_ERR_USAGE; }
  meo_pager_clear_err(p);
  if (!meo_pager_is_live(p)) { return meo_pager_fail(p, -MEO_ERR_USAGE, 0); }
  var removing: bool = ctx == 0 && meo_commit_cb == 0 && meo_rollback_cb == 0;
  if (removing) {
    p->hook_ctx = 0;
    p->hook_commit = 0;
    p->hook_rollback = 0;
    return MEO_OK;
  }
  if (p->journal != 0) { return meo_pager_fail(p, -MEO_ERR_USAGE, 0); }
  p->hook_ctx = ctx;
  p->hook_commit = meo_commit_cb;
  p->hook_rollback = meo_rollback_cb;
  if (p->unflushed) { return 1; }
  return MEO_OK;
}

// The ctx of the installed hook, or 0. A hook owner uses it to prove a pager
// is attached to it before capturing changes for it.
export fn meo_pager_hook_ctx(p: MeoPager*) -> rawptr {
  if (p == 0) { return 0; }
  return p->hook_ctx;
}

// The persisted commit counter as this pager sees it: the value the last
// successful commit (or counted autocommit flush) made durable, or the value
// read at open. 0 for a file that predates the field.
export fn meo_pager_commit_seq(p: MeoPager*) -> uint64 {
  if (p == 0) { return 0; }
  return p->meta.commit_seq;
}

// Read commit_seq straight from page 0 on disk, with no pager: the cheap "did
// anything commit?" probe for another handle or another process. Page 0 is
// validated exactly as an open validates it (magic, version, page size, page
// structure, CRC). No recovery is attempted and nothing is written.
//
// MEO_OK: out[0] is the committed value. 1: out[0] was read, but a journal
// sits beside the database (a transaction is open, is committing, or died
// hot), so the value may belong to a state that is not committed yet and may
// still be rolled back; poll again. Page 0 is read BEFORE the journal is
// looked for: a commit writes page 0, fsyncs, then removes the journal, so a
// new value seen with no journal after it is committed.
//
// Failures: the open's codes for a missing file, -MEO_ERR_NOT_A_DB /
// -MEO_ERR_VERSION for a foreign file, -MEO_ERR_CORRUPT for a page 0 that fails
// its checks. A page 0 that fails its checks while a journal is present is
// -MEO_ERR_BUSY instead: that is a writer caught mid-write (retry), not damage.
// An autocommit flush has no journal, so a reader racing one can see a
// transient -MEO_ERR_CORRUPT; retry before believing it.
export fn meo_peek_commit_seq(path: string, out: uint64*) -> int32 {
  if (out == 0) { return -MEO_ERR_USAGE; }
  var f: MeoFile = meo_file_open(path, MEO_OPEN_READ);
  if (!f.is_open) { return (int32)f.handle; }
  var buf: uint8* = malloc((int64)MEO_PAGE_SIZE);
  if (buf == 0) {
    meo_file_close(f);
    return -MEO_ERR_NOMEM;
  }
  var rc: int32 = meo_file_read_at(f, 0, buf, (int64)MEO_PAGE_SIZE);
  meo_file_close(f);
  var status: int32 = MEO_OK;
  if (rc < 0) {
    status = rc;
  } else if (rc != MEO_PAGE_SIZE) {
    status = -MEO_ERR_CORRUPT;
  } else {
    status = meo_meta_check(buf);
    if (status == MEO_OK && meo_page_verify(buf) != MEO_OK) {
      status = -MEO_ERR_CORRUPT;
    }
  }
  var seq: uint64 = 0;
  if (status == MEO_OK) {
    var m: MeoMeta = meo_meta_read(buf);
    if (!m.valid) {
      status = -MEO_ERR_CORRUPT;
    } else {
      seq = m.commit_seq;
    }
  }
  free(buf);
  var hot: int32 = meo_jrn_present(path);
  if (hot < 0) { return hot; }
  if (status == -MEO_ERR_CORRUPT && hot == 1) { return -MEO_ERR_BUSY; }
  if (status != MEO_OK) { return status; }
  out[0] = seq;
  if (hot == 1) { return 1; }
  return MEO_OK;
}

// --- introspection ---------------------------------------------------------

export fn meo_pager_err(p: MeoPager*) -> int32 {
  if (p == 0) { return meo_pager_last_open_err; }
  return p->err;
}

export fn meo_pager_err_arg(p: MeoPager*) -> int64 {
  if (p == 0) { return meo_pager_last_open_err_arg; }
  return p->err_arg;
}

export fn meo_pager_page_count(p: MeoPager*) -> uint32 {
  if (p == 0) { return 0; }
  return p->page_count;
}

export fn meo_pager_frames(p: MeoPager*) -> int32 {
  if (p == 0) { return 0; }
  return p->n_frames;
}

export fn meo_pager_dirty_count(p: MeoPager*) -> int32 {
  if (p == 0) { return 0; }
  return p->n_dirty;
}

// How many pages have gone through meo_pager_write_page. A test uses it to
// prove an eviction write-back and a flush both take the chokepoint rather
// than a private path to the file write primitive (PHASE3.md 3A).
export fn meo_pager_write_count(p: MeoPager*) -> int64 {
  if (p == 0) { return 0; }
  return p->write_count;
}

export fn meo_pager_root(p: MeoPager*, which: int32) -> uint32 {
  if (p == 0) { return 0; }
  return meo_meta_root(p->meta, which);
}

export fn meo_pager_txn_id(p: MeoPager*) -> uint64 {
  if (p == 0) { return 0; }
  return p->meta.txn_id;
}

// No return channel in PHASE1.md 5.9, so a refused write is reported through
// meo_pager_err like every other failure.
export fn meo_pager_set_txn_id(p: MeoPager*, id: uint64) {
  if (p == 0) { return; }
  meo_pager_clear_err(p);
  if (!meo_pager_is_live(p)) {
    p->err = MEO_ERR_USAGE;
    return;
  }
  if (p->read_only) {
    p->err = MEO_ERR_READONLY;
    return;
  }
  p->meta.txn_id = id;
  meo_pager_meta_touch(p);
}
