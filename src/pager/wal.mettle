// pager/wal: the write-ahead log FILE FORMAT, its in-memory index, the append
// path, recovery, and the process-wide test hooks.
//
// The log is a separate file, `<db>-wal`: a 32-byte header, then frames of 24
// header bytes plus one 4096-byte page. Little-endian through format/bytes.mettle:
//
//   header:  0 u32 magic 0x574F454D   4 u16 version   6 u16 0   8 u32 page_size
//            12 u32 gen   16 u32 salt1   20 u32 salt2   24 u32 hdr_crc   28 u32 0
//   frame:   0 u32 page_no   4 u32 db_size (commit frames only)   8 u32 salt1
//            12 u32 salt2   16 u32 crc   20 u32 0   then the page
//
// The checksum is a cumulative chain, c_0 = hdr_crc and c_i = crc(c_{i-1},
// frame header [0,16), page), so a frame left behind by a rolled-back
// transaction can never validate after different frames replaced its
// predecessors. Every commit ends with page 0, which carries the commit_seq
// bump, so the commit frame and the commit marker are the same frame.
//
// This module must not import the pager. The pager owns the frame table and the
// transactions; the WAL owns the file, the frame index and the durable edge.
// Readers use only the lock-free find and the atomic edges; every other field is
// the writer's, or sits under the lock named next to it.

import "std/mem";
import "std/thread";
import "../error/status.mettle";
import "../format/bytes.mettle";
import "../format/page.mettle";
import "../format/crc32.mettle";
import "../platform/file.mettle";
import "../platform/file_linux.mettle" if linux;
import "../platform/clock_linux.mettle" if linux;
import "../platform/futex_linux.mettle" if linux;

// --- constants --------------------------------------------------------------

export const MEO_WAL_MAGIC: uint32 = 0x574F454D; // on disk the bytes read "MEOW"
export const MEO_WAL_VERSION: int32 = 1;
export const MEO_WAL_HDR: int32 = 32;
export const MEO_WAL_FRAME_HDR: int32 = 24;
export const MEO_WAL_FRAME: int32 = 4120; // frame header + page
export const MEO_WAL_SEG_FRAMES: int32 = 4096;
export const MEO_WAL_HASH_SLOTS: int32 = 8192;
export const MEO_WAL_MAX_SEGS: int32 = 4096;
export const MEO_WAL_MAX_FRAMES: int32 = 16777216; // SEG_FRAMES * MAX_SEGS
export const MEO_WAL_MAX_PENDING: int32 = 256;
export const MEO_WAL_MARKS: int32 = 16;
export const MEO_WAL_DEFAULT_CKPT: int32 = 1000;
export const MEO_WAL_TRUNC_BYTES: int64 = 67108864; // 64 MiB

export const MEO_CKPT_PASSIVE: int32 = 0;
export const MEO_CKPT_FULL: int32 = 1;

// note callback kinds
export const MEO_WAL_NOTE_DURABLE: int32 = 0;
export const MEO_WAL_NOTE_FAILED: int32 = 1;

// meo_wal_test_ctl ops
export const MEO_WAL_T_RESET: int32 = 0;
export const MEO_WAL_T_CRASH_AT: int32 = 1;
export const MEO_WAL_T_TORN: int32 = 2;
export const MEO_WAL_T_SYNC_DELAY_US: int32 = 3;
export const MEO_WAL_T_FAIL_SYNC_AT: int32 = 4;
export const MEO_WAL_T_IO_COUNT: int32 = 5;
export const MEO_WAL_T_SYNC_COUNT: int32 = 6;
export const MEO_WAL_T_LAST_COMMIT_IO: int32 = 7;

// MEO_MAX_PAGES lives in pager.mettle, which imports this module, so the cap is
// repeated here. The two must stay equal.
const WAL_MAX_PAGES: uint32 = 1048576;

const WAL_OFF_PAGE_NO: int64 = 0;
const WAL_OFF_DB_SIZE: int64 = 4;
const WAL_OFF_SALT1: int64 = 8;
const WAL_OFF_SALT2: int64 = 12;
const WAL_OFF_CRC: int64 = 16;
const WAL_OFF_ZERO: int64 = 20;

// Bytes of a frame header the checksum covers.
const WAL_CRC_HDR_BYTES: int64 = 16;
// Frames per read while scanning.
const WAL_SCAN_BATCH: int64 = 16;

const WAL_SYS_EXIT_GROUP: int64 = 231;
const WAL_CRASH_CODE: int64 = 77;

// --- types ------------------------------------------------------------------

export struct MeoWalMark {
  mark: uint32;
  count: int32;
}

export struct MeoWalSnap {
  mx: uint32;
  gen: uint32;
  slot: int32;
}

export struct MeoWalPend {
  frame: uint32;
  seq: uint64;
}

// One index segment: the page number of each of its 4096 frames, and an open
// addressing table from page number to local frame index (1..4096, 0 = empty).
struct MeoWalSeg {
  pgno: uint32[4096];
  hash: uint16[8192];
}

export struct MeoWal {
  file: MeoFile;       // is_open false until the file exists
  db_file: MeoFile;
  path: string;        // owned copy of "<db>-wal"
  read_only: bool;
  hdr_pending: bool;   // the header must be written before the next frame
  gen: int32;          // atomic; bumped by every new generation
  salt1: uint32;
  salt2: uint32;
  hdr_crc: uint32;
  segs: rawptr*;       // MEO_WAL_MAX_SEGS MeoWalSeg*, never moved or freed
  n_segs: int32;
  end: int32;          // last frame written, committed or not (writer only)
  ck: uint32;          // chain CRC at end (writer only)
  appended: int32;     // atomic: last commit frame written
  ck_appended: uint32; // chain CRC at appended
  durable: int32;      // atomic and the futex word: last commit frame fsynced
  nbackfill: int32;    // frames copied into the db file (hdr_lock)
  marks: MeoWalMark[16];  // read marks (hdr_lock)
  n_readers: int32;       // (hdr_lock)
  hdr_lock: int32;        // spin words
  ckpt_lock: int32;
  sync_lock: int32;
  failed: int32;       // atomic: a WAL fsync failed
  pend: MeoWalPend*;   // ring of MEO_WAL_MAX_PENDING (hdr_lock)
  pend_head: int32;
  pend_n: int32;
  ckpt_frames: int32;  // auto-checkpoint threshold, 0 = off
  pcache: rawptr;
  note_ctx: rawptr;
  note_cb: fn(rawptr, int32, uint64) -> void;  // under sync_lock
  n_syncs: int64;      // WAL fsyncs (sync_lock)
}

// A header read off disk. state 2 = valid, 1 = magic and version fit but the
// CRC does not (the numbers only seed the next generation), 0 = nothing usable.
struct MeoWalHdrInfo {
  state: int32;
  gen: int32;
  salt1: uint32;
  salt2: uint32;
  crc: uint32;
}

// --- test control -----------------------------------------------------------

// Process-wide, atomic words. See meo_wal_test_ctl.
var wal_t_io_count: int32 = 0;
var wal_t_crash_at: int32 = 0;
var wal_t_torn: int32 = 0;
var wal_t_sync_delay: int32 = 0;
var wal_t_fail_sync_at: int32 = 0;
var wal_t_sync_count: int32 = 0;
var wal_t_last_commit_io: int32 = 0;

export fn meo_wal_test_ctl(op: int32, arg: int64) -> int64 {
  if (op == MEO_WAL_T_RESET) {
    meo_atomic_store_i32(&wal_t_io_count, 0);
    meo_atomic_store_i32(&wal_t_crash_at, 0);
    meo_atomic_store_i32(&wal_t_torn, 0);
    meo_atomic_store_i32(&wal_t_sync_delay, 0);
    meo_atomic_store_i32(&wal_t_fail_sync_at, 0);
    meo_atomic_store_i32(&wal_t_sync_count, 0);
    meo_atomic_store_i32(&wal_t_last_commit_io, 0);
    return 0;
  }
  if (op == MEO_WAL_T_CRASH_AT) {
    meo_atomic_store_i32(&wal_t_crash_at, (int32)arg);
    return 0;
  }
  if (op == MEO_WAL_T_TORN) {
    meo_atomic_store_i32(&wal_t_torn, (int32)arg);
    return 0;
  }
  if (op == MEO_WAL_T_SYNC_DELAY_US) {
    meo_atomic_store_i32(&wal_t_sync_delay, (int32)arg);
    return 0;
  }
  if (op == MEO_WAL_T_FAIL_SYNC_AT) {
    meo_atomic_store_i32(&wal_t_fail_sync_at, (int32)arg);
    return 0;
  }
  if (op == MEO_WAL_T_IO_COUNT) {
    return (int64)meo_atomic_load_i32(&wal_t_io_count);
  }
  if (op == MEO_WAL_T_SYNC_COUNT) {
    return (int64)meo_atomic_load_i32(&wal_t_sync_count);
  }
  if (op == MEO_WAL_T_LAST_COMMIT_IO) {
    return (int64)meo_atomic_load_i32(&wal_t_last_commit_io);
  }
  return -1;
}

// Count one I/O point and die just before it when it is the chosen one. The
// index is 1-based.
fn wal_point() -> int32 {
  var n: int32 = atomic_inc_i32(&wal_t_io_count);
  if (n == meo_atomic_load_i32(&wal_t_crash_at)) {
    syscall(WAL_SYS_EXIT_GROUP, WAL_CRASH_CODE);
  }
  return n;
}

// Every WAL and db-file write goes through here so a crash test can stop at it.
// A torn crash lands half the bytes first.
fn wal_pwrite(f: MeoFile, off: int64, buf: uint8*, len: int64, commit: bool) -> int32 {
  var n: int32 = atomic_inc_i32(&wal_t_io_count);
  if (n == meo_atomic_load_i32(&wal_t_crash_at)) {
    if (meo_atomic_load_i32(&wal_t_torn) != 0) {
      meo_file_write_at(f, off, buf, len / 2);
    }
    syscall(WAL_SYS_EXIT_GROUP, WAL_CRASH_CODE);
  }
  if (commit) { meo_atomic_store_i32(&wal_t_last_commit_io, n); }
  return meo_file_write_at(f, off, buf, len);
}

// A WAL fsync is also counted on its own, so a test can fail the n-th one.
fn wal_fsync(f: MeoFile, is_wal: bool) -> int32 {
  wal_point();
  if (is_wal) {
    var s: int32 = atomic_inc_i32(&wal_t_sync_count);
    if (s == meo_atomic_load_i32(&wal_t_fail_sync_at)) { return -MEO_ERR_IO; }
  }
  return meo_file_sync(f);
}

// --- helpers ----------------------------------------------------------------

// "<db>-wal", owned by the caller (free(path.chars)).
fn wal_path(db_path: string) -> string {
  var out: string = db_path + "-wal";
  return out;
}

fn wal_hash(page_no: uint32) -> int32 {
  return (int32)((page_no * (uint32)383) & (uint32)8191);
}

// Frame f (1-based) starts here.
fn wal_frame_off(f: int64) -> int64 {
  return (int64)MEO_WAL_HDR + (f - 1) * (int64)MEO_WAL_FRAME;
}

// Encode the header from the current generation and remember its CRC, which
// seeds the checksum chain.
fn wal_hdr_fill(w: MeoWal*, b: uint8*) {
  meo_put_u32le(b, 0, MEO_WAL_MAGIC);
  meo_put_u16le(b, 4, (uint16)MEO_WAL_VERSION);
  meo_put_u16le(b, 6, (uint16)0);
  meo_put_u32le(b, 8, (uint32)MEO_PAGE_SIZE);
  meo_put_u32le(b, 12, (uint32)w->gen);
  meo_put_u32le(b, 16, w->salt1);
  meo_put_u32le(b, 20, w->salt2);
  var c: uint32 = meo_crc32(b, (int64)24);
  meo_put_u32le(b, 24, c);
  meo_put_u32le(b, 28, (uint32)0);
  w->hdr_crc = c;
}

// Start a new generation after (prev_gen, prev salts): gen+1, salt1+1 and a
// salt2 from the clock that differs from the previous one. The header goes to
// disk just before the next frame.
fn wal_new_gen(w: MeoWal*, prev_gen: int32, prev_s1: uint32, prev_s2: uint32) {
  var gen: int32 = prev_gen + 1;
  var mix: uint32 = (uint32)gen * (uint32)0x9E3779B1;
  var s2: uint32 = (uint32)(meo_clock_realtime_us() ^ (int64)mix);
  if (s2 == prev_s2) { s2 = s2 + (uint32)1; }
  w->gen = gen;
  w->salt1 = prev_s1 + (uint32)1;
  w->salt2 = s2;
  w->hdr_pending = true;
  var b: uint8[32];
  wal_hdr_fill(w, &b[0]);
}

// Read and judge the header of an open file of `size` bytes.
fn wal_read_hdr(f: MeoFile, size: int64, h: MeoWalHdrInfo*) -> int32 {
  h->state = 0;
  h->gen = 0;
  h->salt1 = 0;
  h->salt2 = 0;
  h->crc = 0;
  if (size < (int64)MEO_WAL_HDR) { return MEO_OK; }
  var b: uint8[32];
  var n: int32 = meo_file_read_at(f, 0, &b[0], (int64)MEO_WAL_HDR);
  if (n < 0) { return n; }
  if (n != MEO_WAL_HDR) { return MEO_OK; }
  if (meo_get_u32le(&b[0], 0) != MEO_WAL_MAGIC) { return MEO_OK; }
  if ((int32)meo_get_u16le(&b[0], 4) != MEO_WAL_VERSION) { return MEO_OK; }
  if ((int32)meo_get_u32le(&b[0], 8) != MEO_PAGE_SIZE) { return MEO_OK; }
  h->gen = (int32)meo_get_u32le(&b[0], 12);
  h->salt1 = meo_get_u32le(&b[0], 16);
  h->salt2 = meo_get_u32le(&b[0], 20);
  h->crc = meo_get_u32le(&b[0], 24);
  if (meo_crc32(&b[0], (int64)24) != h->crc) {
    h->state = 1;
    return MEO_OK;
  }
  h->state = 2;
  return MEO_OK;
}

// --- index ------------------------------------------------------------------

// Insert frame f for page P (the writer only). pgno first, then the hash slot,
// so a reader that finds the slot also finds the page number.
fn wal_index_insert(w: MeoWal*, f: int32, page_no: uint32) -> int32 {
  var s: int32 = (f - 1) / MEO_WAL_SEG_FRAMES;
  var li: int32 = (f - 1) % MEO_WAL_SEG_FRAMES + 1;
  var seg: MeoWalSeg* = (MeoWalSeg*)w->segs[s];
  if (seg == 0) {
    seg = new MeoWalSeg;
    if (seg == 0) { return -MEO_ERR_NOMEM; }
    w->segs[s] = (rawptr)seg;
    w->n_segs += 1;
  }
  seg->pgno[li - 1] = page_no;
  var h: int32 = wal_hash(page_no);
  while (seg->hash[h] != 0) {
    h = (h + 1) & (MEO_WAL_HASH_SLOTS - 1);
  }
  seg->hash[h] = (uint16)li;
  return MEO_OK;
}

// Drop every frame above mx from the index, newest first. Inserts go in frame
// order, so removing a suffix leaves the probe chains of the rest intact.
fn wal_index_truncate(w: MeoWal*, mx: int32) {
  var f: int32 = w->end;
  while (f > mx) {
    var s: int32 = (f - 1) / MEO_WAL_SEG_FRAMES;
    var li: int32 = (f - 1) % MEO_WAL_SEG_FRAMES + 1;
    var seg: MeoWalSeg* = (MeoWalSeg*)w->segs[s];
    if (seg != 0) {
      var h: int32 = wal_hash(seg->pgno[li - 1]);
      var n: int32 = 0;
      while (seg->hash[h] != (uint16)li && n < MEO_WAL_HASH_SLOTS) {
        h = (h + 1) & (MEO_WAL_HASH_SLOTS - 1);
        n += 1;
      }
      if (n < MEO_WAL_HASH_SLOTS) { seg->hash[h] = (uint16)0; }
      seg->pgno[li - 1] = (uint32)0;
    }
    f -= 1;
  }
}

// The newest frame of page_no at or below mx, or 0. Lock-free: segments never
// move, and a reader only asks for frames at or below the durable edge.
export fn meo_wal_find(w: MeoWal*, page_no: uint32, mx: uint32) -> uint32 {
  if (mx == 0) { return 0; }
  var s: int32 = (int32)((mx - (uint32)1) / (uint32)MEO_WAL_SEG_FRAMES);
  while (s >= 0) {
    var seg: MeoWalSeg* = (MeoWalSeg*)w->segs[s];
    if (seg != 0) {
      var best: uint32 = 0;
      var h: int32 = wal_hash(page_no);
      var n: int32 = 0;
      while (n < MEO_WAL_HASH_SLOTS) {
        var li: int32 = (int32)seg->hash[h];
        if (li == 0) { break; }
        if (seg->pgno[li - 1] == page_no) {
          var fr: uint32 = (uint32)(s * MEO_WAL_SEG_FRAMES + li);
          if (fr <= mx && fr > best) { best = fr; }
        }
        h = (h + 1) & (MEO_WAL_HASH_SLOTS - 1);
        n += 1;
      }
      if (best > 0) { return best; }
    }
    s -= 1;
  }
  return 0;
}

// --- scan -------------------------------------------------------------------

// Walk the frames of an open file from frame 1 while they stay valid (1.3).
// With `w` every valid frame goes into its index and w->end follows the scan;
// with `page0_out` every valid commit frame's page is copied there. `last` is
// the last valid commit frame and `ck_last` the chain CRC at it.
fn wal_scan(f: MeoFile, size: int64, hdr_crc: uint32, salt1: uint32,
    salt2: uint32, w: MeoWal*, page0_out: uint8*, last: uint32*,
    ck_last: uint32*) -> int32 {
  *last = 0;
  *ck_last = hdr_crc;
  var avail: int64 = (size - (int64)MEO_WAL_HDR) / (int64)MEO_WAL_FRAME;
  if (avail > (int64)MEO_WAL_MAX_FRAMES) { avail = (int64)MEO_WAL_MAX_FRAMES; }
  if (avail <= 0) { return MEO_OK; }
  var buf: uint8* = malloc(WAL_SCAN_BATCH * (int64)MEO_WAL_FRAME);
  if (buf == 0) { return -MEO_ERR_NOMEM; }

  var c: uint32 = hdr_crc;
  var done: int64 = 0;   // frames judged valid so far
  var stop: bool = false;
  while (!stop && done < avail) {
    var want: int64 = avail - done;
    if (want > WAL_SCAN_BATCH) { want = WAL_SCAN_BATCH; }
    var rc: int32 = meo_file_read_at(f, wal_frame_off(done + 1), buf,
      want * (int64)MEO_WAL_FRAME);
    if (rc < 0) {
      free(buf);
      return rc;
    }
    var got: int64 = (int64)rc / (int64)MEO_WAL_FRAME;
    if (got < want) { stop = true; }
    var i: int64 = 0;
    while (i < got) {
      var fr: uint8* = buf + i * (int64)MEO_WAL_FRAME;
      var page: uint8* = fr + MEO_WAL_FRAME_HDR;
      var page_no: uint32 = meo_get_u32le(fr, WAL_OFF_PAGE_NO);
      var db_size: uint32 = meo_get_u32le(fr, WAL_OFF_DB_SIZE);
      var ok: bool = true;
      if (meo_get_u32le(fr, WAL_OFF_SALT1) != salt1) { ok = false; }
      if (meo_get_u32le(fr, WAL_OFF_SALT2) != salt2) { ok = false; }
      if (page_no >= WAL_MAX_PAGES) { ok = false; }
      if (db_size != 0) {
        if (page_no != 0 || db_size > WAL_MAX_PAGES) { ok = false; }
      }
      var next: uint32 = 0;
      if (ok) {
        next = meo_crc32_update(c, fr, WAL_CRC_HDR_BYTES);
        next = meo_crc32_update(next, page, (int64)MEO_PAGE_SIZE);
        if (next != meo_get_u32le(fr, WAL_OFF_CRC)) { ok = false; }
      }
      if (ok && meo_page_verify(page) != MEO_OK) { ok = false; }
      if (!ok) {
        stop = true;
        break;
      }
      c = next;
      done += 1;
      if (w != 0) {
        var irc: int32 = wal_index_insert(w, (int32)done, page_no);
        if (irc != MEO_OK) {
          free(buf);
          return irc;
        }
        w->end = (int32)done;
      }
      if (db_size != 0) {
        *last = (uint32)done;
        *ck_last = c;
        if (page0_out != 0) { meo_bytes_copy(page0_out, page, (int64)MEO_PAGE_SIZE); }
      }
      i += 1;
    }
  }
  free(buf);
  return MEO_OK;
}

// --- open and close ---------------------------------------------------------

fn wal_free(w: MeoWal*) {
  var s: int32 = 0;
  if (w->segs != 0) {
    while (s < MEO_WAL_MAX_SEGS) {
      if (w->segs[s] != 0) { free(w->segs[s]); }
      s += 1;
    }
    free((rawptr)w->segs);
  }
  if (w->pend != 0) { free((rawptr)w->pend); }
  if (w->path.chars != 0) { free(w->path.chars); }
  free(w);
}

// Open the WAL beside a database and recover its index (1.8, steps 1-2). A
// missing file is an empty WAL; it is created at the first append. The scan
// stops at the first invalid frame, and only frames up to the last commit
// count.
export fn meo_wal_open(db_path: string, db_file: MeoFile, read_only: bool,
    out: MeoWal**) -> int32 {
  if (out == 0) { return -MEO_ERR_USAGE; }
  *out = 0;
  var w: MeoWal* = new MeoWal;
  if (w == 0) { return -MEO_ERR_NOMEM; }
  var segs: rawptr[] = new rawptr[MEO_WAL_MAX_SEGS];
  var pend: MeoWalPend[] = new MeoWalPend[MEO_WAL_MAX_PENDING];
  w->segs = segs.data;
  w->pend = pend.data;
  w->path = wal_path(db_path);
  if (w->path.chars == 0 || w->segs == 0 || w->pend == 0) {
    wal_free(w);
    return -MEO_ERR_NOMEM;
  }
  w->db_file = db_file;
  w->read_only = read_only;
  w->ckpt_frames = MEO_WAL_DEFAULT_CKPT;

  var flags: int32 = MEO_OPEN_READ;
  if (!read_only) { flags = flags | MEO_OPEN_WRITE; }
  var f: MeoFile = meo_file_open(w->path, flags);
  var hi: MeoWalHdrInfo;
  var last: uint32 = 0;
  var ck_last: uint32 = 0;
  if (f.is_open) {
    w->file = f;
    var size: int64 = meo_file_size(f);
    var rc: int32 = MEO_OK;
    if (size < 0) { rc = (int32)size; }
    if (rc == MEO_OK) { rc = wal_read_hdr(f, size, &hi); }
    if (rc == MEO_OK && hi.state == 2) {
      w->gen = hi.gen;
      w->salt1 = hi.salt1;
      w->salt2 = hi.salt2;
      w->hdr_crc = hi.crc;
      rc = wal_scan(f, size, hi.crc, hi.salt1, hi.salt2, w, 0, &last, &ck_last);
    }
    if (rc != MEO_OK) {
      meo_file_close(f);
      wal_free(w);
      return rc;
    }
  }

  if (hi.state == 2 && last > 0) {
    // The scan indexed frames past the last commit; they do not exist.
    wal_index_truncate(w, (int32)last);
    w->end = (int32)last;
    w->ck = ck_last;
    w->appended = (int32)last;
    w->ck_appended = ck_last;
    w->durable = (int32)last;
    *out = w;
    return MEO_OK;
  }
  // No commit survives: the next append starts a new generation, so none of
  // the old frames can validate again.
  if (hi.state == 2) { wal_index_truncate(w, 0); }
  w->end = 0;
  wal_new_gen(w, hi.gen, hi.salt1, hi.salt2);
  w->ck = w->hdr_crc;
  w->ck_appended = w->hdr_crc;
  *out = w;
  return MEO_OK;
}

// Free everything; unlink the file first when asked and there is one. The
// unlink is an I/O point.
export fn meo_wal_close(w: MeoWal*, unlink_file: bool) -> int32 {
  if (w == 0) { return -MEO_ERR_USAGE; }
  var rc: int32 = MEO_OK;
  var had_file: bool = w->file.is_open;
  if (had_file) { meo_file_close(w->file); }
  if (unlink_file && had_file) {
    wal_point();
    rc = meo_file_unlink(w->path);
  }
  wal_free(w);
  return rc;
}

// --- append -----------------------------------------------------------------

// Create the file if needed and write the header of the new generation.
fn wal_write_header(w: MeoWal*) -> int32 {
  if (!w->file.is_open) {
    var f: MeoFile = meo_file_open(w->path,
      MEO_OPEN_READ | MEO_OPEN_WRITE | MEO_OPEN_CREATE);
    if (!f.is_open) { return (int32)f.handle; }
    w->file = f;
  }
  var b: uint8[32];
  wal_hdr_fill(w, &b[0]);
  var rc: int32 = wal_pwrite(w->file, 0, &b[0], (int64)MEO_WAL_HDR, false);
  if (rc != MEO_OK) { return rc; }
  w->hdr_pending = false;
  return MEO_OK;
}

// Write one frame at end + 1. The state moves only after the write and the
// index insert both succeed, so a failed frame is simply beyond `end`.
fn wal_put_frame(w: MeoWal*, page_no: uint32, db_size: uint32, page: uint8*,
    commit: bool) -> int32 {
  if (w->read_only) { return -MEO_ERR_READONLY; }
  if (w->end >= MEO_WAL_MAX_FRAMES) { return -MEO_ERR_NOSPC; }
  if (page_no >= WAL_MAX_PAGES) { return -MEO_ERR_RANGE; }
  if (w->hdr_pending) {
    var hrc: int32 = wal_write_header(w);
    if (hrc != MEO_OK) { return hrc; }
  }
  var f: int32 = w->end + 1;
  var b: uint8[4120];
  meo_put_u32le(&b[0], WAL_OFF_PAGE_NO, page_no);
  meo_put_u32le(&b[0], WAL_OFF_DB_SIZE, db_size);
  meo_put_u32le(&b[0], WAL_OFF_SALT1, w->salt1);
  meo_put_u32le(&b[0], WAL_OFF_SALT2, w->salt2);
  meo_put_u32le(&b[0], WAL_OFF_ZERO, (uint32)0);
  meo_bytes_copy(&b[MEO_WAL_FRAME_HDR], page, (int64)MEO_PAGE_SIZE);
  var c: uint32 = meo_crc32_update(w->ck, &b[0], WAL_CRC_HDR_BYTES);
  c = meo_crc32_update(c, &b[MEO_WAL_FRAME_HDR], (int64)MEO_PAGE_SIZE);
  meo_put_u32le(&b[0], WAL_OFF_CRC, c);
  var rc: int32 = wal_pwrite(w->file, wal_frame_off((int64)f), &b[0],
    (int64)MEO_WAL_FRAME, commit);
  if (rc != MEO_OK) { return rc; }
  rc = wal_index_insert(w, f, page_no);
  if (rc != MEO_OK) { return rc; }
  w->ck = c;
  w->end = f;
  return MEO_OK;
}

// Append a sealed page as a non-commit frame.
export fn meo_wal_append(w: MeoWal*, page_no: uint32, page: uint8*) -> int32 {
  if (w == 0 || page == 0) { return -MEO_ERR_USAGE; }
  return wal_put_frame(w, page_no, (uint32)0, page, false);
}

// Append page 0 as the commit frame. It is not visible to anyone, and not
// counted as appended, until meo_wal_commit_publish.
export fn meo_wal_commit_write(w: MeoWal*, page0: uint8*, db_size: uint32,
    frame_out: uint32*) -> int32 {
  if (w == 0 || page0 == 0 || frame_out == 0) { return -MEO_ERR_USAGE; }
  if (db_size == 0 || db_size > WAL_MAX_PAGES) { return -MEO_ERR_USAGE; }
  if (meo_atomic_load_i32(&w->failed) != 0) { return -MEO_ERR_IO; }
  var rc: int32 = wal_put_frame(w, 0, db_size, page0, true);
  if (rc != MEO_OK) { return rc; }
  *frame_out = (uint32)w->end;
  return MEO_OK;
}

// Make the commit frame `frame` the appended edge and queue its feed sequence
// for the note callback. The ticket names the frame within this generation.
export fn meo_wal_commit_publish(w: MeoWal*, frame: uint32, seq: uint64,
    ticket: uint64*) {
  spin_lock(&w->hdr_lock);
  // The queue cannot be full here: a full queue is waited out before the
  // commit frame is written.
  if (w->pend_n < MEO_WAL_MAX_PENDING) {
    var at: int32 = (w->pend_head + w->pend_n) % MEO_WAL_MAX_PENDING;
    w->pend[at].frame = frame;
    w->pend[at].seq = seq;
    w->pend_n += 1;
  }
  meo_atomic_store_i32(&w->appended, (int32)frame);
  w->ck_appended = w->ck;
  spin_unlock(&w->hdr_lock);
  *ticket = (((uint64)(uint32)meo_atomic_load_i32(&w->gen)) << 32) | (uint64)frame;
}

// Forget everything written since the last commit frame.
export fn meo_wal_tx_rollback(w: MeoWal*) -> int32 {
  if (w == 0) { return -MEO_ERR_USAGE; }
  var app: int32 = meo_atomic_load_i32(&w->appended);
  wal_index_truncate(w, app);
  w->end = app;
  w->ck = w->ck_appended;
  return MEO_OK;
}

// --- read -------------------------------------------------------------------

// The 4096 page bytes of frame `frame`. Any thread.
export fn meo_wal_read_page(w: MeoWal*, frame: uint32, buf: uint8*) -> int32 {
  if (w == 0 || buf == 0 || frame == 0 || !w->file.is_open) {
    return -MEO_ERR_USAGE;
  }
  var off: int64 = wal_frame_off((int64)frame) + (int64)MEO_WAL_FRAME_HDR;
  var n: int32 = meo_file_read_at(w->file, off, buf, (int64)MEO_PAGE_SIZE);
  if (n < 0) { return n; }
  if (n != MEO_PAGE_SIZE) { return -MEO_ERR_CORRUPT; }
  return MEO_OK;
}

// The db_size field of a frame header, 0 for a non-commit frame or on error.
export fn meo_wal_frame_db_size(w: MeoWal*, frame: uint32) -> uint32 {
  if (w == 0 || frame == 0 || !w->file.is_open) { return 0; }
  var b: uint8[24];
  var n: int32 = meo_file_read_at(w->file, wal_frame_off((int64)frame), &b[0],
    (int64)MEO_WAL_FRAME_HDR);
  if (n != MEO_WAL_FRAME_HDR) { return 0; }
  return meo_get_u32le(&b[0], WAL_OFF_DB_SIZE);
}

// --- sync -------------------------------------------------------------------

// Pop every pending entry up to `target` and tell the owner. The callback runs
// outside hdr_lock, which is a leaf lock.
fn wal_deliver(w: MeoWal*, target: int32) {
  while (true) {
    var have: bool = false;
    var e: MeoWalPend;
    spin_lock(&w->hdr_lock);
    if (w->pend_n > 0 && (int32)w->pend[w->pend_head].frame <= target) {
      e = w->pend[w->pend_head];
      w->pend_head = (w->pend_head + 1) % MEO_WAL_MAX_PENDING;
      w->pend_n -= 1;
      have = true;
    }
    spin_unlock(&w->hdr_lock);
    if (!have) { return; }
    if (w->note_cb != 0) { w->note_cb(w->note_ctx, MEO_WAL_NOTE_DURABLE, e.seq); }
  }
}

// One fsync covering everything appended so far, with sync_lock held. On
// success the durable edge moves to what was appended before the fsync; on
// failure the WAL is failed for good.
fn wal_lead_sync(w: MeoWal*) -> int32 {
  var target: int32 = meo_atomic_load_i32(&w->appended);
  var delay: int32 = meo_atomic_load_i32(&wal_t_sync_delay);
  if (delay > 0) { meo_sleep_us((int64)delay); }
  var rc: int32 = wal_fsync(w->file, true);
  w->n_syncs += 1;
  if (rc != MEO_OK) {
    meo_atomic_store_i32(&w->failed, 1);
    spin_lock(&w->hdr_lock);
    w->pend_head = 0;
    w->pend_n = 0;
    spin_unlock(&w->hdr_lock);
    if (w->note_cb != 0) { w->note_cb(w->note_ctx, MEO_WAL_NOTE_FAILED, (uint64)0); }
    meo_futex_wake(&w->durable, 2147483647);
    return -MEO_ERR_IO;
  }
  meo_atomic_store_i32(&w->durable, target);
  wal_deliver(w, target);
  meo_futex_wake(&w->durable, 2147483647);
  return MEO_OK;
}

// Make everything appended durable. Single-threaded version.
export fn meo_wal_sync(w: MeoWal*) -> int32 {
  if (w == 0) { return -MEO_ERR_USAGE; }
  if (meo_atomic_load_i32(&w->failed) != 0) { return -MEO_ERR_IO; }
  var rc: int32 = MEO_OK;
  spin_lock(&w->sync_lock);
  if (w->end > meo_atomic_load_i32(&w->durable)) { rc = wal_lead_sync(w); }
  spin_unlock(&w->sync_lock);
  return rc;
}

// --- accessors --------------------------------------------------------------

export fn meo_wal_end(w: MeoWal*) -> uint32 {
  return (uint32)w->end;
}

export fn meo_wal_last_commit(w: MeoWal*) -> uint32 {
  return (uint32)meo_atomic_load_i32(&w->appended);
}

export fn meo_wal_durable(w: MeoWal*) -> uint32 {
  return (uint32)meo_atomic_load_i32(&w->durable);
}

export fn meo_wal_backfilled(w: MeoWal*) -> uint32 {
  spin_lock(&w->hdr_lock);
  var n: int32 = w->nbackfill;
  spin_unlock(&w->hdr_lock);
  return (uint32)n;
}

export fn meo_wal_gen(w: MeoWal*) -> uint32 {
  return (uint32)meo_atomic_load_i32(&w->gen);
}

// --- peek -------------------------------------------------------------------

// Read the newest commit frame's page of `<db>-wal` without keeping any state:
// no MeoWal, no index, nothing written. found is false when there is no WAL or
// it holds no commit.
export fn meo_wal_peek(db_path: string, page0_out: uint8*, found: bool*) -> int32 {
  if (page0_out == 0 || found == 0) { return -MEO_ERR_USAGE; }
  *found = false;
  var path: string = wal_path(db_path);
  if (path.chars == 0) { return -MEO_ERR_NOMEM; }
  var f: MeoFile = meo_file_open(path, MEO_OPEN_READ);
  free(path.chars);
  if (!f.is_open) { return MEO_OK; }
  var size: int64 = meo_file_size(f);
  if (size < 0) {
    meo_file_close(f);
    return (int32)size;
  }
  var hi: MeoWalHdrInfo;
  var rc: int32 = wal_read_hdr(f, size, &hi);
  if (rc == MEO_OK && hi.state == 2) {
    var last: uint32 = 0;
    var ck_last: uint32 = 0;
    rc = wal_scan(f, size, hi.crc, hi.salt1, hi.salt2, 0, page0_out, &last,
      &ck_last);
    if (rc == MEO_OK && last > 0) { *found = true; }
  }
  meo_file_close(f);
  return rc;
}
