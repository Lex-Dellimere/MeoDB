// format/page: the 16-byte page header, the dense cell-pointer array, the
// free gap, sealing and the structural checks.
//
// Format version 2: every cell carries its own length. Every function takes a
// raw pointer to MEO_PAGE_SIZE bytes and never allocates. No struct is overlaid
// on a page: fields are encoded and decoded at the offsets below,
// little-endian, through format/bytes.mettle.
//
// Header, fixed offsets, on every page:
//   0  type(1)  1 flags(1)  2 n_cells(u16)  4 cell_start(u16)
//   6  free_start(u16)  8 free_end(u16)  10 reserved(u16)  12 crc32(u32)
//
// Cell region: every cell body is preceded by its own
// two-byte little-endian length, so a cell's extent is known without the
// caller:
//   ... | free gap | [len0][body0] [len1][body1] | end of page
//                   ^ free_end                   ^ MEO_PAGE_SIZE
// A pointer names the BODY; the length lives at body - 2.
//
// The page is not resealed by the mutators. A mutator leaves the checksum
// stale on purpose; meo_page_seal is called by whoever is about to write the
// page, and by meo_page_init.

import "../error/status.mettle";
import "bytes.mettle";
import "crc32.mettle";

// --- constants --------------------------------------------------------------

export const MEO_PAGE_SIZE: int32 = 4096;
export const MEO_PAGE_HDR: int32 = 16;
export const MEO_FORMAT_VERSION: int32 = 2;
export const MEO_MAGIC: uint32 = 0x504F454D; // on disk the bytes read "MEOP"

export const MEO_PAGE_FREE: int32 = 0;
export const MEO_PAGE_META: int32 = 1; // page 0 only
export const MEO_PAGE_BTREE_LEAF: int32 = 2;
export const MEO_PAGE_BTREE_INNER: int32 = 3;
export const MEO_PAGE_OVERFLOW: int32 = 4;
export const MEO_PAGE_FREELIST: int32 = 5;
export const MEO_PAGE_COUNT_TYPES: int32 = 6; // meo_page_type must be < this

// MEO_META_BODY belongs to the meta page's contract but is defined here because
// meo_page_init needs it and format/meta.mettle imports this module for
// meo_page_seal: a cycle would be a build error. There is exactly one
// definition of the value.
export const MEO_META_BODY: int32 = 128; // first free byte of the meta page

// Header field offsets. Named once and used everywhere; never write a bare
// number for a header field.
const PAGE_OFF_TYPE: int32 = 0;
const PAGE_OFF_FLAGS: int32 = 1;
const PAGE_OFF_N_CELLS: int32 = 2;
const PAGE_OFF_CELL_START: int32 = 4;
const PAGE_OFF_FREE_START: int32 = 6;
const PAGE_OFF_FREE_END: int32 = 8;
const PAGE_OFF_RESERVED: int32 = 10;
const PAGE_OFF_CRC32: int32 = 12;

// A u16 pointer array cannot exceed this many cells and still fit the page.
const PAGE_MAX_CELLS: int32 = (MEO_PAGE_SIZE - MEO_PAGE_HDR) / 2;

// Largest body a u16 length prefix can name (n <= 65533).
const PAGE_CELL_MAX_BODY: int32 = 65533;

// A cell's length prefix sits immediately in front of its body.
const PAGE_CELL_PREFIX: int32 = 2;

// --- header accessors -------------------------------------------------------

export fn meo_page_type(p: uint8*) -> int32 {
  return (int32)p[PAGE_OFF_TYPE];
}

export fn meo_page_flags(p: uint8*) -> int32 {
  return (int32)p[PAGE_OFF_FLAGS];
}

export fn meo_page_set_flags(p: uint8*, v: int32) {
  p[PAGE_OFF_FLAGS] = (uint8)(v & 0xFF);
}

export fn meo_page_n_cells(p: uint8*) -> int32 {
  return (int32)meo_get_u16le(p, PAGE_OFF_N_CELLS);
}

export fn meo_page_free_start(p: uint8*) -> int32 {
  return (int32)meo_get_u16le(p, PAGE_OFF_FREE_START);
}

export fn meo_page_free_end(p: uint8*) -> int32 {
  return (int32)meo_get_u16le(p, PAGE_OFF_FREE_END);
}

export fn meo_page_free_bytes(p: uint8*) -> int32 {
  return meo_page_free_end(p) - meo_page_free_start(p);
}

export fn meo_page_used(p: uint8*) -> int32 {
  return MEO_PAGE_SIZE - meo_page_free_bytes(p);
}

// --- lifecycle --------------------------------------------------------------

// Zero all MEO_PAGE_SIZE bytes, write the header and seal. The meta page gets
// MEO_META_BODY as free_start; every other type gets MEO_PAGE_HDR + 2*n_cells,
// which is MEO_PAGE_HDR because a fresh page has no cells.
export fn meo_page_init(p: uint8*, page_type: int32) -> int32 {
  if (page_type < 0 || page_type >= MEO_PAGE_COUNT_TYPES) {
    return -MEO_ERR_USAGE;
  }
  meo_bytes_zero(p, (int64)MEO_PAGE_SIZE);
  p[PAGE_OFF_TYPE] = (uint8)page_type;
  p[PAGE_OFF_FLAGS] = 0;
  meo_put_u16le(p, PAGE_OFF_N_CELLS, (uint16)0);
  meo_put_u16le(p, PAGE_OFF_CELL_START, (uint16)MEO_PAGE_HDR);
  if (page_type == MEO_PAGE_META) {
    meo_put_u16le(p, PAGE_OFF_FREE_START, (uint16)MEO_META_BODY);
  } else {
    meo_put_u16le(p, PAGE_OFF_FREE_START, (uint16)MEO_PAGE_HDR);
  }
  meo_put_u16le(p, PAGE_OFF_FREE_END, (uint16)MEO_PAGE_SIZE);
  meo_put_u16le(p, PAGE_OFF_RESERVED, (uint16)0);
  meo_page_seal(p);
  return MEO_OK;
}

// Enforce the nine header relationships plus the three cell-extent rules. Now
// that every cell carries its length this can prove that no two cells overlap,
// which is the corruption class the phase-1 format could only be surprised by.
export fn meo_page_check(p: uint8*) -> int32 {
  var t: int32 = meo_page_type(p);
  // 1. known page type.
  if (t < 0 || t >= MEO_PAGE_COUNT_TYPES) { return -MEO_ERR_CORRUPT; }
  // 2. flags and reserved are 0 in phase 1.
  if (meo_page_flags(p) != 0) { return -MEO_ERR_CORRUPT; }
  if (meo_get_u16le(p, PAGE_OFF_RESERVED) != (uint16)0) {
    return -MEO_ERR_CORRUPT;
  }
  // 3. cell_start is always MEO_PAGE_HDR.
  if (meo_get_u16le(p, PAGE_OFF_CELL_START) != (uint16)MEO_PAGE_HDR) {
    return -MEO_ERR_CORRUPT;
  }

  var n: int32 = meo_page_n_cells(p);
  var fs: int32 = meo_page_free_start(p);
  var fe: int32 = meo_page_free_end(p);

  // 4/5. the pointer array is dense, and the meta page has no cells and a
  // fixed free_start.
  if (t == MEO_PAGE_META) {
    if (n != 0 || fs != MEO_META_BODY) { return -MEO_ERR_CORRUPT; }
  } else {
    if (n > PAGE_MAX_CELLS) { return -MEO_ERR_CORRUPT; }
    if (fs != MEO_PAGE_HDR + 2 * n) { return -MEO_ERR_CORRUPT; }
  }
  // 6. the gap is inside the page and not inverted.
  if (fs > fe || fe > MEO_PAGE_SIZE) { return -MEO_ERR_CORRUPT; }

  // 7/8. every pointer is at or above free_start (so it cannot overlap the
  // pointer array) and below the end of the page.
  // 9. every body starts inside [free_end, MEO_PAGE_SIZE) and the pointers are
  // strictly descending, which is the ordering the packing rule produces.
  // 10. the length prefix is above the gap: body >= free_end + 2.
  // 11. the extent [body - 2, body + len) fits inside the page and its length
  // is one a u16 can name.
  // 12. no extent crosses another one. Strictly descending pointers mean only
  // the next-higher cell can be crossed, so the extent must end at or below
  // that cell's prefix.
  var prev: int32 = MEO_PAGE_SIZE;
  var higher_lo: int32 = MEO_PAGE_SIZE;
  var i: int32 = 0;
  while (i < n) {
    var off: int32 = meo_page_cell_off(p, i);
    var len: int32 = meo_page_cell_len(p, i);
    if (off < fs) { return -MEO_ERR_CORRUPT; }
    if (off - PAGE_CELL_PREFIX < fe) { return -MEO_ERR_CORRUPT; }
    if (off > MEO_PAGE_SIZE - 1) { return -MEO_ERR_CORRUPT; }
    if (len > PAGE_CELL_MAX_BODY) { return -MEO_ERR_CORRUPT; }
    if (off + len > MEO_PAGE_SIZE) { return -MEO_ERR_CORRUPT; }
    if (off >= prev) { return -MEO_ERR_CORRUPT; }
    if (off + len > higher_lo) { return -MEO_ERR_CORRUPT; }
    prev = off;
    higher_lo = off - PAGE_CELL_PREFIX;
    i += 1;
  }
  return MEO_OK;
}

// The CRC-32 the page should carry: computed over [0,12) then [16,4096), so
// the four checksum bytes are excluded from their own input.
export fn meo_page_checksum(p: uint8*) -> uint32 {
  var crc: uint32 = meo_crc32_update((uint32)0, p, (int64)PAGE_OFF_CRC32);
  crc = meo_crc32_update(crc, p + PAGE_OFF_CRC32 + 4,
    (int64)(MEO_PAGE_SIZE - PAGE_OFF_CRC32 - 4));
  return crc;
}

// Write the checksum. Sealing twice is stable: the checksum bytes are not
// part of the input.
export fn meo_page_seal(p: uint8*) {
  meo_put_u32le(p, PAGE_OFF_CRC32, meo_page_checksum(p));
}

// Compare the stored checksum with the computed one. This is the integrity
// check, not the structural one; meo_page_check is the structural one.
export fn meo_page_verify(p: uint8*) -> int32 {
  if (meo_get_u32le(p, PAGE_OFF_CRC32) != meo_page_checksum(p)) {
    return -MEO_ERR_CORRUPT;
  }
  return MEO_OK;
}

// --- cells ------------------------------------------------------------------

// Offset of cell i, or -1 when i is not a cell index. (This is a sentinel, not
// a MEO_ERR_* failure.)
export fn meo_page_cell_off(p: uint8*, i: int32) -> int32 {
  if (i < 0 || i >= meo_page_n_cells(p)) { return -1; }
  return (int32)meo_get_u16le(p, (int64)MEO_PAGE_HDR + 2 * (int64)i);
}

// Pointer to cell i's body, or 0 when i is not a cell index.
export fn meo_page_cell_ptr(p: uint8*, i: int32) -> uint8* {
  var off: int32 = meo_page_cell_off(p, i);
  if (off < 0) { return 0; }
  return p + (int64)off;
}

// Length of cell i's body, read from the u16 in front of it.
// -1 when i is not a cell index, the same sentinel meo_page_cell_off uses.
export fn meo_page_cell_len(p: uint8*, i: int32) -> int32 {
  var off: int32 = meo_page_cell_off(p, i);
  if (off < 0) { return -1; }
  return (int32)meo_get_u16le(p, (int64)(off - PAGE_CELL_PREFIX));
}

// Carve a cell of `n` body bytes from the gap: free_end moves down by n + 2,
// the length goes in at the new free_end, and the BODY offset (free_end + 2)
// is returned. The page is unchanged on -MEO_ERR_FULL. This only moves the
// frontier and writes the length; the caller records the returned offset with
// meo_page_insert_cell.
export fn meo_page_alloc(p: uint8*, n: int32) -> int32 {
  if (n < 0 || n > PAGE_CELL_MAX_BODY) { return -MEO_ERR_USAGE; }
  var fs: int32 = meo_page_free_start(p);
  var fe: int32 = meo_page_free_end(p);
  if (n + PAGE_CELL_PREFIX > fe - fs) { return -MEO_ERR_FULL; }
  var new_fe: int32 = fe - (n + PAGE_CELL_PREFIX);
  meo_put_u16le(p, (int64)new_fe, (uint16)n);
  meo_put_u16le(p, PAGE_OFF_FREE_END, (uint16)new_fe);
  return new_fe + PAGE_CELL_PREFIX;
}

// Remove the pointer at index i (shift the rest of the dense array down) and
// leave the [len][body] extent where it is: free_end is not moved, so the
// freed bytes do not return to the gap. The extent is still known, which is
// what lets meo_page_defrag reclaim a hole anywhere in the page.
export fn meo_page_free_cell(p: uint8*, i: int32) -> int32 {
  var n: int32 = meo_page_n_cells(p);
  if (i < 0 || i >= n) { return -MEO_ERR_RANGE; }
  var k: int32 = i;
  while (k < n - 1) {
    meo_put_u16le(p, (int64)MEO_PAGE_HDR + 2 * (int64)k,
      meo_get_u16le(p, (int64)MEO_PAGE_HDR + 2 * (int64)(k + 1)));
    k += 1;
  }
  meo_put_u16le(p, PAGE_OFF_N_CELLS, (uint16)(n - 1));
  meo_put_u16le(p, PAGE_OFF_FREE_START,
    (uint16)(MEO_PAGE_HDR + 2 * (n - 1)));
  return MEO_OK;
}

// Insert the pointer `off` at index `at` (0..n_cells; n_cells appends). The
// array stays dense, so free_start grows by two.
//
// Order is the caller's responsibility: meo_page_check requires strictly
// descending offsets (the packing rule), so the normal build sequence is
// allocate a body (always the new lowest offset) and append its pointer with
// at == n_cells.
export fn meo_page_insert_cell(p: uint8*, off: int32, at: int32) -> int32 {
  var n: int32 = meo_page_n_cells(p);
  if (at < 0 || at > n) { return -MEO_ERR_RANGE; }
  var fs: int32 = meo_page_free_start(p);
  var fe: int32 = meo_page_free_end(p);
  if (off < 0 || off > MEO_PAGE_SIZE - 1) { return -MEO_ERR_RANGE; }
  if (off - PAGE_CELL_PREFIX < fe) { return -MEO_ERR_RANGE; }
  if (fs + 2 > fe) { return -MEO_ERR_FULL; }

  var k: int32 = n;
  while (k > at) {
    meo_put_u16le(p, (int64)MEO_PAGE_HDR + 2 * (int64)k,
      meo_get_u16le(p, (int64)MEO_PAGE_HDR + 2 * (int64)(k - 1)));
    k -= 1;
  }
  meo_put_u16le(p, (int64)MEO_PAGE_HDR + 2 * (int64)at, (uint16)off);
  meo_put_u16le(p, PAGE_OFF_N_CELLS, (uint16)(n + 1));
  meo_put_u16le(p, PAGE_OFF_FREE_START, (uint16)(MEO_PAGE_HDR + 2 * (n + 1)));
  return MEO_OK;
}

// Copy `n` bytes of the page from `src` to `dst` with the direction chosen by
// the offsets. meo_bytes_copy takes non-overlapping ranges, and a repack moves
// an extent down into a region that can still hold a cell it has not copied
// yet, so the direction is part of the contract here.
fn page_cell_move(p: uint8*, dst: int32, src: int32, n: int32) {
  if (dst <= src) {
    var i: int32 = 0;
    while (i < n) {
      p[(int64)(dst + i)] = p[(int64)(src + i)];
      i += 1;
    }
    return;
  }
  var j: int32 = n;
  while (j > 0) {
    j -= 1;
    p[(int64)(dst + j)] = p[(int64)(src + j)];
  }
}

// Reclaim EVERY hole: walk the cells in pointer order and copy each
// [len][body] extent downward from MEO_PAGE_SIZE, rewriting the pointers. On a
// page that is already compact nothing moves and the second call is a no-op,
// so this is idempotent.
//
// The loop reads cell i's offset before it rewrites pointer i, and offsets
// descend in pointer order, so the repack keeps every pointer strictly
// descending (meo_page_check rule 9).
export fn meo_page_defrag(p: uint8*) -> int32 {
  var n: int32 = meo_page_n_cells(p);
  var fs: int32 = meo_page_free_start(p);
  if (fs > MEO_PAGE_SIZE) { return -MEO_ERR_CORRUPT; }

  // Validate before moving anything: a corrupt extent must not be copied, and
  // the repacked page must still fit. The pointer array is included in the
  // budget, so a page whose bodies cannot fit returns CORRUPT untouched.
  var need: int32 = fs;
  var i: int32 = 0;
  while (i < n) {
    var off: int32 = meo_page_cell_off(p, i);
    var len: int32 = meo_page_cell_len(p, i);
    if (off - PAGE_CELL_PREFIX < fs) { return -MEO_ERR_CORRUPT; }
    if (len > PAGE_CELL_MAX_BODY) { return -MEO_ERR_CORRUPT; }
    if (off + len > MEO_PAGE_SIZE) { return -MEO_ERR_CORRUPT; }
    need += len + PAGE_CELL_PREFIX;
    i += 1;
  }
  if (need > MEO_PAGE_SIZE) { return -MEO_ERR_CORRUPT; }

  var cursor: int32 = MEO_PAGE_SIZE;
  i = 0;
  while (i < n) {
    var off: int32 = meo_page_cell_off(p, i);
    var len: int32 = meo_page_cell_len(p, i);
    var ext: int32 = len + PAGE_CELL_PREFIX;
    var dst: int32 = cursor - ext;
    page_cell_move(p, dst, off - PAGE_CELL_PREFIX, ext);
    meo_put_u16le(p, (int64)MEO_PAGE_HDR + 2 * (int64)i,
      (uint16)(dst + PAGE_CELL_PREFIX));
    cursor = dst;
    i += 1;
  }
  meo_put_u16le(p, PAGE_OFF_FREE_END, (uint16)cursor);
  return MEO_OK;
}

// Free bytes plus the bytes the dead cells still occupy: the gap a defrag
// would produce. A caller short of space defrags when
// reclaimable >= needed + 2 and free_bytes < needed + 2.
export fn meo_page_reclaimable(p: uint8*) -> int32 {
  var n: int32 = meo_page_n_cells(p);
  var live: int32 = 0;
  var i: int32 = 0;
  while (i < n) {
    live += meo_page_cell_len(p, i) + PAGE_CELL_PREFIX;
    i += 1;
  }
  return meo_page_free_bytes(p)
    + (MEO_PAGE_SIZE - meo_page_free_end(p) - live);
}
