// format/meta: page 0's body — magic, version, page size, page count, roots,
// and the transaction/write-version/commit counters.
//
// PHASE1.md sections 4 and 5.8. The body starts at offset 16 and the free area
// of the meta page starts at MEO_META_BODY (128). As everywhere in format/, the
// page is explicit encode/decode at fixed offsets; no struct is overlaid.
//
// Nothing here allocates. Invariant: every byte of [META_OFF_RESERVED,
// MEO_META_BODY) is zero after meo_meta_write, so a field carved out of the
// reserved area later reads 0 from every file written before it existed.
//
// commit_seq (offset 56, u64) is such a field: the change feed's persisted
// commit counter. Files written before it existed carry zeros there and
// therefore read commit_seq = 0, which is a valid starting value, so adding it
// needed no format-version bump. The reserved area now starts at 64.

import "../error/status.mettle";
import "bytes.mettle";
import "page.mettle";

export const MEO_ROOT_FREELIST: int32 = 0;
export const MEO_ROOT_CATALOG: int32 = 1;
export const MEO_ROOT_BTREE: int32 = 2;
export const MEO_ROOT_COUNT: int32 = 3;

// Meta body offsets, in absolute page bytes.
const META_OFF_MAGIC: int64 = 16;
const META_OFF_VERSION: int64 = 20;
const META_OFF_PAGE_SIZE: int64 = 22;
const META_OFF_PAGE_COUNT: int64 = 24;
const META_OFF_FREELIST_ROOT: int64 = 28;
const META_OFF_CATALOG_ROOT: int64 = 32;
const META_OFF_BTREE_ROOT: int64 = 36;
const META_OFF_TXN_ID: int64 = 40;
const META_OFF_WRITE_VERSION: int64 = 48;
const META_OFF_COMMIT_SEQ: int64 = 56;
const META_OFF_RESERVED: int64 = 64;
const META_RESERVED_BYTES: int64 = (int64)MEO_META_BODY - META_OFF_RESERVED;

export struct MeoMeta {
  valid: bool;
  magic: uint32;
  version: int32;
  page_size: int32;
  page_count: uint32;
  freelist_root: uint32;
  catalog_root: uint32;
  btree_root: uint32;
  txn_id: uint64;
  write_version: uint64;
  commit_seq: uint64;  // successful commits (and counted autocommit flushes)
}

// Decode the meta body. A bad magic, version or page size returns a zeroed
// MeoMeta with valid = false; it is not an error, because the pager decides
// what a bad header means (meo_meta_check is the function that fails).
export fn meo_meta_read(p: uint8*) -> MeoMeta {
  var bad: MeoMeta;
  var magic: uint32 = meo_get_u32le(p, META_OFF_MAGIC);
  var version: int32 = (int32)meo_get_u16le(p, META_OFF_VERSION);
  var page_size: int32 = (int32)meo_get_u16le(p, META_OFF_PAGE_SIZE);
  if (magic != MEO_MAGIC) { return bad; }
  if (version != MEO_FORMAT_VERSION) { return bad; }
  if (page_size != MEO_PAGE_SIZE) { return bad; }

  var m: MeoMeta;
  m.valid = true;
  m.magic = magic;
  m.version = version;
  m.page_size = page_size;
  m.page_count = meo_get_u32le(p, META_OFF_PAGE_COUNT);
  m.freelist_root = meo_get_u32le(p, META_OFF_FREELIST_ROOT);
  m.catalog_root = meo_get_u32le(p, META_OFF_CATALOG_ROOT);
  m.btree_root = meo_get_u32le(p, META_OFF_BTREE_ROOT);
  m.txn_id = meo_get_u64le(p, META_OFF_TXN_ID);
  m.write_version = meo_get_u64le(p, META_OFF_WRITE_VERSION);
  m.commit_seq = meo_get_u64le(p, META_OFF_COMMIT_SEQ);
  return m;
}

// Validate page 0 as a database header. Magic is tested first, so a foreign
// file is NOT_A_DB even when its bytes would also fail the structural check;
// then a known-magic file with a version or page size we do not speak is
// VERSION; then the page structure itself is CORRUPT (PHASE1.md section 7).
export fn meo_meta_check(p: uint8*) -> int32 {
  if (meo_get_u32le(p, META_OFF_MAGIC) != MEO_MAGIC) {
    return -MEO_ERR_NOT_A_DB;
  }
  if ((int32)meo_get_u16le(p, META_OFF_VERSION) != MEO_FORMAT_VERSION) {
    return -MEO_ERR_VERSION;
  }
  if ((int32)meo_get_u16le(p, META_OFF_PAGE_SIZE) != MEO_PAGE_SIZE) {
    return -MEO_ERR_VERSION;
  }
  if (meo_page_type(p) != MEO_PAGE_META) { return -MEO_ERR_CORRUPT; }
  if (meo_page_check(p) != MEO_OK) { return -MEO_ERR_CORRUPT; }
  return MEO_OK;
}

// Write the body and reseal. The page must already carry the meta header
// (meo_page_init with MEO_PAGE_META); this function owns the body, not the
// header.
export fn meo_meta_write(p: uint8*, m: MeoMeta) -> int32 {
  meo_put_u32le(p, META_OFF_MAGIC, m.magic);
  meo_put_u16le(p, META_OFF_VERSION, (uint16)m.version);
  meo_put_u16le(p, META_OFF_PAGE_SIZE, (uint16)m.page_size);
  meo_put_u32le(p, META_OFF_PAGE_COUNT, m.page_count);
  meo_put_u32le(p, META_OFF_FREELIST_ROOT, m.freelist_root);
  meo_put_u32le(p, META_OFF_CATALOG_ROOT, m.catalog_root);
  meo_put_u32le(p, META_OFF_BTREE_ROOT, m.btree_root);
  meo_put_u64le(p, META_OFF_TXN_ID, m.txn_id);
  meo_put_u64le(p, META_OFF_WRITE_VERSION, m.write_version);
  meo_put_u64le(p, META_OFF_COMMIT_SEQ, m.commit_seq);
  // Only the bytes after commit_seq are reserved now; zeroing from 56 would
  // erase the counter on every write.
  meo_bytes_zero(p + META_OFF_RESERVED, META_RESERVED_BYTES);
  meo_page_seal(p);
  return MEO_OK;
}

// Set commit_seq in an encoded meta page and reseal, touching no other byte.
// The pager uses it when page 0's frame may carry bytes a caller wrote through
// the frame, which a full meo_meta_write from the pager's copy would clobber.
export fn meo_meta_put_commit_seq(p: uint8*, v: uint64) {
  meo_put_u64le(p, META_OFF_COMMIT_SEQ, v);
  meo_page_seal(p);
}

// Root page number for a MEO_ROOT_* slot; 0 means "none". An unknown slot also
// answers 0, the same as a valid-but-empty root.
export fn meo_meta_root(m: MeoMeta, which: int32) -> uint32 {
  switch (which) {
    case MEO_ROOT_FREELIST: { return m.freelist_root; }
    case MEO_ROOT_CATALOG: { return m.catalog_root; }
    case MEO_ROOT_BTREE: { return m.btree_root; }
  }
  return 0;
}

// Set a MEO_ROOT_* slot. An out-of-range slot is -MEO_ERR_RANGE.
export fn meo_meta_set_root(m: MeoMeta*, which: int32, page_no: uint32) -> int32 {
  switch (which) {
    case MEO_ROOT_FREELIST: { m->freelist_root = page_no; return MEO_OK; }
    case MEO_ROOT_CATALOG: { m->catalog_root = page_no; return MEO_OK; }
    case MEO_ROOT_BTREE: { m->btree_root = page_no; return MEO_OK; }
  }
  return -MEO_ERR_RANGE;
}
