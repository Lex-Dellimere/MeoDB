// catalog/catalog: the persisted table list, a table tree at
// meta.catalog_root. Rowid 0 = header ["meocat", 1]; rowid k = table id k:
// [name, root, n_cols, tflags, then per column: name, affinity, cflags,
// index_root, then per column: index name or NULL] (see catalog/schema).
// MeoTable pointers stay valid while open; reload updates them in place and
// marks vanished tables live = false.

import "std/mem";
import "../error/status.mettle";
import "../format/bytes.mettle";
import "../format/page.mettle";
import "../format/meta.mettle";
import "../pager/pager.mettle";
import "../btree/node.mettle";
import "../btree/btree.mettle";
import "../types/key.mettle";
import "../record/value.mettle";
import "../record/codec.mettle";
import "../table/overflow.mettle";
import "schema.mettle";

export const MEO_CAT_VERSION: int32 = 1;

export struct MeoCatalog {
  pager: MeoPager*;
  tables: MeoTable**;    // n_tables stable pointers, in id order of discovery
  n_tables: int32;
  cap_tables: int32;
  next_id: int64;        // id the next CREATE TABLE gets; never decreases
  broken: bool;          // a reload failed: memory may not match disk
}

// The table-tree comparator: the first 8 bytes (the encoded rowid) decide.
// table/ uses the same order (meo_tbl_cmp).
export fn meo_cat_cmp(a: uint8*, an: int32, b: uint8*, bn: int32) -> int32 {
  var n: int32 = an;
  if (n > 8) { n = 8; }
  var m: int32 = bn;
  if (m > 8) { m = 8; }
  return meo_key_compare(a, n, b, m);
}

// ASCII case-insensitive identifier equality.
export fn meo_cat_name_eq(a: uint8*, an: int32, b: uint8*, bn: int32) -> bool {
  if (an != bn) { return false; }
  var i: int32 = 0;
  while (i < an) {
    var x: uint8 = a[i];
    var y: uint8 = b[i];
    if (x >= (uint8)65 && x <= (uint8)90) { x = x + (uint8)32; }
    if (y >= (uint8)65 && y <= (uint8)90) { y = y + (uint8)32; }
    if (x != y) { return false; }
    i += 1;
  }
  return true;
}

fn cat_dup(p: uint8*, n: int32) -> uint8* {
  var q: uint8* = malloc((int64)n + 1);
  if (q == 0) { return 0; }
  meo_bytes_copy(q, p, (int64)n);
  q[n] = 0;
  return q;
}

fn cat_free_table(t: MeoTable*) {
  if (t == 0) { return; }
  var i: int32 = 0;
  while (i < t->n_cols) {
    if (t->columns[i].name != 0) { free(t->columns[i].name); }
    if (t->columns[i].idx_name != 0) { free(t->columns[i].idx_name); }
    i += 1;
  }
  if (t->columns != 0) { free(t->columns); }
  if (t->name != 0) { free(t->name); }
  free(t);
}

fn cat_push(cat: MeoCatalog*, t: MeoTable*) -> int32 {
  if (cat->n_tables == cat->cap_tables) {
    var nc: int32 = cat->cap_tables * 2;
    if (nc < 8) { nc = 8; }
    var nt: MeoTable** = (MeoTable**)malloc((int64)nc * (int64)sizeof(MeoTable*));
    if (nt == 0) { return -MEO_ERR_NOMEM; }
    var i: int32 = 0;
    while (i < cat->n_tables) {
      nt[i] = cat->tables[i];
      i += 1;
    }
    if (cat->tables != 0) { free(cat->tables); }
    cat->tables = nt;
    cat->cap_tables = nc;
  }
  cat->tables[cat->n_tables] = t;
  cat->n_tables += 1;
  return MEO_OK;
}

// --- decode ----------------------------------------------------------------

fn cat_get_int(rec: uint8*, len: int32, col: int32, out: int64*) -> int32 {
  var v: MeoValue;
  var rc: int32 = meo_rec_get(rec, len, col, &v);
  if (rc != MEO_OK) { return rc; }
  if (v.type != MEO_T_INT) { return -MEO_ERR_CORRUPT; }
  out[0] = v.i;
  return MEO_OK;
}

fn cat_check_header(rec: uint8*, len: int32) -> int32 {
  var v: MeoValue;
  var rc: int32 = meo_rec_get(rec, len, 0, &v);
  if (rc != MEO_OK) { return rc; }
  if (v.type != MEO_T_TEXT || v.n != 6) { return -MEO_ERR_CORRUPT; }
  var magic: string = "meocat";
  if (!meo_bytes_equal(v.p, magic.chars, 6)) { return -MEO_ERR_CORRUPT; }
  var ver: int64 = 0;
  rc = cat_get_int(rec, len, 1, &ver);
  if (rc != MEO_OK) { return rc; }
  if (ver != (int64)MEO_CAT_VERSION) { return -MEO_ERR_VERSION; }
  return MEO_OK;
}

// Decode one table row into a fresh MeoTable (live, owned buffers).
fn cat_decode_table(id: int64, rec: uint8*, len: int32, out: MeoTable**) -> int32 {
  var v: MeoValue;
  var rc: int32 = meo_rec_get(rec, len, 0, &v);
  if (rc != MEO_OK) { return rc; }
  if (v.type != MEO_T_TEXT || v.n <= 0) { return -MEO_ERR_CORRUPT; }
  var root: int64 = 0;
  var ncols: int64 = 0;
  var tflags: int64 = 0;
  rc = cat_get_int(rec, len, 1, &root);
  if (rc == MEO_OK) { rc = cat_get_int(rec, len, 2, &ncols); }
  if (rc == MEO_OK) { rc = cat_get_int(rec, len, 3, &tflags); }
  if (rc != MEO_OK) { return rc; }
  if (ncols < 1 || ncols > (int64)MEO_MAX_COLS || root < 0) { return -MEO_ERR_CORRUPT; }
  var t: MeoTable* = new MeoTable;
  if (t == 0) { return -MEO_ERR_NOMEM; }
  t->id = id;
  t->name = 0;
  t->n_cols = 0;
  t->columns = 0;
  t->root = (uint32)root;
  t->tflags = (int32)tflags;
  t->live = true;
  t->name = cat_dup(v.p, v.n);
  t->name_len = v.n;
  t->columns = (MeoColumn*)malloc(ncols * (int64)sizeof(MeoColumn));
  if (t->name == 0 || t->columns == 0) {
    cat_free_table(t);
    return -MEO_ERR_NOMEM;
  }
  var i: int32 = 0;
  while (i < (int32)ncols) {
    t->columns[i].name = 0;
    t->columns[i].idx_name = 0;
    t->columns[i].idx_name_len = 0;
    i += 1;
  }
  t->n_cols = (int32)ncols;
  i = 0;
  while (i < (int32)ncols) {
    var base: int32 = 4 + i * 4;
    var cv: MeoValue;
    rc = meo_rec_get(rec, len, base, &cv);
    if (rc == MEO_OK && (cv.type != MEO_T_TEXT || cv.n <= 0)) { rc = -MEO_ERR_CORRUPT; }
    var aff: int64 = 0;
    var cfl: int64 = 0;
    var iroot: int64 = 0;
    if (rc == MEO_OK) { rc = cat_get_int(rec, len, base + 1, &aff); }
    if (rc == MEO_OK) { rc = cat_get_int(rec, len, base + 2, &cfl); }
    if (rc == MEO_OK) { rc = cat_get_int(rec, len, base + 3, &iroot); }
    if (rc == MEO_OK && !meo_schema_affinity_ok((int32)aff)) { rc = -MEO_ERR_CORRUPT; }
    // The index name trails every column group; an older row has none (NULL).
    var nv: MeoValue;
    if (rc == MEO_OK) { rc = meo_rec_get(rec, len, 4 + (int32)ncols * 4 + i, &nv); }
    if (rc == MEO_OK && nv.type != MEO_T_NULL && (nv.type != MEO_T_TEXT || nv.n <= 0)) {
      rc = -MEO_ERR_CORRUPT;
    }
    if (rc != MEO_OK) {
      cat_free_table(t);
      return rc;
    }
    t->columns[i].name = cat_dup(cv.p, cv.n);
    if (t->columns[i].name == 0) {
      cat_free_table(t);
      return -MEO_ERR_NOMEM;
    }
    t->columns[i].name_len = cv.n;
    t->columns[i].affinity = (int32)aff;
    t->columns[i].cflags = (int32)cfl;
    t->columns[i].index_root = (uint32)iroot;
    if (nv.type == MEO_T_TEXT) {
      t->columns[i].idx_name = cat_dup(nv.p, nv.n);
      if (t->columns[i].idx_name == 0) {
        cat_free_table(t);
        return -MEO_ERR_NOMEM;
      }
      t->columns[i].idx_name_len = nv.n;
    }
    i += 1;
  }
  out[0] = t;
  return MEO_OK;
}

// Same id and name, and one column list is a prefix of the other: the decoded
// row describes this object (a longer or shorter list is an ADD COLUMN that
// was committed or rolled back). The index flags may differ: CREATE / DROP
// INDEX changes them on the same object.
fn cat_same(old: MeoTable*, t: MeoTable*) -> bool {
  if (old->id != t->id) { return false; }
  if (!meo_cat_name_eq(old->name, old->name_len, t->name, t->name_len)) { return false; }
  var n: int32 = old->n_cols;
  if (t->n_cols < n) { n = t->n_cols; }
  var k: int32 = 0;
  while (k < n) {
    var a: MeoColumn* = &old->columns[k];
    var b: MeoColumn* = &t->columns[k];
    if (!meo_cat_name_eq(a->name, a->name_len, b->name, b->name_len)) { return false; }
    var keep: int32 = ~(MEO_COL_UNIQUE | MEO_COL_INDEXED);
    if (a->affinity != b->affinity || (a->cflags & keep) != (b->cflags & keep)) { return false; }
    k += 1;
  }
  return true;
}

// Merge a decoded table into the catalog: update the matching object in place
// (its pointer stays valid), or append the new one. A dead object that shares
// only the id stays dead, so a statement prepared against it cannot reach the
// new table.
fn cat_merge(cat: MeoCatalog*, t: MeoTable*) -> int32 {
  var i: int32 = 0;
  while (i < cat->n_tables) {
    var old: MeoTable* = cat->tables[i];
    if (cat_same(old, t)) {
      old->root = t->root;
      old->tflags = t->tflags;
      old->live = true;
      if (old->n_cols != t->n_cols) {
        // Take the decoded column list; the old one goes with t.
        var oc: MeoColumn* = old->columns;
        var on: int32 = old->n_cols;
        old->columns = t->columns;
        old->n_cols = t->n_cols;
        t->columns = oc;
        t->n_cols = on;
      } else {
        var k: int32 = 0;
        while (k < old->n_cols) {
          var oc2: MeoColumn* = &old->columns[k];
          var tc: MeoColumn* = &t->columns[k];
          oc2->index_root = tc->index_root;
          oc2->cflags = tc->cflags;
          // Swap the index names: the stale one is freed with t.
          var nm: uint8* = oc2->idx_name;
          var nn: int32 = oc2->idx_name_len;
          oc2->idx_name = tc->idx_name;
          oc2->idx_name_len = tc->idx_name_len;
          tc->idx_name = nm;
          tc->idx_name_len = nn;
          k += 1;
        }
      }
      cat_free_table(t);
      return MEO_OK;
    }
    i += 1;
  }
  var rc: int32 = cat_push(cat, t);
  if (rc != MEO_OK) { cat_free_table(t); }
  return rc;
}

// Re-read the catalog tree into `cat` in place (see the header). MEO_OK,
// -MEO_ERR_VERSION for a foreign header version, -MEO_ERR_CORRUPT for an
// undecodable row, or a pager/b-tree error. A failure marks the catalog
// broken: every later save or create answers -MEO_ERR_CORRUPT.
export fn meo_cat_reload(cat: MeoCatalog*) -> int32 {
  if (cat == 0) { return -MEO_ERR_USAGE; }
  var rc: int32 = cat_reload(cat);
  if (rc != MEO_OK) { cat->broken = true; }
  return rc;
}

fn cat_reload(cat: MeoCatalog*) -> int32 {
  var p: MeoPager* = cat->pager;
  var i: int32 = 0;
  while (i < cat->n_tables) {
    cat->tables[i]->live = false;
    i += 1;
  }
  var root: uint32 = meo_pager_root(p, MEO_ROOT_CATALOG);
  if (root == 0) { return MEO_OK; }
  var k0: uint8[8];
  meo_key_rowid(&k0[0], 8, 0);
  var key: MeoBtKey = { data: &k0[0], len: 8 };
  var c: MeoBtCursor;
  meo_bt_cursor_init(&c);
  var rc: int32 = meo_bt_seek(p, &c, root, meo_cat_cmp, key);
  var seen_header: bool = false;
  while (rc == 0) {
    var kp: uint8* = meo_btn_leaf_key_ptr(c.leaf->data, c.slot_in_leaf);
    var kl: int32 = meo_btn_leaf_key_len(c.leaf->data, c.slot_in_leaf);
    var rid: uint64 = meo_btn_leaf_rowid(c.leaf->data, c.slot_in_leaf);
    if (kl < 9) {
      rc = -MEO_ERR_CORRUPT;
      break;
    }
    if (rid == 0) {
      rc = cat_check_header(kp + 8, kl - 8);
      if (rc != MEO_OK) { break; }
      seen_header = true;
    } else {
      if (!seen_header) {
        rc = -MEO_ERR_CORRUPT;
        break;
      }
      var t: MeoTable* = 0;
      rc = cat_decode_table((int64)rid, kp + 8, kl - 8, &t);
      if (rc != MEO_OK) { break; }
      rc = cat_merge(cat, t);
      if (rc != MEO_OK) { break; }
      if ((int64)rid >= cat->next_id) { cat->next_id = (int64)rid + 1; }
    }
    rc = meo_bt_next(p, &c);
  }
  meo_bt_close(p, &c);
  if (rc < 0) { return rc; }
  if (!seen_header) { return -MEO_ERR_CORRUPT; }
  return MEO_OK;
}

// Load the catalog of an open pager into a new MeoCatalog.
export fn meo_cat_open(p: MeoPager*, out: MeoCatalog**) -> int32 {
  if (p == 0 || out == 0) { return -MEO_ERR_USAGE; }
  out[0] = 0;
  var cat: MeoCatalog* = new MeoCatalog;
  if (cat == 0) { return -MEO_ERR_NOMEM; }
  cat->pager = p;
  cat->tables = 0;
  cat->n_tables = 0;
  cat->cap_tables = 0;
  cat->next_id = 1;
  cat->broken = false;
  var rc: int32 = meo_cat_reload(cat);
  if (rc != MEO_OK) {
    meo_cat_close(cat);
    return rc;
  }
  out[0] = cat;
  return MEO_OK;
}

// Free the catalog and every MeoTable it ever held. The pager is not touched.
export fn meo_cat_close(cat: MeoCatalog*) {
  if (cat == 0) { return; }
  var i: int32 = 0;
  while (i < cat->n_tables) {
    cat_free_table(cat->tables[i]);
    i += 1;
  }
  if (cat->tables != 0) { free(cat->tables); }
  free(cat);
}

// The live table with this name (ASCII case-insensitive), or 0.
export fn meo_cat_find(cat: MeoCatalog*, name: uint8*, n: int32) -> MeoTable* {
  if (cat == 0 || name == 0) { return 0; }
  var i: int32 = 0;
  while (i < cat->n_tables) {
    var t: MeoTable* = cat->tables[i];
    if (t->live && meo_cat_name_eq(t->name, t->name_len, name, n)) { return t; }
    i += 1;
  }
  return 0;
}

// The live table with this id, or 0.
export fn meo_cat_get(cat: MeoCatalog*, id: int64) -> MeoTable* {
  if (cat == 0) { return 0; }
  var i: int32 = 0;
  while (i < cat->n_tables) {
    var t: MeoTable* = cat->tables[i];
    if (t->live && t->id == id) { return t; }
    i += 1;
  }
  return 0;
}

// --- encode / save ---------------------------------------------------------

// Insert one row (rowid, values) into the catalog tree.
fn cat_put_row(p: MeoPager*, root: uint32*, rowid: int64, vals: MeoValue*, n: int32) -> int32 {
  var sz: int32 = meo_rec_size(vals, n);
  if (sz < 0) { return sz; }
  var buf: uint8* = malloc((int64)sz + 8);
  if (buf == 0) { return -MEO_ERR_NOMEM; }
  defer free(buf);
  meo_key_rowid(buf, 8, rowid);
  var w: int32 = meo_rec_encode(buf + 8, sz, vals, n);
  if (w < 0) { return w; }
  var key: MeoBtKey = { data: buf, len: w + 8 };
  return meo_bt_insert_sep(p, root, meo_cat_cmp, key, (uint64)rowid, 8);
}

// Fill vals (4 + 5 * n_cols entries) with t's catalog row. Borrows t's names.
fn cat_row_vals(t: MeoTable*, vals: MeoValue*) {
  meo_value_set_text(&vals[0], t->name, t->name_len);
  meo_value_set_int(&vals[1], (int64)t->root);
  meo_value_set_int(&vals[2], (int64)t->n_cols);
  meo_value_set_int(&vals[3], (int64)t->tflags);
  var i: int32 = 0;
  while (i < t->n_cols) {
    var b: int32 = 4 + i * 4;
    meo_value_set_text(&vals[b], t->columns[i].name, t->columns[i].name_len);
    meo_value_set_int(&vals[b + 1], (int64)t->columns[i].affinity);
    meo_value_set_int(&vals[b + 2], (int64)t->columns[i].cflags);
    meo_value_set_int(&vals[b + 3], (int64)t->columns[i].index_root);
    var nv: MeoValue* = &vals[4 + t->n_cols * 4 + i];
    if (t->columns[i].idx_name != 0) {
      meo_value_set_text(nv, t->columns[i].idx_name, t->columns[i].idx_name_len);
    } else {
      meo_value_set_null(nv);
    }
    i += 1;
  }
}

// Encoded size of t's catalog row. Roots are sized at their widest so a row
// that fits now still fits after any root change.
fn cat_row_size(t: MeoTable*) -> int32 {
  var n: int32 = 4 + 5 * t->n_cols;
  var vals: MeoValue* = (MeoValue*)malloc((int64)n * (int64)sizeof(MeoValue));
  if (vals == 0) { return -MEO_ERR_NOMEM; }
  defer free(vals);
  cat_row_vals(t, vals);
  meo_value_set_int(&vals[1], (int64)4294967295);
  var i: int32 = 0;
  while (i < t->n_cols) {
    meo_value_set_int(&vals[4 + i * 4 + 3], (int64)4294967295);
    i += 1;
  }
  return meo_rec_size(vals, n);
}

fn cat_put_table(p: MeoPager*, root: uint32*, t: MeoTable*) -> int32 {
  var n: int32 = 4 + 5 * t->n_cols;
  var vals: MeoValue* = (MeoValue*)malloc((int64)n * (int64)sizeof(MeoValue));
  if (vals == 0) { return -MEO_ERR_NOMEM; }
  defer free(vals);
  cat_row_vals(t, vals);
  return cat_put_row(p, root, t->id, vals, n);
}

// Persist t's current row (name, table root, every column's index root) in
// the caller's pager transaction: delete the old row, insert the new one.
// Creates the catalog tree with its header row on first use. -MEO_ERR_SCHEMA for
// a dead table, -MEO_ERR_CORRUPT once a reload has failed.
export fn meo_cat_save_table(cat: MeoCatalog*, t: MeoTable*) -> int32 {
  if (cat == 0 || t == 0) { return -MEO_ERR_USAGE; }
  if (cat->broken) { return -MEO_ERR_CORRUPT; }
  if (!t->live) { return -MEO_ERR_SCHEMA; }
  var p: MeoPager* = cat->pager;
  var start: uint32 = meo_pager_root(p, MEO_ROOT_CATALOG);
  var root: uint32 = start;
  var rc: int32 = MEO_OK;
  if (root == 0) {
    var hv: MeoValue[2];
    var magic: string = "meocat";
    meo_value_set_text(&hv[0], magic.chars, 6);
    meo_value_set_int(&hv[1], (int64)MEO_CAT_VERSION);
    rc = cat_put_row(p, &root, 0, &hv[0], 2);
  } else {
    var k: uint8[8];
    meo_key_rowid(&k[0], 8, t->id);
    var key: MeoBtKey = { data: &k[0], len: 8 };
    rc = meo_bt_delete(p, &root, meo_cat_cmp, key);
    if (rc == 1) { rc = MEO_OK; }   // first save of a new table
  }
  if (rc == MEO_OK) { rc = cat_put_table(p, &root, t); }
  if (rc != MEO_OK) { return rc; }
  if (root != start) { return meo_pager_set_root(p, MEO_ROOT_CATALOG, root); }
  return MEO_OK;
}

// Create a table: validate, copy name and columns, give it the next id and
// root 0 (its tree is created by the first insert), and save it. MEO_OK and
// *out set; -MEO_ERR_SCHEMA when a live table has the name or two columns share
// one; -MEO_ERR_USAGE for 0 or more than MEO_MAX_COLS columns or a bad
// affinity; -MEO_ERR_TOOBIG when the catalog row would exceed MEO_REC_MAX;
// -MEO_ERR_CORRUPT once a reload has failed. Nothing is written on any of
// these. The caller holds the db lock and a pager transaction.
export fn meo_cat_create_table(cat: MeoCatalog*, name: uint8*, name_len: int32,
    cols: MeoColumn*, n_cols: int32, out: MeoTable**) -> int32 {
  if (cat == 0 || name == 0 || name_len <= 0 || cols == 0 || out == 0) {
    return -MEO_ERR_USAGE;
  }
  if (n_cols < 1 || n_cols > MEO_MAX_COLS) { return -MEO_ERR_USAGE; }
  if (cat->broken) { return -MEO_ERR_CORRUPT; }
  if (meo_cat_find(cat, name, name_len) != 0) { return -MEO_ERR_SCHEMA; }
  var i: int32 = 0;
  while (i < n_cols) {
    if (!meo_schema_affinity_ok(cols[i].affinity) || cols[i].name_len <= 0) {
      return -MEO_ERR_USAGE;
    }
    var j: int32 = 0;
    while (j < i) {
      if (meo_cat_name_eq(cols[i].name, cols[i].name_len, cols[j].name, cols[j].name_len)) {
        return -MEO_ERR_SCHEMA;
      }
      j += 1;
    }
    i += 1;
  }
  var t: MeoTable* = new MeoTable;
  if (t == 0) { return -MEO_ERR_NOMEM; }
  t->id = 0;
  t->root = 0;
  t->tflags = 0;
  t->live = true;
  t->n_cols = 0;
  t->name = cat_dup(name, name_len);
  t->name_len = name_len;
  t->columns = (MeoColumn*)malloc((int64)n_cols * (int64)sizeof(MeoColumn));
  if (t->name == 0 || t->columns == 0) {
    cat_free_table(t);
    return -MEO_ERR_NOMEM;
  }
  i = 0;
  while (i < n_cols) {
    t->columns[i].name = cat_dup(cols[i].name, cols[i].name_len);
    t->columns[i].name_len = cols[i].name_len;
    t->columns[i].affinity = cols[i].affinity;
    t->columns[i].cflags = cols[i].cflags;
    t->columns[i].index_root = 0;
    t->columns[i].idx_name = 0;
    t->columns[i].idx_name_len = 0;
    t->n_cols = i + 1;
    if (t->columns[i].name == 0) {
      cat_free_table(t);
      return -MEO_ERR_NOMEM;
    }
    i += 1;
  }
  var sz: int32 = cat_row_size(t);
  if (sz < 0 || sz > MEO_REC_MAX) {
    cat_free_table(t);
    if (sz < 0) { return sz; }
    return -MEO_ERR_TOOBIG;
  }
  var rc: int32 = cat_push(cat, t);
  if (rc != MEO_OK) {
    cat_free_table(t);
    return rc;
  }
  // Ids are never reused while open, even after a rollback or a failed save.
  t->id = cat->next_id;
  cat->next_id += 1;
  rc = meo_cat_save_table(cat, t);
  if (rc != MEO_OK) {
    // Not saved: hide it. The object stays (pointers are stable); the caller
    // rolls the transaction back.
    t->live = false;
    return rc;
  }
  out[0] = t;
  return MEO_OK;
}

// --- drop / add column -----------------------------------------------------

// The negative code for a failed pager call; a page the file does not have
// means a corrupt tree.
fn cat_pager_fail(p: MeoPager*) -> int32 {
  var e: int32 = meo_pager_err(p);
  if (e == MEO_OK || e == MEO_ERR_RANGE) { e = MEO_ERR_CORRUPT; }
  return 0 - e;
}

// Free the overflow chain behind every stub in a table leaf.
fn cat_free_chains(p: MeoPager*, d: uint8*) -> int32 {
  var n: int32 = meo_page_n_cells(d);
  var i: int32 = 0;
  while (i < n) {
    var kl: int32 = meo_btn_leaf_key_len(d, i);
    if (kl >= 9) {
      var len: int32 = 0;
      var first: uint32 = 0;
      var rc: int32 = meo_ovf_stub_get(meo_btn_leaf_key_ptr(d, i) + 8, kl - 8, &len, &first);
      if (rc < 0) { return rc; }
      if (rc == MEO_OK) {
        rc = meo_ovf_free(p, first, len);
        if (rc != MEO_OK) { return rc; }
      }
    }
    i += 1;
  }
  return MEO_OK;
}

// Free the tree under `page`; `rows` marks a table tree, whose leaves may hold
// overflow stubs to follow.
fn cat_free_level(p: MeoPager*, page: uint32, depth: int32, rows: bool) -> int32 {
  if (depth >= MEO_BT_MAX_DEPTH) { return -MEO_ERR_CORRUPT; }
  var f: MeoFrame* = meo_pager_get(p, page, false);
  if (f == 0) { return cat_pager_fail(p); }
  var rc: int32 = meo_btn_check(f->data);
  if (rc != MEO_OK) {
    meo_pager_release(p, f, false);
    return rc;
  }
  if (meo_btn_is_leaf(f->data)) {
    if (rows) {
      rc = cat_free_chains(p, f->data);
      if (rc != MEO_OK) {
        meo_pager_release(p, f, false);
        return rc;
      }
    }
    meo_pager_release(p, f, false);
    return meo_pager_free_page(p, page);
  }
  // Copy the children out: a page cannot be freed while pinned.
  var n: int32 = meo_page_n_cells(f->data);
  var kids: uint32* = (uint32*)malloc((int64)n * 4 + 4);
  if (kids == 0) {
    meo_pager_release(p, f, false);
    return -MEO_ERR_NOMEM;
  }
  defer free(kids);
  var i: int32 = 0;
  while (i < n) {
    kids[i] = meo_btn_inner_child(f->data, i);
    i += 1;
  }
  meo_pager_release(p, f, false);
  i = 0;
  while (i < n) {
    if (kids[i] == 0) { return -MEO_ERR_CORRUPT; }
    rc = cat_free_level(p, kids[i], depth + 1, rows);
    if (rc != MEO_OK) { return rc; }
    i += 1;
  }
  return meo_pager_free_page(p, page);
}

// Put every page of the tree at `root` on the freelist, in the caller's pager
// transaction. Root 0 (no tree yet) is MEO_OK.
export fn meo_cat_free_tree(p: MeoPager*, root: uint32) -> int32 {
  if (p == 0) { return -MEO_ERR_USAGE; }
  if (root == 0) { return MEO_OK; }
  return cat_free_level(p, root, 0, false);
}

// Drop t: free its table tree and every index tree, delete its catalog row,
// mark it dead. The caller holds the db lock and a pager transaction and rolls
// it back on failure (the reload brings t back). -MEO_ERR_SCHEMA for a dead
// table, -MEO_ERR_CORRUPT once a reload has failed.
export fn meo_cat_drop_table(cat: MeoCatalog*, t: MeoTable*) -> int32 {
  if (cat == 0 || t == 0) { return -MEO_ERR_USAGE; }
  if (cat->broken) { return -MEO_ERR_CORRUPT; }
  if (!t->live) { return -MEO_ERR_SCHEMA; }
  var p: MeoPager* = cat->pager;
  // Dead from the first freed page on, so nothing reads a half-freed tree.
  t->live = false;
  var rc: int32 = MEO_OK;
  if (t->root != 0) { rc = cat_free_level(p, t->root, 0, true); }
  var i: int32 = 0;
  while (i < t->n_cols && rc == MEO_OK) {
    rc = meo_cat_free_tree(p, t->columns[i].index_root);
    i += 1;
  }
  if (rc != MEO_OK) { return rc; }
  var start: uint32 = meo_pager_root(p, MEO_ROOT_CATALOG);
  var root: uint32 = start;
  var k: uint8[8];
  meo_key_rowid(&k[0], 8, t->id);
  var key: MeoBtKey = { data: &k[0], len: 8 };
  rc = meo_bt_delete(p, &root, meo_cat_cmp, key);
  if (rc == 1) { return -MEO_ERR_CORRUPT; }   // a live table always has its row
  if (rc != MEO_OK) { return rc; }
  if (root != start) { return meo_pager_set_root(p, MEO_ROOT_CATALOG, root); }
  return MEO_OK;
}

// Append one column to t and save its row. Existing rows are not rewritten:
// they read the new column as NULL. -MEO_ERR_UNSUPPORTED unless the column is
// nullable and not PK or UNIQUE; -MEO_ERR_SCHEMA for a dead table or a name
// t already has; -MEO_ERR_USAGE for a bad affinity or name or a full table;
// -MEO_ERR_TOOBIG when the catalog row would exceed MEO_REC_MAX. Nothing
// changes on any of these. The caller holds the db lock and a pager
// transaction.
export fn meo_cat_add_column(cat: MeoCatalog*, t: MeoTable*, col: MeoColumn*) -> int32 {
  if (cat == 0 || t == 0 || col == 0 || col->name == 0) { return -MEO_ERR_USAGE; }
  if (cat->broken) { return -MEO_ERR_CORRUPT; }
  if (!t->live) { return -MEO_ERR_SCHEMA; }
  if (col->cflags != 0) { return -MEO_ERR_UNSUPPORTED; }
  if (!meo_schema_affinity_ok(col->affinity) || col->name_len <= 0) { return -MEO_ERR_USAGE; }
  var i: int32 = 0;
  while (i < t->n_cols) {
    if (meo_cat_name_eq(t->columns[i].name, t->columns[i].name_len, col->name, col->name_len)) {
      return -MEO_ERR_SCHEMA;
    }
    i += 1;
  }
  if (t->n_cols >= MEO_MAX_COLS) { return -MEO_ERR_USAGE; }
  var n: int32 = t->n_cols + 1;
  var nc: MeoColumn* = (MeoColumn*)malloc((int64)n * (int64)sizeof(MeoColumn));
  var nm: uint8* = cat_dup(col->name, col->name_len);
  if (nc == 0 || nm == 0) {
    if (nc != 0) { free(nc); }
    if (nm != 0) { free(nm); }
    return -MEO_ERR_NOMEM;
  }
  i = 0;
  while (i < t->n_cols) {
    nc[i] = t->columns[i];
    i += 1;
  }
  nc[i].name = nm;
  nc[i].name_len = col->name_len;
  nc[i].affinity = col->affinity;
  nc[i].cflags = 0;
  nc[i].index_root = 0;
  nc[i].idx_name = 0;
  nc[i].idx_name_len = 0;
  var oc: MeoColumn* = t->columns;
  t->columns = nc;
  t->n_cols = n;
  var rc: int32 = cat_row_size(t);
  if (rc >= 0 && rc > MEO_REC_MAX) { rc = -MEO_ERR_TOOBIG; }
  if (rc >= 0) { rc = meo_cat_save_table(cat, t); }
  if (rc < 0) {
    // The names are shared with oc; only the new one and the array go.
    t->columns = oc;
    t->n_cols = n - 1;
    free(nm);
    free(nc);
    return rc;
  }
  free(oc);
  return MEO_OK;
}

// --- named indexes ---------------------------------------------------------

// The live table holding the index named `name` (ASCII case-insensitive), and
// its column in *col; 0 when no index has that name.
export fn meo_cat_find_index(cat: MeoCatalog*, name: uint8*, n: int32, col: int32*) -> MeoTable* {
  if (cat == 0 || name == 0 || col == 0) { return 0; }
  var i: int32 = 0;
  while (i < cat->n_tables) {
    var t: MeoTable* = cat->tables[i];
    var k: int32 = 0;
    while (t->live && k < t->n_cols) {
      var c: MeoColumn* = &t->columns[k];
      if (c->idx_name != 0 && meo_cat_name_eq(c->idx_name, c->idx_name_len, name, n)) {
        col[0] = k;
        return t;
      }
      k += 1;
    }
    i += 1;
  }
  return 0;
}

// Whether column `col` of t can take an index named `name`, without writing:
// MEO_OK; -MEO_ERR_SCHEMA for a dead table, a name already used, the rowid
// alias or a column that already has an index; -MEO_ERR_USAGE for a bad
// column or name; -MEO_ERR_TOOBIG when the catalog row would exceed
// MEO_REC_MAX; -MEO_ERR_CORRUPT once a reload has failed.
export fn meo_cat_index_check(cat: MeoCatalog*, t: MeoTable*, col: int32, name: uint8*,
    name_len: int32) -> int32 {
  if (cat == 0 || t == 0 || name == 0 || name_len <= 0) { return -MEO_ERR_USAGE; }
  if (cat->broken) { return -MEO_ERR_CORRUPT; }
  if (!t->live) { return -MEO_ERR_SCHEMA; }
  if (col < 0 || col >= t->n_cols) { return -MEO_ERR_USAGE; }
  var other: int32 = 0;
  if (meo_cat_find_index(cat, name, name_len, &other) != 0) { return -MEO_ERR_SCHEMA; }
  var c: MeoColumn* = &t->columns[col];
  var any: int32 = MEO_COL_ROWID_ALIAS | MEO_COL_PK | MEO_COL_UNIQUE | MEO_COL_INDEXED;
  if ((c->cflags & any) != 0) { return -MEO_ERR_SCHEMA; }
  // Size the row with the name in place, borrowed for the call.
  c->idx_name = name;
  c->idx_name_len = name_len;
  var sz: int32 = cat_row_size(t);
  c->idx_name = 0;
  c->idx_name_len = 0;
  if (sz < 0) { return sz; }
  if (sz > MEO_REC_MAX) { return -MEO_ERR_TOOBIG; }
  return MEO_OK;
}

// Record a built index tree at `root` as index `name` on column `col` of t
// and save the row: UNIQUE when `unique` (a real constraint from now on),
// else MEO_COL_INDEXED. meo_cat_index_check's codes, nothing changed on any
// of them. The caller holds the db lock and a pager transaction and rolls it
// back on failure.
export fn meo_cat_create_index(cat: MeoCatalog*, t: MeoTable*, col: int32, name: uint8*,
    name_len: int32, unique: bool, root: uint32) -> int32 {
  var rc: int32 = meo_cat_index_check(cat, t, col, name, name_len);
  if (rc != MEO_OK) { return rc; }
  var nm: uint8* = cat_dup(name, name_len);
  if (nm == 0) { return -MEO_ERR_NOMEM; }
  var c: MeoColumn* = &t->columns[col];
  c->idx_name = nm;
  c->idx_name_len = name_len;
  c->index_root = root;
  if (unique) {
    c->cflags = c->cflags | MEO_COL_UNIQUE;
  } else {
    c->cflags = c->cflags | MEO_COL_INDEXED;
  }
  return meo_cat_save_table(cat, t);
}

// Drop the named index on column `col` of t: free its tree, clear the flag
// CREATE INDEX set and the name, save the row. -MEO_ERR_SCHEMA for a dead
// table or a column with no named index (constraint indexes have no name).
// The caller holds the db lock and a pager transaction and rolls it back on
// failure (the reload brings the index back).
export fn meo_cat_drop_index(cat: MeoCatalog*, t: MeoTable*, col: int32) -> int32 {
  if (cat == 0 || t == 0) { return -MEO_ERR_USAGE; }
  if (cat->broken) { return -MEO_ERR_CORRUPT; }
  if (!t->live) { return -MEO_ERR_SCHEMA; }
  if (col < 0 || col >= t->n_cols) { return -MEO_ERR_USAGE; }
  var c: MeoColumn* = &t->columns[col];
  if (c->idx_name == 0) { return -MEO_ERR_SCHEMA; }
  var root: uint32 = c->index_root;
  // Unindexed from the first freed page on, so nothing reads a half-freed tree.
  c->index_root = 0;
  c->cflags = c->cflags & ~(MEO_COL_UNIQUE | MEO_COL_INDEXED);
  free(c->idx_name);
  c->idx_name = 0;
  c->idx_name_len = 0;
  var rc: int32 = meo_cat_free_tree(cat->pager, root);
  if (rc != MEO_OK) { return rc; }
  return meo_cat_save_table(cat, t);
}
