// wire/stmt: the QUERY payload, a statement as data. Field for field the
// shape of flux_orm's RcStmt, with flux's numbers (RC_OP_*, RC_W_*), so flux
// encodes with no translation table.
//
//   u8 op; u8 sflags (bit0 if_not_exists / if exists, bit1 unique index)
//   str16 table; str16 name (index name, empty when unused)
//   u16 n_cols    x { str16 name; u8 type; u8 cflags }
//   u32 n_rows
//   u16 n_terms   x { str16 col; u8 op; u32 arg0; u32 n_args }
//   u16 n_order   x { str16 col; u8 desc }
//   i64 limit; i64 offset
//   u32 n_args    x val
//
// Decoding is structural only: reserved bits and bad booleans are PROTO, but
// op ranges and argument shapes are the server's to check (USAGE).

import "../error/status.mettle";
import "../mem/arena.mettle";
import "../record/value.mettle";
import "frame.mettle";
import "value.mettle";

export const MEO_WIRE_OP_CREATE: int32 = 1;
export const MEO_WIRE_OP_INSERT: int32 = 2;
export const MEO_WIRE_OP_SELECT: int32 = 3;
export const MEO_WIRE_OP_UPDATE: int32 = 4;
export const MEO_WIRE_OP_DELETE: int32 = 5;
export const MEO_WIRE_OP_COUNT: int32 = 6;
export const MEO_WIRE_OP_DROP: int32 = 7;
export const MEO_WIRE_OP_ADD_COLUMN: int32 = 8;
export const MEO_WIRE_OP_CREATE_INDEX: int32 = 9;
export const MEO_WIRE_OP_DROP_INDEX: int32 = 10;

export const MEO_WIRE_W_EQ: int32 = 0;
export const MEO_WIRE_W_NE: int32 = 1;
export const MEO_WIRE_W_LT: int32 = 2;
export const MEO_WIRE_W_LE: int32 = 3;
export const MEO_WIRE_W_GT: int32 = 4;
export const MEO_WIRE_W_GE: int32 = 5;
export const MEO_WIRE_W_IN: int32 = 6;
export const MEO_WIRE_W_NULL: int32 = 7;
export const MEO_WIRE_W_NOT_NULL: int32 = 8;

export const MEO_WIRE_SF_IF_NOT_EXISTS: int32 = 1;
export const MEO_WIRE_SF_UNIQUE: int32 = 2;

export const MEO_WIRE_CF_PK: int32 = 1;
export const MEO_WIRE_CF_NOT_NULL: int32 = 2;
export const MEO_WIRE_CF_UNIQUE: int32 = 4;
export const MEO_WIRE_CF_ADD: int32 = 8;      // UPDATE: col = col + value

export struct MeoWCol {
  name: string;
  ty: int32;
  flags: int32;
}

export struct MeoWTerm {
  col: string;
  op: int32;
  arg0: int32;
  n_args: int32;
}

export struct MeoWOrder {
  col: string;
  desc: bool;
}

export struct MeoWStmt {
  op: int32;
  table: string;
  if_not_exists: bool;
  name: string;
  unique: bool;
  cols: MeoWCol*;
  n_cols: int32;
  n_rows: int32;
  terms: MeoWTerm*;
  n_terms: int32;
  order: MeoWOrder*;
  n_order: int32;
  limit: int64;
  offset: int64;
  args: MeoValue*;
  n_args: int32;
}

export fn meo_wire_stmt_init(st: MeoWStmt*) {
  st->op = 0;
  st->table.chars = 0;
  st->table.length = 0;
  st->if_not_exists = false;
  st->name.chars = 0;
  st->name.length = 0;
  st->unique = false;
  st->cols = 0;
  st->n_cols = 0;
  st->n_rows = 0;
  st->terms = 0;
  st->n_terms = 0;
  st->order = 0;
  st->n_order = 0;
  st->limit = -1;
  st->offset = 0;
  st->args = 0;
  st->n_args = 0;
}

fn meo_wire_u16_count(n: int32, p: rawptr) -> bool {
  return n >= 0 && n <= 65535 && (n == 0 || p != 0);
}

export fn meo_wire_stmt_put(w: MeoWBuf*, st: MeoWStmt*) -> int32 {
  if (st == 0 || st->op < 0 || st->op > 255 || st->n_rows < 0
      || !meo_wire_u16_count(st->n_cols, (rawptr)st->cols)
      || !meo_wire_u16_count(st->n_terms, (rawptr)st->terms)
      || !meo_wire_u16_count(st->n_order, (rawptr)st->order)
      || st->n_args < 0 || (st->n_args > 0 && st->args == 0)) {
    meo_wbuf_usage(w);
    return w->err;
  }
  var sf: int32 = 0;
  if (st->if_not_exists) { sf = sf | MEO_WIRE_SF_IF_NOT_EXISTS; }
  if (st->unique) { sf = sf | MEO_WIRE_SF_UNIQUE; }
  meo_wbuf_u8(w, st->op);
  meo_wbuf_u8(w, sf);
  meo_wbuf_str16(w, st->table);
  meo_wbuf_str16(w, st->name);
  meo_wbuf_u16(w, st->n_cols);
  var i: int32 = 0;
  while (i < st->n_cols) {
    var c: MeoWCol* = &st->cols[i];
    if (c->ty < 0 || c->ty > 255 || c->flags < 0 || c->flags > 15) { meo_wbuf_usage(w); }
    meo_wbuf_str16(w, c->name);
    meo_wbuf_u8(w, c->ty);
    meo_wbuf_u8(w, c->flags);
    i += 1;
  }
  meo_wbuf_u32(w, (uint32)st->n_rows);
  meo_wbuf_u16(w, st->n_terms);
  i = 0;
  while (i < st->n_terms) {
    var t: MeoWTerm* = &st->terms[i];
    if (t->op < 0 || t->op > 255 || t->arg0 < 0 || t->n_args < 0) { meo_wbuf_usage(w); }
    meo_wbuf_str16(w, t->col);
    meo_wbuf_u8(w, t->op);
    meo_wbuf_u32(w, (uint32)t->arg0);
    meo_wbuf_u32(w, (uint32)t->n_args);
    i += 1;
  }
  meo_wbuf_u16(w, st->n_order);
  i = 0;
  while (i < st->n_order) {
    meo_wbuf_str16(w, st->order[i].col);
    if (st->order[i].desc) { meo_wbuf_u8(w, 1); } else { meo_wbuf_u8(w, 0); }
    i += 1;
  }
  meo_wbuf_i64(w, st->limit);
  meo_wbuf_i64(w, st->offset);
  meo_wbuf_u32(w, (uint32)st->n_args);
  i = 0;
  while (i < st->n_args) {
    meo_wire_val_put(w, &st->args[i]);
    i += 1;
  }
  return w->err;
}

// Every count is checked against the bytes left (at its smallest item size)
// before the array is allocated from `a`. Names and TEXT/BLOB bytes are views
// into r's payload.
export fn meo_wire_stmt_get(r: MeoWRd*, a: MeoArena*, st: MeoWStmt*) -> int32 {
  meo_wire_stmt_init(st);
  if (a == 0) {
    meo_wrd_fail(r, -MEO_ERR_USAGE);
    return r->err;
  }
  st->op = meo_wrd_u8(r);
  var sf: int32 = meo_wrd_u8(r);
  if ((sf & ~3) != 0) { meo_wrd_fail(r, -MEO_ERR_PROTO); }
  st->if_not_exists = (sf & MEO_WIRE_SF_IF_NOT_EXISTS) != 0;
  st->unique = (sf & MEO_WIRE_SF_UNIQUE) != 0;
  meo_wrd_str16(r, &st->table);
  meo_wrd_str16(r, &st->name);

  var nc: int32 = meo_wrd_u16(r);
  if (r->err != MEO_OK) { return r->err; }
  if ((int64)nc * 4 > (int64)meo_wrd_left(r)) {
    meo_wrd_fail(r, -MEO_ERR_PROTO);
    return r->err;
  }
  if (nc > 0) {
    st->cols = (MeoWCol*)meo_arena_alloc(a, (int64)nc * (int64)sizeof(MeoWCol));
    if (st->cols == 0) {
      meo_wrd_fail(r, -MEO_ERR_NOMEM);
      return r->err;
    }
  }
  var i: int32 = 0;
  while (i < nc) {
    var c: MeoWCol* = &st->cols[i];
    meo_wrd_str16(r, &c->name);
    c->ty = meo_wrd_u8(r);
    c->flags = meo_wrd_u8(r);
    if ((c->flags & ~15) != 0) { meo_wrd_fail(r, -MEO_ERR_PROTO); }
    i += 1;
  }
  if (r->err != MEO_OK) { return r->err; }
  st->n_cols = nc;
  st->n_rows = meo_wrd_count(r);

  var nt: int32 = meo_wrd_u16(r);
  if (r->err != MEO_OK) { return r->err; }
  if ((int64)nt * 11 > (int64)meo_wrd_left(r)) {
    meo_wrd_fail(r, -MEO_ERR_PROTO);
    return r->err;
  }
  if (nt > 0) {
    st->terms = (MeoWTerm*)meo_arena_alloc(a, (int64)nt * (int64)sizeof(MeoWTerm));
    if (st->terms == 0) {
      meo_wrd_fail(r, -MEO_ERR_NOMEM);
      return r->err;
    }
  }
  i = 0;
  while (i < nt) {
    var t: MeoWTerm* = &st->terms[i];
    meo_wrd_str16(r, &t->col);
    t->op = meo_wrd_u8(r);
    t->arg0 = meo_wrd_count(r);
    t->n_args = meo_wrd_count(r);
    i += 1;
  }
  if (r->err != MEO_OK) { return r->err; }
  st->n_terms = nt;

  var no: int32 = meo_wrd_u16(r);
  if (r->err != MEO_OK) { return r->err; }
  if ((int64)no * 3 > (int64)meo_wrd_left(r)) {
    meo_wrd_fail(r, -MEO_ERR_PROTO);
    return r->err;
  }
  if (no > 0) {
    st->order = (MeoWOrder*)meo_arena_alloc(a, (int64)no * (int64)sizeof(MeoWOrder));
    if (st->order == 0) {
      meo_wrd_fail(r, -MEO_ERR_NOMEM);
      return r->err;
    }
  }
  i = 0;
  while (i < no) {
    var o: MeoWOrder* = &st->order[i];
    meo_wrd_str16(r, &o->col);
    var d: int32 = meo_wrd_u8(r);
    if (d > 1) { meo_wrd_fail(r, -MEO_ERR_PROTO); }
    o->desc = d == 1;
    i += 1;
  }
  if (r->err != MEO_OK) { return r->err; }
  st->n_order = no;

  st->limit = meo_wrd_i64(r);
  st->offset = meo_wrd_i64(r);
  var na: int32 = meo_wrd_count(r);
  if (r->err != MEO_OK) { return r->err; }
  if ((int64)na > (int64)meo_wrd_left(r)) {
    meo_wrd_fail(r, -MEO_ERR_PROTO);
    return r->err;
  }
  if (na > 0) {
    st->args = (MeoValue*)meo_arena_alloc(a, (int64)na * (int64)sizeof(MeoValue));
    if (st->args == 0) {
      meo_wrd_fail(r, -MEO_ERR_NOMEM);
      return r->err;
    }
  }
  i = 0;
  while (i < na) {
    meo_wire_val_get(r, &st->args[i]);
    i += 1;
  }
  if (r->err != MEO_OK) { return r->err; }
  st->n_args = na;
  return meo_wrd_end(r);
}
