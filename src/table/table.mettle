// table/table: unlocked row primitives over one table b-tree plus one unique
// index b-tree per UNIQUE column and per non-INTEGER PRIMARY KEY.
//
// Table key = 8-byte rowid ++ record, separators truncated to 8; the rowid
// alias is stored NULL and filled from the key. Index key = types/key
// encoding of the value, u64 = rowid, whole-key separators; NULLs are not
// indexed. Writes are two-phase: meo_tbl_check_rows / meo_tbl_check_update
// find every constraint failure without writing, then write_row / update /
// delete only write. The caller holds the db lock and a pager transaction; a
// root change of the table or an index is saved through meo_cat_save_table in
// that transaction.

import "std/mem";
import "../error/status.mettle";
import "../format/bytes.mettle";
import "../pager/pager.mettle";
import "../btree/node.mettle";
import "../btree/btree.mettle";
import "../types/key.mettle";
import "../record/value.mettle";
import "../record/codec.mettle";
import "../mem/arena.mettle";
import "../catalog/schema.mettle";
import "../catalog/catalog.mettle";
import "../db/db.mettle";
import "../feed/feed.mettle";

// One row: its rowid and a view of its record bytes (see the header).
export struct MeoTblRow {
  rowid: int64;
  rec: uint8*;
  rec_len: int32;
}

// A scan cursor in rowid order, from `start` up. Holds one pinned leaf while
// open.
export struct MeoTblScan {
  db: MeoDb*;
  t: MeoTable*;
  cur: MeoBtCursor;
  started: bool;
  done: bool;
  start: int64;           // the first rowid the scan seeks to
}

// A range cursor over one unique index, in key order. Holds one pinned leaf
// and a key buffer while open.
export struct MeoTblIdxScan {
  db: MeoDb*;
  t: MeoTable*;
  col: int32;
  cur: MeoBtCursor;
  started: bool;
  done: bool;
  keys: uint8*;           // lo key, then hi key, MEO_REC_MAX bytes each (malloc)
  lo_n: int32;            // lo key length; the lone type tag when unbounded
  hi_n: int32;            // hi key length; 0 when unbounded
  tag: int32;             // MEO_KEY_* of the column's keys
}

// The table-tree comparator: the 8-byte rowid prefix decides.
export fn meo_tbl_cmp(a: uint8*, an: int32, b: uint8*, bn: int32) -> int32 {
  return meo_cat_cmp(a, an, b, bn);
}

// Index of the rowid-alias column, or -1.
export fn meo_tbl_alias_col(t: MeoTable*) -> int32 {
  if (t == 0) { return -1; }
  var i: int32 = 0;
  while (i < t->n_cols) {
    if ((t->columns[i].cflags & MEO_COL_ROWID_ALIAS) != 0) { return i; }
    i += 1;
  }
  return -1;
}

// True when column `i` has (or needs) a unique index.
export fn meo_tbl_col_indexed(t: MeoTable*, i: int32) -> bool {
  var f: int32 = t->columns[i].cflags;
  if ((f & MEO_COL_ROWID_ALIAS) != 0) { return false; }
  return (f & (MEO_COL_UNIQUE | MEO_COL_PK)) != 0;
}

// Coerce / check one value against column `i` (strict typing): NULL or the
// affinity, INTEGER into REAL converts; NOT NULL / PK -> CONSTRAINT.
fn tbl_check_value(t: MeoTable*, i: int32, v: MeoValue*) -> int32 {
  var rc: int32 = meo_value_check(v);
  if (rc != MEO_OK) { return rc; }
  var col: MeoColumn* = &t->columns[i];
  if (v->type == MEO_T_NULL) {
    if ((col->cflags & MEO_COL_ROWID_ALIAS) != 0) { return MEO_OK; }
    if ((col->cflags & (MEO_COL_NOT_NULL | MEO_COL_PK)) != 0) {
      return -MEO_ERR_CONSTRAINT;
    }
    return MEO_OK;
  }
  if (v->type == col->affinity) { return MEO_OK; }
  if (col->affinity == MEO_T_REAL && v->type == MEO_T_INT) {
    meo_value_set_real(v, (float64)v->i);
    return MEO_OK;
  }
  return -MEO_ERR_MISMATCH;
}

// The largest rowid in the tree, or 0 for an empty table (rowids start at 1).
fn tbl_max_rowid(db: MeoDb*, t: MeoTable*, out: int64*) -> int32 {
  out[0] = 0;
  var last: uint64 = 0;
  var rc: int32 = meo_bt_last(db->pager, t->root, &last);
  if (rc < 0) { return rc; }
  if (rc == 1) { return MEO_OK; }
  out[0] = (int64)last;
  return MEO_OK;
}

// Look rowid up. MEO_OK (present), 1 (absent), negative on failure.
fn tbl_rowid_exists(db: MeoDb*, t: MeoTable*, rowid: int64) -> int32 {
  if (t->root == 0) { return 1; }
  var k: uint8[8];
  meo_key_rowid(&k[0], 8, rowid);
  var key: MeoBtKey = { data: &k[0], len: 8 };
  var got: uint64 = 0;
  return meo_bt_lookup(db->pager, t->root, meo_tbl_cmp, key, &got);
}

fn tbl_sift(a: int64*, root: int32, n: int32) {
  var r: int32 = root;
  while (r * 2 + 1 < n) {
    var c: int32 = r * 2 + 1;
    if (c + 1 < n && a[c + 1] > a[c]) { c += 1; }
    if (a[r] >= a[c]) { return; }
    var x: int64 = a[r];
    a[r] = a[c];
    a[c] = x;
    r = c;
  }
}

// Heapsort: n can be thousands, so no quadratic sort.
fn tbl_sort_i64(a: int64*, n: int32) {
  var i: int32 = n / 2 - 1;
  while (i >= 0) {
    tbl_sift(a, i, n);
    i -= 1;
  }
  var end: int32 = n - 1;
  while (end > 0) {
    var x: int64 = a[0];
    a[0] = a[end];
    a[end] = x;
    tbl_sift(a, 0, end);
    end -= 1;
  }
}

// Encoded record size of one row with the rowid alias stored NULL.
fn tbl_row_size(t: MeoTable*, vals: MeoValue*, n: int32) -> int32 {
  var alias: int32 = meo_tbl_alias_col(t);
  var saved: MeoValue;
  if (alias >= 0) {
    saved = vals[alias];
    meo_value_set_null(&vals[alias]);
  }
  var sz: int32 = meo_rec_size(vals, n);
  if (alias >= 0) { vals[alias] = saved; }
  return sz;
}

// One encoded index key, kept in the statement arena for the duplicate check.
struct TblKeyRef {
  p: uint8*;
  n: int32;
}

// Index key length for a value: 0 for NULL (not indexed).
fn tbl_key_len(v: MeoValue*) -> int32 {
  if (v->type == MEO_T_INT || v->type == MEO_T_REAL) { return 9; }
  if (v->type == MEO_T_TEXT || v->type == MEO_T_BLOB) { return v->n + 1; }
  return 0;
}

// Encode the index key of `v` into buf[0..cap). Its length, 0 for NULL,
// -MEO_ERR_TOOBIG past MEO_REC_MAX.
fn tbl_key_encode(v: MeoValue*, buf: uint8*, cap: int32) -> int32 {
  var n: int32 = tbl_key_len(v);
  if (n == 0) { return 0; }
  if (n > MEO_REC_MAX) { return -MEO_ERR_TOOBIG; }
  if (n > cap) { return -MEO_ERR_FULL; }
  if (v->type == MEO_T_INT) { return meo_key_int(buf, cap, v->i); }
  if (v->type == MEO_T_REAL) { return meo_key_real(buf, cap, v->f); }
  if (v->type == MEO_T_BLOB) { return meo_key_blob(buf, cap, v->p, v->n); }
  // meo_key_text wants a string; the layout is the tag then the raw bytes.
  buf[0] = (uint8)MEO_KEY_TEXT;
  if (v->n > 0) { meo_bytes_copy(buf + 1, v->p, (int64)v->n); }
  return n;
}

// The rowid index `col` maps key to: MEO_OK, 1 absent, negative on failure.
fn tbl_index_get(db: MeoDb*, t: MeoTable*, col: int32, k: uint8*, kn: int32,
    out: int64*) -> int32 {
  var root: uint32 = t->columns[col].index_root;
  if (root == 0) { return 1; }
  var key: MeoBtKey = { data: k, len: kn };
  var got: uint64 = 0;
  var rc: int32 = meo_bt_lookup(db->pager, root, meo_key_compare, key, &got);
  if (rc == MEO_OK) { out[0] = (int64)got; }
  return rc;
}

fn tbl_ksift(a: TblKeyRef*, root: int32, n: int32) {
  var r: int32 = root;
  while (r * 2 + 1 < n) {
    var c: int32 = r * 2 + 1;
    if (c + 1 < n && meo_key_compare(a[c + 1].p, a[c + 1].n, a[c].p, a[c].n) > 0) { c += 1; }
    if (meo_key_compare(a[r].p, a[r].n, a[c].p, a[c].n) >= 0) { return; }
    var x: TblKeyRef = a[r];
    a[r] = a[c];
    a[c] = x;
    r = c;
  }
}

fn tbl_sort_keys(a: TblKeyRef*, n: int32) {
  var i: int32 = n / 2 - 1;
  while (i >= 0) {
    tbl_ksift(a, i, n);
    i -= 1;
  }
  var end: int32 = n - 1;
  while (end > 0) {
    var x: TblKeyRef = a[0];
    a[0] = a[end];
    a[end] = x;
    tbl_ksift(a, 0, end);
    end -= 1;
  }
}

// True when two of the n sorted rowids are equal.
fn tbl_dup_rowids(arena: MeoArena*, ids: int64*, n: int32, err: int32*) -> bool {
  err[0] = MEO_OK;
  if (n < 2) { return false; }
  var sorted: int64* = (int64*)meo_arena_alloc(arena, (int64)n * 8);
  if (sorted == 0) {
    err[0] = -MEO_ERR_NOMEM;
    return false;
  }
  var r: int32 = 0;
  while (r < n) {
    sorted[r] = ids[r];
    r += 1;
  }
  tbl_sort_i64(sorted, n);
  r = 1;
  while (r < n) {
    if (sorted[r] == sorted[r - 1]) { return true; }
    r += 1;
  }
  return false;
}

// The unique-index part of Phase A for n rows (row r owns rowid own[r]): a
// value already indexed under another rowid, or the same value twice among
// the rows, is a CONFLICT. An existing entry under the row's own rowid is the
// row itself (UPDATE keeping its value).
fn tbl_check_indexes(db: MeoDb*, t: MeoTable*, rows: MeoValue*, n: int32, n_cols: int32,
    own: int64*, arena: MeoArena*) -> int32 {
  var c: int32 = 0;
  while (c < n_cols) {
    if (meo_tbl_col_indexed(t, c)) {
      var refs: TblKeyRef* = 0;
      if (n > 1) {
        refs = (TblKeyRef*)meo_arena_alloc(arena, (int64)n * (int64)sizeof(TblKeyRef));
        if (refs == 0) { return -MEO_ERR_NOMEM; }
      }
      var k: int32 = 0;
      var r: int32 = 0;
      while (r < n) {
        var v: MeoValue* = &rows[(int64)r * (int64)n_cols + (int64)c];
        var kn: int32 = tbl_key_len(v);
        if (kn > MEO_REC_MAX) { return -MEO_ERR_TOOBIG; }
        if (kn > 0) {
          var kb: uint8* = meo_arena_alloc(arena, (int64)kn);
          if (kb == 0) { return -MEO_ERR_NOMEM; }
          var w: int32 = tbl_key_encode(v, kb, kn);
          if (w < 0) { return w; }
          var hit: int64 = 0;
          var rc: int32 = tbl_index_get(db, t, c, kb, w, &hit);
          if (rc < 0) { return rc; }
          if (rc == MEO_OK && hit != own[r]) { return -MEO_ERR_CONFLICT; }
          if (refs != 0) {
            refs[k].p = kb;
            refs[k].n = w;
            k += 1;
          }
        }
        r += 1;
      }
      if (k > 1) {
        tbl_sort_keys(refs, k);
        var i: int32 = 1;
        while (i < k) {
          if (meo_key_compare(refs[i].p, refs[i].n, refs[i - 1].p, refs[i - 1].n) == 0) {
            return -MEO_ERR_CONFLICT;
          }
          i += 1;
        }
      }
    }
    c += 1;
  }
  return MEO_OK;
}

// Phase A for a whole INSERT, no writes: `rows` holds n_rows rows of n_cols
// values, row-major (coerced in place, INTEGER -> REAL). Checks arity, types,
// NOT NULL, rowid conflicts with the tree and within the statement, record
// size, and every unique index against the tree and within the statement.
// rowids_out[r] gets row r's rowid: the alias value, or for a NULL/omitted
// alias the next of max+1, max+2, ... as if inserted in order.
// MEO_OK, or SCHEMA, MISMATCH, CONSTRAINT, CONFLICT, TOOBIG, FULL, or a storage
// error.
export fn meo_tbl_check_rows(db: MeoDb*, t: MeoTable*, rows: MeoValue*, n_rows: int32,
    n_cols: int32, arena: MeoArena*, rowids_out: int64*) -> int32 {
  if (db == 0 || t == 0 || arena == 0 || rowids_out == 0 || n_rows < 0) {
    return -MEO_ERR_USAGE;
  }
  if (n_rows == 0) { return MEO_OK; }
  if (rows == 0) { return -MEO_ERR_USAGE; }
  if (!t->live) { return -MEO_ERR_SCHEMA; }
  if (n_cols != t->n_cols) { return -MEO_ERR_SCHEMA; }
  var alias: int32 = meo_tbl_alias_col(t);
  var int64_max: int64 = (int64)(((uint64)1 << 63) - (uint64)1);
  var hi: int64 = 0;
  var rc: int32 = tbl_max_rowid(db, t, &hi);
  if (rc != MEO_OK) { return rc; }
  var r: int32 = 0;
  while (r < n_rows) {
    var vals: MeoValue* = rows + (int64)r * (int64)n_cols;
    var c: int32 = 0;
    while (c < n_cols) {
      rc = tbl_check_value(t, c, &vals[c]);
      if (rc != MEO_OK) { return rc; }
      c += 1;
    }
    var rowid: int64 = 0;
    if (alias >= 0 && vals[alias].type == MEO_T_INT) {
      rowid = vals[alias].i;
      var ex: int32 = tbl_rowid_exists(db, t, rowid);
      if (ex < 0) { return ex; }
      if (ex == MEO_OK) { return -MEO_ERR_CONFLICT; }
    } else {
      if (hi == int64_max) { return -MEO_ERR_FULL; }
      rowid = hi + 1;
      if (rowid < 1) { rowid = 1; }
    }
    if (rowid > hi) { hi = rowid; }
    var sz: int32 = tbl_row_size(t, vals, n_cols);
    if (sz < 0) { return sz; }
    if (sz > MEO_REC_MAX) { return -MEO_ERR_TOOBIG; }
    rowids_out[r] = rowid;
    r += 1;
  }
  var err: int32 = MEO_OK;
  if (tbl_dup_rowids(arena, rowids_out, n_rows, &err)) { return -MEO_ERR_CONFLICT; }
  if (err != MEO_OK) { return err; }
  return tbl_check_indexes(db, t, rows, n_rows, n_cols, rowids_out, arena);
}

// Phase A for an UPDATE of n rows: rowids[i] gets new_vals row i (n_cols
// values each, coerced in place). Same codes as meo_tbl_check_rows; a NULL
// rowid alias is CONSTRAINT. A unique value (or a new rowid alias) that some
// other row holds now is a CONFLICT even when that row is in the update set
// and would give it up: v1 does not reorder writes, so swapping or shifting
// unique values between updated rows fails.
export fn meo_tbl_check_update(db: MeoDb*, t: MeoTable*, rowids: int64*, n: int32,
    new_vals: MeoValue*, n_cols: int32, arena: MeoArena*) -> int32 {
  if (db == 0 || t == 0 || arena == 0 || n < 0) { return -MEO_ERR_USAGE; }
  if (n == 0) { return MEO_OK; }
  if (rowids == 0 || new_vals == 0) { return -MEO_ERR_USAGE; }
  if (!t->live) { return -MEO_ERR_SCHEMA; }
  if (n_cols != t->n_cols) { return -MEO_ERR_SCHEMA; }
  var alias: int32 = meo_tbl_alias_col(t);
  var new_ids: int64* = (int64*)meo_arena_alloc(arena, (int64)n * 8);
  if (new_ids == 0) { return -MEO_ERR_NOMEM; }
  var rc: int32 = MEO_OK;
  var r: int32 = 0;
  while (r < n) {
    var vals: MeoValue* = new_vals + (int64)r * (int64)n_cols;
    var c: int32 = 0;
    while (c < n_cols) {
      rc = tbl_check_value(t, c, &vals[c]);
      if (rc != MEO_OK) { return rc; }
      c += 1;
    }
    new_ids[r] = rowids[r];
    if (alias >= 0) {
      if (vals[alias].type != MEO_T_INT) { return -MEO_ERR_CONSTRAINT; }
      var nid: int64 = vals[alias].i;
      if (nid != rowids[r]) {
        var ex: int32 = tbl_rowid_exists(db, t, nid);
        if (ex < 0) { return ex; }
        if (ex == MEO_OK) { return -MEO_ERR_CONFLICT; }
      }
      new_ids[r] = nid;
    }
    var sz: int32 = tbl_row_size(t, vals, n_cols);
    if (sz < 0) { return sz; }
    if (sz > MEO_REC_MAX) { return -MEO_ERR_TOOBIG; }
    r += 1;
  }
  var err: int32 = MEO_OK;
  if (tbl_dup_rowids(arena, new_ids, n, &err)) { return -MEO_ERR_CONFLICT; }
  if (err != MEO_OK) { return err; }
  return tbl_check_indexes(db, t, new_vals, n, n_cols, rowids, arena);
}

// Encode a row into a fresh buffer: 8-byte rowid ++ record with the alias
// stored NULL. *out (free it) and *out_len.
fn tbl_encode_row(t: MeoTable*, vals: MeoValue*, n: int32, rowid: int64, out: uint8**,
    out_len: int32*) -> int32 {
  var alias: int32 = meo_tbl_alias_col(t);
  var saved: MeoValue;
  if (alias >= 0) {
    saved = vals[alias];
    meo_value_set_null(&vals[alias]);
  }
  var sz: int32 = meo_rec_size(vals, n);
  if (sz < 0 || sz > MEO_REC_MAX) {
    if (alias >= 0) { vals[alias] = saved; }
    return -MEO_ERR_USAGE;   // Phase A was skipped
  }
  var buf: uint8* = malloc((int64)sz + 8);
  if (buf == 0) {
    if (alias >= 0) { vals[alias] = saved; }
    return -MEO_ERR_NOMEM;
  }
  meo_key_rowid(buf, 8, rowid);
  var w: int32 = meo_rec_encode(buf + 8, sz, vals, n);
  if (alias >= 0) { vals[alias] = saved; }
  if (w < 0) {
    free(buf);
    return w;
  }
  out[0] = buf;
  out_len[0] = w + 8;
  return MEO_OK;
}

// Insert an encoded row (rowid ++ record) into the table tree.
fn tbl_put_row(db: MeoDb*, t: MeoTable*, buf: uint8*, len: int32, rowid: int64,
    dirty: bool*) -> int32 {
  var key: MeoBtKey = { data: buf, len: len };
  var root: uint32 = t->root;
  var rc: int32 = meo_bt_insert_sep(db->pager, &root, meo_tbl_cmp, key, (uint64)rowid, 8);
  if (root != t->root) {
    t->root = root;
    dirty[0] = true;
  }
  return rc;
}

fn tbl_del_row(db: MeoDb*, t: MeoTable*, rowid: int64) -> int32 {
  var k: uint8[8];
  meo_key_rowid(&k[0], 8, rowid);
  var key: MeoBtKey = { data: &k[0], len: 8 };
  var root: uint32 = t->root;
  return meo_bt_delete(db->pager, &root, meo_tbl_cmp, key);
}

// Add (put) or remove every index entry of one record. kbuf holds
// MEO_REC_MAX bytes. Values come from the record, so they stay valid while
// the trees change.
fn tbl_index_rec(db: MeoDb*, t: MeoTable*, rec: uint8*, rec_len: int32, rowid: int64,
    put: bool, kbuf: uint8*, dirty: bool*) -> int32 {
  var c: int32 = 0;
  while (c < t->n_cols) {
    if (meo_tbl_col_indexed(t, c)) {
      var v: MeoValue;
      var rc: int32 = meo_rec_get(rec, rec_len, c, &v);
      if (rc != MEO_OK) { return rc; }
      var kn: int32 = tbl_key_encode(&v, kbuf, MEO_REC_MAX);
      if (kn < 0) { return kn; }
      if (kn > 0) {
        var key: MeoBtKey = { data: kbuf, len: kn };
        var root: uint32 = t->columns[c].index_root;
        if (put) {
          rc = meo_bt_insert(db->pager, &root, meo_key_compare, key, (uint64)rowid);
          if (root != t->columns[c].index_root) {
            t->columns[c].index_root = root;
            dirty[0] = true;
          }
        } else {
          rc = meo_bt_delete(db->pager, &root, meo_key_compare, key);
          if (rc == 1) { rc = -MEO_ERR_CORRUPT; }   // index lost the row's entry
        }
        if (rc != MEO_OK) { return rc; }
      }
    }
    c += 1;
  }
  return MEO_OK;
}

fn tbl_finish(db: MeoDb*, t: MeoTable*, rc: int32, dirty: bool) -> int32 {
  if (rc != MEO_OK) { return rc; }
  if (dirty) { return meo_cat_save_table(db->cat, t); }
  return MEO_OK;
}

// Report one finished row write to the attached feed, if any. Called only
// after the whole write succeeded; a rollback drops what it recorded.
fn tbl_feed(db: MeoDb*, t: MeoTable*, kind: int32, rowid: int64, old_rowid: int64,
    rec: uint8*, rec_len: int32) {
  var f: MeoFeed* = meo_feed_of(db->pager);
  if (f == 0) { return; }
  var k: uint8[8];
  meo_key_rowid(&k[0], 8, rowid);
  meo_feed_capture(f, (uint32)t->id, kind, &k[0], 8, (uint64)rowid, (uint64)old_rowid,
    rec, rec_len);
}

// Phase B: write one row that meo_tbl_check_rows accepted, under `rowid`, and
// its index entries. No re-check, so no Phase-A code: any failure here is a
// storage failure and the caller treats the statement as having written.
export fn meo_tbl_write_row(db: MeoDb*, t: MeoTable*, vals: MeoValue*, n: int32,
    rowid: int64) -> int32 {
  if (db == 0 || t == 0 || vals == 0 || n != t->n_cols) { return -MEO_ERR_USAGE; }
  var buf: uint8* = 0;
  var len: int32 = 0;
  var rc: int32 = tbl_encode_row(t, vals, n, rowid, &buf, &len);
  if (rc != MEO_OK) { return rc; }
  var kbuf: uint8* = malloc((int64)MEO_REC_MAX);
  if (kbuf == 0) {
    free(buf);
    return -MEO_ERR_NOMEM;
  }
  var dirty: bool = false;
  rc = tbl_put_row(db, t, buf, len, rowid, &dirty);
  if (rc == MEO_OK) { rc = tbl_index_rec(db, t, buf + 8, len - 8, rowid, true, kbuf, &dirty); }
  free(kbuf);
  rc = tbl_finish(db, t, rc, dirty);
  if (rc == MEO_OK) { tbl_feed(db, t, MEO_CHANGE_INSERT, rowid, 0, buf + 8, len - 8); }
  free(buf);
  if (rc != MEO_OK) { return rc; }
  db->last_rowid = rowid;
  return MEO_OK;
}

// Delete the row with this rowid and its index entries. MEO_OK, 1 absent.
export fn meo_tbl_delete(db: MeoDb*, t: MeoTable*, rowid: int64) -> int32 {
  if (db == 0 || t == 0) { return -MEO_ERR_USAGE; }
  var old: uint8* = malloc((int64)MEO_REC_MAX * 2);
  if (old == 0) { return -MEO_ERR_NOMEM; }
  defer free(old);
  var row: MeoTblRow;
  var rc: int32 = meo_tbl_lookup_rowid(db, t, rowid, old, MEO_REC_MAX, &row);
  if (rc != MEO_OK) { return rc; }
  var dirty: bool = false;
  rc = tbl_index_rec(db, t, row.rec, row.rec_len, rowid, false, old + MEO_REC_MAX, &dirty);
  if (rc != MEO_OK) { return rc; }
  rc = tbl_del_row(db, t, rowid);
  if (rc == 1) { return -MEO_ERR_CORRUPT; }
  rc = tbl_finish(db, t, rc, dirty);
  if (rc == MEO_OK) { tbl_feed(db, t, MEO_CHANGE_DELETE, rowid, 0, row.rec, row.rec_len); }
  return rc;
}

// Replace the row with this rowid by `vals` (n == t->n_cols), as accepted by
// meo_tbl_check_update. A new rowid alias value moves the row. The new record
// is encoded before any tree changes, so vals may borrow from a scan leaf.
// MEO_OK, 1 absent.
export fn meo_tbl_update(db: MeoDb*, t: MeoTable*, rowid: int64, vals: MeoValue*,
    n: int32) -> int32 {
  if (db == 0 || t == 0 || vals == 0 || n != t->n_cols) { return -MEO_ERR_USAGE; }
  var old: uint8* = malloc((int64)MEO_REC_MAX * 2);
  if (old == 0) { return -MEO_ERR_NOMEM; }
  defer free(old);
  var kbuf: uint8* = old + MEO_REC_MAX;
  var row: MeoTblRow;
  var rc: int32 = meo_tbl_lookup_rowid(db, t, rowid, old, MEO_REC_MAX, &row);
  if (rc != MEO_OK) { return rc; }
  var nid: int64 = rowid;
  var alias: int32 = meo_tbl_alias_col(t);
  if (alias >= 0 && vals[alias].type == MEO_T_INT) { nid = vals[alias].i; }
  var buf: uint8* = 0;
  var len: int32 = 0;
  rc = tbl_encode_row(t, vals, n, nid, &buf, &len);
  if (rc != MEO_OK) { return rc; }
  defer free(buf);
  var dirty: bool = false;
  rc = tbl_index_rec(db, t, row.rec, row.rec_len, rowid, false, kbuf, &dirty);
  // An equal-key insert keeps the old bytes, so the row key goes first.
  if (rc == MEO_OK) {
    rc = tbl_del_row(db, t, rowid);
    if (rc == 1) { rc = -MEO_ERR_CORRUPT; }
  }
  if (rc == MEO_OK) { rc = tbl_put_row(db, t, buf, len, nid, &dirty); }
  if (rc == MEO_OK) { rc = tbl_index_rec(db, t, buf + 8, len - 8, nid, true, kbuf, &dirty); }
  rc = tbl_finish(db, t, rc, dirty);
  if (rc == MEO_OK) { tbl_feed(db, t, MEO_CHANGE_REPLACE, nid, rowid, buf + 8, len - 8); }
  return rc;
}

// The rowid a unique index maps `v` to: MEO_OK and *rowid_out, 1 absent
// (NULL is never indexed, and a value of another type cannot be stored),
// -MEO_ERR_USAGE when column `col` has no index.
export fn meo_tbl_index_lookup(db: MeoDb*, t: MeoTable*, col: int32, v: MeoValue*,
    rowid_out: int64*) -> int32 {
  if (db == 0 || t == 0 || v == 0 || rowid_out == 0 || col < 0 || col >= t->n_cols) {
    return -MEO_ERR_USAGE;
  }
  if (!meo_tbl_col_indexed(t, col)) { return -MEO_ERR_USAGE; }
  var q: MeoValue = v[0];
  var aff: int32 = t->columns[col].affinity;
  if (q.type == MEO_T_INT && aff == MEO_T_REAL) { meo_value_set_real(&q, (float64)v->i); }
  if (q.type != aff) { return 1; }
  var kbuf: uint8* = malloc((int64)MEO_REC_MAX);
  if (kbuf == 0) { return -MEO_ERR_NOMEM; }
  defer free(kbuf);
  var kn: int32 = tbl_key_encode(&q, kbuf, MEO_REC_MAX);
  if (kn == -MEO_ERR_TOOBIG) { return 1; }
  if (kn < 0) { return kn; }
  return tbl_index_get(db, t, col, kbuf, kn, rowid_out);
}

// Point lookup: copy the record of `rowid` into buf[0..cap) (cap >=
// MEO_REC_MAX always suffices) and point row at it. MEO_OK, 1 absent,
// -MEO_ERR_FULL when cap is too small, negative on failure.
export fn meo_tbl_lookup_rowid(db: MeoDb*, t: MeoTable*, rowid: int64, buf: uint8*,
    cap: int32, row: MeoTblRow*) -> int32 {
  if (db == 0 || t == 0 || buf == 0 || row == 0) { return -MEO_ERR_USAGE; }
  if (t->root == 0) { return 1; }
  var k: uint8[8];
  meo_key_rowid(&k[0], 8, rowid);
  var key: MeoBtKey = { data: &k[0], len: 8 };
  var c: MeoBtCursor;
  meo_bt_cursor_init(&c);
  var rc: int32 = meo_bt_seek(db->pager, &c, t->root, meo_tbl_cmp, key);
  if (rc != 0) {
    meo_bt_close(db->pager, &c);
    return rc;
  }
  var got: uint64 = meo_btn_leaf_rowid(c.leaf->data, c.slot_in_leaf);
  if ((int64)got != rowid) {
    meo_bt_close(db->pager, &c);
    return 1;
  }
  var kl: int32 = meo_btn_leaf_key_len(c.leaf->data, c.slot_in_leaf);
  if (kl < 9) {
    meo_bt_close(db->pager, &c);
    return -MEO_ERR_CORRUPT;
  }
  if (kl - 8 > cap) {
    meo_bt_close(db->pager, &c);
    return -MEO_ERR_FULL;
  }
  meo_bytes_copy(buf, meo_btn_leaf_key_ptr(c.leaf->data, c.slot_in_leaf) + 8, (int64)(kl - 8));
  meo_bt_close(db->pager, &c);
  row->rowid = rowid;
  row->rec = buf;
  row->rec_len = kl - 8;
  return MEO_OK;
}

// Open a full scan in rowid order. MEO_OK; nothing is pinned until the first
// meo_tbl_scan_next.
export fn meo_tbl_scan_open(db: MeoDb*, t: MeoTable*, sc: MeoTblScan*) -> int32 {
  if (db == 0 || t == 0 || sc == 0) { return -MEO_ERR_USAGE; }
  if (!t->live) { return -MEO_ERR_SCHEMA; }
  sc->db = db;
  sc->t = t;
  sc->started = false;
  sc->done = false;
  sc->start = (int64)((uint64)1 << 63);   // INT64_MIN
  meo_bt_cursor_init(&sc->cur);
  return MEO_OK;
}

// meo_tbl_scan_open, but the first row is the first with rowid >= lo. The
// caller stops at its own upper bound.
export fn meo_tbl_scan_from(db: MeoDb*, t: MeoTable*, lo: int64, sc: MeoTblScan*) -> int32 {
  var rc: int32 = meo_tbl_scan_open(db, t, sc);
  if (rc != MEO_OK) { return rc; }
  sc->start = lo;
  return MEO_OK;
}

// The next row: 0 = *row filled (borrowing the pinned leaf), 1 = done,
// negative on failure.
export fn meo_tbl_scan_next(sc: MeoTblScan*, row: MeoTblRow*) -> int32 {
  if (sc == 0 || row == 0) { return -MEO_ERR_USAGE; }
  if (sc->done) { return 1; }
  var p: MeoPager* = sc->db->pager;
  var rc: int32 = 0;
  if (!sc->started) {
    sc->started = true;
    if (sc->t->root == 0) {
      sc->done = true;
      return 1;
    }
    var k: uint8[8];
    meo_key_rowid(&k[0], 8, sc->start);
    var key: MeoBtKey = { data: &k[0], len: 8 };
    rc = meo_bt_seek(p, &sc->cur, sc->t->root, meo_tbl_cmp, key);
  } else {
    rc = meo_bt_next(p, &sc->cur);
  }
  if (rc != 0) {
    sc->done = true;
    meo_bt_close(p, &sc->cur);
    return rc;
  }
  var lf: uint8* = sc->cur.leaf->data;
  var at: int32 = sc->cur.slot_in_leaf;
  var kl: int32 = meo_btn_leaf_key_len(lf, at);
  if (kl < 9) {
    sc->done = true;
    meo_bt_close(p, &sc->cur);
    return -MEO_ERR_CORRUPT;
  }
  row->rowid = (int64)meo_btn_leaf_rowid(lf, at);
  row->rec = meo_btn_leaf_key_ptr(lf, at) + 8;
  row->rec_len = kl - 8;
  return 0;
}

// Release the scan's leaf. Always safe.
export fn meo_tbl_scan_close(sc: MeoTblScan*) {
  if (sc == 0 || sc->db == 0) { return; }
  meo_bt_close(sc->db->pager, &sc->cur);
  sc->done = true;
}

// An int64 bound for the REAL bound `f`, rounded outward (down for a lower
// bound, up for an upper one) and widened past 2^53, where an INTEGER's float64
// conversion is itself rounded. MEO_OK and *out, or 1 when no int64 can lie in
// the range (NaN, a lower bound above INT64_MAX, an upper one below INT64_MIN).
export fn meo_tbl_real_bound(f: float64, upper: bool, out: int64*) -> int32 {
  var int64_min: int64 = (int64)((uint64)1 << 63);
  var int64_max: int64 = (int64)(((uint64)1 << 63) - (uint64)1);
  if (f != f) { return 1; }
  if (f >= 9223372036854775808.0) {
    if (!upper) { return 1; }
    out[0] = int64_max;
    return MEO_OK;
  }
  if (f < -9223372036854775808.0) {
    if (upper) { return 1; }
    out[0] = int64_min;
    return MEO_OK;
  }
  var i: int64 = (int64)f;
  if (upper && (float64)i < f) { i += 1; }
  if (!upper && (float64)i > f) { i -= 1; }
  var big: int64 = 9007199254740992;
  var pad: int64 = 1024;
  if (i >= big || i <= -big) {
    if (upper) {
      if (i > int64_max - pad) { i = int64_max; } else { i += pad; }
    } else {
      if (i < int64_min + pad) { i = int64_min; } else { i -= pad; }
    }
  }
  out[0] = i;
  return MEO_OK;
}

// A range bound as a value of column `aff`'s own type, so its key sorts among
// the column's keys. MEO_OK and *out, 1 when nothing can satisfy it,
// -MEO_ERR_MISMATCH when it cannot be compared with the column.
fn tbl_bound_value(aff: int32, v: MeoValue*, upper: bool, out: MeoValue*) -> int32 {
  if (aff == MEO_T_INT && v->type == MEO_T_INT) {
    out[0] = v[0];
    return MEO_OK;
  }
  if (aff == MEO_T_INT && v->type == MEO_T_REAL) {
    var i: int64 = 0;
    var rc: int32 = meo_tbl_real_bound(v->f, upper, &i);
    if (rc != MEO_OK) { return rc; }
    meo_value_set_int(out, i);
    return MEO_OK;
  }
  if (aff == MEO_T_REAL && v->type == MEO_T_INT) {
    meo_value_set_real(out, (float64)v->i);
    return MEO_OK;
  }
  if (aff == MEO_T_REAL && v->type == MEO_T_REAL) {
    if (v->f != v->f) { return 1; }
    out[0] = v[0];
    return MEO_OK;
  }
  if ((aff == MEO_T_TEXT || aff == MEO_T_BLOB) && v->type == aff) {
    out[0] = v[0];
    return MEO_OK;
  }
  return -MEO_ERR_MISMATCH;
}

fn tbl_tag_of(aff: int32) -> int32 {
  if (aff == MEO_T_INT) { return MEO_KEY_INT; }
  if (aff == MEO_T_REAL) { return MEO_KEY_REAL; }
  if (aff == MEO_T_TEXT) { return MEO_KEY_TEXT; }
  return MEO_KEY_BLOB;
}

// Open a scan of the unique index on `col` over [lo, hi], both inclusive; 0
// leaves a side unbounded. An INTEGER column takes REAL bounds, a REAL column
// INTEGER ones, TEXT and BLOB their own type; anything else is
// -MEO_ERR_MISMATCH, a text/blob bound past MEO_REC_MAX -MEO_ERR_TOOBIG,
// -MEO_ERR_USAGE for a column with no index. Bounds are rounded outward, so
// the caller still filters. Nothing is pinned until the first
// meo_tbl_idx_scan_next.
export fn meo_tbl_idx_scan_open(db: MeoDb*, t: MeoTable*, col: int32, lo: MeoValue*,
    hi: MeoValue*, sc: MeoTblIdxScan*) -> int32 {
  if (db == 0 || t == 0 || sc == 0 || col < 0 || col >= t->n_cols) { return -MEO_ERR_USAGE; }
  if (!meo_tbl_col_indexed(t, col)) { return -MEO_ERR_USAGE; }
  if (!t->live) { return -MEO_ERR_SCHEMA; }
  sc->db = db;
  sc->t = t;
  sc->col = col;
  sc->started = false;
  sc->done = true;
  sc->keys = 0;
  sc->lo_n = 0;
  sc->hi_n = 0;
  meo_bt_cursor_init(&sc->cur);
  var aff: int32 = t->columns[col].affinity;
  sc->tag = tbl_tag_of(aff);
  var b: MeoValue;
  var empty: bool = false;
  var rc: int32 = MEO_OK;
  if (lo != 0) {
    rc = tbl_bound_value(aff, lo, false, &b);
    if (rc < 0) { return rc; }
    if (rc == 1) { empty = true; }
  }
  var b2: MeoValue;
  if (hi != 0) {
    rc = tbl_bound_value(aff, hi, true, &b2);
    if (rc < 0) { return rc; }
    if (rc == 1) { empty = true; }
  }
  if (empty) { return MEO_OK; }
  var keys: uint8* = malloc((int64)MEO_REC_MAX * 2);
  if (keys == 0) { return -MEO_ERR_NOMEM; }
  keys[0] = (uint8)sc->tag;
  var n: int32 = 1;
  if (lo != 0) { n = tbl_key_encode(&b, keys, MEO_REC_MAX); }
  var hn: int32 = 0;
  if (n >= 0 && hi != 0) { hn = tbl_key_encode(&b2, keys + MEO_REC_MAX, MEO_REC_MAX); }
  if (n < 0 || hn < 0) {
    free(keys);
    if (n < 0) { return n; }
    return hn;
  }
  sc->lo_n = n;
  sc->hi_n = hn;
  sc->keys = keys;
  sc->done = false;
  return MEO_OK;
}

// The next entry in key order: 0 = *rowid_out set, 1 = done, negative on
// failure.
export fn meo_tbl_idx_scan_next(sc: MeoTblIdxScan*, rowid_out: int64*) -> int32 {
  if (sc == 0 || rowid_out == 0) { return -MEO_ERR_USAGE; }
  if (sc->done) { return 1; }
  var p: MeoPager* = sc->db->pager;
  var root: uint32 = sc->t->columns[sc->col].index_root;
  var rc: int32 = 0;
  if (!sc->started) {
    sc->started = true;
    if (root == 0) {
      sc->done = true;
      return 1;
    }
    var key: MeoBtKey = { data: sc->keys, len: sc->lo_n };
    rc = meo_bt_seek(p, &sc->cur, root, meo_key_compare, key);
  } else {
    rc = meo_bt_next(p, &sc->cur);
  }
  if (rc != 0) {
    sc->done = true;
    meo_bt_close(p, &sc->cur);
    return rc;
  }
  var lf: uint8* = sc->cur.leaf->data;
  var at: int32 = sc->cur.slot_in_leaf;
  var kp: uint8* = meo_btn_leaf_key_ptr(lf, at);
  var kl: int32 = meo_btn_leaf_key_len(lf, at);
  // Past the column's keys, or past the upper bound.
  var past: bool = kl < 1 || (int32)kp[0] != sc->tag;
  if (!past && sc->hi_n > 0) {
    past = meo_key_compare(kp, kl, sc->keys + MEO_REC_MAX, sc->hi_n) > 0;
  }
  if (past) {
    sc->done = true;
    meo_bt_close(p, &sc->cur);
    return 1;
  }
  rowid_out[0] = (int64)meo_btn_leaf_rowid(lf, at);
  return 0;
}

// Release the scan's leaf and key buffer. Always safe.
export fn meo_tbl_idx_scan_close(sc: MeoTblIdxScan*) {
  if (sc == 0 || sc->db == 0) { return; }
  meo_bt_close(sc->db->pager, &sc->cur);
  sc->done = true;
  if (sc->keys != 0) { free(sc->keys); }
  sc->keys = 0;
}

// Column `col` of a row, the rowid alias filled from the rowid. out.p
// borrows row->rec.
export fn meo_tbl_row_get(t: MeoTable*, row: MeoTblRow*, col: int32, out: MeoValue*) -> int32 {
  if (t == 0 || row == 0 || out == 0 || col < 0 || col >= t->n_cols) {
    return -MEO_ERR_USAGE;
  }
  if ((t->columns[col].cflags & MEO_COL_ROWID_ALIAS) != 0) {
    meo_value_set_int(out, row->rowid);
    return MEO_OK;
  }
  return meo_rec_get(row->rec, row->rec_len, col, out);
}
