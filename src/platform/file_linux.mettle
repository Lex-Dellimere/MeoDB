// platform/file_linux: the Linux x86-64 backend for the meo_file_* contract in
// file.mettle. Every byte here reaches the kernel through a raw syscall; there
// is no libc, no stdio and no cursor: reads and writes are pread64/pwrite64 so
// they never move the descriptor's seek offset.
//
// No errno escapes this file. A syscall's negative result is consumed by
// meo_file_err and becomes -MEO_ERR_IO / -MEO_ERR_NOMEM / -MEO_ERR_USAGE; callers
// above the platform layer only ever see those three codes.
//
// Syscall numbers follow Linux x86-64. The set is exactly what the file API
// needs: open(2), close(3), pread64(17), pwrite64(18), fsync(74),
// ftruncate(77), plus lseek(8) for meo_file_size, rename(82) for
// meo_file_rename, unlink(87) for meo_file_unlink and flock(73) for
// meo_file_lock.

import "../error/status.mettle";
import "file.mettle";
import "std/mem";

const MEO_SYS_OPEN: int64 = 2;
const MEO_SYS_CLOSE: int64 = 3;
const MEO_SYS_LSEEK: int64 = 8;
const MEO_SYS_PREAD64: int64 = 17;
const MEO_SYS_PWRITE64: int64 = 18;
const MEO_SYS_FLOCK: int64 = 73;
const MEO_SYS_FSYNC: int64 = 74;
const MEO_SYS_FTRUNCATE: int64 = 77;
const MEO_SYS_RENAME: int64 = 82;
const MEO_SYS_UNLINK: int64 = 87;

// open(2) flag bits, translated from the MEO_OPEN_* API bits.
const MEO_O_WRONLY: int64 = 1;
const MEO_O_RDWR: int64 = 2;
const MEO_O_CREAT: int64 = 64;
const MEO_O_EXCL: int64 = 128;
const MEO_O_MODE: int64 = 420;  // 0644

// lseek(2) whence values.
const MEO_SEEK_SET: int64 = 0;
const MEO_SEEK_CUR: int64 = 1;
const MEO_SEEK_END: int64 = 2;

// flock(2) operation bits.
const MEO_LOCK_SH: int64 = 1;
const MEO_LOCK_EX: int64 = 2;
const MEO_LOCK_NB: int64 = 4;

// Errno values this backend distinguishes. Everything else -- ENOENT, EACCES,
// ENOSPC, EIO, ... -- is a kernel refusal and becomes MEO_ERR_IO.
const MEO_E_BADF: int64 = 9;
const MEO_E_WOULDBLOCK: int64 = 11;
const MEO_E_NOMEM: int64 = 12;
const MEO_E_FAULT: int64 = 14;
const MEO_E_ISDIR: int64 = 21;
const MEO_E_INVAL: int64 = 22;
const MEO_E_NFILE: int64 = 23;
const MEO_E_MFILE: int64 = 24;
const MEO_E_NAMETOOLONG: int64 = 36;

// A read_at count is returned as int32, so a larger request is refused rather
// than truncated into a bogus (possibly negative) count.
const MEO_MAX_READ: int64 = 2147483647;

// `code` is the already-negative status a failed open reports, not the
// positive MEO_ERR_* constant.
//
// A struct returned as a literal is an IR-lowering ICE on this compiler; the
// result is bound to a local first (same reason as meo_file_open).
fn meo_file_failed(code: int32) -> MeoFile {
  var out: MeoFile = { handle: (int64)code, is_open: false };
  return out;
}

// Map a negative syscall result to the only three codes the platform layer is
// allowed to expose. Exhausted descriptors count as NOMEM (the resource is
// allocated), a malformed request or a dead descriptor is USAGE (bad argument
// / bad state), and the kernel refusing to do the work is IO.
fn meo_file_err(rc: int64) -> int32 {
  var e: int64 = 0 - rc;
  if (e == MEO_E_NOMEM || e == MEO_E_MFILE || e == MEO_E_NFILE) {
    return -MEO_ERR_NOMEM;
  }
  if (e == MEO_E_BADF || e == MEO_E_INVAL || e == MEO_E_FAULT || e == MEO_E_ISDIR
      || e == MEO_E_NAMETOOLONG) {
    return -MEO_ERR_USAGE;
  }
  return -MEO_ERR_IO;
}

// A NUL-terminated copy of a Mettle string, for the kernel. The length is
// bytes, not characters; the string is a borrowed view with no terminator
// guarantee, so it is copied rather than passed through.
fn meo_file_cpath(path: string) -> cstring {
  var n: int64 = (int64)path.length;
  var out: cstring = malloc(n + 1);
  if (out == 0) { return 0; }
  var i: int64 = 0;
  while (i < n) {
    out[i] = path.chars[i];
    i = i + 1;
  }
  out[n] = 0;
  return out;
}

export fn meo_file_open(path: string, flags: int32) -> MeoFile {
  var can_read: bool = (flags & MEO_OPEN_READ) != 0;
  var can_write: bool = (flags & MEO_OPEN_WRITE) != 0;
  if ((int64)path.length <= 0) { return meo_file_failed(-MEO_ERR_USAGE); }
  if (!can_read && !can_write) { return meo_file_failed(-MEO_ERR_USAGE); }

  var oflags: int64 = 0;
  if (can_read && can_write) {
    oflags = MEO_O_RDWR;
  } else if (can_write) {
    oflags = MEO_O_WRONLY;
  }
  // MEO_OPEN_CREATE never truncates: reopening an existing database must not
  // erase it. A caller that wants an empty file truncates explicitly.
  if ((flags & MEO_OPEN_CREATE) != 0) { oflags = oflags | MEO_O_CREAT; }
  if ((flags & MEO_OPEN_EXCL) != 0) { oflags = oflags | MEO_O_EXCL; }

  var cpath: cstring = meo_file_cpath(path);
  if (cpath == 0) { return meo_file_failed(-MEO_ERR_NOMEM); }
  var fd: int64 = syscall(MEO_SYS_OPEN, cpath, oflags, MEO_O_MODE);
  free(cpath);
  if (fd < 0) { return meo_file_failed(meo_file_err(fd)); }
  var out: MeoFile = { handle: fd, is_open: true };
  return out;
}

export fn meo_file_close(f: MeoFile) -> int32 {
  if (!f.is_open) { return MEO_OK; }
  var rc: int64 = syscall(MEO_SYS_CLOSE, f.handle);
  if (rc < 0) {
    // A MeoFile is a value; closing it cannot mark the caller's copy. So a
    // second close of the same value reaches the kernel as EBADF, and that is
    // precisely the already-closed case, which is MEO_OK. A caller that changes
    // the file's identity (a reused descriptor) must not keep a stale handle.
    var e: int64 = 0 - rc;
    if (e == MEO_E_BADF) { return MEO_OK; }
    return meo_file_err(rc);
  }
  return MEO_OK;
}

export fn meo_file_read_at(f: MeoFile, off: int64, buf: uint8*, len: int64) -> int32 {
  if (!f.is_open || f.handle < 0) { return -MEO_ERR_USAGE; }
  if (off < 0 || len < 0) { return -MEO_ERR_USAGE; }
  if (len > MEO_MAX_READ) { return -MEO_ERR_USAGE; }
  if (len == 0) { return 0; }
  if (buf == 0) { return -MEO_ERR_USAGE; }
  var rc: int64 = syscall(MEO_SYS_PREAD64, f.handle, (int64)buf, len, off);
  if (rc < 0) { return meo_file_err(rc); }
  if (rc > len) { return -MEO_ERR_IO; }
  return (int32)rc;
}

export fn meo_file_write_at(f: MeoFile, off: int64, buf: uint8*, len: int64) -> int32 {
  if (!f.is_open || f.handle < 0) { return -MEO_ERR_USAGE; }
  if (off < 0 || len < 0) { return -MEO_ERR_USAGE; }
  if (len == 0) { return MEO_OK; }
  if (buf == 0) { return -MEO_ERR_USAGE; }
  var rc: int64 = syscall(MEO_SYS_PWRITE64, f.handle, (int64)buf, len, off);
  if (rc < 0) { return meo_file_err(rc); }
  // A short write means the file system is lying. Report failure, never success.
  if (rc != len) { return -MEO_ERR_IO; }
  return MEO_OK;
}

export fn meo_file_sync(f: MeoFile) -> int32 {
  if (!f.is_open || f.handle < 0) { return -MEO_ERR_USAGE; }
  var rc: int64 = syscall(MEO_SYS_FSYNC, f.handle);
  if (rc < 0) { return meo_file_err(rc); }
  return MEO_OK;
}

// The size is the offset at end-of-file. The seek offset is saved and restored
// so this stays a query even for a backend that shares the descriptor.
export fn meo_file_size(f: MeoFile) -> int64 {
  if (!f.is_open || f.handle < 0) { return (int64)(0 - MEO_ERR_USAGE); }
  var saved: int64 = syscall(MEO_SYS_LSEEK, f.handle, (int64)0, MEO_SEEK_CUR);
  var end: int64 = syscall(MEO_SYS_LSEEK, f.handle, (int64)0, MEO_SEEK_END);
  if (saved >= 0) { syscall(MEO_SYS_LSEEK, f.handle, saved, MEO_SEEK_SET); }
  if (end < 0) { return (int64)meo_file_err(end); }
  return end;
}

export fn meo_file_truncate(f: MeoFile, size: int64) -> int32 {
  if (!f.is_open || f.handle < 0) { return -MEO_ERR_USAGE; }
  if (size < 0) { return -MEO_ERR_USAGE; }
  var rc: int64 = syscall(MEO_SYS_FTRUNCATE, f.handle, size);
  if (rc < 0) { return meo_file_err(rc); }
  return MEO_OK;
}

// Take a whole-file lock without waiting: shared for readers, exclusive for a
// writer. A conflicting holder is -MEO_ERR_BUSY. flock locks belong to the open
// file description, so a second open in the same process is refused too. The
// lock lasts until the descriptor closes, so there is no unlock call.
export fn meo_file_lock(f: MeoFile, exclusive: bool) -> int32 {
  if (!f.is_open || f.handle < 0) { return -MEO_ERR_USAGE; }
  var op: int64 = MEO_LOCK_SH;
  if (exclusive) { op = MEO_LOCK_EX; }
  var rc: int64 = syscall(MEO_SYS_FLOCK, f.handle, op | MEO_LOCK_NB);
  if (rc < 0) {
    if (0 - rc == MEO_E_WOULDBLOCK) { return -MEO_ERR_BUSY; }
    return meo_file_err(rc);
  }
  return MEO_OK;
}

// The pager's atomic-replace path needs rename. Same contract and errno
// mapping as the other calls.
export fn meo_file_rename(from: string, to: string) -> int32 {
  if ((int64)from.length <= 0 || (int64)to.length <= 0) { return -MEO_ERR_USAGE; }
  var cfrom: cstring = meo_file_cpath(from);
  if (cfrom == 0) { return -MEO_ERR_NOMEM; }
  var cto: cstring = meo_file_cpath(to);
  if (cto == 0) {
    free(cfrom);
    return -MEO_ERR_NOMEM;
  }
  var rc: int64 = syscall(MEO_SYS_RENAME, cfrom, cto);
  free(cfrom);
  free(cto);
  if (rc < 0) { return meo_file_err(rc); }
  return MEO_OK;
}

// Remove a path. The journal is the only caller: it
// is the one way a journal file can delete itself. A missing path is
// -MEO_ERR_IO, which the caller decides whether to care about.
export fn meo_file_unlink(path: string) -> int32 {
  if ((int64)path.length <= 0) { return -MEO_ERR_USAGE; }
  var cpath: cstring = meo_file_cpath(path);
  if (cpath == 0) { return -MEO_ERR_NOMEM; }
  var rc: int64 = syscall(MEO_SYS_UNLINK, cpath);
  free(cpath);
  if (rc < 0) { return meo_file_err(rc); }
  return MEO_OK;
}
