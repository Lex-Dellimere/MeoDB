// sql/ast: the parsed form of one SQL statement, for exactly the D7 grammar.
//
//   CREATE TABLE [IF NOT EXISTS] name ( coldef {, coldef} )
//   INSERT INTO name [( name {, name} )] VALUES row {, row}
//   SELECT (* | name {, name}) FROM name [where] [ORDER BY name [ASC|DESC] {, ...}]
//          [LIMIT int] [OFFSET int]
//   UPDATE name SET name = operand {, name = operand} [where]
//   DELETE FROM name [where]
//   where   := WHERE term {AND term}
//   term    := name = operand | name IN ( operand {, operand} ) | name IS [NOT] NULL
//   operand := ? | int | real | 'string' | NULL
//
// sql/parser builds one MeoAst per statement; sql/plan resolves its names. The
// types are frozen here (WS0) so both sides compile against the same shape.
//
// Memory: every array is (pointer, count) allocated in the statement's
// mem/arena by the parser; nothing here owns or frees anything. An absent
// list has count 0 and may have a null pointer.
//
// Identifiers and text literals are a MeoAstName / MeoValue view (pointer,
// byte length). The view points INTO the statement's SQL bytes whenever the
// token needs no unescaping (the common case, no copy), and into an arena copy
// when it does ("x""y" -> x"y, 'it''s' -> it's). Quotes are never part of the
// view. Either way the bytes live exactly as long as the statement, so sql/plan
// and sql/exec may hold the views until finalize. `off` fields are byte
// offsets into the SQL text for error reporting (err_off).

import "../record/value.mettle";

// Statement kinds (MeoAst.kind).
export const MEO_AST_CREATE: int32 = 1;
export const MEO_AST_INSERT: int32 = 2;
export const MEO_AST_SELECT: int32 = 3;
export const MEO_AST_UPDATE: int32 = 4;
export const MEO_AST_DELETE: int32 = 5;

// Column-definition constraint bits (MeoAstColDef.cflags). Same values as
// catalog/schema MEO_COL_PK / NOT_NULL / UNIQUE, so plan may copy them; sql/ast
// cannot import catalog/ (D1), hence the second spelling. ROWID_ALIAS is
// decided by plan (INTEGER + PRIMARY KEY), never by the parser.
export const MEO_AST_C_PK: int32 = 1;
export const MEO_AST_C_NOT_NULL: int32 = 2;
export const MEO_AST_C_UNIQUE: int32 = 4;

// Operand kinds (MeoAstOperand.kind).
export const MEO_AST_OPND_PARAM: int32 = 1;    // `?`, number in `param`
export const MEO_AST_OPND_LITERAL: int32 = 2;  // value in `val`

// WHERE term kinds (MeoAstTerm.kind).
export const MEO_AST_T_EQ: int32 = 1;          // col = rhs
export const MEO_AST_T_IN: int32 = 2;          // col IN (list[0..n_list))
export const MEO_AST_T_IS_NULL: int32 = 3;     // col IS NULL
export const MEO_AST_T_NOT_NULL: int32 = 4;    // col IS NOT NULL

// An identifier as written, quotes removed (see the header for lifetime).
export struct MeoAstName {
  p: uint8*;
  n: int32;
  off: int32;
}

// One coldef of CREATE TABLE.
export struct MeoAstColDef {
  name: MeoAstName;
  affinity: int32;       // MEO_T_INT | MEO_T_REAL | MEO_T_TEXT | MEO_T_BLOB
  cflags: int32;         // MEO_AST_C_* bits
}

// `?` or a literal. For a literal, val.type is MEO_T_NULL, MEO_T_INT,
// MEO_T_REAL or MEO_T_TEXT (never BLOB: the grammar has no blob literal).
export struct MeoAstOperand {
  kind: int32;           // MEO_AST_OPND_*
  param: int32;          // PARAM only: 1-based, numbered left to right
  val: MeoValue;         // LITERAL only
  off: int32;
}

// One AND-ed WHERE term.
export struct MeoAstTerm {
  kind: int32;           // MEO_AST_T_*
  col: MeoAstName;
  rhs: MeoAstOperand;    // EQ only
  list: MeoAstOperand*;  // IN only, n_list >= 1
  n_list: int32;
}

// One ORDER BY item.
export struct MeoAstOrder {
  col: MeoAstName;
  desc: bool;            // false = ASC (the default)
}

// One UPDATE `col = operand`.
export struct MeoAstAssign {
  col: MeoAstName;
  val: MeoAstOperand;
}

// One parsed statement. Fields not used by `kind` are zero / empty.
export struct MeoAst {
  kind: int32;               // MEO_AST_*
  table: MeoAstName;         // every kind

  // CREATE
  if_not_exists: bool;
  cols: MeoAstColDef*;
  n_cols: int32;

  // INSERT column list, or SELECT column list. INSERT with no list and
  // SELECT * both have n_names = 0; select_star tells SELECT * apart.
  names: MeoAstName*;
  n_names: int32;
  select_star: bool;

  // INSERT VALUES: n_rows rows of row_width operands, row-major:
  // row r column c is values[r * row_width + c]. Every row has the same
  // width (the parser rejects ragged rows with -MEO_ERR_SQL).
  values: MeoAstOperand*;
  n_rows: int32;
  row_width: int32;

  // UPDATE SET
  sets: MeoAstAssign*;
  n_sets: int32;

  // WHERE (SELECT, UPDATE, DELETE); n_where = 0 means every row
  where_terms: MeoAstTerm*;
  n_where: int32;

  // SELECT ORDER BY / LIMIT / OFFSET
  order: MeoAstOrder*;
  n_order: int32;
  limit: int64;              // -1 = no LIMIT
  offset: int64;             // 0 = no OFFSET

  n_params: int32;           // number of `?` in the statement
}

// Zero a MeoAst and set the non-zero defaults (limit = -1).
export fn meo_ast_init(a: MeoAst*) {
  a->kind = 0;
  a->table.p = 0;
  a->table.n = 0;
  a->table.off = 0;
  a->if_not_exists = false;
  a->cols = 0;
  a->n_cols = 0;
  a->names = 0;
  a->n_names = 0;
  a->select_star = false;
  a->values = 0;
  a->n_rows = 0;
  a->row_width = 0;
  a->sets = 0;
  a->n_sets = 0;
  a->where_terms = 0;
  a->n_where = 0;
  a->order = 0;
  a->n_order = 0;
  a->limit = -1;
  a->offset = 0;
  a->n_params = 0;
}
