// sql/exec: MeoStmt and the run on first step, under the db lock (D7, D5).
// SELECT is materialized; later steps walk the buffer without the lock.
// Real: CREATE, INSERT, SELECT over FULL_SCAN.
// WS8: filters, point/index paths, sort, LIMIT, UPDATE, DELETE.

import "std/mem";
import "../error/status.mettle";
import "../format/bytes.mettle";
import "../record/value.mettle";
import "../mem/arena.mettle";
import "../catalog/schema.mettle";
import "../catalog/catalog.mettle";
import "../db/db.mettle";
import "../db/flags.mettle";
import "../table/table.mettle";
import "ast.mettle";
import "plan.mettle";

export const MEO_STMT_PREPARED: int32 = 0;
export const MEO_STMT_ROWS: int32 = 1;
export const MEO_STMT_DONE: int32 = 2;
export const MEO_STMT_ERROR: int32 = 3;

export struct MeoStmt {
  db: MeoDb*;
  sql: uint8*;            // owned copy of the SQL text (AST views point here)
  sql_len: int32;
  arena: MeoArena*;       // AST + plan; lives until finalize
  ast: MeoAst;
  plan: MeoPlan;

  binds: MeoValue*;       // n_binds slots; `?` number i is binds[i - 1]
  bind_buf: uint8**;      // per slot: owned copy of bound text/blob bytes
  bind_cap: int32*;       // per slot: bytes bind_buf[k] holds
  n_binds: int32;

  state: int32;           // MEO_STMT_*
  err: int32;             // the negative code while ERROR

  res: MeoValue*;         // n_rows * n_cols, row-major (malloc)
  res_cap: int32;         // rows res can hold
  res_arena: MeoArena*;   // result text/blob bytes
  n_rows: int32;
  n_cols: int32;
  cur: int32;             // current row while ROWS

  changes: int32;         // rows written by the last run (statement-scoped, D5)
  last_rowid: int64;      // last rowid inserted by the last run
}

// Room for one more result row.
fn exec_res_row(st: MeoStmt*) -> MeoValue* {
  if (st->n_rows == st->res_cap) {
    var nc: int32 = st->res_cap * 2;
    if (nc < 64) { nc = 64; }
    var w: int32 = st->n_cols;
    if (w < 1) { w = 1; }
    var nr: MeoValue* = (MeoValue*)malloc((int64)nc * (int64)w * (int64)sizeof(MeoValue));
    if (nr == 0) { return 0; }
    var i: int64 = 0;
    var used: int64 = (int64)st->n_rows * (int64)w;
    while (i < used) {
      nr[i] = st->res[i];
      i += 1;
    }
    if (st->res != 0) { free(st->res); }
    st->res = nr;
    st->res_cap = nc;
  }
  var r: MeoValue* = st->res + (int64)st->n_rows * (int64)st->n_cols;
  st->n_rows += 1;
  return r;
}

// Copy one decoded value into the result (bytes into res_arena, NUL-terminated).
fn exec_res_put(st: MeoStmt*, dst: MeoValue*, v: MeoValue*) -> int32 {
  dst[0] = v[0];
  if (v->type == MEO_T_TEXT || v->type == MEO_T_BLOB) {
    var q: uint8* = meo_arena_alloc(st->res_arena, (int64)v->n + 1);
    if (q == 0) { return -MEO_ERR_NOMEM; }
    meo_bytes_copy(q, v->p, (int64)v->n);
    q[v->n] = 0;
    dst->p = q;
  }
  return MEO_OK;
}

// The value an operand stands for: a binding (unbound = NULL) or the literal.
fn exec_operand(st: MeoStmt*, op: MeoAstOperand*, out: MeoValue*) {
  if (op->kind == MEO_AST_OPND_PARAM) {
    if (op->param >= 1 && op->param <= st->n_binds) {
      out[0] = st->binds[op->param - 1];
      return;
    }
    meo_value_set_null(out);
    return;
  }
  out[0] = op->val;
}

fn exec_create(st: MeoStmt*) -> int32 {
  var db: MeoDb* = st->db;
  var a: MeoAst* = &st->ast;
  if (meo_cat_find(db->cat, a->table.p, a->table.n) != 0) {
    if (a->if_not_exists) { return MEO_OK; }
    return -MEO_ERR_SQL;
  }
  var started: bool = false;
  var rc: int32 = meo_db_stmt_begin(db, &started);
  if (rc != MEO_OK) { return rc; }
  var t: MeoTable* = 0;
  rc = meo_cat_create_table(db->cat, a->table.p, a->table.n, st->plan.new_cols,
    st->plan.n_new_cols, &t);
  return meo_db_stmt_end(db, started, true, rc);
}

// Phase A over every row, then Phase B (D5): a check failure writes nothing.
fn exec_insert(st: MeoStmt*, t: MeoTable*) -> int32 {
  var db: MeoDb* = st->db;
  var a: MeoAst* = &st->ast;
  var nc: int32 = t->n_cols;
  var nr: int32 = a->n_rows;
  var rows: MeoValue* = (MeoValue*)malloc((int64)nr * (int64)nc * (int64)sizeof(MeoValue) + 1);
  var rowids: int64* = (int64*)malloc((int64)nr * 8 + 8);
  var tmp: MeoArena* = meo_arena_new(4096);
  if (rows == 0 || rowids == 0 || tmp == 0) {
    if (rows != 0) { free(rows); }
    if (rowids != 0) { free(rowids); }
    if (tmp != 0) { meo_arena_free(tmp); }
    return -MEO_ERR_NOMEM;
  }
  defer free(rows);
  defer free(rowids);
  defer meo_arena_free(tmp);
  var r: int32 = 0;
  while (r < nr) {
    var c: int32 = 0;
    while (c < nc) {
      var dst: MeoValue* = &rows[(int64)r * (int64)nc + (int64)c];
      var src: int32 = st->plan.col_src[c];
      if (src < 0) {
        meo_value_set_null(dst);
      } else {
        exec_operand(st, &a->values[r * a->row_width + src], dst);
      }
      c += 1;
    }
    r += 1;
  }
  var started: bool = false;
  var rc: int32 = meo_db_stmt_begin(db, &started);
  if (rc != MEO_OK) { return rc; }
  rc = meo_tbl_check_rows(db, t, rows, nr, nc, tmp, rowids);
  var wrote: bool = false;
  r = 0;
  while (r < nr && rc == MEO_OK) {
    wrote = true;
    rc = meo_tbl_write_row(db, t, &rows[(int64)r * (int64)nc], nc, rowids[r]);
    if (rc == MEO_OK) {
      st->changes += 1;
      st->last_rowid = rowids[r];
    }
    r += 1;
  }
  return meo_db_stmt_end(db, started, wrote, rc);
}

fn exec_select(st: MeoStmt*, t: MeoTable*) -> int32 {
  var db: MeoDb* = st->db;
  if (st->plan.access != MEO_PATH_FULL_SCAN) { return -MEO_ERR_UNSUPPORTED; }  // WS8
  var sc: MeoTblScan;
  var rc: int32 = meo_tbl_scan_open(db, t, &sc);
  if (rc != MEO_OK) { return rc; }
  var row: MeoTblRow;
  while (true) {
    rc = meo_tbl_scan_next(&sc, &row);
    if (rc != 0) { break; }
    // WS8: residual WHERE filter here.
    var dst: MeoValue* = exec_res_row(st);
    if (dst == 0) {
      rc = -MEO_ERR_NOMEM;
      break;
    }
    var i: int32 = 0;
    while (i < st->plan.n_out && rc == 0) {
      var v: MeoValue;
      rc = meo_tbl_row_get(t, &row, st->plan.out_cols[i], &v);
      if (rc == MEO_OK) { rc = exec_res_put(st, &dst[i], &v); }
      i += 1;
    }
    if (rc != 0) { break; }
  }
  meo_tbl_scan_close(&sc);
  if (rc < 0) { return rc; }
  // WS8: sort, OFFSET, LIMIT.
  return MEO_OK;
}

// Run the statement once (first step). Lock held for the whole run.
fn exec_run(st: MeoStmt*) -> int32 {
  var db: MeoDb* = st->db;
  var rc: int32 = meo_db_enter(db);
  if (rc != MEO_OK) { return rc; }
  st->changes = 0;
  st->last_rowid = 0;
  st->n_rows = 0;
  st->n_cols = st->plan.n_out;
  if (st->ast.kind == MEO_AST_CREATE) {
    rc = exec_create(st);
  } else {
    var t: MeoTable* = meo_cat_get(db->cat, st->plan.table_id);
    if (t == 0 || !t->live || t != st->plan.t) {
      rc = -MEO_ERR_SQL;    // the table is gone (rollback): re-prepare
    } else if (st->ast.kind == MEO_AST_INSERT) {
      rc = exec_insert(st, t);
    } else if (st->ast.kind == MEO_AST_SELECT) {
      rc = exec_select(st, t);
    } else {
      rc = -MEO_ERR_UNSUPPORTED;   // WS8: UPDATE, DELETE
    }
  }
  meo_db_leave(db);
  return rc;
}

// One step (see the header). MEO_ROW, MEO_DONE or a negative code.
export fn meo_exec_step(st: MeoStmt*) -> int32 {
  if (st == 0) { return -MEO_ERR_USAGE; }
  if (st->state == MEO_STMT_DONE) { return MEO_DONE; }
  if (st->state == MEO_STMT_ERROR) { return st->err; }
  if (st->state == MEO_STMT_PREPARED) {
    var rc: int32 = exec_run(st);
    if (rc < 0) {
      st->state = MEO_STMT_ERROR;
      st->err = rc;
      return rc;
    }
    st->cur = 0;
  } else {
    st->cur += 1;
  }
  if (st->cur < st->n_rows) {
    st->state = MEO_STMT_ROWS;
    return MEO_ROW;
  }
  st->state = MEO_STMT_DONE;
  return MEO_DONE;
}

// Back to PREPARED; bindings kept, the result dropped.
export fn meo_exec_reset(st: MeoStmt*) -> int32 {
  if (st == 0) { return -MEO_ERR_USAGE; }
  st->state = MEO_STMT_PREPARED;
  st->err = MEO_OK;
  st->n_rows = 0;
  st->cur = 0;
  if (st->res_arena != 0) { meo_arena_reset(st->res_arena); }
  return MEO_OK;
}

// The current row's column i, or 0 when there is no such cell.
export fn meo_exec_cell(st: MeoStmt*, i: int32) -> MeoValue* {
  if (st == 0 || st->state != MEO_STMT_ROWS) { return 0; }
  if (i < 0 || i >= st->n_cols) { return 0; }
  return st->res + (int64)st->cur * (int64)st->n_cols + (int64)i;
}
