// sql/parser: one statement -> MeoAst in the statement arena. Recursive
// descent over the grammar in sql/ast, one function per statement.

import "../error/status.mettle";
import "../record/value.mettle";
import "../mem/arena.mettle";
import "lexer.mettle";
import "ast.mettle";

struct PrsState {
  lx: MeoLexer;
  tok: MeoToken;
  arena: MeoArena*;
  ast: MeoAst*;
  err_off: int32*;
}

fn prs_fail(ps: PrsState*, code: int32) -> int32 {
  ps->err_off[0] = ps->tok.off;
  return code;
}

fn prs_advance(ps: PrsState*) -> int32 {
  var rc: int32 = meo_lex_next(&ps->lx, &ps->tok);
  if (rc != MEO_OK) {
    ps->err_off[0] = ps->tok.off;
    return rc;
  }
  return MEO_OK;
}

fn prs_is(ps: PrsState*, kw: string) -> bool {
  return meo_lex_kw(&ps->lx, &ps->tok, kw);
}

// Consume keyword `kw` or fail with -MEO_ERR_SQL.
fn prs_expect_kw(ps: PrsState*, kw: string) -> int32 {
  if (!prs_is(ps, kw)) { return prs_fail(ps, -MEO_ERR_SQL); }
  return prs_advance(ps);
}

fn prs_expect(ps: PrsState*, kind: int32) -> int32 {
  if (ps->tok.kind != kind) { return prs_fail(ps, -MEO_ERR_SQL); }
  return prs_advance(ps);
}

// Grow an arena array of `elem`-byte items when n == *cap: a new block of
// twice the size, the old bytes copied (the old block stays in the arena).
fn prs_grow(ps: PrsState*, p: uint8*, n: int32, cap: int32*, elem: int64) -> uint8* {
  if (p != 0 && n < cap[0]) { return p; }
  var nc: int32 = cap[0] * 2;
  if (nc < 4) { nc = 4; }
  var q: uint8* = meo_arena_alloc_zeroed(ps->arena, (int64)nc * elem);
  if (q == 0) { return 0; }
  var i: int64 = 0;
  var used: int64 = (int64)n * elem;
  while (i < used) {
    q[i] = p[i];
    i += 1;
  }
  cap[0] = nc;
  return q;
}

// The body of a quoted token without its quotes, a doubled quote collapsed.
// No copy unless an escape is present.
fn prs_unquote(ps: PrsState*, out_p: uint8**, out_n: int32*) -> int32 {
  var src: uint8* = ps->lx.src + ps->tok.off + 1;
  var n: int32 = ps->tok.len - 2;
  var q: uint8 = ps->lx.src[ps->tok.off];
  var esc: bool = false;
  var i: int32 = 0;
  while (i < n) {
    if (src[i] == q) { esc = true; }
    i += 1;
  }
  if (!esc) {
    out_p[0] = src;
    out_n[0] = n;
    return MEO_OK;
  }
  var d: uint8* = meo_arena_alloc(ps->arena, (int64)n + 1);
  if (d == 0) { return -MEO_ERR_NOMEM; }
  var j: int32 = 0;
  i = 0;
  while (i < n) {
    d[j] = src[i];
    j += 1;
    if (src[i] == q) { i += 2; } else { i += 1; }
  }
  out_p[0] = d;
  out_n[0] = j;
  return MEO_OK;
}

// Words that end or shape a clause; a bare one is never a name, so
// `SELECT FROM t` fails at FROM rather than at t.
fn prs_reserved(ps: PrsState*) -> bool {
  return prs_is(ps, "SELECT") || prs_is(ps, "FROM") || prs_is(ps, "WHERE")
    || prs_is(ps, "AND") || prs_is(ps, "OR") || prs_is(ps, "ORDER") || prs_is(ps, "BY")
    || prs_is(ps, "LIMIT") || prs_is(ps, "OFFSET") || prs_is(ps, "INSERT")
    || prs_is(ps, "INTO") || prs_is(ps, "VALUES") || prs_is(ps, "UPDATE")
    || prs_is(ps, "SET") || prs_is(ps, "DELETE") || prs_is(ps, "CREATE")
    || prs_is(ps, "TABLE") || prs_is(ps, "NULL") || prs_is(ps, "NOT")
    || prs_is(ps, "IS") || prs_is(ps, "IN") || prs_is(ps, "JOIN")
    || prs_is(ps, "LEFT") || prs_is(ps, "ON");
}

// name := IDENT | "QUOTED"
fn prs_name(ps: PrsState*, out: MeoAstName*) -> int32 {
  out->off = ps->tok.off;
  if (ps->tok.kind == MEO_TK_IDENT) {
    if (prs_reserved(ps)) { return prs_fail(ps, -MEO_ERR_SQL); }
    out->p = ps->lx.src + ps->tok.off;
    out->n = ps->tok.len;
  } else if (ps->tok.kind == MEO_TK_QIDENT) {
    var rc: int32 = prs_unquote(ps, &out->p, &out->n);
    if (rc != MEO_OK) { return rc; }
  } else {
    return prs_fail(ps, -MEO_ERR_SQL);
  }
  return prs_advance(ps);
}

// Decimal digits of the current token as an unsigned magnitude; false on
// overflow past 2^63.
fn prs_digits(ps: PrsState*, start: int32, end: int32, out: uint64*) -> bool {
  var v: uint64 = 0;
  var lim: uint64 = (uint64)1 << 63;
  var i: int32 = start;
  while (i < end) {
    var d: uint64 = (uint64)(ps->lx.src[i] - (uint8)48);
    if (v > (lim - d) / (uint64)10) { return false; }
    v = v * (uint64)10 + d;
    i += 1;
  }
  out[0] = v;
  return true;
}

// digits.digits -> float64. Up to 18 digits and 22 fraction digits it is one
// exact integer divided by an exact power of ten, so correctly rounded; longer
// literals take the digit loop and may be an ulp off.
fn prs_real(ps: PrsState*, s: int32, e: int32, neg: bool) -> float64 {
  var mant: uint64 = 0;
  var nd: int32 = 0;
  var nf: int32 = 0;
  var frac: bool = false;
  var i: int32 = s;
  while (i < e) {
    var c: uint8 = ps->lx.src[i];
    if (c == (uint8)46) {
      frac = true;
    } else {
      if (nd < 18) { mant = mant * (uint64)10 + (uint64)(c - (uint8)48); }
      nd += 1;
      if (frac) { nf += 1; }
    }
    i += 1;
  }
  var f: float64 = 0.0;
  if (nd <= 18 && nf <= 22) {
    var p10: float64 = 1.0;
    var k: int32 = 0;
    while (k < nf) {
      p10 = p10 * 10.0;
      k += 1;
    }
    f = (float64)mant / p10;
  } else {
    var scale: float64 = 1.0;
    frac = false;
    i = s;
    while (i < e) {
      var d: uint8 = ps->lx.src[i];
      if (d == (uint8)46) {
        frac = true;
      } else {
        f = f * 10.0 + (float64)(int32)(d - (uint8)48);
        if (frac) { scale = scale * 10.0; }
      }
      i += 1;
    }
    f = f / scale;
  }
  if (neg) { f = 0.0 - f; }
  return f;
}

// A numeric literal token (INT or REAL), negated when `neg`.
fn prs_number(ps: PrsState*, neg: bool, out: MeoValue*) -> int32 {
  var s: int32 = ps->tok.off;
  var e: int32 = s + ps->tok.len;
  if (ps->tok.kind == MEO_TK_INT) {
    var u: uint64 = 0;
    if (!prs_digits(ps, s, e, &u)) { return prs_fail(ps, -MEO_ERR_SQL); }
    var lim: uint64 = (uint64)1 << 63;
    if (!neg && u == lim) { return prs_fail(ps, -MEO_ERR_SQL); }
    var v: int64 = (int64)u;
    if (neg) { v = (int64)((uint64)0 - u); }
    meo_value_set_int(out, v);
    return prs_advance(ps);
  }
  if (ps->tok.kind == MEO_TK_REAL) {
    meo_value_set_real(out, prs_real(ps, s, e, neg));
    return prs_advance(ps);
  }
  return prs_fail(ps, -MEO_ERR_SQL);
}

// operand := ? | int | real | -int | -real | 'string' | NULL
fn prs_operand(ps: PrsState*, out: MeoAstOperand*) -> int32 {
  out->off = ps->tok.off;
  out->param = 0;
  meo_value_set_null(&out->val);
  if (ps->tok.kind == MEO_TK_PARAM) {
    out->kind = MEO_AST_OPND_PARAM;
    ps->ast->n_params += 1;
    out->param = ps->ast->n_params;
    return prs_advance(ps);
  }
  out->kind = MEO_AST_OPND_LITERAL;
  if (ps->tok.kind == MEO_TK_MINUS) {
    var rc: int32 = prs_advance(ps);
    if (rc != MEO_OK) { return rc; }
    return prs_number(ps, true, &out->val);
  }
  if (ps->tok.kind == MEO_TK_INT || ps->tok.kind == MEO_TK_REAL) {
    return prs_number(ps, false, &out->val);
  }
  if (ps->tok.kind == MEO_TK_STRING) {
    var p: uint8* = 0;
    var n: int32 = 0;
    var rc2: int32 = prs_unquote(ps, &p, &n);
    if (rc2 != MEO_OK) { return rc2; }
    meo_value_set_text(&out->val, p, n);
    return prs_advance(ps);
  }
  if (prs_is(ps, "NULL")) { return prs_advance(ps); }
  return prs_fail(ps, -MEO_ERR_SQL);
}

// name {, name} -> ast->names / n_names
fn prs_name_list(ps: PrsState*) -> int32 {
  var cap: int32 = 0;
  while (true) {
    var g: uint8* = prs_grow(ps, (uint8*)ps->ast->names, ps->ast->n_names, &cap,
      (int64)sizeof(MeoAstName));
    if (g == 0) { return -MEO_ERR_NOMEM; }
    ps->ast->names = (MeoAstName*)g;
    var rc: int32 = prs_name(ps, &ps->ast->names[ps->ast->n_names]);
    if (rc != MEO_OK) { return rc; }
    ps->ast->n_names += 1;
    if (ps->tok.kind != MEO_TK_COMMA) { return MEO_OK; }
    rc = prs_advance(ps);
    if (rc != MEO_OK) { return rc; }
  }
  return MEO_OK;
}

// CREATE TABLE [IF NOT EXISTS] name ( coldef {, coldef} )
fn prs_create(ps: PrsState*) -> int32 {
  var a: MeoAst* = ps->ast;
  a->kind = MEO_AST_CREATE;
  var rc: int32 = prs_expect_kw(ps, "TABLE");
  if (rc != MEO_OK) { return rc; }
  if (prs_is(ps, "IF")) {
    rc = prs_advance(ps);
    if (rc == MEO_OK) { rc = prs_expect_kw(ps, "NOT"); }
    if (rc == MEO_OK) { rc = prs_expect_kw(ps, "EXISTS"); }
    if (rc != MEO_OK) { return rc; }
    a->if_not_exists = true;
  }
  rc = prs_name(ps, &a->table);
  if (rc == MEO_OK) { rc = prs_expect(ps, MEO_TK_LPAREN); }
  if (rc != MEO_OK) { return rc; }
  var cap: int32 = 0;
  while (true) {
    var g: uint8* = prs_grow(ps, (uint8*)a->cols, a->n_cols, &cap,
      (int64)sizeof(MeoAstColDef));
    if (g == 0) { return -MEO_ERR_NOMEM; }
    a->cols = (MeoAstColDef*)g;
    var cd: MeoAstColDef* = &a->cols[a->n_cols];
    rc = prs_name(ps, &cd->name);
    if (rc != MEO_OK) { return rc; }
    if (prs_is(ps, "INTEGER")) {
      cd->affinity = MEO_T_INT;
    } else if (prs_is(ps, "REAL")) {
      cd->affinity = MEO_T_REAL;
    } else if (prs_is(ps, "TEXT")) {
      cd->affinity = MEO_T_TEXT;
    } else if (prs_is(ps, "BLOB")) {
      cd->affinity = MEO_T_BLOB;
    } else {
      return prs_fail(ps, -MEO_ERR_SQL);
    }
    rc = prs_advance(ps);
    if (rc != MEO_OK) { return rc; }
    cd->cflags = 0;
    while (true) {
      if (prs_is(ps, "PRIMARY")) {
        rc = prs_advance(ps);
        if (rc == MEO_OK) { rc = prs_expect_kw(ps, "KEY"); }
        cd->cflags = cd->cflags | MEO_AST_C_PK;
      } else if (prs_is(ps, "NOT")) {
        rc = prs_advance(ps);
        if (rc == MEO_OK) { rc = prs_expect_kw(ps, "NULL"); }
        cd->cflags = cd->cflags | MEO_AST_C_NOT_NULL;
      } else if (prs_is(ps, "UNIQUE")) {
        rc = prs_advance(ps);
        cd->cflags = cd->cflags | MEO_AST_C_UNIQUE;
      } else {
        break;
      }
      if (rc != MEO_OK) { return rc; }
    }
    a->n_cols += 1;
    if (ps->tok.kind == MEO_TK_COMMA) {
      rc = prs_advance(ps);
      if (rc != MEO_OK) { return rc; }
    } else {
      break;
    }
  }
  return prs_expect(ps, MEO_TK_RPAREN);
}

// INSERT INTO name [( name {, name} )] VALUES row {, row}
fn prs_insert(ps: PrsState*) -> int32 {
  var a: MeoAst* = ps->ast;
  a->kind = MEO_AST_INSERT;
  var rc: int32 = prs_expect_kw(ps, "INTO");
  if (rc == MEO_OK) { rc = prs_name(ps, &a->table); }
  if (rc != MEO_OK) { return rc; }
  if (ps->tok.kind == MEO_TK_LPAREN) {
    rc = prs_advance(ps);
    if (rc == MEO_OK) { rc = prs_name_list(ps); }
    if (rc == MEO_OK) { rc = prs_expect(ps, MEO_TK_RPAREN); }
    if (rc != MEO_OK) { return rc; }
  }
  rc = prs_expect_kw(ps, "VALUES");
  if (rc != MEO_OK) { return rc; }
  var cap: int32 = 0;
  var total: int32 = 0;
  while (true) {
    var row_off: int32 = ps->tok.off;
    rc = prs_expect(ps, MEO_TK_LPAREN);
    if (rc != MEO_OK) { return rc; }
    var width: int32 = 0;
    while (true) {
      var g: uint8* = prs_grow(ps, (uint8*)a->values, total, &cap,
        (int64)sizeof(MeoAstOperand));
      if (g == 0) { return -MEO_ERR_NOMEM; }
      a->values = (MeoAstOperand*)g;
      rc = prs_operand(ps, &a->values[total]);
      if (rc != MEO_OK) { return rc; }
      total += 1;
      width += 1;
      if (ps->tok.kind != MEO_TK_COMMA) { break; }
      rc = prs_advance(ps);
      if (rc != MEO_OK) { return rc; }
    }
    rc = prs_expect(ps, MEO_TK_RPAREN);
    if (rc != MEO_OK) { return rc; }
    if (a->n_rows == 0) {
      a->row_width = width;
    } else if (width != a->row_width) {
      ps->err_off[0] = row_off;
      return -MEO_ERR_SQL;
    }
    if (a->n_names > 0 && width != a->n_names) {
      ps->err_off[0] = row_off;
      return -MEO_ERR_SQL;
    }
    a->n_rows += 1;
    if (ps->tok.kind != MEO_TK_COMMA) { break; }
    rc = prs_advance(ps);
    if (rc != MEO_OK) { return rc; }
  }
  return MEO_OK;
}

// IN ( operand {, operand} ) -> t->list / n_list
fn prs_in_list(ps: PrsState*, t: MeoAstTerm*) -> int32 {
  var rc: int32 = prs_expect(ps, MEO_TK_LPAREN);
  if (rc != MEO_OK) { return rc; }
  var cap: int32 = 0;
  while (true) {
    var g: uint8* = prs_grow(ps, (uint8*)t->list, t->n_list, &cap,
      (int64)sizeof(MeoAstOperand));
    if (g == 0) { return -MEO_ERR_NOMEM; }
    t->list = (MeoAstOperand*)g;
    rc = prs_operand(ps, &t->list[t->n_list]);
    if (rc != MEO_OK) { return rc; }
    t->n_list += 1;
    if (ps->tok.kind != MEO_TK_COMMA) { break; }
    rc = prs_advance(ps);
    if (rc != MEO_OK) { return rc; }
  }
  return prs_expect(ps, MEO_TK_RPAREN);
}

// term := name = operand | name IN ( ... ) | name IS [NOT] NULL
fn prs_term(ps: PrsState*, t: MeoAstTerm*) -> int32 {
  var rc: int32 = prs_name(ps, &t->col);
  if (rc != MEO_OK) { return rc; }
  if (ps->tok.kind == MEO_TK_EQ) {
    t->kind = MEO_AST_T_EQ;
    rc = prs_advance(ps);
    if (rc != MEO_OK) { return rc; }
    return prs_operand(ps, &t->rhs);
  }
  if (prs_is(ps, "IN")) {
    t->kind = MEO_AST_T_IN;
    rc = prs_advance(ps);
    if (rc != MEO_OK) { return rc; }
    return prs_in_list(ps, t);
  }
  if (prs_is(ps, "IS")) {
    t->kind = MEO_AST_T_IS_NULL;
    rc = prs_advance(ps);
    if (rc != MEO_OK) { return rc; }
    if (prs_is(ps, "NOT")) {
      t->kind = MEO_AST_T_NOT_NULL;
      rc = prs_advance(ps);
      if (rc != MEO_OK) { return rc; }
    }
    return prs_expect_kw(ps, "NULL");
  }
  // Valid SQL the term kinds cannot hold yet.
  if (ps->tok.kind == MEO_TK_CMP || prs_is(ps, "LIKE") || prs_is(ps, "BETWEEN")) {
    return prs_fail(ps, -MEO_ERR_UNSUPPORTED);
  }
  return prs_fail(ps, -MEO_ERR_SQL);
}

// [WHERE term {AND term}] -> ast->where_terms / n_where
fn prs_where(ps: PrsState*) -> int32 {
  if (!prs_is(ps, "WHERE")) { return MEO_OK; }
  var a: MeoAst* = ps->ast;
  var cap: int32 = 0;
  while (true) {
    var rc: int32 = prs_advance(ps);  // WHERE or AND
    if (rc != MEO_OK) { return rc; }
    var g: uint8* = prs_grow(ps, (uint8*)a->where_terms, a->n_where, &cap,
      (int64)sizeof(MeoAstTerm));
    if (g == 0) { return -MEO_ERR_NOMEM; }
    a->where_terms = (MeoAstTerm*)g;
    rc = prs_term(ps, &a->where_terms[a->n_where]);
    if (rc != MEO_OK) { return rc; }
    a->n_where += 1;
    if (!prs_is(ps, "AND")) { return MEO_OK; }
  }
  return MEO_OK;
}

// A non-negative integer literal (LIMIT / OFFSET).
fn prs_count(ps: PrsState*, out: int64*) -> int32 {
  if (ps->tok.kind != MEO_TK_INT) { return prs_fail(ps, -MEO_ERR_SQL); }
  var v: MeoValue;
  var rc: int32 = prs_number(ps, false, &v);
  if (rc != MEO_OK) { return rc; }
  out[0] = v.i;
  return MEO_OK;
}

// ORDER BY name [ASC|DESC] {, name [ASC|DESC]}
fn prs_order(ps: PrsState*) -> int32 {
  var a: MeoAst* = ps->ast;
  var rc: int32 = prs_advance(ps);
  if (rc == MEO_OK) { rc = prs_expect_kw(ps, "BY"); }
  if (rc != MEO_OK) { return rc; }
  var cap: int32 = 0;
  while (true) {
    var g: uint8* = prs_grow(ps, (uint8*)a->order, a->n_order, &cap,
      (int64)sizeof(MeoAstOrder));
    if (g == 0) { return -MEO_ERR_NOMEM; }
    a->order = (MeoAstOrder*)g;
    var o: MeoAstOrder* = &a->order[a->n_order];
    rc = prs_name(ps, &o->col);
    if (rc != MEO_OK) { return rc; }
    o->desc = false;
    if (prs_is(ps, "DESC")) {
      o->desc = true;
      rc = prs_advance(ps);
    } else if (prs_is(ps, "ASC")) {
      rc = prs_advance(ps);
    }
    if (rc != MEO_OK) { return rc; }
    a->n_order += 1;
    if (ps->tok.kind != MEO_TK_COMMA) { return MEO_OK; }
    rc = prs_advance(ps);
    if (rc != MEO_OK) { return rc; }
  }
  return MEO_OK;
}

// SELECT (* | name {, name}) FROM name [where] [ORDER BY ...] [LIMIT int]
//   [OFFSET int]
fn prs_select(ps: PrsState*) -> int32 {
  var a: MeoAst* = ps->ast;
  a->kind = MEO_AST_SELECT;
  var rc: int32 = MEO_OK;
  if (ps->tok.kind == MEO_TK_STAR) {
    a->select_star = true;
    rc = prs_advance(ps);
  } else {
    rc = prs_name_list(ps);
  }
  if (rc == MEO_OK) { rc = prs_expect_kw(ps, "FROM"); }
  if (rc == MEO_OK) { rc = prs_name(ps, &a->table); }
  if (rc != MEO_OK) { return rc; }
  if (prs_is(ps, "JOIN") || prs_is(ps, "LEFT") || prs_is(ps, "INNER")
      || prs_is(ps, "CROSS") || ps->tok.kind == MEO_TK_COMMA) {
    return prs_fail(ps, -MEO_ERR_UNSUPPORTED);
  }
  rc = prs_where(ps);
  if (rc != MEO_OK) { return rc; }
  if (prs_is(ps, "ORDER")) {
    rc = prs_order(ps);
    if (rc != MEO_OK) { return rc; }
  }
  if (prs_is(ps, "LIMIT")) {
    rc = prs_advance(ps);
    if (rc == MEO_OK) { rc = prs_count(ps, &a->limit); }
    if (rc != MEO_OK) { return rc; }
  }
  if (prs_is(ps, "OFFSET")) {
    rc = prs_advance(ps);
    if (rc == MEO_OK) { rc = prs_count(ps, &a->offset); }
    if (rc != MEO_OK) { return rc; }
  }
  return MEO_OK;
}

// UPDATE name SET name = operand {, name = operand} [where]
fn prs_update(ps: PrsState*) -> int32 {
  var a: MeoAst* = ps->ast;
  a->kind = MEO_AST_UPDATE;
  var rc: int32 = prs_name(ps, &a->table);
  if (rc == MEO_OK) { rc = prs_expect_kw(ps, "SET"); }
  if (rc != MEO_OK) { return rc; }
  var cap: int32 = 0;
  while (true) {
    var g: uint8* = prs_grow(ps, (uint8*)a->sets, a->n_sets, &cap,
      (int64)sizeof(MeoAstAssign));
    if (g == 0) { return -MEO_ERR_NOMEM; }
    a->sets = (MeoAstAssign*)g;
    var st: MeoAstAssign* = &a->sets[a->n_sets];
    rc = prs_name(ps, &st->col);
    if (rc == MEO_OK) { rc = prs_expect(ps, MEO_TK_EQ); }
    if (rc == MEO_OK) { rc = prs_operand(ps, &st->val); }
    if (rc != MEO_OK) { return rc; }
    a->n_sets += 1;
    if (ps->tok.kind != MEO_TK_COMMA) { break; }
    rc = prs_advance(ps);
    if (rc != MEO_OK) { return rc; }
  }
  return prs_where(ps);
}

// DELETE FROM name [where]
fn prs_delete(ps: PrsState*) -> int32 {
  var a: MeoAst* = ps->ast;
  a->kind = MEO_AST_DELETE;
  var rc: int32 = prs_expect_kw(ps, "FROM");
  if (rc == MEO_OK) { rc = prs_name(ps, &a->table); }
  if (rc != MEO_OK) { return rc; }
  return prs_where(ps);
}

// Parse exactly one statement of src[0..n) into *ast, allocating in `arena`.
// MEO_OK, -MEO_ERR_SQL (syntax; *err_off set), -MEO_ERR_UNSUPPORTED (valid but
// not supported; *err_off set), -MEO_ERR_NOMEM.
export fn meo_sql_parse(src: uint8*, n: int32, arena: MeoArena*, ast: MeoAst*,
    err_off: int32*) -> int32 {
  if (src == 0 || n < 0 || arena == 0 || ast == 0 || err_off == 0) {
    return -MEO_ERR_USAGE;
  }
  err_off[0] = 0;
  meo_ast_init(ast);
  var ps: PrsState;
  meo_lex_init(&ps.lx, src, n);
  ps.arena = arena;
  ps.ast = ast;
  ps.err_off = err_off;
  var rc: int32 = prs_advance(&ps);
  if (rc != MEO_OK) { return rc; }
  if (prs_is(&ps, "CREATE")) {
    rc = prs_advance(&ps);
    if (rc == MEO_OK) { rc = prs_create(&ps); }
  } else if (prs_is(&ps, "INSERT")) {
    rc = prs_advance(&ps);
    if (rc == MEO_OK) { rc = prs_insert(&ps); }
  } else if (prs_is(&ps, "SELECT")) {
    rc = prs_advance(&ps);
    if (rc == MEO_OK) { rc = prs_select(&ps); }
  } else if (prs_is(&ps, "UPDATE")) {
    rc = prs_advance(&ps);
    if (rc == MEO_OK) { rc = prs_update(&ps); }
  } else if (prs_is(&ps, "DELETE")) {
    rc = prs_advance(&ps);
    if (rc == MEO_OK) { rc = prs_delete(&ps); }
  } else {
    return prs_fail(&ps, -MEO_ERR_SQL);
  }
  if (rc != MEO_OK) { return rc; }
  if (ps.tok.kind == MEO_TK_SEMI) {
    rc = prs_advance(&ps);
    if (rc != MEO_OK) { return rc; }
  }
  if (ps.tok.kind != MEO_TK_EOF) { return prs_fail(&ps, -MEO_ERR_SQL); }
  return MEO_OK;
}
