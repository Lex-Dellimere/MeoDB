// query/plan: resolve a MeoQSpec against one MeoTable and pick the access
// path. Sees schemas only; the caller looks the table up under the db lock.
// Access path: an EQ on the rowid alias, else an EQ on a unique column, else
// an IN on the rowid alias, else an IN on a unique column, else a full scan.
// Every term is still re-checked on every row the path yields.

import "../error/status.mettle";
import "../record/value.mettle";
import "../mem/arena.mettle";
import "../catalog/schema.mettle";
import "spec.mettle";

export const MEO_PATH_FULL_SCAN: int32 = 1;
export const MEO_PATH_ROWID_EQ: int32 = 2;
export const MEO_PATH_ROWID_IN: int32 = 3;
export const MEO_PATH_UNIQUE_EQ: int32 = 4;
export const MEO_PATH_UNIQUE_IN: int32 = 5;

export struct MeoPlan {
  kind: int32;            // MEO_Q_K_*
  t: MeoTable*;           // resolved table; 0 for CREATE

  // CREATE: the columns for meo_cat_create_table; ADD COLUMN: the one new
  // column (arena; names point into the spec).
  new_cols: MeoColumn*;
  n_new_cols: int32;

  // INSERT: for table column c, col_src[c] is the cell index within one row,
  // or -1 (not listed: NULL). n_rows rows of `width` cells.
  col_src: int32*;
  n_rows: int32;
  width: int32;

  // SELECT: result column i is table column out_cols[i].
  out_cols: int32*;
  n_out: int32;

  // Filters (SELECT / UPDATE / DELETE): term_cols[k] = table column of term k.
  term_cols: int32*;
  access: int32;          // MEO_PATH_*
  access_term: int32;     // the term that drives a non-scan path, -1

  // ORDER BY: order_cols[k] = table column of item k. UPDATE: set_cols[k].
  order_cols: int32*;
  need_sort: bool;
  set_cols: int32*;
}

export fn meo_plan_init(pl: MeoPlan*) {
  pl->kind = 0;
  pl->t = 0;
  pl->new_cols = 0;
  pl->n_new_cols = 0;
  pl->col_src = 0;
  pl->n_rows = 0;
  pl->width = 0;
  pl->out_cols = 0;
  pl->n_out = 0;
  pl->term_cols = 0;
  pl->access = MEO_PATH_FULL_SCAN;
  pl->access_term = -1;
  pl->order_cols = 0;
  pl->need_sort = false;
  pl->set_cols = 0;
}

fn plan_name_eq(a: uint8*, an: int32, b: uint8*, bn: int32) -> bool {
  if (an != bn) { return false; }
  var i: int32 = 0;
  while (i < an) {
    var x: uint8 = a[i];
    var y: uint8 = b[i];
    if (x >= (uint8)65 && x <= (uint8)90) { x = x + (uint8)32; }
    if (y >= (uint8)65 && y <= (uint8)90) { y = y + (uint8)32; }
    if (x != y) { return false; }
    i += 1;
  }
  return true;
}

// Column index of `nm` in t, or -1.
export fn meo_plan_col(t: MeoTable*, nm: MeoQName*) -> int32 {
  var i: int32 = 0;
  while (i < t->n_cols) {
    if (plan_name_eq(t->columns[i].name, t->columns[i].name_len, nm->p, nm->n)) { return i; }
    i += 1;
  }
  return -1;
}

fn plan_ints(arena: MeoArena*, n: int32) -> int32* {
  var k: int32 = n;
  if (k < 1) { k = 1; }
  return (int32*)meo_arena_alloc_zeroed(arena, (int64)k * 4);
}

fn plan_create(s: MeoQSpec*, arena: MeoArena*, pl: MeoPlan*) -> int32 {
  if (s->n_cols < 1) { return -MEO_ERR_USAGE; }
  if (s->n_cols > MEO_MAX_COLS) { return -MEO_ERR_SCHEMA; }
  pl->new_cols = (MeoColumn*)meo_arena_alloc_zeroed(arena,
    (int64)s->n_cols * (int64)sizeof(MeoColumn));
  if (pl->new_cols == 0) { return -MEO_ERR_NOMEM; }
  var n_pk: int32 = 0;
  var i: int32 = 0;
  while (i < s->n_cols) {
    var cd: MeoQColDef* = &s->cols[i];
    var c: MeoColumn* = &pl->new_cols[i];
    c->name = cd->name.p;
    c->name_len = cd->name.n;
    c->affinity = cd->affinity;
    c->cflags = cd->cflags;
    c->index_root = 0;
    if ((cd->cflags & MEO_COL_PK) != 0) {
      n_pk += 1;
      if (cd->affinity == MEO_T_INT) {
        c->cflags = c->cflags | MEO_COL_ROWID_ALIAS;
      } else {
        c->cflags = c->cflags | MEO_COL_NOT_NULL;   // a non-rowid PK implies NOT NULL
      }
    }
    var j: int32 = 0;
    while (j < i) {
      if (plan_name_eq(pl->new_cols[j].name, pl->new_cols[j].name_len, c->name, c->name_len)) {
        return -MEO_ERR_SCHEMA;
      }
      j += 1;
    }
    i += 1;
  }
  if (n_pk > 1) { return -MEO_ERR_SCHEMA; }   // no composite keys in v1
  pl->n_new_cols = s->n_cols;
  return MEO_OK;
}

fn plan_add_column(s: MeoQSpec*, t: MeoTable*, arena: MeoArena*, pl: MeoPlan*) -> int32 {
  if (s->n_cols != 1) { return -MEO_ERR_USAGE; }
  var cd: MeoQColDef* = &s->cols[0];
  if (cd->cflags != 0) { return -MEO_ERR_UNSUPPORTED; }   // nullable, no index
  if (meo_plan_col(t, &cd->name) >= 0) { return -MEO_ERR_SCHEMA; }
  if (t->n_cols >= MEO_MAX_COLS) { return -MEO_ERR_USAGE; }
  pl->new_cols = (MeoColumn*)meo_arena_alloc_zeroed(arena, (int64)sizeof(MeoColumn));
  if (pl->new_cols == 0) { return -MEO_ERR_NOMEM; }
  pl->new_cols[0].name = cd->name.p;
  pl->new_cols[0].name_len = cd->name.n;
  pl->new_cols[0].affinity = cd->affinity;
  pl->new_cols[0].cflags = 0;
  pl->new_cols[0].index_root = 0;
  pl->n_new_cols = 1;
  return MEO_OK;
}

fn plan_insert(s: MeoQSpec*, t: MeoTable*, arena: MeoArena*, pl: MeoPlan*) -> int32 {
  var w: int32 = s->n_names;
  if (w == 0) { w = t->n_cols; }
  if (s->n_cells == 0 || s->n_cells % w != 0) { return -MEO_ERR_USAGE; }
  pl->width = w;
  pl->n_rows = s->n_cells / w;
  pl->col_src = plan_ints(arena, t->n_cols);
  if (pl->col_src == 0) { return -MEO_ERR_NOMEM; }
  var i: int32 = 0;
  if (s->n_names == 0) {
    while (i < t->n_cols) {
      pl->col_src[i] = i;
      i += 1;
    }
    return MEO_OK;
  }
  while (i < t->n_cols) {
    pl->col_src[i] = -1;
    i += 1;
  }
  i = 0;
  while (i < s->n_names) {
    var c: int32 = meo_plan_col(t, &s->names[i]);
    if (c < 0 || pl->col_src[c] >= 0) { return -MEO_ERR_SCHEMA; }   // unknown or repeated
    pl->col_src[c] = i;
    i += 1;
  }
  return MEO_OK;
}

// Resolve the filter columns and pick the access path.
fn plan_terms(s: MeoQSpec*, t: MeoTable*, arena: MeoArena*, pl: MeoPlan*) -> int32 {
  pl->term_cols = plan_ints(arena, s->n_terms);
  if (pl->term_cols == 0) { return -MEO_ERR_NOMEM; }
  var rank: int32 = 0;   // 4 rowid EQ, 3 unique EQ, 2 rowid IN, 1 unique IN
  var k: int32 = 0;
  while (k < s->n_terms) {
    var c: int32 = meo_plan_col(t, &s->terms[k].col);
    if (c < 0) { return -MEO_ERR_SCHEMA; }
    pl->term_cols[k] = c;
    var kind: int32 = s->terms[k].kind;
    var alias: bool = (t->columns[c].cflags & MEO_COL_ROWID_ALIAS) != 0;
    var uniq: bool = !alias && (t->columns[c].cflags & (MEO_COL_UNIQUE | MEO_COL_PK)) != 0;
    var r: int32 = 0;
    var path: int32 = MEO_PATH_FULL_SCAN;
    if (kind == MEO_Q_EQ && alias) {
      r = 4;
      path = MEO_PATH_ROWID_EQ;
    } else if (kind == MEO_Q_EQ && uniq) {
      r = 3;
      path = MEO_PATH_UNIQUE_EQ;
    } else if (kind == MEO_Q_IN && alias) {
      r = 2;
      path = MEO_PATH_ROWID_IN;
    } else if (kind == MEO_Q_IN && uniq) {
      r = 1;
      path = MEO_PATH_UNIQUE_IN;
    }
    if (r > rank) {
      rank = r;
      pl->access = path;
      pl->access_term = k;
    }
    k += 1;
  }
  return MEO_OK;
}

fn plan_select(s: MeoQSpec*, t: MeoTable*, arena: MeoArena*, pl: MeoPlan*) -> int32 {
  var i: int32 = 0;
  if (s->n_names == 0) {
    pl->n_out = t->n_cols;
    pl->out_cols = plan_ints(arena, t->n_cols);
    if (pl->out_cols == 0) { return -MEO_ERR_NOMEM; }
    while (i < t->n_cols) {
      pl->out_cols[i] = i;
      i += 1;
    }
  } else {
    pl->n_out = s->n_names;
    pl->out_cols = plan_ints(arena, s->n_names);
    if (pl->out_cols == 0) { return -MEO_ERR_NOMEM; }
    while (i < s->n_names) {
      var c: int32 = meo_plan_col(t, &s->names[i]);
      if (c < 0) { return -MEO_ERR_SCHEMA; }
      pl->out_cols[i] = c;
      i += 1;
    }
  }
  var rc: int32 = plan_terms(s, t, arena, pl);
  if (rc != MEO_OK) { return rc; }
  pl->order_cols = plan_ints(arena, s->n_order);
  if (pl->order_cols == 0) { return -MEO_ERR_NOMEM; }
  i = 0;
  while (i < s->n_order) {
    var c: int32 = meo_plan_col(t, &s->order[i].col);
    if (c < 0) { return -MEO_ERR_SCHEMA; }
    pl->order_cols[i] = c;
    i += 1;
  }
  pl->need_sort = s->n_order > 0;
  // A scan already yields rowid order.
  if (s->n_order == 1 && !s->order[0].desc && pl->access == MEO_PATH_FULL_SCAN
      && (t->columns[pl->order_cols[0]].cflags & MEO_COL_ROWID_ALIAS) != 0) {
    pl->need_sort = false;
  }
  return MEO_OK;
}

fn plan_update(s: MeoQSpec*, t: MeoTable*, arena: MeoArena*, pl: MeoPlan*) -> int32 {
  pl->set_cols = plan_ints(arena, s->n_sets);
  if (pl->set_cols == 0) { return -MEO_ERR_NOMEM; }
  var i: int32 = 0;
  while (i < s->n_sets) {
    var c: int32 = meo_plan_col(t, &s->sets[i].col);
    if (c < 0) { return -MEO_ERR_SCHEMA; }
    var j: int32 = 0;
    while (j < i) {
      if (pl->set_cols[j] == c) { return -MEO_ERR_SCHEMA; }   // assigned twice
      j += 1;
    }
    pl->set_cols[i] = c;
    i += 1;
  }
  return plan_terms(s, t, arena, pl);
}

// Build the plan for `s` against table `t` (0 only for CREATE, or DROP of a
// missing table, which exec answers). MEO_OK,
// -MEO_ERR_SCHEMA (unknown table or column, bad definition), -MEO_ERR_USAGE
// (shape), -MEO_ERR_NOMEM.
export fn meo_plan_build(s: MeoQSpec*, t: MeoTable*, arena: MeoArena*, pl: MeoPlan*) -> int32 {
  if (s == 0 || arena == 0 || pl == 0) { return -MEO_ERR_USAGE; }
  meo_plan_init(pl);
  pl->kind = s->kind;
  if (s->kind == MEO_Q_K_CREATE) { return plan_create(s, arena, pl); }
  if (s->kind == MEO_Q_K_UPDATE && s->n_sets == 0) { return -MEO_ERR_USAGE; }
  if (s->kind == MEO_Q_K_DROP) {
    pl->t = t;
    return MEO_OK;
  }
  if (t == 0) { return -MEO_ERR_SCHEMA; }   // no such table
  pl->t = t;
  if (s->kind == MEO_Q_K_ADD_COLUMN) { return plan_add_column(s, t, arena, pl); }
  if (s->kind == MEO_Q_K_INSERT) { return plan_insert(s, t, arena, pl); }
  if (s->kind == MEO_Q_K_SELECT) { return plan_select(s, t, arena, pl); }
  if (s->kind == MEO_Q_K_UPDATE) { return plan_update(s, t, arena, pl); }
  if (s->kind == MEO_Q_K_COUNT) { pl->n_out = 1; }
  if (s->kind == MEO_Q_K_DELETE || s->kind == MEO_Q_K_COUNT) {
    return plan_terms(s, t, arena, pl);
  }
  return -MEO_ERR_USAGE;
}
