// query/query: the public meo_q_* interface. A query is built by calls, run by
// meo_q_step, and reused with meo_q_reset + meo_q_set_value.
//
// Builders copy every name and every text/blob byte, take no lock and read no
// catalog; names resolve at the first step. Every value a builder takes gets
// the next slot, 0-based, in call order. A builder used on the wrong kind,
// with a bad argument, or outside READY returns -MEO_ERR_USAGE and the error
// sticks: every later step returns it. A failed builder never half-adds.
// Column pointers are borrowed until the next step, reset or free; meo_q_cell
// pointers until reset or free.

import "std/mem";
import "std/thread";
import "../error/status.mettle";
import "../format/bytes.mettle";
import "../record/value.mettle";
import "../mem/arena.mettle";
import "../catalog/schema.mettle";
import "../db/db.mettle";
import "../db/flags.mettle";
import "../catalog/catalog.mettle";
import "../table/table.mettle";
import "spec.mettle";
import "plan.mettle";
import "exec.mettle";

fn q_release(q: MeoQuery*) {
  var i: int32 = 0;
  while (i < q->cap_vals) {
    if (q->val_buf[i] != 0) { free(q->val_buf[i]); }
    i += 1;
  }
  if (q->val_buf != 0) { free(q->val_buf); }
  if (q->val_cap != 0) { free(q->val_cap); }
  if (q->vals != 0) { free(q->vals); }
  if (q->res != 0) { free(q->res); }
  if (q->perm != 0) { free(q->perm); }
  if (q->res_arena != 0) { meo_arena_free(q->res_arena); }
  if (q->plan_arena != 0) { meo_arena_free(q->plan_arena); }
  meo_qspec_free(&q->spec);
  free(q);
}

fn q_new(db: MeoDb*, kind: int32, table: string, out: MeoQuery**) -> int32 {
  if (db == 0 || out == 0) { return -MEO_ERR_USAGE; }
  out[0] = 0;
  var q: MeoQuery* = new MeoQuery;
  if (q == 0) { return -MEO_ERR_NOMEM; }
  q->db = db;
  meo_qspec_init(&q->spec, kind);
  meo_plan_init(&q->plan);
  q->plan_arena = 0;
  q->vals = 0;
  q->val_buf = 0;
  q->val_cap = 0;
  q->n_vals = 0;
  q->cap_vals = 0;
  q->state = MEO_Q_READY;
  q->err = MEO_OK;
  q->sticky = MEO_OK;
  q->res = 0;
  q->res_cap = 0;
  q->res_w = 0;
  q->res_arena = 0;
  q->perm = 0;
  q->perm_cap = 0;
  q->use_perm = false;
  q->row0 = 0;
  q->n_rows = 0;
  q->n_cols = 0;
  q->cur = 0;
  q->changes = 0;
  q->last_rowid = 0;
  q->ticket = 0;
  q->defer_sync = false;
  var rc: int32 = meo_qspec_name(&q->spec.table, table);
  if (rc == MEO_OK) {
    q->plan_arena = meo_arena_new(4096);
    q->res_arena = meo_arena_new(65536);
    if (q->plan_arena == 0 || q->res_arena == 0) { rc = -MEO_ERR_NOMEM; }
  }
  if (rc != MEO_OK) {
    q_release(q);
    return rc;
  }
  // Atomic, not under the lock: builders never take it.
  atomic_inc_i32(&db->n_stmts);
  out[0] = q;
  return MEO_OK;
}

export fn meo_q_create(db: MeoDb*, table: string, out: MeoQuery**) -> int32 {
  return q_new(db, MEO_Q_K_CREATE, table, out);
}

export fn meo_q_insert(db: MeoDb*, table: string, out: MeoQuery**) -> int32 {
  return q_new(db, MEO_Q_K_INSERT, table, out);
}

export fn meo_q_select(db: MeoDb*, table: string, out: MeoQuery**) -> int32 {
  return q_new(db, MEO_Q_K_SELECT, table, out);
}

export fn meo_q_update(db: MeoDb*, table: string, out: MeoQuery**) -> int32 {
  return q_new(db, MEO_Q_K_UPDATE, table, out);
}

export fn meo_q_delete(db: MeoDb*, table: string, out: MeoQuery**) -> int32 {
  return q_new(db, MEO_Q_K_DELETE, table, out);
}

// Count the rows the filters accept: one row with one INTEGER column, then
// MEO_DONE. Counts while scanning, no rows are materialized.
export fn meo_q_count(db: MeoDb*, table: string, out: MeoQuery**) -> int32 {
  return q_new(db, MEO_Q_K_COUNT, table, out);
}

// Drop a table, its rows and its indexes. Missing -> -MEO_ERR_SCHEMA, or
// MEO_DONE with changes 0 after meo_q_if_not_exists (here: "if exists").
export fn meo_q_drop(db: MeoDb*, table: string, out: MeoQuery**) -> int32 {
  return q_new(db, MEO_Q_K_DROP, table, out);
}

// Add one column, given by exactly one meo_q_column_def: nullable, not PK,
// not UNIQUE (else -MEO_ERR_UNSUPPORTED). Existing rows read it as NULL.
export fn meo_q_add_column(db: MeoDb*, table: string, out: MeoQuery**) -> int32 {
  return q_new(db, MEO_Q_K_ADD_COLUMN, table, out);
}

fn q_new_index(db: MeoDb*, kind: int32, table: string, name: string, out: MeoQuery**) -> int32 {
  var rc: int32 = q_new(db, kind, table, out);
  if (rc != MEO_OK) { return rc; }
  rc = meo_qspec_name(&out[0]->spec.index, name);
  if (rc != MEO_OK) {
    meo_q_free(out[0]);
    out[0] = 0;
  }
  return rc;
}

// Create index `name` on one column of `table`, given by meo_q_index_column;
// meo_q_unique makes it a UNIQUE index, meo_q_if_not_exists a no-op when the
// name is taken. Existing rows are indexed in the same statement. Unknown
// table or column, a taken name, the rowid alias or a column that already has
// an index -> -MEO_ERR_SCHEMA; duplicate values under UNIQUE ->
// -MEO_ERR_CONFLICT; more than one column -> -MEO_ERR_UNSUPPORTED.
export fn meo_q_create_index(db: MeoDb*, table: string, name: string, out: MeoQuery**) -> int32 {
  return q_new_index(db, MEO_Q_K_CREATE_INDEX, table, name, out);
}

// Drop index `name` of `table`. Missing (or on another table) ->
// -MEO_ERR_SCHEMA, or MEO_DONE after meo_q_if_not_exists (here: "if
// exists"). Indexes from PRIMARY KEY / UNIQUE in CREATE TABLE have no name.
export fn meo_q_drop_index(db: MeoDb*, table: string, name: string, out: MeoQuery**) -> int32 {
  return q_new_index(db, MEO_Q_K_DROP_INDEX, table, name, out);
}

// --- builders ---------------------------------------------------------------

// Record a builder failure so the next step reports it.
fn q_fail(q: MeoQuery*, rc: int32) -> int32 {
  if (q->sticky == MEO_OK) { q->sticky = rc; }
  return rc;
}

// MEO_OK when a builder may run on q for one of the kinds a..b.
fn q_check(q: MeoQuery*, a: int32, b: int32) -> int32 {
  if (q->state != MEO_Q_READY) { return q_fail(q, -MEO_ERR_USAGE); }
  if (q->spec.kind < a || q->spec.kind > b) { return q_fail(q, -MEO_ERR_USAGE); }
  return MEO_OK;
}

// Filters apply to SELECT, UPDATE, DELETE and COUNT (kinds 3..6).
fn q_check_filter(q: MeoQuery*) -> int32 {
  return q_check(q, MEO_Q_K_SELECT, MEO_Q_K_COUNT);
}

fn q_check_value(q: MeoQuery*, v: MeoValue*) -> int32 {
  if (meo_value_check(v) != MEO_OK) { return q_fail(q, -MEO_ERR_USAGE); }
  return MEO_OK;
}

export fn meo_q_column_def(q: MeoQuery*, name: string, affinity: int32, cflags: int32) -> int32 {
  if (q == 0) { return -MEO_ERR_USAGE; }
  var rc: int32 = MEO_OK;
  if (q->spec.kind == MEO_Q_K_ADD_COLUMN) {
    rc = q_check(q, MEO_Q_K_ADD_COLUMN, MEO_Q_K_ADD_COLUMN);
  } else {
    rc = q_check(q, MEO_Q_K_CREATE, MEO_Q_K_CREATE);
  }
  if (rc != MEO_OK) { return rc; }
  var known: int32 = MEO_COL_PK | MEO_COL_NOT_NULL | MEO_COL_UNIQUE;
  if (!meo_schema_affinity_ok(affinity) || (cflags & ~known) != 0) {
    return q_fail(q, -MEO_ERR_USAGE);
  }
  var s: MeoQSpec* = &q->spec;
  var np: MeoQColDef* = meo_qspec_grow(s->cols, s->n_cols, &s->cap_cols, (int64)sizeof(MeoQColDef));
  if (np == 0) { return q_fail(q, -MEO_ERR_NOMEM); }
  s->cols = np;
  var cd: MeoQColDef* = &s->cols[s->n_cols];
  rc = meo_qspec_name(&cd->name, name);
  if (rc != MEO_OK) { return q_fail(q, rc); }
  cd->affinity = affinity;
  cd->cflags = cflags;
  s->n_cols += 1;
  return MEO_OK;
}

// CREATE, CREATE INDEX: if not exists. DROP, DROP INDEX: if exists.
export fn meo_q_if_not_exists(q: MeoQuery*) -> int32 {
  if (q == 0) { return -MEO_ERR_USAGE; }
  var k: int32 = q->spec.kind;
  var rc: int32 = MEO_OK;
  if (k == MEO_Q_K_DROP || k == MEO_Q_K_CREATE_INDEX || k == MEO_Q_K_DROP_INDEX) {
    rc = q_check(q, k, k);
  } else {
    rc = q_check(q, MEO_Q_K_CREATE, MEO_Q_K_CREATE);
  }
  if (rc != MEO_OK) { return rc; }
  q->spec.if_not_exists = true;
  return MEO_OK;
}

// CREATE INDEX: the indexed column. Indexes are single-column: a second call
// makes the step answer -MEO_ERR_UNSUPPORTED.
export fn meo_q_index_column(q: MeoQuery*, name: string) -> int32 {
  if (q == 0) { return -MEO_ERR_USAGE; }
  var rc: int32 = q_check(q, MEO_Q_K_CREATE_INDEX, MEO_Q_K_CREATE_INDEX);
  if (rc != MEO_OK) { return rc; }
  return q_add_name(q, name);
}

// CREATE INDEX: a UNIQUE index, a constraint on later writes too.
export fn meo_q_unique(q: MeoQuery*) -> int32 {
  if (q == 0) { return -MEO_ERR_USAGE; }
  var rc: int32 = q_check(q, MEO_Q_K_CREATE_INDEX, MEO_Q_K_CREATE_INDEX);
  if (rc != MEO_OK) { return rc; }
  q->spec.unique = true;
  return MEO_OK;
}

// One more INSERT column / SELECT result column.
fn q_add_name(q: MeoQuery*, name: string) -> int32 {
  var s: MeoQSpec* = &q->spec;
  var np: MeoQName* = meo_qspec_grow(s->names, s->n_names, &s->cap_names, (int64)sizeof(MeoQName));
  if (np == 0) { return q_fail(q, -MEO_ERR_NOMEM); }
  s->names = np;
  var rc: int32 = meo_qspec_name(&s->names[s->n_names], name);
  if (rc != MEO_OK) { return q_fail(q, rc); }
  s->n_names += 1;
  return MEO_OK;
}

export fn meo_q_into(q: MeoQuery*, name: string) -> int32 {
  if (q == 0) { return -MEO_ERR_USAGE; }
  var rc: int32 = q_check(q, MEO_Q_K_INSERT, MEO_Q_K_INSERT);
  if (rc != MEO_OK) { return rc; }
  return q_add_name(q, name);
}

export fn meo_q_value(q: MeoQuery*, v: MeoValue*) -> int32 {
  if (q == 0) { return -MEO_ERR_USAGE; }
  var rc: int32 = q_check(q, MEO_Q_K_INSERT, MEO_Q_K_INSERT);
  if (rc == MEO_OK) { rc = q_check_value(q, v); }
  if (rc != MEO_OK) { return rc; }
  var k: int32 = meo_exec_slots_add(q, v, 1);
  if (k < 0) { return q_fail(q, k); }
  // Only meo_q_value adds slots to an INSERT, so the cells stay contiguous.
  if (q->spec.n_cells == 0) { q->spec.cells_v0 = k; }
  q->spec.n_cells += 1;
  return MEO_OK;
}

export fn meo_q_pick(q: MeoQuery*, name: string) -> int32 {
  if (q == 0) { return -MEO_ERR_USAGE; }
  var rc: int32 = q_check(q, MEO_Q_K_SELECT, MEO_Q_K_SELECT);
  if (rc != MEO_OK) { return rc; }
  return q_add_name(q, name);
}

export fn meo_q_assign(q: MeoQuery*, name: string, v: MeoValue*) -> int32 {
  if (q == 0) { return -MEO_ERR_USAGE; }
  var rc: int32 = q_check(q, MEO_Q_K_UPDATE, MEO_Q_K_UPDATE);
  if (rc == MEO_OK) { rc = q_check_value(q, v); }
  if (rc != MEO_OK) { return rc; }
  var s: MeoQSpec* = &q->spec;
  var np: MeoQAssign* = meo_qspec_grow(s->sets, s->n_sets, &s->cap_sets, (int64)sizeof(MeoQAssign));
  if (np == 0) { return q_fail(q, -MEO_ERR_NOMEM); }
  s->sets = np;
  var a: MeoQAssign* = &s->sets[s->n_sets];
  rc = meo_qspec_name(&a->col, name);
  if (rc != MEO_OK) { return q_fail(q, rc); }
  var k: int32 = meo_exec_slots_add(q, v, 1);
  if (k < 0) {
    free(a->col.p);
    return q_fail(q, k);
  }
  a->v = k;
  a->add = false;
  a->delta = 0;
  s->n_sets += 1;
  return MEO_OK;
}

// UPDATE assignment col = col + delta for an INTEGER column. Takes no value
// slot. A row whose current value is not an INTEGER (NULL included) fails the
// run with -MEO_ERR_MISMATCH, an int64 overflow with -MEO_ERR_RANGE.
export fn meo_q_assign_add(q: MeoQuery*, name: string, delta: int64) -> int32 {
  if (q == 0) { return -MEO_ERR_USAGE; }
  var rc: int32 = q_check(q, MEO_Q_K_UPDATE, MEO_Q_K_UPDATE);
  if (rc != MEO_OK) { return rc; }
  var s: MeoQSpec* = &q->spec;
  var np: MeoQAssign* = meo_qspec_grow(s->sets, s->n_sets, &s->cap_sets, (int64)sizeof(MeoQAssign));
  if (np == 0) { return q_fail(q, -MEO_ERR_NOMEM); }
  s->sets = np;
  var a: MeoQAssign* = &s->sets[s->n_sets];
  rc = meo_qspec_name(&a->col, name);
  if (rc != MEO_OK) { return q_fail(q, rc); }
  a->v = -1;
  a->add = true;
  a->delta = delta;
  s->n_sets += 1;
  return MEO_OK;
}

// Append one filter term with n values (vals may be 0 when n == 0).
fn q_add_term(q: MeoQuery*, name: string, kind: int32, vals: MeoValue*, n: int32) -> int32 {
  var s: MeoQSpec* = &q->spec;
  var np: MeoQTerm* = meo_qspec_grow(s->terms, s->n_terms, &s->cap_terms, (int64)sizeof(MeoQTerm));
  if (np == 0) { return q_fail(q, -MEO_ERR_NOMEM); }
  s->terms = np;
  var tm: MeoQTerm* = &s->terms[s->n_terms];
  var rc: int32 = meo_qspec_name(&tm->col, name);
  if (rc != MEO_OK) { return q_fail(q, rc); }
  tm->kind = kind;
  tm->v0 = q->n_vals;
  tm->n_v = n;
  if (n > 0) {
    var k: int32 = meo_exec_slots_add(q, vals, n);
    if (k < 0) {
      free(tm->col.p);
      return q_fail(q, k);
    }
    tm->v0 = k;
  }
  s->n_terms += 1;
  return MEO_OK;
}

export fn meo_q_where(q: MeoQuery*, name: string, op: int32, v: MeoValue*) -> int32 {
  if (q == 0) { return -MEO_ERR_USAGE; }
  var rc: int32 = q_check_filter(q);
  if (rc == MEO_OK) { rc = q_check_value(q, v); }
  if (rc != MEO_OK) { return rc; }
  if (op != MEO_Q_EQ && op != MEO_Q_NE && (op < MEO_Q_LT || op > MEO_Q_GE)) {
    return q_fail(q, -MEO_ERR_USAGE);
  }
  return q_add_term(q, name, op, v, 1);
}

export fn meo_q_where_in(q: MeoQuery*, name: string, vals: MeoValue*, n: int32) -> int32 {
  if (q == 0) { return -MEO_ERR_USAGE; }
  var rc: int32 = q_check_filter(q);
  if (rc != MEO_OK) { return rc; }
  if (n < 1 || vals == 0) { return q_fail(q, -MEO_ERR_USAGE); }
  var i: int32 = 0;
  while (i < n) {
    rc = q_check_value(q, &vals[i]);
    if (rc != MEO_OK) { return rc; }
    i += 1;
  }
  return q_add_term(q, name, MEO_Q_IN, vals, n);
}

export fn meo_q_where_null(q: MeoQuery*, name: string) -> int32 {
  if (q == 0) { return -MEO_ERR_USAGE; }
  var rc: int32 = q_check_filter(q);
  if (rc != MEO_OK) { return rc; }
  return q_add_term(q, name, MEO_Q_IS_NULL, 0, 0);
}

export fn meo_q_where_not_null(q: MeoQuery*, name: string) -> int32 {
  if (q == 0) { return -MEO_ERR_USAGE; }
  var rc: int32 = q_check_filter(q);
  if (rc != MEO_OK) { return rc; }
  return q_add_term(q, name, MEO_Q_NOT_NULL, 0, 0);
}

export fn meo_q_order(q: MeoQuery*, name: string, desc: bool) -> int32 {
  if (q == 0) { return -MEO_ERR_USAGE; }
  var rc: int32 = q_check(q, MEO_Q_K_SELECT, MEO_Q_K_SELECT);
  if (rc != MEO_OK) { return rc; }
  var s: MeoQSpec* = &q->spec;
  var np: MeoQOrder* = meo_qspec_grow(s->order, s->n_order, &s->cap_order, (int64)sizeof(MeoQOrder));
  if (np == 0) { return q_fail(q, -MEO_ERR_NOMEM); }
  s->order = np;
  rc = meo_qspec_name(&s->order[s->n_order].col, name);
  if (rc != MEO_OK) { return q_fail(q, rc); }
  s->order[s->n_order].desc = desc;
  s->n_order += 1;
  return MEO_OK;
}

export fn meo_q_limit(q: MeoQuery*, n: int64) -> int32 {
  if (q == 0) { return -MEO_ERR_USAGE; }
  var rc: int32 = q_check(q, MEO_Q_K_SELECT, MEO_Q_K_SELECT);
  if (rc != MEO_OK) { return rc; }
  if (n < 0) { return q_fail(q, -MEO_ERR_USAGE); }
  q->spec.limit = n;
  return MEO_OK;
}

export fn meo_q_offset(q: MeoQuery*, n: int64) -> int32 {
  if (q == 0) { return -MEO_ERR_USAGE; }
  var rc: int32 = q_check(q, MEO_Q_K_SELECT, MEO_Q_K_SELECT);
  if (rc != MEO_OK) { return rc; }
  if (n < 0) { return q_fail(q, -MEO_ERR_USAGE); }
  q->spec.offset = n;
  return MEO_OK;
}

// --- values -----------------------------------------------------------------

export fn meo_q_n_values(q: MeoQuery*) -> int32 {
  if (q == 0) { return 0; }
  return q->n_vals;
}

// Replace slot `slot` with a copy of *v. Not while rows are being read.
export fn meo_q_set_value(q: MeoQuery*, slot: int32, v: MeoValue*) -> int32 {
  if (q == 0 || slot < 0 || slot >= q->n_vals) { return -MEO_ERR_USAGE; }
  if (q->state == MEO_Q_ROWS) { return -MEO_ERR_USAGE; }
  if (meo_value_check(v) != MEO_OK) { return -MEO_ERR_USAGE; }
  return meo_exec_slot_put(q, slot, v);
}

// --- run --------------------------------------------------------------------

export fn meo_q_step(q: MeoQuery*) -> int32 {
  return meo_exec_step(q);
}

export fn meo_q_changes(q: MeoQuery*) -> int32 {
  if (q == 0) { return 0; }
  return q->changes;
}

export fn meo_q_last_insert_rowid(q: MeoQuery*) -> int64 {
  if (q == 0) { return 0; }
  return q->last_rowid;
}

export fn meo_q_reset(q: MeoQuery*) -> int32 {
  return meo_exec_reset(q);
}

export fn meo_q_free(q: MeoQuery*) -> int32 {
  if (q == 0) { return MEO_OK; }
  // Atomic, not under the lock: free must never fail or block.
  atomic_dec_i32(&q->db->n_stmts);
  q_release(q);
  return MEO_OK;
}

// --- results ----------------------------------------------------------------

// Result columns of the last run (a SELECT), 0 before the first step.
export fn meo_q_column_count(q: MeoQuery*) -> int32 {
  if (q == 0) { return 0; }
  return q->n_cols;
}

// MEO_T_* of the current row's column i; MEO_T_NULL when there is none.
export fn meo_q_column_type(q: MeoQuery*, i: int32) -> int32 {
  var v: MeoValue* = meo_exec_cell(q, i);
  if (v == 0) { return MEO_T_NULL; }
  return v->type;
}

export fn meo_q_column_int64(q: MeoQuery*, i: int32) -> int64 {
  var v: MeoValue* = meo_exec_cell(q, i);
  if (v == 0) { return 0; }
  if (v->type == MEO_T_INT) { return v->i; }
  if (v->type == MEO_T_REAL) { return (int64)v->f; }
  return 0;
}

export fn meo_q_column_double(q: MeoQuery*, i: int32) -> float64 {
  var v: MeoValue* = meo_exec_cell(q, i);
  if (v == 0) { return 0.0; }
  if (v->type == MEO_T_REAL) { return v->f; }
  if (v->type == MEO_T_INT) { return (float64)v->i; }
  return 0.0;
}

// NUL-terminated bytes of a TEXT (or BLOB) cell, borrowed; 0 otherwise.
export fn meo_q_column_text(q: MeoQuery*, i: int32) -> uint8* {
  var v: MeoValue* = meo_exec_cell(q, i);
  if (v == 0) { return 0; }
  if (v->type == MEO_T_TEXT || v->type == MEO_T_BLOB) { return v->p; }
  return 0;
}

export fn meo_q_column_blob(q: MeoQuery*, i: int32) -> uint8* {
  return meo_q_column_text(q, i);
}

export fn meo_q_column_bytes(q: MeoQuery*, i: int32) -> int32 {
  var v: MeoValue* = meo_exec_cell(q, i);
  if (v == 0) { return 0; }
  if (v->type == MEO_T_TEXT || v->type == MEO_T_BLOB) { return v->n; }
  return 0;
}

// Copy the current row's cell into *out (out.p borrowed). -MEO_ERR_USAGE when
// not on a row.
export fn meo_q_column(q: MeoQuery*, i: int32, out: MeoValue*) -> int32 {
  if (out == 0) { return -MEO_ERR_USAGE; }
  var v: MeoValue* = meo_exec_cell(q, i);
  if (v == 0) { return -MEO_ERR_USAGE; }
  out[0] = v[0];
  return MEO_OK;
}

// Rows in the whole result, valid after the first step until reset or free.
export fn meo_q_row_count(q: MeoQuery*) -> int32 {
  if (q == 0) { return -MEO_ERR_USAGE; }
  if (q->state != MEO_Q_ROWS && q->state != MEO_Q_DONE) { return -MEO_ERR_USAGE; }
  return q->n_rows;
}

// Any cell of the result (out.p borrowed until reset or free).
export fn meo_q_cell(q: MeoQuery*, row: int32, col: int32, out: MeoValue*) -> int32 {
  if (out == 0) { return -MEO_ERR_USAGE; }
  var v: MeoValue* = meo_exec_cell_at(q, row, col);
  if (v == 0) { return -MEO_ERR_USAGE; }
  out[0] = v[0];
  return MEO_OK;
}

// --- streaming x/y scan -----------------------------------------------------

// One scan: the callbacks, the column positions and the x window.
struct QScan {
  fn_xy: fn(rawptr, float64, float64) -> int32 with alloc, syscall, asm;
  fn_xyg: fn(rawptr, int64, float64, float64) -> int32 with alloc, syscall, asm;
  ctx: rawptr;
  grouped: bool;
  xc: int32;
  yc: int32;
  gc: int32;
  lo: float64;
  hi: float64;
}

fn q_nan() -> float64 {
  var b: uint8[8];
  meo_put_u64le(&b[0], 0, (uint64)0x7FF8 << 48);
  return meo_get_f64le(&b[0], 0);
}

fn q_col(t: MeoTable*, name: string) -> int32 {
  var nm: MeoQName;
  nm.p = name.chars;
  nm.n = (int32)name.length;
  return meo_plan_col(t, &nm);
}

// One row: skipped unless x is a number inside the window (and the group an
// INTEGER), else handed to the callback. 0 to go on; a callback's nonzero
// answer or a negative code stops the scan.
fn q_scan_row(sc: QScan*, t: MeoTable*, row: MeoTblRow*) -> int32 {
  var v: MeoValue;
  var rc: int32 = meo_tbl_row_get(t, row, sc->xc, &v);
  if (rc != MEO_OK) { return rc; }
  var x: float64 = 0.0;
  if (v.type == MEO_T_INT) {
    x = (float64)v.i;
  } else if (v.type == MEO_T_REAL) {
    x = v.f;
  } else {
    return 0;
  }
  if (!(x >= sc->lo && x <= sc->hi)) { return 0; }
  var g: int64 = 0;
  if (sc->grouped) {
    rc = meo_tbl_row_get(t, row, sc->gc, &v);
    if (rc != MEO_OK) { return rc; }
    if (v.type != MEO_T_INT) { return 0; }
    g = v.i;
  }
  rc = meo_tbl_row_get(t, row, sc->yc, &v);
  if (rc != MEO_OK) { return rc; }
  var y: float64 = q_nan();
  if (v.type == MEO_T_INT) { y = (float64)v.i; }
  if (v.type == MEO_T_REAL) { y = v.f; }
  if (sc->grouped) { return sc->fn_xyg(sc->ctx, g, x, y); }
  return sc->fn_xy(sc->ctx, x, y);
}

// How a scan loop ended: the row step's stop code wins, then a cursor failure
// (rc < 0; 1 is the cursor's plain "done").
fn q_scan_end(rc: int32, st: int32) -> int32 {
  if (st != 0) { return st; }
  if (rc < 0) { return rc; }
  return MEO_OK;
}

// Rowid-alias x: rows arrive in x order.
fn q_scan_rowids(db: MeoDb*, t: MeoTable*, sc: QScan*) -> int32 {
  var lo: int64 = 0;
  var hi: int64 = 0;
  if (meo_tbl_real_bound(sc->lo, false, &lo) != MEO_OK) { return MEO_OK; }
  if (meo_tbl_real_bound(sc->hi, true, &hi) != MEO_OK) { return MEO_OK; }
  var cur: MeoTblScan;
  var rc: int32 = meo_tbl_scan_from(db, t, lo, &cur);
  if (rc != MEO_OK) { return rc; }
  var row: MeoTblRow;
  var st: int32 = 0;
  while (true) {
    rc = meo_tbl_scan_next(&cur, &row);
    if (rc != 0 || row.rowid > hi) { break; }
    st = q_scan_row(sc, t, &row);
    if (st != 0) { break; }
  }
  meo_tbl_scan_close(&cur);
  return q_scan_end(rc, st);
}

// Indexed x: rows arrive in x order.
fn q_scan_index(db: MeoDb*, t: MeoTable*, sc: QScan*) -> int32 {
  var buf: MeoTblBuf;
  meo_tbl_buf_init(&buf);
  defer meo_tbl_buf_free(&buf);
  var lo: MeoValue;
  var hi: MeoValue;
  meo_value_set_real(&lo, sc->lo);
  meo_value_set_real(&hi, sc->hi);
  var cur: MeoTblIdxScan;
  var rc: int32 = meo_tbl_idx_scan_open(db, t, sc->xc, &lo, &hi, &cur);
  if (rc != MEO_OK) { return rc; }
  var row: MeoTblRow;
  var st: int32 = 0;
  while (true) {
    var id: int64 = 0;
    rc = meo_tbl_idx_scan_next(&cur, &id);
    if (rc != 0) { break; }
    rc = meo_tbl_lookup_rowid(db, t, id, &buf, &row);
    if (rc == MEO_OK) {
      st = q_scan_row(sc, t, &row);
    } else if (rc == 1) {
      rc = MEO_OK;
    }
    if (rc < 0 || st != 0) { break; }
  }
  meo_tbl_idx_scan_close(&cur);
  return q_scan_end(rc, st);
}

// Unindexed x: every row, rowid order.
fn q_scan_full(db: MeoDb*, t: MeoTable*, sc: QScan*) -> int32 {
  var cur: MeoTblScan;
  var rc: int32 = meo_tbl_scan_open(db, t, &cur);
  if (rc != MEO_OK) { return rc; }
  var row: MeoTblRow;
  var st: int32 = 0;
  while (true) {
    rc = meo_tbl_scan_next(&cur, &row);
    if (rc != 0) { break; }
    st = q_scan_row(sc, t, &row);
    if (st != 0) { break; }
  }
  meo_tbl_scan_close(&cur);
  return q_scan_end(rc, st);
}

// The scan on `db`: the base handle under its lock, or a snapshot view with no
// lock. Columns resolve here, so an unknown table or column is -MEO_ERR_SCHEMA.
fn q_scan_locked(db: MeoDb*, table: string, x: string, y: string, group: string,
    sc: QScan*) -> int32 {
  var t: MeoTable* = meo_cat_find(db->cat, table.chars, (int32)table.length);
  if (t == 0) { return -MEO_ERR_SCHEMA; }
  sc->xc = q_col(t, x);
  sc->yc = q_col(t, y);
  sc->gc = 0;
  if (sc->grouped) { sc->gc = q_col(t, group); }
  if (sc->xc < 0 || sc->yc < 0 || sc->gc < 0) { return -MEO_ERR_SCHEMA; }
  if (!(sc->lo <= sc->hi)) { return MEO_OK; }   // empty, or a NaN bound
  var f: int32 = t->columns[sc->xc].cflags;
  var aff: int32 = t->columns[sc->xc].affinity;
  if (aff != MEO_T_INT && aff != MEO_T_REAL) { return MEO_OK; }   // no numeric x
  if ((f & MEO_COL_ROWID_ALIAS) != 0) { return q_scan_rowids(db, t, sc); }
  if (meo_tbl_col_has_index(t, sc->xc)) { return q_scan_index(db, t, sc); }
  return q_scan_full(db, t, sc);
}

// seq_out (may be 0) gets the commit_seq the scan read.
fn q_scan(db: MeoDb*, table: string, x: string, y: string, group: string, sc: QScan*,
    seq_out: uint64*) -> int32 {
  if (seq_out != 0) { seq_out[0] = 0; }
  // A snapshot view the caller owns: scan it as it stands.
  if (db->view_of != 0) {
    if (seq_out != 0) { seq_out[0] = meo_db_snap_commit_seq(db); }
    return q_scan_locked(db, table, x, y, group, sc);
  }
  // WAL mode, no lock held by this thread: scan a snapshot, never block on a
  // writer. A thread inside its own transaction scans its own writes.
  if (db->wal && !meo_lock_held(&db->lock)) {
    var v: MeoDb* = 0;
    var src: int32 = meo_db_snap_begin(db, &v);
    if (src != MEO_OK) { return src; }
    if (seq_out != 0) { seq_out[0] = meo_db_snap_commit_seq(v); }
    src = q_scan_locked(v, table, x, y, group, sc);
    var e: int32 = meo_db_snap_end(v);
    if (src >= 0 && e < 0) { src = e; }
    return src;
  }
  var rc: int32 = meo_db_enter(db);
  if (rc != MEO_OK) { return rc; }
  if (seq_out != 0) { seq_out[0] = meo_pager_commit_seq(db->pager); }
  rc = q_scan_locked(db, table, x, y, group, sc);
  meo_db_leave(db);
  return rc;
}

// Stream the (x, y) of every row of `table` with lo <= x <= hi to
// meo_scan_cb(ctx, x, y), without building a result. x must be an INTEGER or
// REAL column; a row whose x is NULL or not a number is skipped. INTEGER
// values (timestamps in microseconds, say) arrive as float64. A y that is NULL
// or not a number arrives as NaN, so a chart can draw a gap. Rows arrive in x
// order when x is the rowid alias or an indexed column (a range scan, so only
// the window is read); otherwise every row is read, in rowid order. A nonzero
// meo_scan_cb answer stops the scan and is returned. Else MEO_OK, or
// -MEO_ERR_SCHEMA (unknown table or column) or a storage code.
//
// The callback runs with a page pinned: keep it quick and do not call back
// into this db. In rollback mode it runs under the db lock; in WAL mode it
// runs on a snapshot, holding it (not the lock) for the whole scan. A db that
// is a snapshot view (meo_db_snap_begin) is scanned as it stands, no lock.
export fn meo_q_scan_xy(db: MeoDb*, table: string, x: string, y: string, lo: float64,
    hi: float64, meo_scan_cb: fn(rawptr, float64, float64) -> int32 with alloc, syscall, asm,
    ctx: rawptr) -> int32 {
  return meo_q_scan_xy_seq(db, table, x, y, lo, hi, meo_scan_cb, ctx, 0);
}

// meo_q_scan_xy that also reports, in *seq_out, the commit_seq the scan read:
// the snapshot's in WAL mode, the pager's under the lock otherwise (inside the
// caller's own transaction, the value as of its last commit).
export fn meo_q_scan_xy_seq(db: MeoDb*, table: string, x: string, y: string, lo: float64,
    hi: float64, meo_scan_cb: fn(rawptr, float64, float64) -> int32 with alloc, syscall, asm,
    ctx: rawptr, seq_out: uint64*) -> int32 {
  if (db == 0 || meo_scan_cb == 0) { return -MEO_ERR_USAGE; }
  var sc: QScan;
  sc.fn_xy = meo_scan_cb;
  sc.fn_xyg = 0;
  sc.ctx = ctx;
  sc.grouped = false;
  sc.lo = lo;
  sc.hi = hi;
  return q_scan(db, table, x, y, "", &sc, seq_out);
}

// meo_q_scan_xy with a grouping column: meo_scan_gcb(ctx, group, x, y). The
// group column must be INTEGER; a row whose group is NULL or not an INTEGER is
// skipped. Same order, locking and stop rules.
export fn meo_q_scan_xyg(db: MeoDb*, table: string, x: string, y: string, group: string,
    lo: float64, hi: float64,
    meo_scan_gcb: fn(rawptr, int64, float64, float64) -> int32 with alloc, syscall, asm,
    ctx: rawptr) -> int32 {
  return meo_q_scan_xyg_seq(db, table, x, y, group, lo, hi, meo_scan_gcb, ctx, 0);
}

// meo_q_scan_xyg that also reports the commit_seq the scan read, as
// meo_q_scan_xy_seq does.
export fn meo_q_scan_xyg_seq(db: MeoDb*, table: string, x: string, y: string,
    group: string, lo: float64, hi: float64,
    meo_scan_gcb: fn(rawptr, int64, float64, float64) -> int32 with alloc, syscall, asm,
    ctx: rawptr, seq_out: uint64*) -> int32 {
  if (db == 0 || meo_scan_gcb == 0) { return -MEO_ERR_USAGE; }
  var sc: QScan;
  sc.fn_xy = 0;
  sc.fn_xyg = meo_scan_gcb;
  sc.ctx = ctx;
  sc.grouped = true;
  sc.lo = lo;
  sc.hi = hi;
  return q_scan(db, table, x, y, group, &sc, seq_out);
}

// From now on a run of q does not wait for its WAL commit to become durable:
// meo_q_sync_ticket names the commit and the caller waits with
// meo_db_commit_wait. No effect in rollback mode, where the commit is synchronous.
export fn meo_q_defer_sync(q: MeoQuery*) -> int32 {
  if (q == 0) { return -MEO_ERR_USAGE; }
  q->defer_sync = true;
  return MEO_OK;
}

// The commit the last run appended and did not wait for, or 0: a read, rollback
// mode, a failure, or a query that is not deferred. The caller must
// meo_db_commit_wait on it before reporting success.
export fn meo_q_sync_ticket(q: MeoQuery*) -> uint64 {
  if (q == 0 || !q->defer_sync) { return 0; }
  return q->ticket;
}
