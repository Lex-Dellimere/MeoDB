// server/session: one client connection, shaped like an actor.
//
// The session's thread owns the socket for the connection's whole life. Each
// frame is a message, handled to completion; every ending goes through
// srv_session_exit, which rolls back an open transaction on this same thread
// (the lock owner) before the socket closes. A SUBSCRIBE turns the connection
// into a push stream (sub.mettle) that the same thread serves until
// UNSUBSCRIBE.

import "std/mem";
import "std/thread";
import "../error/status.mettle";
import "../mem/arena.mettle";
import "../db/db.mettle";
import "../db/flags.mettle";
import "../net/sock.mettle";
import "../wire/frame.mettle";
import "../wire/stmt.mettle";
import "../wire/msg.mettle";
import "conn.mettle";
import "exec.mettle";
import "sub.mettle";
import "scan.mettle";

const SRV_AUTH_DELAY_MS: uint32 = 200;

export fn meo_srv_session_new(srv: MeoSrv*, slot: int32, fd: int64, id: int64) -> MeoSrvSession* {
  var s: MeoSrvSession* = new MeoSrvSession;
  if (s == 0) { return 0; }
  s->id = id;
  s->srv = srv;
  s->slot = slot;
  s->fd = fd;
  s->state = MEO_SRV_S_HELLO;
  s->minor = 0;
  s->tx_start_ms = 0;
  s->peer_max = MEO_WIRE_MIN_FRAME;
  s->rbuf = 0;
  s->rcap = 0;
  meo_wbuf_init(&s->w, srv->cfg.max_frame);
  s->arena = meo_arena_new(4096);
  s->sub = 0;
  s->reason = MEO_SRV_EXIT_NORMAL;
  if (s->arena == 0) {
    free(s);
    return 0;
  }
  return s;
}

export fn meo_srv_session_free(s: MeoSrvSession*) {
  if (s == 0) { return; }
  meo_wbuf_free(&s->w);
  if (s->rbuf != 0) { free((rawptr)s->rbuf); }
  if (s->arena != 0) { meo_arena_free(s->arena); }
  free(s);
}

// Longer of the two lengths, so the time does not depend on where they differ.
fn srv_token_ok(srv: MeoSrv*, t: string) -> bool {
  var want: int32 = srv->cfg.token_n;
  var got: int32 = (int32)t.length;
  var n: int32 = want;
  if (got > n) { n = got; }
  var diff: int32 = 0;
  if (got != want) { diff = 1; }
  var i: int32 = 0;
  while (i < n) {
    var a: int32 = 0;
    var b: int32 = 0;
    if (i < want) { a = (int32)srv->cfg.token[i]; }
    if (i < got) { b = (int32)t.chars[i]; }
    diff = diff | (a ^ b);
    i += 1;
  }
  return diff == 0;
}

fn srv_on_hello(s: MeoSrvSession*, h: MeoWHdr*, r: MeoWRd*) -> int32 {
  var hello: MeoWHello;
  var rc: int32 = meo_wire_hello_get(r, &hello);
  if (rc == -MEO_ERR_VERSION) {
    return meo_srv_fatal(s, h->rid, MEO_ERR_VERSION, MEO_SRV_EXIT_CRASHED);
  }
  if (rc < 0) { return meo_srv_fatal(s, h->rid, MEO_ERR_PROTO, MEO_SRV_EXIT_CRASHED); }
  if (s->srv->cfg.token_n > 0 && !srv_token_ok(s->srv, hello.token)) {
    Sleep(SRV_AUTH_DELAY_MS);
    return meo_srv_fatal(s, h->rid, MEO_ERR_AUTH, MEO_SRV_EXIT_CRASHED);
  }
  s->peer_max = hello.max_frame;
  var ok: MeoWHelloOk;
  ok.major = MEO_WIRE_MAJOR;
  ok.minor = hello.minor;
  if (ok.minor > MEO_WIRE_MINOR) { ok.minor = MEO_WIRE_MINOR; }
  s->minor = ok.minor;
  ok.max_frame = s->srv->cfg.max_frame;
  ok.session = (uint64)s->id;
  ok.caps = MEO_SRV_CAPS;
  ok.name = "meodb 0.1.0";
  meo_wbuf_begin(&s->w);
  meo_wire_hello_ok_put(&s->w, &ok);
  rc = meo_srv_send(s, meo_wbuf_finish(&s->w, MEO_WIRE_K_HELLO_OK, h->rid));
  if (rc == MEO_OK) { meo_srv_set_state(s, MEO_SRV_S_READY); }
  return meo_srv_after(s, rc);
}

fn srv_on_query(s: MeoSrvSession*, h: MeoWHdr*, r: MeoWRd*) -> int32 {
  meo_arena_reset(s->arena);
  var st: MeoWStmt;
  var rc: int32 = meo_wire_stmt_get(r, s->arena, &st);
  if (rc == -MEO_ERR_NOMEM) { return meo_srv_after(s, meo_srv_reply_error(s, h->rid, MEO_ERR_NOMEM, false)); }
  if (rc < 0) { return meo_srv_fatal(s, h->rid, MEO_ERR_PROTO, MEO_SRV_EXIT_CRASHED); }
  if (s->state == MEO_SRV_S_ABORTED) {
    return meo_srv_after(s, meo_srv_reply_error(s, h->rid, MEO_ERR_TX, false));
  }
  s->w.max = meo_srv_frame_max(s);
  meo_wbuf_begin(&s->w);
  rc = meo_srv_exec(s->srv->db, &st, MEO_SRV_CAPS, &s->w);
  s->w.max = s->srv->cfg.max_frame;
  if (rc < 0) { return meo_srv_after(s, meo_srv_reply_error(s, h->rid, -rc, false)); }
  return meo_srv_after(s, meo_srv_send(s, meo_wbuf_finish(&s->w, MEO_WIRE_K_RESULT, h->rid)));
}

// Handle one frame to completion: MEO_SRV_CONTINUE, or MEO_SRV_STOP with s->reason set.
fn srv_session_handle(s: MeoSrvSession*, h: MeoWHdr*, body: uint8*) -> int32 {
  var r: MeoWRd;
  meo_wrd_init(&r, body, h->len);
  // The minor-1 kinds are reserved for a client that negotiated minor 1.
  var known: bool = meo_wire_kind_is_request(h->kind) ||
    (meo_wire_kind_is_sub_request(h->kind) && s->minor >= 1);
  if (!known) {
    return meo_srv_fatal(s, h->rid, MEO_ERR_PROTO, MEO_SRV_EXIT_CRASHED);
  }
  if (s->state == MEO_SRV_S_HELLO) {
    if (h->kind != MEO_WIRE_K_HELLO) {
      return meo_srv_fatal(s, h->rid, MEO_ERR_PROTO, MEO_SRV_EXIT_CRASHED);
    }
    return srv_on_hello(s, h, &r);
  }
  if (h->kind == MEO_WIRE_K_HELLO) {
    return meo_srv_fatal(s, h->rid, MEO_ERR_PROTO, MEO_SRV_EXIT_CRASHED);
  }
  if (s->state == MEO_SRV_S_SUBSCRIBED) { return meo_srv_sub_frame(s, h, &r); }
  if (s->state == MEO_SRV_S_TX) {
    var cap: int32 = s->srv->cfg.tx_max_ms;
    if (cap > 0 && meo_srv_now_ms() - s->tx_start_ms > (int64)cap) { meo_srv_rollback(s); }
  }
  var db: MeoDb* = s->srv->db;
  var rc: int32 = MEO_OK;
  if (h->kind == MEO_WIRE_K_QUERY) { return srv_on_query(s, h, &r); }
  if (h->kind == MEO_WIRE_K_SCAN) { return meo_srv_on_scan(s, h, &r); }
  if (h->kind == MEO_WIRE_K_SUBSCRIBE) { return meo_srv_on_subscribe(s, h, &r); }
  if (h->kind == MEO_WIRE_K_BEGIN) {
    var mode: int32 = 0;
    if (meo_wire_begin_get(&r, &mode) < 0) {
      return meo_srv_fatal(s, h->rid, MEO_ERR_PROTO, MEO_SRV_EXIT_CRASHED);
    }
    if (s->state != MEO_SRV_S_READY) {
      return meo_srv_after(s, meo_srv_reply_error(s, h->rid, MEO_ERR_TX, false));
    }
    rc = meo_db_begin(db, mode);
    if (rc < 0) { return meo_srv_after(s, meo_srv_reply_error(s, h->rid, -rc, false)); }
    s->tx_start_ms = meo_srv_now_ms();
    meo_srv_set_state(s, MEO_SRV_S_TX);
    return meo_srv_after(s, meo_srv_reply_empty(s, MEO_WIRE_K_OK, h->rid));
  }
  // ACK and UNSUBSCRIBE mean something only while SUBSCRIBED.
  if (h->kind == MEO_WIRE_K_ACK || h->kind == MEO_WIRE_K_UNSUBSCRIBE) {
    return meo_srv_after(s, meo_srv_reply_error(s, h->rid, MEO_ERR_TX, false));
  }
  if (meo_wire_empty_get(&r) < 0) {
    return meo_srv_fatal(s, h->rid, MEO_ERR_PROTO, MEO_SRV_EXIT_CRASHED);
  }
  if (h->kind == MEO_WIRE_K_PING) {
    // An aborted transaction answers TX to everything until ROLLBACK.
    if (s->state == MEO_SRV_S_ABORTED) {
      return meo_srv_after(s, meo_srv_reply_error(s, h->rid, MEO_ERR_TX, false));
    }
    return meo_srv_after(s, meo_srv_reply_empty(s, MEO_WIRE_K_OK, h->rid));
  }
  if (h->kind == MEO_WIRE_K_COMMIT) {
    if (s->state != MEO_SRV_S_TX) {
      return meo_srv_after(s, meo_srv_reply_error(s, h->rid, MEO_ERR_TX, false));
    }
    // A failed commit leaves the transaction open: only ROLLBACK clears it.
    rc = meo_db_commit(db);
    if (rc < 0) { return meo_srv_after(s, meo_srv_reply_error(s, h->rid, -rc, false)); }
    meo_srv_set_state(s, MEO_SRV_S_READY);
    return meo_srv_after(s, meo_srv_reply_empty(s, MEO_WIRE_K_OK, h->rid));
  }
  if (h->kind == MEO_WIRE_K_ROLLBACK) {
    if (s->state == MEO_SRV_S_READY) {
      return meo_srv_after(s, meo_srv_reply_error(s, h->rid, MEO_ERR_TX, false));
    }
    meo_srv_rollback(s);
    meo_srv_set_state(s, MEO_SRV_S_READY);
    return meo_srv_after(s, meo_srv_reply_empty(s, MEO_WIRE_K_OK, h->rid));
  }
  // BYE
  meo_srv_reply_empty(s, MEO_WIRE_K_OK, h->rid);
  s->reason = MEO_SRV_EXIT_NORMAL;
  return MEO_SRV_STOP;
}

// EOF or a socket error: which exit it is depends on why.
fn srv_lost(s: MeoSrvSession*) -> int64 {
  if (meo_srv_stopping(s->srv)) { return MEO_SRV_EXIT_SHUTDOWN; }
  if (s->state == MEO_SRV_S_READY || s->state == MEO_SRV_S_SUBSCRIBED) { return MEO_SRV_EXIT_NORMAL; }
  return MEO_SRV_EXIT_LOST;
}

// Read one frame, header into h and body into s->rbuf: MEO_SRV_CONTINUE, or
// MEO_SRV_STOP with s->reason set.
fn srv_read_frame(s: MeoSrvSession*, h: MeoWHdr*) -> int32 {
  var hb: uint8[12];
  var rc: int32 = meo_sock_recv_exact(s->fd, &hb[0], MEO_WIRE_HDR);
  if (rc == -MEO_ERR_TIMEOUT) {
    if (meo_srv_stopping(s->srv)) {
      s->reason = MEO_SRV_EXIT_SHUTDOWN;
      return MEO_SRV_STOP;
    }
    return meo_srv_fatal(s, 0, MEO_ERR_TIMEOUT, MEO_SRV_EXIT_KILLED);
  }
  if (rc <= 0) {
    s->reason = srv_lost(s);
    return MEO_SRV_STOP;
  }
  rc = meo_wire_hdr_get(&hb[0], s->srv->cfg.max_frame, h);
  if (rc == -MEO_ERR_TOOBIG) {
    return meo_srv_fatal(s, h->rid, MEO_ERR_TOOBIG, MEO_SRV_EXIT_CRASHED);
  }
  if (rc < 0) {
    return meo_srv_fatal(s, h->rid, MEO_ERR_PROTO, MEO_SRV_EXIT_CRASHED);
  }
  if (h->len > s->rcap) {
    var p: rawptr = realloc((rawptr)s->rbuf, (int64)h->len);
    if (p == 0) {
      return meo_srv_fatal(s, h->rid, MEO_ERR_NOMEM, MEO_SRV_EXIT_CRASHED);
    }
    s->rbuf = (uint8*)p;
    s->rcap = h->len;
  }
  if (h->len > 0) {
    rc = meo_sock_recv_exact(s->fd, s->rbuf, h->len);
    if (rc == -MEO_ERR_TIMEOUT && !meo_srv_stopping(s->srv)) {
      return meo_srv_fatal(s, 0, MEO_ERR_TIMEOUT, MEO_SRV_EXIT_KILLED);
    }
    if (rc != h->len) {
      s->reason = srv_lost(s);
      return MEO_SRV_STOP;
    }
  }
  return MEO_SRV_CONTINUE;
}

// Handle one frame, then drop a buffer a big frame grew.
fn srv_serve_frame(s: MeoSrvSession*, h: MeoWHdr*) -> int32 {
  if (srv_session_handle(s, h, s->rbuf) == MEO_SRV_STOP) { return MEO_SRV_STOP; }
  if (s->rcap > MEO_SRV_BUF_KEEP) {
    free((rawptr)s->rbuf);
    s->rbuf = 0;
    s->rcap = 0;
  }
  return MEO_SRV_CONTINUE;
}

// SUBSCRIBED: push events, wait, and serve the frames that arrive meanwhile,
// until UNSUBSCRIBE (back to READY) or the end of the connection. Nothing
// blocks on the socket without a deadline, so a stop is noticed within one wait.
fn srv_sub_run(s: MeoSrvSession*) -> int32 {
  var h: MeoWHdr;
  while (s->state == MEO_SRV_S_SUBSCRIBED) {
    if (meo_srv_stopping(s->srv)) {
      s->reason = MEO_SRV_EXIT_SHUTDOWN;
      return MEO_SRV_STOP;
    }
    if (meo_srv_sub_pump(s) == MEO_SRV_STOP) { return MEO_SRV_STOP; }
    meo_srv_sub_wait(s);
    if (meo_sock_poll_in(s->fd, 0) == 1) {
      if (srv_read_frame(s, &h) == MEO_SRV_STOP) { return MEO_SRV_STOP; }
      if (srv_serve_frame(s, &h) == MEO_SRV_STOP) { return MEO_SRV_STOP; }
    }
  }
  return MEO_SRV_CONTINUE;
}

fn srv_session_loop(s: MeoSrvSession*) -> int64 {
  var h: MeoWHdr;
  meo_sock_set_nodelay(s->fd, true);
  meo_srv_set_state(s, MEO_SRV_S_HELLO);
  while (true) {
    if (srv_read_frame(s, &h) == MEO_SRV_STOP) { return s->reason; }
    if (srv_serve_frame(s, &h) == MEO_SRV_STOP) { return s->reason; }
    if (s->state == MEO_SRV_S_SUBSCRIBED && srv_sub_run(s) == MEO_SRV_STOP) { return s->reason; }
  }
  return MEO_SRV_EXIT_LOST;
}

// The one way out: roll back on this thread, close, mark the slot done.
fn srv_session_exit(s: MeoSrvSession*, reason: int64) {
  meo_srv_rollback(s);
  s->reason = reason;
  var srv: MeoSrv* = s->srv;
  mutex_lock_infinite(srv->mtx);
  meo_sock_close(s->fd);
  s->fd = -1;
  mutex_unlock(srv->mtx);
  meo_wbuf_free(&s->w);
  if (s->rbuf != 0) { free((rawptr)s->rbuf); }
  s->rbuf = 0;
  s->rcap = 0;
  meo_srv_sub_free(s->sub);
  s->sub = 0;
  atomic_exchange_i32(&srv->slots[s->slot].done, 1);
}

// Thread entry; arg is the MeoSrvSession*. The session struct itself is freed
// by whoever joins this thread.
export fn meo_srv_session_run(arg: cstring) -> uint32 {
  var s: MeoSrvSession* = (MeoSrvSession*)arg;
  srv_session_exit(s, srv_session_loop(s));
  return 0;
}
