// types/key: order-preserving key encoding for the b-tree.
//
// A b-tree keeps keys sorted by comparing bytes (meo_key_compare), so an
// encoded key must compare the way its value sorts logically -- not merely
// round-trip. A signed int64 therefore cannot be
// stored as a plain big-endian uint64: that puts -1 at 0xFFFF...FF, above 0,
// and puts every negative above every non-negative.
//
// One encoded field is:
//
//   [tag:u8][payload]   meo_key_int (9 bytes), meo_key_text (1 + len), meo_key_null (1)
//                       meo_key_real (9 bytes), meo_key_blob (1 + len)
//   [payload]           meo_key_rowid (8 bytes), the only field with no tag
//
// A composite key is the fields concatenated in index order, with no
// separators: the b-tree only compares whole keys against whole keys of the
// same index, so nothing ever needs to find a field boundary again.
//
// The 8-byte payload is big-endian with the sign bit flipped, so the order of
// the unsigned bit pattern equals the signed order. format/bytes.mettle owns
// byte order, so the flip is spelled "byte-reverse the value, then write it
// little-endian": a byte-reversed little-endian u64 is a big-endian u64, and
// the endian decision stays in one module.
//
// Nothing here allocates. Every failure is a negative MEO_ERR_*.

import "../error/status.mettle";
import "../format/bytes.mettle";

export const MEO_KEY_INT: int32 = 1;
export const MEO_KEY_TEXT: int32 = 2;
export const MEO_KEY_NULL: int32 = 3;
export const MEO_KEY_ROWID: int32 = 4;
export const MEO_KEY_REAL: int32 = 5;
export const MEO_KEY_BLOB: int32 = 6;

// Byte-reverse a uint64: the big-endian writer, since meo_put_u64le is
// little-endian and bytes.mettle is the only place allowed to say so.
fn key_bswap64(v: uint64) -> uint64 {
  var r: uint64 = 0;
  var x: uint64 = v;
  var i: int32 = 0;
  while (i < 8) {
    r = (r << 8) | (x & (uint64)0xFF);
    x = x >> 8;
    i += 1;
  }
  return r;
}

// Write the order-preserving 8-byte payload of `v` at buf[off, off + 8).
fn key_put_int64(buf: uint8*, off: int32, v: int64) {
  // The shift, not a literal: an int32 literal cannot spell 2^63.
  var x: uint64 = ((uint64)v) ^ ((uint64)1 << 63);
  meo_put_u64le(buf, (int64)off, key_bswap64(x));
}

// Encode a tagged int64 key: [MEO_KEY_INT][8 bytes]. Returns 9, or
// -MEO_ERR_FULL when cap < 9 (nothing is written).
export fn meo_key_int(buf: uint8*, cap: int32, v: int64) -> int32 {
  if (buf == 0 || cap < 0) { return -MEO_ERR_USAGE; }
  if (cap < 9) { return -MEO_ERR_FULL; }
  buf[0] = (uint8)MEO_KEY_INT;
  key_put_int64(buf, 1, v);
  return 9;
}

// Encode a rowid for the tail of an index key: the same order-preserving
// encoding as meo_key_int, with no tag. Returns 8, or -MEO_ERR_FULL when
// cap < 8 (nothing is written).
export fn meo_key_rowid(buf: uint8*, cap: int32, v: int64) -> int32 {
  if (buf == 0 || cap < 0) { return -MEO_ERR_USAGE; }
  if (cap < 8) { return -MEO_ERR_FULL; }
  key_put_int64(buf, 0, v);
  return 8;
}

// Encode a tagged text key: [MEO_KEY_TEXT][the raw UTF-8 bytes]. Returns
// 1 + s.length, or -MEO_ERR_FULL when the buffer cannot hold that (nothing is
// written). The bytes are not escaped or terminated, so a string that is a
// prefix of another sorts first under meo_key_compare.
export fn meo_key_text(buf: uint8*, cap: int32, s: string) -> int32 {
  if (buf == 0 || cap < 0) { return -MEO_ERR_USAGE; }
  var n: int64 = (int64)s.length;
  if (n > (int64)cap - 1) { return -MEO_ERR_FULL; }
  buf[0] = (uint8)MEO_KEY_TEXT;
  meo_bytes_copy(buf + 1, s.chars, n);
  return (int32)(n + 1);
}

// Encode a tagged null key: [MEO_KEY_NULL], one byte. Returns 1, or
// -MEO_ERR_FULL if the buffer cannot hold the tag.
export fn meo_key_null(buf: uint8*, cap: int32) -> int32 {
  if (buf == 0 || cap < 0) { return -MEO_ERR_USAGE; }
  if (cap < 1) { return -MEO_ERR_FULL; }
  buf[0] = (uint8)MEO_KEY_NULL;
  return 1;
}

// Compare two encoded keys: lexicographic over the common prefix, then the
// shorter key first. Returns -1, 0 or 1.
export fn meo_key_compare(a: uint8*, an: int32, b: uint8*, bn: int32) -> int32 {
  var n: int32 = an;
  if (bn < n) { n = bn; }
  if (n > 0) {
    var c: int32 = meo_bytes_compare(a, b, (int64)n);
    if (c != 0) { return c; }
  }
  if (an < bn) { return -1; }
  if (an > bn) { return 1; }
  return 0;
}

// Encode a tagged float64 key: [MEO_KEY_REAL][8 bytes], ordered like the
// numbers. A set sign bit flips every bit (more negative sorts lower), a clear
// one flips only the sign bit (positives above negatives). -0.0 is stored as
// 0.0 so the two compare equal, and every NaN is stored as one quiet NaN that
// sorts above +inf. Returns 9, or -MEO_ERR_FULL when cap < 9.
export fn meo_key_real(buf: uint8*, cap: int32, v: float64) -> int32 {
  if (buf == 0 || cap < 0) { return -MEO_ERR_USAGE; }
  if (cap < 9) { return -MEO_ERR_FULL; }
  var x: float64 = v;
  if (x == 0.0) { x = 0.0; }
  meo_put_f64le(buf, 1, x);
  var bits: uint64 = meo_get_u64le(buf, 1);
  if (v != v) { bits = (uint64)0x7FF8 << 48; }
  var sign: uint64 = (uint64)1 << 63;
  if ((bits & sign) != (uint64)0) {
    bits = ~bits;
  } else {
    bits = bits ^ sign;
  }
  buf[0] = (uint8)MEO_KEY_REAL;
  meo_put_u64le(buf, 1, key_bswap64(bits));
  return 9;
}

// Encode a tagged blob key: [MEO_KEY_BLOB][the raw bytes]. Returns 1 + n, or
// -MEO_ERR_FULL when the buffer cannot hold that (nothing is written).
export fn meo_key_blob(buf: uint8*, cap: int32, p: uint8*, n: int32) -> int32 {
  if (buf == 0 || cap < 0 || n < 0) { return -MEO_ERR_USAGE; }
  if (p == 0 && n > 0) { return -MEO_ERR_USAGE; }
  if ((int64)n > (int64)cap - 1) { return -MEO_ERR_FULL; }
  buf[0] = (uint8)MEO_KEY_BLOB;
  if (n > 0) { meo_bytes_copy(buf + 1, p, (int64)n); }
  return n + 1;
}

// Decode the meo_key_int field at the front of buf into out[0]. Returns 9 (the
// bytes read; a composite key may continue after them), or -MEO_ERR_CORRUPT
// when buf does not start with one.
export fn meo_key_int_decode(buf: uint8*, n: int32, out: int64*) -> int32 {
  if (buf == 0 || out == 0) { return -MEO_ERR_USAGE; }
  if (n < 9 || (int32)buf[0] != MEO_KEY_INT) { return -MEO_ERR_CORRUPT; }
  var x: uint64 = key_bswap64(meo_get_u64le(buf, 1));
  out[0] = (int64)(x ^ ((uint64)1 << 63));
  return 9;
}
