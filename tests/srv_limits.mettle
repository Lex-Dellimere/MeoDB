// srv_limits: the server's limits and handshake refusals, driven with raw
// frames because the client library refuses to send most of this input.
// Server A (token, 4 connections, 128 KiB frames): oversize headers, bad
// magic and major, requests before HELLO, wrong and missing token, the
// connection cap, results over either side's max_frame, refused ops.
// Server B (short timeouts, no token): hello_ms, idle_ms and tx_max_ms.

import "std/io";
import "std/mem";
import "../src/error/status.mettle";
import "../src/platform/file.mettle";
import "../src/platform/file_linux.mettle";
import "../src/mem/arena.mettle";
import "../src/meo_server.mettle";

// Red-check switch: 1 expects an oversize result to be fatal.
// Must be 0 when committed.
const LIM_RED: int32 = 0;
const LIM_DB: string = "build/srv_limits.db";
const LIM_IP: string = "127.0.0.1";
const LIM_TOKEN: string = "sekrit";
const LIM_SRV_FRAME: int32 = 131072;
const LIM_BUF: int32 = 1048576;
const LIM_CONNS: int32 = 4;
const LIM_HELLO_MS: int32 = 300;
const LIM_IDLE_MS: int32 = 600;
const LIM_TX_MAX_MS: int32 = 400;

var g_port: int32 = 0;
var g_rid: uint32 = 0;
var g_w: MeoWBuf;
var g_buf: uint8* = 0;
var g_hdr: MeoWHdr;
var g_rd: MeoWRd;
var g_arena: MeoArena* = 0;
var g_err: MeoWError;
var g_res: MeoWResult;
var g_srv: MeoSrv* = 0;

fn lim_fail(msg: string) -> int32 {
  println("FAIL srv_limits: {msg}");
  return 1;
}

fn lim_reset(db: string) -> int32 {
  var f: MeoFile = meo_file_open(db, MEO_OPEN_READ | MEO_OPEN_WRITE | MEO_OPEN_CREATE);
  if (!f.is_open) { return -MEO_ERR_IO; }
  var rc: int32 = meo_file_truncate(f, 0);
  meo_file_close(f);
  var jpath: string = db + "-journal";
  meo_file_unlink(jpath);
  free(jpath.chars);
  return rc;
}

fn lim_connect() -> int64 {
  var fd: int64 = meo_sock_connect(LIM_IP, g_port);
  if (fd >= 0) { meo_sock_set_recv_timeout(fd, 3000); }
  return fd;
}

fn lim_send(fd: int64, kind: int32) -> int32 {
  g_rid += 1;
  var n: int32 = meo_wbuf_finish(&g_w, kind, g_rid);
  if (n < 0) { return n; }
  var rc: int32 = meo_sock_send_all(fd, g_w.p, n);
  if (rc < 0) { return rc; }
  return MEO_OK;
}

// Read one frame into g_hdr / g_rd: its kind, 0 on EOF, or -MEO_ERR_*.
fn lim_recv(fd: int64) -> int32 {
  var rc: int32 = meo_sock_recv_exact(fd, g_buf, MEO_WIRE_HDR);
  if (rc <= 0) { return rc; }
  rc = meo_wire_hdr_get(g_buf, LIM_BUF, &g_hdr);
  if (rc < 0) { return rc; }
  if (g_hdr.len > 0) {
    rc = meo_sock_recv_exact(fd, g_buf + MEO_WIRE_HDR, g_hdr.len);
    if (rc != g_hdr.len) { return -MEO_ERR_IO; }
  }
  meo_wrd_init(&g_rd, g_buf + MEO_WIRE_HDR, g_hdr.len);
  return g_hdr.kind;
}

// The reply to the last request; an ERROR lands in g_err, a RESULT in g_res.
fn lim_reply(fd: int64) -> int32 {
  var k: int32 = lim_recv(fd);
  if (k == MEO_WIRE_K_ERROR) {
    if (meo_wire_error_get(&g_rd, &g_err) < 0) { return -MEO_ERR_PROTO; }
  } else if (k == MEO_WIRE_K_RESULT) {
    meo_arena_reset(g_arena);
    if (meo_wire_result_get(&g_rd, g_arena, &g_res) < 0) { return -MEO_ERR_PROTO; }
  }
  if (k > 0 && g_hdr.rid != g_rid && g_hdr.rid != 0) { return -MEO_ERR_PROTO; }
  return k;
}

// A frame the server sent unasked (rid 0); an ERROR lands in g_err.
fn lim_recv_err(fd: int64) -> int32 {
  var k: int32 = lim_recv(fd);
  if (k == MEO_WIRE_K_ERROR && meo_wire_error_get(&g_rd, &g_err) < 0) { return -MEO_ERR_PROTO; }
  return k;
}

fn lim_call(fd: int64, kind: int32) -> int32 {
  meo_wbuf_begin(&g_w);
  var rc: int32 = lim_send(fd, kind);
  if (rc < 0) { return rc; }
  return lim_reply(fd);
}

fn lim_hello(fd: int64, token: string, max_frame: int32) -> int32 {
  var h: MeoWHello;
  h.major = MEO_WIRE_MAJOR;
  h.minor = MEO_WIRE_MINOR;
  h.max_frame = max_frame;
  h.token = token;
  h.name = "srv_limits";
  meo_wbuf_begin(&g_w);
  meo_wire_hello_put(&g_w, &h);
  var rc: int32 = lim_send(fd, MEO_WIRE_K_HELLO);
  if (rc < 0) { return rc; }
  return lim_reply(fd);
}

fn lim_open_max(token: string, max_frame: int32) -> int64 {
  var fd: int64 = lim_connect();
  if (fd < 0) { return fd; }
  if (lim_hello(fd, token, max_frame) != MEO_WIRE_K_HELLO_OK) {
    meo_sock_close(fd);
    return (int64)(-MEO_ERR_PROTO);
  }
  return fd;
}

fn lim_open(token: string) -> int64 {
  return lim_open_max(token, MEO_WIRE_MIN_FRAME);
}

fn lim_query(fd: int64, st: MeoWStmt*) -> int32 {
  meo_wbuf_begin(&g_w);
  var rc: int32 = meo_wire_stmt_put(&g_w, st);
  if (rc < 0) { return rc; }
  rc = lim_send(fd, MEO_WIRE_K_QUERY);
  if (rc < 0) { return rc; }
  return lim_reply(fd);
}

fn lim_begin(fd: int64) -> int32 {
  meo_wbuf_begin(&g_w);
  meo_wire_begin_put(&g_w, 0);
  var rc: int32 = lim_send(fd, MEO_WIRE_K_BEGIN);
  if (rc < 0) { return rc; }
  return lim_reply(fd);
}

fn lim_col(c: MeoWCol*, name: string, ty: int32, flags: int32) {
  c->name = name;
  c->ty = ty;
  c->flags = flags;
}

fn lim_create(fd: int64) -> int32 {
  var cols: MeoWCol[2];
  lim_col(&cols[0], "id", 1, MEO_WIRE_CF_PK);
  lim_col(&cols[1], "name", 3, 0);
  var st: MeoWStmt;
  meo_wire_stmt_init(&st);
  st.op = MEO_WIRE_OP_CREATE;
  st.table = "t";
  st.cols = &cols[0];
  st.n_cols = 2;
  return lim_query(fd, &st);
}

// INSERT INTO t(id, name) one row per id in [lo, hi), name = n bytes of 'x'.
fn lim_insert(fd: int64, lo: int64, hi: int64, n: int32) -> int32 {
  var cols: MeoWCol[2];
  lim_col(&cols[0], "id", 0, 0);
  lim_col(&cols[1], "name", 0, 0);
  var rows: int32 = (int32)(hi - lo);
  var args: MeoValue* = (MeoValue*)malloc((int64)rows * 2 * (int64)sizeof(MeoValue));
  var text: uint8* = (uint8*)malloc((int64)n + 1);
  memset((rawptr)text, 120, (int64)n + 1);
  var i: int32 = 0;
  while (i < rows) {
    meo_value_set_int(&args[i * 2], lo + (int64)i);
    meo_value_set_text(&args[i * 2 + 1], text, n);
    i += 1;
  }
  var st: MeoWStmt;
  meo_wire_stmt_init(&st);
  st.op = MEO_WIRE_OP_INSERT;
  st.table = "t";
  st.cols = &cols[0];
  st.n_cols = 2;
  st.n_rows = rows;
  st.args = args;
  st.n_args = rows * 2;
  var k: int32 = lim_query(fd, &st);
  free((rawptr)args);
  free((rawptr)text);
  return k;
}

// SELECT id FROM t WHERE id = x: rows found, or a negative code.
fn lim_find(fd: int64, x: int64) -> int32 {
  var cols: MeoWCol[1];
  lim_col(&cols[0], "id", 0, 0);
  var terms: MeoWTerm[1];
  terms[0].col = "id";
  terms[0].op = MEO_WIRE_W_EQ;
  terms[0].arg0 = 0;
  terms[0].n_args = 1;
  var v: MeoValue;
  meo_value_set_int(&v, x);
  var st: MeoWStmt;
  meo_wire_stmt_init(&st);
  st.op = MEO_WIRE_OP_SELECT;
  st.table = "t";
  st.cols = &cols[0];
  st.n_cols = 1;
  st.terms = &terms[0];
  st.n_terms = 1;
  st.args = &v;
  st.n_args = 1;
  var k: int32 = lim_query(fd, &st);
  if (k != MEO_WIRE_K_RESULT) { return -MEO_ERR_PROTO; }
  return g_res.n_rows;
}

// SELECT * FROM t LIMIT lim: the reply kind.
fn lim_select_all(fd: int64, lim: int64) -> int32 {
  var st: MeoWStmt;
  meo_wire_stmt_init(&st);
  st.op = MEO_WIRE_OP_SELECT;
  st.table = "t";
  st.limit = lim;
  return lim_query(fd, &st);
}

fn lim_expect_error(k: int32, code: int32, fatal: bool, what: string) -> int32 {
  if (k != MEO_WIRE_K_ERROR) { return lim_fail("{what}: kind {k}"); }
  if (g_err.code != code || g_err.fatal != fatal) {
    return lim_fail("{what}: code {g_err.code} fatal {g_err.fatal}");
  }
  return 0;
}

// After a fatal error the server closes: the next read is EOF.
fn lim_expect_close(fd: int64, what: string) -> int32 {
  var k: int32 = lim_recv(fd);
  meo_sock_close(fd);
  if (k != 0) { return lim_fail("{what}: no close, got {k}"); }
  return 0;
}

// Wait until the server has seen every closed socket, so the cap counts only
// live connections.
fn lim_settle(n: int32) -> int32 {
  var tries: int32 = 0;
  while (meo_srv_n_sessions(g_srv) > n && tries < 400) {
    Sleep(5);
    tries += 1;
  }
  if (meo_srv_n_sessions(g_srv) > n) { return lim_fail("sessions {meo_srv_n_sessions(g_srv)} > {n}"); }
  return 0;
}

// A header claiming more than max_frame: TOOBIG fatal, the body never read.
fn lim_oversize_hdr() -> int32 {
  var lens: uint32[2];
  lens[0] = (uint32)LIM_SRV_FRAME + 1;
  lens[1] = 4294967295;
  var i: int32 = 0;
  while (i < 2) {
    var fd: int64 = lim_open(LIM_TOKEN);
    if (fd < 0) { return lim_fail("open for oversize"); }
    var hb: uint8[12];
    g_rid += 1;
    meo_wire_hdr_put(&hb[0], 0, MEO_WIRE_K_QUERY, g_rid);
    meo_put_u32le(&hb[0], 0, lens[i]);
    if (meo_sock_send_all(fd, &hb[0], MEO_WIRE_HDR) < 0) { return lim_fail("send oversize"); }
    if (lim_expect_error(lim_reply(fd), MEO_ERR_TOOBIG, true, "oversize header {lens[i]}") != 0) {
      return 1;
    }
    if (lim_expect_close(fd, "oversize header") != 0) { return 1; }
    i += 1;
  }
  return 0;
}

// HELLO with the given magic and major; good_tail adds the rest of a valid hello.
fn lim_bad_hello(magic: string, major: int32, good_tail: bool, what: string) -> int32 {
  var fd: int64 = lim_connect();
  if (fd < 0) { return lim_fail("connect {what}"); }
  meo_wbuf_begin(&g_w);
  meo_wbuf_bytes(&g_w, magic.chars, 4);
  meo_wbuf_u16(&g_w, major);
  if (good_tail) {
    meo_wbuf_u16(&g_w, 0);
    meo_wbuf_u32(&g_w, (uint32)MEO_WIRE_MIN_FRAME);
    meo_wbuf_str16(&g_w, LIM_TOKEN);
    meo_wbuf_str16(&g_w, "srv_limits");
  }
  if (lim_send(fd, MEO_WIRE_K_HELLO) < 0) { return lim_fail("send {what}"); }
  if (lim_expect_error(lim_reply(fd), MEO_ERR_VERSION, true, what) != 0) { return 1; }
  return lim_expect_close(fd, what);
}

fn lim_handshake() -> int32 {
  if (lim_bad_hello("MEOX", 1, true, "bad magic") != 0) { return 1; }
  if (lim_bad_hello("MEOS", 2, true, "major 2") != 0) { return 1; }
  // The rest of a major-2 hello is not read, so a short one is still VERSION.
  if (lim_bad_hello("MEOS", 2, false, "short major 2") != 0) { return 1; }

  var kinds: int32[2];
  kinds[0] = MEO_WIRE_K_PING;
  kinds[1] = MEO_WIRE_K_BEGIN;
  var i: int32 = 0;
  while (i < 2) {
    var fd: int64 = lim_connect();
    meo_wbuf_begin(&g_w);
    if (kinds[i] == MEO_WIRE_K_BEGIN) { meo_wire_begin_put(&g_w, 0); }
    if (lim_send(fd, kinds[i]) < 0) { return lim_fail("send before hello"); }
    if (lim_expect_error(lim_reply(fd), MEO_ERR_PROTO, true, "kind {kinds[i]} before hello") != 0) {
      return 1;
    }
    if (lim_expect_close(fd, "before hello") != 0) { return 1; }
    i += 1;
  }

  var toks: string[3];
  toks[0] = "wrong!";
  toks[1] = "sekri";
  toks[2] = "";
  i = 0;
  while (i < 3) {
    var fd: int64 = lim_connect();
    var t0: int64 = meo_srv_now_ms();
    if (lim_expect_error(lim_hello(fd, toks[i], MEO_WIRE_MIN_FRAME), MEO_ERR_AUTH, true, "token '{toks[i]}'") != 0) {
      return 1;
    }
    var ms: int64 = meo_srv_now_ms() - t0;
    if (ms < 150) { return lim_fail("AUTH answered after {ms} ms, want the 200 ms delay"); }
    if (lim_expect_close(fd, "bad token") != 0) { return 1; }
    i += 1;
  }
  return 0;
}

// LIM_CONNS live sessions: one more gets ERROR BUSY fatal, rid 0, before any
// HELLO; a freed slot is usable again.
fn lim_cap() -> int32 {
  if (lim_settle(0) != 0) { return 1; }
  var fds: int64[4];
  var i: int32 = 0;
  while (i < LIM_CONNS) {
    fds[i] = lim_open(LIM_TOKEN);
    if (fds[i] < 0) { return lim_fail("open {i} under the cap"); }
    i += 1;
  }
  var x: int64 = lim_connect();
  if (x < 0) { return lim_fail("connect over the cap"); }
  if (lim_expect_error(lim_recv_err(x), MEO_ERR_BUSY, true, "over the cap") != 0) { return 1; }
  if (g_hdr.rid != 0) {
    return lim_fail("cap refusal rid {g_hdr.rid}");
  }
  if (lim_expect_close(x, "over the cap") != 0) { return 1; }
  if (meo_srv_n_sessions(g_srv) != LIM_CONNS) { return lim_fail("sessions {meo_srv_n_sessions(g_srv)}"); }
  // The refused connection cost the others nothing.
  if (lim_call(fds[0], MEO_WIRE_K_PING) != MEO_WIRE_K_OK) { return lim_fail("ping after refusal"); }

  meo_sock_close(fds[3]);
  if (lim_settle(LIM_CONNS - 1) != 0) { return 1; }
  fds[3] = lim_open(LIM_TOKEN);
  if (fds[3] < 0) { return lim_fail("open after a slot freed"); }
  i = 0;
  while (i < LIM_CONNS) {
    meo_sock_close(fds[i]);
    i += 1;
  }
  return lim_settle(0);
}

// A result over min(server, client) max_frame is a non-fatal TOOBIG.
fn lim_big_result() -> int32 {
  var a: int64 = lim_open(LIM_TOKEN);
  var b: int64 = lim_open_max(LIM_TOKEN, LIM_BUF);
  if (a < 0 || b < 0) { return lim_fail("open for big result"); }
  if (lim_insert(a, 1000, 1050, 1000) != MEO_WIRE_K_RESULT) { return lim_fail("big insert 1"); }
  if (lim_insert(a, 1050, 1100, 1000) != MEO_WIRE_K_RESULT) { return lim_fail("big insert 2"); }
  // ~100 KiB: over a's 64 KiB, under the server's 128 KiB.
  var k: int32 = lim_select_all(a, -1);
  if (LIM_RED != 0) {
    if (lim_expect_error(k, MEO_ERR_TOOBIG, true, "select over client max") != 0) { return 1; }
  } else {
    if (lim_expect_error(k, MEO_ERR_TOOBIG, false, "select over client max") != 0) { return 1; }
  }
  if (g_err.tx != MEO_WIRE_TX_NONE) { return lim_fail("TOOBIG tx {g_err.tx}"); }
  if (lim_call(a, MEO_WIRE_K_PING) != MEO_WIRE_K_OK) { return lim_fail("ping after TOOBIG"); }
  if (lim_select_all(a, 30) != MEO_WIRE_K_RESULT || g_res.n_rows != 30) { return lim_fail("paged select"); }
  if (lim_select_all(b, -1) != MEO_WIRE_K_RESULT || g_res.n_rows < 100) {
    return lim_fail("select under both maxes");
  }

  // ~200 KiB: over the server's max even for b.
  if (lim_insert(b, 1100, 1200, 1000) != MEO_WIRE_K_RESULT) { return lim_fail("big insert 3"); }
  if (lim_expect_error(lim_select_all(b, -1), MEO_ERR_TOOBIG, false, "select over server max") != 0) {
    return 1;
  }
  if (lim_call(b, MEO_WIRE_K_PING) != MEO_WIRE_K_OK) { return lim_fail("ping after server TOOBIG"); }
  meo_sock_close(a);
  meo_sock_close(b);
  return 0;
}

// Index ops: UNSUPPORTED, non-fatal, the transaction untouched. Term op 9: USAGE.
fn lim_refused_ops() -> int32 {
  var fd: int64 = lim_open(LIM_TOKEN);
  if (fd < 0) { return lim_fail("open for refused ops"); }
  var st: MeoWStmt;
  meo_wire_stmt_init(&st);
  st.op = MEO_WIRE_OP_CREATE_INDEX;
  st.table = "t";
  st.name = "ix";
  if (lim_expect_error(lim_query(fd, &st), MEO_ERR_UNSUPPORTED, false, "create index") != 0) { return 1; }
  if (g_err.tx != MEO_WIRE_TX_NONE) { return lim_fail("create index outside tx: tx {g_err.tx}"); }

  if (lim_begin(fd) != MEO_WIRE_K_OK) { return lim_fail("begin"); }
  if (lim_insert(fd, 7, 8, 3) != MEO_WIRE_K_RESULT) { return lim_fail("insert in tx"); }
  if (lim_expect_error(lim_query(fd, &st), MEO_ERR_UNSUPPORTED, false, "create index in tx") != 0) {
    return 1;
  }
  if (g_err.tx != MEO_WIRE_TX_OPEN) { return lim_fail("create index in tx: tx {g_err.tx}"); }
  st.op = MEO_WIRE_OP_DROP_INDEX;
  if (lim_expect_error(lim_query(fd, &st), MEO_ERR_UNSUPPORTED, false, "drop index in tx") != 0) {
    return 1;
  }
  if (g_err.tx != MEO_WIRE_TX_OPEN) { return lim_fail("drop index in tx: tx {g_err.tx}"); }
  if (lim_call(fd, MEO_WIRE_K_COMMIT) != MEO_WIRE_K_OK) { return lim_fail("commit after refused ops"); }
  if (lim_find(fd, 7) != 1) { return lim_fail("row inserted around the index ops is missing"); }

  var terms: MeoWTerm[1];
  terms[0].col = "id";
  terms[0].op = 9;
  terms[0].arg0 = 0;
  terms[0].n_args = 0;
  meo_wire_stmt_init(&st);
  st.op = MEO_WIRE_OP_SELECT;
  st.table = "t";
  st.terms = &terms[0];
  st.n_terms = 1;
  if (lim_expect_error(lim_query(fd, &st), MEO_ERR_USAGE, false, "term op 9") != 0) { return 1; }
  if (lim_call(fd, MEO_WIRE_K_PING) != MEO_WIRE_K_OK) { return lim_fail("ping after USAGE"); }
  meo_sock_close(fd);
  return 0;
}

fn lim_start(db: MeoDb*, c: MeoSrvConfig*) -> int32 {
  var rc: int32 = meo_srv_start(db, c, &g_srv);
  if (rc != MEO_OK) { return lim_fail("start rc={rc}"); }
  g_port = meo_srv_port(g_srv);
  if (g_port <= 0) { return lim_fail("port {g_port}"); }
  return 0;
}

fn lim_stop() -> int32 {
  var bad: int32 = 0;
  if (meo_srv_stop(g_srv) != MEO_OK) { bad = lim_fail("stop"); }
  if (meo_srv_free(g_srv) != MEO_OK && bad == 0) { bad = lim_fail("free"); }
  g_srv = 0;
  return bad;
}

fn lim_server_a(db: MeoDb*) -> int32 {
  var tok: string = LIM_TOKEN;
  var c: MeoSrvConfig;
  meo_srv_config_default(&c);
  c.port = 0;
  c.max_conns = LIM_CONNS;
  c.max_frame = LIM_SRV_FRAME;
  c.token = tok.chars;
  c.token_n = (int32)tok.length;
  if (lim_start(db, &c) != 0) { return 1; }
  var bad: int32 = 0;
  var fd: int64 = lim_open(LIM_TOKEN);
  if (fd < 0 || lim_create(fd) != MEO_WIRE_K_RESULT) { bad = lim_fail("create"); }
  if (fd >= 0) { meo_sock_close(fd); }
  if (bad == 0) { bad = lim_oversize_hdr(); }
  if (bad == 0) { bad = lim_handshake(); }
  if (bad == 0) { bad = lim_cap(); }
  if (bad == 0) { bad = lim_big_result(); }
  if (bad == 0) { bad = lim_refused_ops(); }
  if (lim_stop() != 0 && bad == 0) { bad = 1; }
  return bad;
}

// A receive timeout: ERROR TIMEOUT fatal with rid 0 after about `ms`, then close.
fn lim_expect_timeout(fd: int64, ms: int32, what: string) -> int32 {
  var t0: int64 = meo_srv_now_ms();
  var k: int32 = lim_recv_err(fd);
  var took: int64 = meo_srv_now_ms() - t0;
  if (lim_expect_error(k, MEO_ERR_TIMEOUT, true, what) != 0) { return 1; }
  if (g_hdr.rid != 0) { return lim_fail("{what}: rid {g_hdr.rid}"); }
  if (took < (int64)ms - 50 || took > (int64)ms + 1000) { return lim_fail("{what}: after {took} ms, want ~{ms}"); }
  return lim_expect_close(fd, what);
}

fn lim_timeouts() -> int32 {
  // A silent connection is cut off at hello_ms.
  var fd: int64 = lim_connect();
  if (fd < 0) { return lim_fail("connect silent"); }
  if (lim_expect_timeout(fd, LIM_HELLO_MS, "hello_ms") != 0) { return 1; }

  // READY with nothing sent is cut off at idle_ms.
  fd = lim_open("");
  if (fd < 0) { return lim_fail("open idle"); }
  if (lim_expect_timeout(fd, LIM_IDLE_MS, "idle_ms") != 0) { return 1; }

  // tx_max_ms: the next frame finds the transaction rolled back and ABORTED.
  var x: int64 = lim_open("");
  if (x < 0) { return lim_fail("open x"); }
  if (lim_begin(x) != MEO_WIRE_K_OK) { return lim_fail("begin x"); }
  if (lim_insert(x, 500, 501, 3) != MEO_WIRE_K_RESULT) { return lim_fail("insert x"); }
  Sleep(500);
  if (lim_expect_error(lim_insert(x, 501, 502, 3), MEO_ERR_TX, false, "query past tx_max") != 0) { return 1; }
  if (g_err.tx != MEO_WIRE_TX_ABORTED) { return lim_fail("past tx_max: tx {g_err.tx}"); }
  if (lim_expect_error(lim_call(x, MEO_WIRE_K_COMMIT), MEO_ERR_TX, false, "commit aborted") != 0) { return 1; }
  if (g_err.tx != MEO_WIRE_TX_ABORTED) { return lim_fail("commit aborted: tx {g_err.tx}"); }
  if (lim_expect_error(lim_begin(x), MEO_ERR_TX, false, "begin aborted") != 0) { return 1; }

  // The lock went with the abort; the row with it.
  var y: int64 = lim_open("");
  if (y < 0) { return lim_fail("open y"); }
  var t0: int64 = meo_srv_now_ms();
  if (lim_begin(y) != MEO_WIRE_K_OK) { return lim_fail("begin y code {g_err.code}"); }
  if (meo_srv_now_ms() - t0 > 200) { return lim_fail("begin y waited for an aborted tx"); }
  if (lim_find(y, 500) != 0) { return lim_fail("aborted row visible"); }
  if (lim_call(y, MEO_WIRE_K_ROLLBACK) != MEO_WIRE_K_OK) { return lim_fail("rollback y"); }

  if (lim_call(x, MEO_WIRE_K_ROLLBACK) != MEO_WIRE_K_OK) { return lim_fail("rollback aborted"); }
  if (lim_begin(x) != MEO_WIRE_K_OK) { return lim_fail("begin after aborted"); }
  if (lim_call(x, MEO_WIRE_K_COMMIT) != MEO_WIRE_K_OK) { return lim_fail("commit after aborted"); }
  meo_sock_close(x);
  meo_sock_close(y);
  return 0;
}

fn lim_server_b(db: MeoDb*) -> int32 {
  var c: MeoSrvConfig;
  meo_srv_config_default(&c);
  c.port = 0;
  c.hello_ms = LIM_HELLO_MS;
  c.idle_ms = LIM_IDLE_MS;
  c.tx_idle_ms = 3000;
  c.tx_max_ms = LIM_TX_MAX_MS;
  if (lim_start(db, &c) != 0) { return 1; }
  var bad: int32 = lim_timeouts();
  if (lim_stop() != 0 && bad == 0) { bad = 1; }
  return bad;
}

fn lim_run() -> int32 {
  if (lim_reset(LIM_DB) != MEO_OK) { return lim_fail("reset db"); }
  var db: MeoDb* = 0;
  var rc: int32 = meo_db_open(LIM_DB, MEO_OPEN_CREATE | MEO_OPEN_READ | MEO_OPEN_WRITE, 0, &db);
  if (rc != MEO_OK) { return lim_fail("open db rc={rc}"); }
  var bad: int32 = lim_server_a(db);
  if (bad == 0) { bad = lim_server_b(db); }
  rc = meo_db_close(db);
  if (rc != MEO_OK && bad == 0) { bad = lim_fail("close rc={rc}"); }
  return bad;
}

fn main() -> int32 {
  meo_wbuf_init(&g_w, LIM_BUF);
  g_buf = (uint8*)malloc((int64)LIM_BUF + 64);
  g_arena = meo_arena_new(65536);
  var bad: int32 = lim_run();
  meo_wbuf_free(&g_w);
  free((rawptr)g_buf);
  meo_arena_free(g_arena);
  if (bad != 0) { return 1; }
  println("PASS srv_limits");
  return 0;
}
