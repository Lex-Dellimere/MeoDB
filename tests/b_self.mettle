// _b_self: self-test for lane B -- platform/file.mettle, platform/file_linux
// and mem/arena.mettle. A program, not a @test, because it needs real files;
// run it from the repo root so the relative data paths resolve.
//
//   ./tools/mettle --build tests/_b_self.mettle -o build/b_self && ./build/b_self
//
// It prints PASS or FAIL <case> and returns non-zero on the first failure.
// The leading underscore keeps it out of the shared gate until lane B is done.

import "../src/platform/file.mettle";
import "../src/platform/file_linux.mettle";
import "../src/error/status.mettle";
import "../src/mem/arena.mettle";
import "std/io";

const B_DB: string = "build/tmp_b_self_io.dat";
const B_EXCL: string = "build/tmp_b_self_excl.dat";
const B_RENAMED: string = "build/tmp_b_self_renamed.dat";
const B_SCRATCH: string = "build/tmp_b_self_scratch.dat";

var b_failures: int32 = 0;

// Report whether a check failed, so a section can stop at the first one:
// `if (!b_ok(cond, "label")) { return 1; }`.
fn b_ok(cond: bool, label: string) -> bool {
  if (!cond) {
    println("FAIL {label}");
    b_failures += 1;
    return false;
  }
  return true;
}

fn b_fill(buf: uint8*, n: int64, seed: int64) {
  var i: int64 = 0;
  while (i < n) {
    buf[i] = (uint8)((i * 7 + seed) & 255);
    i = i + 1;
  }
}

fn b_same(a: uint8*, b: uint8*, n: int64) -> bool {
  var i: int64 = 0;
  while (i < n) {
    if (a[i] != b[i]) { return false; }
    i = i + 1;
  }
  return true;
}

// ---- file.mettle ------------------------------------------------------------

fn b_flags_contract() -> int32 {
  if (MEO_OPEN_READ != 1) { return 1; }
  if (MEO_OPEN_WRITE != 2) { return 2; }
  if (MEO_OPEN_CREATE != 4) { return 3; }
  if (MEO_OPEN_EXCL != 8) { return 4; }
  var all: int32 = MEO_OPEN_READ | MEO_OPEN_WRITE | MEO_OPEN_CREATE | MEO_OPEN_EXCL;
  if (all != 15) { return 5; }  // disjoint bits: a backend translates by mask
  var h: MeoFile = { handle: (int64)(0 - MEO_ERR_USAGE), is_open: false };
  if (h.is_open) { return 6; }
  h.is_open = true;
  h.handle = 3;
  if (h.handle != 3) { return 7; }
  return 0;
}

// ---- platform/file_linux ----------------------------------------------------

fn b_file_io() -> int32 {
  var f: MeoFile = meo_file_open(B_DB, MEO_OPEN_READ | MEO_OPEN_WRITE | MEO_OPEN_CREATE);
  if (!b_ok(f.is_open, "open create rw")) { return 1; }
  if (!b_ok(f.handle >= 0, "open returns a descriptor")) { return 1; }
  // CREATE alone must not truncate; make the file empty explicitly so a
  // second run starts from the same state.
  if (!b_ok(meo_file_truncate(f, 0) == MEO_OK, "truncate to empty")) { return 1; }
  if (!b_ok(meo_file_size(f) == 0, "size is 0 after truncate")) { return 1; }

  if (!b_ok(meo_file_write_at(f, 0, 0, 8) == -MEO_ERR_USAGE, "write with null buf is USAGE")) {
    return 1;
  }
  if (!b_ok(meo_file_read_at(f, 0, 0, 8) == -MEO_ERR_USAGE, "read with null buf is USAGE")) {
    return 1;
  }
  if (!b_ok(meo_file_write_at(f, -1, 0, 1) == -MEO_ERR_USAGE, "write at negative offset is USAGE")) {
    return 1;
  }
  if (!b_ok(meo_file_read_at(f, 0, 0, -1) == -MEO_ERR_USAGE, "read with negative len is USAGE")) {
    return 1;
  }
  if (!b_ok(meo_file_truncate(f, -1) == -MEO_ERR_USAGE, "truncate negative is USAGE")) { return 1; }

  var a: uint8[] = new uint8[8192];
  var b: uint8[] = new uint8[4096];
  if (!b_ok(a.length == 8192 && b.length == 4096, "buffers are heap sized")) { return 1; }
  b_fill(a.data, 8192, 1);
  b_fill(b.data, 4096, 99);

  if (!b_ok(meo_file_write_at(f, 0, a.data, 8192) == MEO_OK, "write 8192 at 0")) { return 1; }
  if (!b_ok(meo_file_write_at(f, 8192, b.data, 4096) == MEO_OK, "write 4096 at 8192")) { return 1; }
  if (!b_ok(meo_file_write_at(f, 12288, b.data, 0) == MEO_OK, "zero-length write is MEO_OK")) {
    return 1;
  }
  if (!b_ok(meo_file_sync(f) == MEO_OK, "fsync returns 0")) { return 1; }
  if (!b_ok(meo_file_size(f) == 12288, "size is 12288")) { return 1; }

  var ra: uint8[] = new uint8[8192];
  var rb: uint8[] = new uint8[4096];
  b_fill(ra.data, 8192, 200);
  b_fill(rb.data, 4096, 201);
  if (!b_ok(meo_file_read_at(f, 0, ra.data, 8192) == 8192, "read 8192 at 0 returns 8192")) {
    return 1;
  }
  if (!b_ok(meo_file_read_at(f, 8192, rb.data, 4096) == 4096, "read 4096 at 8192 returns 4096")) {
    return 1;
  }
  if (!b_ok(b_same(ra.data, a.data, 8192), "first 8192 bytes read back")) { return 1; }
  if (!b_ok(b_same(rb.data, b.data, 4096), "next 4096 bytes read back")) { return 1; }

  // read_at reports what the file has: a count, 0 at EOF, never a padded len.
  if (!b_ok(meo_file_read_at(f, 12288, rb.data, 16) == 0, "read at EOF returns 0")) { return 1; }
  if (!b_ok(meo_file_read_at(f, 20000, rb.data, 16) == 0, "read past EOF returns 0")) { return 1; }
  if (!b_ok(meo_file_read_at(f, 12280, rb.data, 16) == 8, "short read returns what exists")) {
    return 1;
  }
  if (!b_ok(b_same(rb.data, b.data + 4088, 8), "short read has the tail bytes")) { return 1; }
  if (!b_ok(meo_file_read_at(f, 0, ra.data, 0) == 0, "zero-length read is 0")) { return 1; }
  // The count is an int32, so a request that cannot be reported is refused
  // instead of being truncated into a bogus count.
  if (!b_ok(meo_file_read_at(f, 0, ra.data, (int64)1 << 31) == -MEO_ERR_USAGE,
            "read longer than INT32_MAX is USAGE")) { return 1; }

  // close is idempotent and a closed handle is a usage error for every op.
  if (!b_ok(meo_file_close(f) == MEO_OK, "close returns MEO_OK")) { return 1; }
  if (!b_ok(meo_file_close(f) == MEO_OK, "close twice is MEO_OK")) { return 1; }
  if (!b_ok(meo_file_sync(f) == -MEO_ERR_USAGE, "sync on a closed handle is USAGE")) { return 1; }
  if (!b_ok(meo_file_read_at(f, 0, ra.data, 8) == -MEO_ERR_USAGE, "read on closed is USAGE")) {
    return 1;
  }
  if (!b_ok(meo_file_write_at(f, 0, ra.data, 8) == -MEO_ERR_USAGE, "write on closed is USAGE")) {
    return 1;
  }
  if (!b_ok(meo_file_size(f) == (int64)(0 - MEO_ERR_USAGE), "size on closed is USAGE")) { return 1; }
  var zero_handle: MeoFile = { handle: 0, is_open: false };
  if (!b_ok(meo_file_close(zero_handle) == MEO_OK, "close of a zeroed handle is MEO_OK")) { return 1; }

  // Reopen read-only: the bytes are durable and the mode is honoured.
  var r: MeoFile = meo_file_open(B_DB, MEO_OPEN_READ);
  if (!b_ok(r.is_open, "reopen read-only")) { return 1; }
  if (!b_ok(meo_file_size(r) == 12288, "size survives close")) { return 1; }
  var rc: uint8[] = new uint8[8192];
  if (!b_ok(meo_file_read_at(r, 0, rc.data, 8192) == 8192, "read after reopen")) { return 1; }
  if (!b_ok(b_same(rc.data, a.data, 8192), "content survives close")) { return 1; }
  // EBADF (a write on an O_RDONLY descriptor) is a bad state, so USAGE; the
  // platform layer has no READONLY code, the pager owns that decision.
  if (!b_ok(meo_file_write_at(r, 0, a.data, 1) == -MEO_ERR_USAGE,
            "write on a read-only fd is USAGE")) { return 1; }
  if (!b_ok(meo_file_close(r) == MEO_OK, "close read-only")) { return 1; }
  return 0;
}

fn b_file_errors() -> int32 {
  var missing: MeoFile = meo_file_open("build/tmp_b_self_missing.dat", MEO_OPEN_READ);
  if (!b_ok(!missing.is_open, "open of a missing file fails")) { return 1; }
  if (!b_ok(missing.handle == (int64)(0 - MEO_ERR_IO), "missing file maps to IO")) { return 1; }

  var nodir: MeoFile = meo_file_open("build/tmp_b_self_no_dir/x.dat", MEO_OPEN_WRITE | MEO_OPEN_CREATE);
  if (!b_ok(!nodir.is_open, "open in a missing directory fails")) { return 1; }
  if (!b_ok(nodir.handle == (int64)(0 - MEO_ERR_IO), "missing directory maps to IO")) { return 1; }

  var noflags: MeoFile = meo_file_open(B_DB, 0);
  if (!b_ok(!noflags.is_open, "open with no read/write fails")) { return 1; }
  if (!b_ok(noflags.handle == (int64)(0 - MEO_ERR_USAGE), "no access mode is USAGE")) { return 1; }

  var nopath: MeoFile = meo_file_open("", MEO_OPEN_READ);
  if (!b_ok(!nopath.is_open, "open of an empty path fails")) { return 1; }
  if (!b_ok(nopath.handle == (int64)(0 - MEO_ERR_USAGE), "empty path is USAGE")) { return 1; }

  var excl: MeoFile = meo_file_open(B_DB, MEO_OPEN_WRITE | MEO_OPEN_CREATE | MEO_OPEN_EXCL);
  if (!b_ok(!excl.is_open, "exclusive create of an existing file fails")) { return 1; }

  // A closed struct is a value; every op on it is USAGE, not a crash.
  var closed: MeoFile = { handle: (int64)(0 - MEO_ERR_IO), is_open: false };
  if (!b_ok(meo_file_truncate(closed, 0) == -MEO_ERR_USAGE, "truncate on a failed open is USAGE")) {
    return 1;
  }
  return 0;
}

fn b_file_rename() -> int32 {
  // rename replaces its destination, so clearing the endpoints this way is
  // idempotent across runs; a missing source is an expected IO failure.
  var _c1: int32 = meo_file_rename(B_EXCL, B_SCRATCH);
  var _c2: int32 = meo_file_rename(B_RENAMED, B_SCRATCH);

  var fresh: MeoFile = meo_file_open(B_EXCL, MEO_OPEN_WRITE | MEO_OPEN_CREATE | MEO_OPEN_EXCL);
  if (!b_ok(fresh.is_open, "exclusive create of a new file")) { return 1; }
  var one: uint8[] = new uint8[1];
  one[0] = 42;
  if (!b_ok(meo_file_write_at(fresh, 0, one.data, 1) == MEO_OK, "write one byte")) { return 1; }
  if (!b_ok(meo_file_close(fresh) == MEO_OK, "close before rename")) { return 1; }

  if (!b_ok(meo_file_rename(B_EXCL, B_RENAMED) == MEO_OK, "rename returns MEO_OK")) { return 1; }
  var gone: MeoFile = meo_file_open(B_EXCL, MEO_OPEN_READ);
  if (!b_ok(!gone.is_open, "rename removed the old name")) { return 1; }
  var moved: MeoFile = meo_file_open(B_RENAMED, MEO_OPEN_READ);
  if (!b_ok(moved.is_open, "rename created the new name")) { return 1; }
  var back: uint8[] = new uint8[1];
  if (!b_ok(meo_file_read_at(moved, 0, back.data, 1) == 1, "renamed file keeps its bytes")) {
    return 1;
  }
  if (!b_ok(back[0] == 42, "renamed file content")) { return 1; }
  if (!b_ok(meo_file_close(moved) == MEO_OK, "close after rename")) { return 1; }

  if (!b_ok(meo_file_rename("build/tmp_b_self_missing.dat", B_SCRATCH) == -MEO_ERR_IO,
            "rename of a missing file is IO")) { return 1; }
  if (!b_ok(meo_file_rename(B_RENAMED, "") == -MEO_ERR_USAGE, "rename to an empty path is USAGE")) {
    return 1;
  }
  return 0;
}

// ---- mem/arena --------------------------------------------------------------

// Shared by main() and the interpreter @test: pure arena behaviour, no files.
// Codes identify the case that failed.
fn b_arena_contract() -> int32 {
  var a: MeoArena* = meo_arena_new(256);
  if (a == 0) { return 1; }
  if (a->chunk != 256) { return 2; }

  // Bad sizes are refused, not truncated into a bogus pointer.
  if (meo_arena_alloc(a, 0) != 0) { return 3; }
  if (meo_arena_alloc(a, -8) != 0) { return 4; }
  if (meo_arena_alloc(a, (int64)1 << 42) != 0) { return 5; }
  if (meo_arena_new(0) != 0) { return 6; }
  if (meo_arena_new(-1) != 0) { return 7; }
  if (meo_arena_alloc(0, 8) != 0) { return 8; }

  var p1: uint8* = meo_arena_alloc(a, 16);
  if (p1 == 0) { return 9; }
  var i: int64 = 0;
  while (i < 16) {
    p1[i] = (uint8)171;
    i = i + 1;
  }
  var p2: uint8* = meo_arena_alloc(a, 16);
  if (p2 == 0) { return 10; }
  if ((int64)p2 - (int64)p1 != 16) { return 11; }  // bump, no overlap

  // The current chunk cannot serve these, so new chunks appear; every
  // returned block must still be distinct and writable.
  var slots: uint8*[8];
  var k: int32 = 0;
  while (k < 8) {
    var p: uint8* = meo_arena_alloc(a, 200);
    if (p == 0) { return 12; }
    slots[k] = p;
    p[0] = (uint8)k;
    p[199] = (uint8)(k + 1);
    k = k + 1;
  }
  k = 0;
  while (k < 8) {
    if (slots[k][0] != (uint8)k) { return 13; }
    if (slots[k][199] != (uint8)(k + 1)) { return 14; }
    k = k + 1;
  }

  // Larger than the chunk: a dedicated chunk, fully usable.
  var huge: uint8* = meo_arena_alloc(a, 4096);
  if (huge == 0) { return 15; }
  huge[0] = 1;
  huge[4095] = 2;
  if (huge[4095] != 2) { return 16; }
  if (a->owns <= 256) { return 17; }  // it really owns more than one chunk

  // reset keeps the first chunk: the first allocation lands where it did the
  // first time, and the stale bytes it holds must not leak through alloc_zeroed.
  meo_arena_reset(a);
  if (a->owns != 16 + 256) { return 18; }
  var z: uint8* = meo_arena_alloc_zeroed(a, 16);
  if (z == 0) { return 19; }
  if (z != p1) { return 20; }
  i = 0;
  while (i < 16) {
    if (z[i] != 0) { return 21; }
    i = i + 1;
  }
  var p3: uint8* = meo_arena_alloc(a, 16);
  if (p3 == 0) { return 22; }
  if ((int64)p3 - (int64)z != 16) { return 23; }

  // A chunk that was freed by reset is gone, but allocating still works.
  var big: uint8* = meo_arena_alloc(a, 1000);
  if (big == 0) { return 24; }
  big[999] = 5;
  if (big[999] != 5) { return 25; }

  meo_arena_free(a);
  meo_arena_free(0);  // a null arena is a no-op
  return 0;
}

fn b_arena() -> int32 {
  var rc: int32 = b_arena_contract();
  if (!b_ok(rc == 0, "arena contract")) {
    println("  arena case {rc}");
    return 1;
  }
  return 0;
}

// ---- entry points -----------------------------------------------------------

@test fn b_flags_are_the_api() -> int64 {
  return (int64)b_flags_contract();
}

@test fn b_arena_rules() -> int64 {
  return (int64)b_arena_contract();
}

fn main() -> int32 {
  if (b_flags_contract() != 0) {
    println("FAIL b_self: flag contract");
    return 1;
  }
  if (b_file_io() != 0) { return 1; }
  if (b_file_errors() != 0) { return 1; }
  if (b_file_rename() != 0) { return 1; }
  if (b_arena() != 0) { return 1; }

  if (b_failures != 0) {
    println("FAIL b_self: {b_failures} failure(s)");
    return 1;
  }
  println("PASS b_self");
  return 0;
}
