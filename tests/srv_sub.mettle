// srv_sub: SUBSCRIBE and the push stream over the wire, against the server
// embedded on 127.0.0.1 port 0, once on a WAL database and once on a
// rollback-journal one. A writer connection commits while a second connection
// watches: events arrive in commit order with their values, the alias column
// carries the rowid, an UPDATE brings the old row, a new table or an ADD COLUMN
// is announced by a SCHEMA event, the window caps what is in flight, a
// subscriber that stops reading gets a GAP while the writer carries on,
// from_seq and from_commit resume without a hole or a repeat, and a v1 client
// sees nothing new.

import "std/io";
import "std/mem";
import "std/thread";
import "../src/error/status.mettle";
import "../src/platform/file.mettle";
import "../src/platform/file_linux.mettle";
import "../src/platform/clock_linux.mettle";
import "../src/meo_server.mettle";
import "srv_client.mettle";

const SUB_DB: string = "build/srv_sub.db";
const SUB_HB_MS: int32 = 300;
const SUB_CAP: int32 = 4096;
const SUB_LAT_N: int32 = 1000;
const SUB_P99_MS: int64 = 50;
const SUB_JOIN_MS: uint32 = 120000;

// What the tests look at in one event; the frame it came in is gone by the
// next ss_recv.
struct SubEv {
  seq: uint64;
  commit: uint64;
  at: int64;           // when its frame arrived, monotonic us
  kind: int32;
  table: uint32;
  rowid: int64;
  old_rowid: int64;
  n_vals: int32;
  n_old: int32;
  id: int64;           // vals[0]
  v: float64;          // vals[1]
  tlen: int32;         // vals[2], a TEXT
  v3_null: bool;       // vals[3] is NULL
  ov: float64;         // old[1]
  name_len: int32;     // SCHEMA
  name0: int32;
  n_cols: int32;
}

var g_port: int32 = 0;
var g_ev: SubEv* = 0;
var g_n_ev: int32 = 0;
var g_tsend: int64[1024];            // latency: when row i was sent
var g_lat_bad: int32 = 0;

fn sub_fail(msg: string) -> int32 {
  println("FAIL srv_sub: {msg}");
  return 1;
}

fn sub_reset(db: string) -> int32 {
  var f: MeoFile = meo_file_open(db, MEO_OPEN_READ | MEO_OPEN_WRITE | MEO_OPEN_CREATE);
  if (!f.is_open) { return -MEO_ERR_IO; }
  var rc: int32 = meo_file_truncate(f, 0);
  meo_file_close(f);
  var jpath: string = db + "-journal";
  meo_file_unlink(jpath);
  free(jpath.chars);
  var wpath: string = db + "-wal";
  meo_file_unlink(wpath);
  free(wpath.chars);
  return rc;
}

fn sub_timeout(c: SsC*, ms: int32) {
  meo_sock_set_recv_timeout(c->fd, ms);
}

// Take the events of the next EVENTS frames into g_ev (appending) until `want`
// are held or timeout_ms has passed; heartbeats are skipped. 0, or a negative
// code for any other frame.
fn sub_collect(c: SsC*, want: int32, timeout_ms: int32) -> int32 {
  var end: int64 = meo_clock_monotonic_us() + (int64)timeout_ms * (int64)1000;
  while (g_n_ev < want) {
    var left: int64 = (end - meo_clock_monotonic_us()) / 1000;
    if (left < 1) { return 0; }
    sub_timeout(c, (int32)left);
    var k: int32 = ss_recv(c);
    if (k == -MEO_ERR_TIMEOUT) { return 0; }
    if (k != MEO_WIRE_K_EVENTS || c->hdr.rid != 0) { return -MEO_ERR_PROTO; }
    var now: int64 = meo_clock_monotonic_us();
    var i: int32 = 0;
    while (i < c->evs.n && g_n_ev < SUB_CAP) {
      var e: MeoWEvent* = &c->evs.ev[i];
      var o: SubEv* = &g_ev[g_n_ev];
      o->seq = e->seq;
      o->commit = e->commit_seq;
      o->at = now;
      o->kind = e->kind;
      o->table = e->table_id;
      o->rowid = e->rowid;
      o->old_rowid = e->old_rowid;
      o->n_vals = e->n_vals;
      o->n_old = e->n_old;
      o->id = 0;
      o->v = 0.0;
      o->tlen = 0;
      o->v3_null = false;
      o->ov = 0.0;
      o->name_len = (int32)e->name.length;
      o->name0 = 0;
      if (e->name.length > 0) { o->name0 = (int32)e->name.chars[0]; }
      o->n_cols = e->n_cols;
      if (e->n_vals >= 3) {
        o->id = e->vals[0].i;
        o->v = e->vals[1].f;
        o->tlen = e->vals[2].n;
      }
      if (e->n_vals >= 4) { o->v3_null = e->vals[3].type == MEO_T_NULL; }
      if (e->n_old >= 2) { o->ov = e->old[1].f; }
      g_n_ev += 1;
      i += 1;
    }
  }
  return 0;
}

fn sub_clear() {
  g_n_ev = 0;
}

// Subscribe to one table (or all, name ""): the SUB_OK kind.
fn sub_open_one(c: SsC*, table: string, from_seq: uint64, from_commit: uint64, window: uint32) -> int32 {
  var names: string[1];
  names[0] = table;
  var n: int32 = 1;
  if (table.length == 0) { n = 0; }
  return ss_subscribe(c, n, &names[0], from_seq, from_commit, window);
}

fn sub_ping_ok(c: SsC*) -> bool {
  meo_wbuf_begin(&c->w);
  ss_send(c, MEO_WIRE_K_PING);
  return ss_answer(c) == MEO_WIRE_K_OK;
}

// Unsubscribe and wait for the OK (pushes before it are fine).
fn sub_unsubscribe(c: SsC*) -> bool {
  meo_wbuf_begin(&c->w);
  ss_send(c, MEO_WIRE_K_UNSUBSCRIBE);
  sub_timeout(c, 5000);
  return ss_answer(c) == MEO_WIRE_K_OK;
}

// An error answer to the last request: its code, or -1 for anything else.
fn sub_err_code(c: SsC*) -> int32 {
  if (ss_answer(c) != MEO_WIRE_K_ERROR) { return -1; }
  if (c->err.fatal) { return -2; }
  return c->err.code;
}

// ---- cases ----

fn sub_basic(w: SsC*, c: SsC*) -> int32 {
  if (!ss_create(w, "a", "v", MEO_T_REAL, "name", MEO_T_TEXT)) { return sub_fail("create a"); }
  if (!ss_create(w, "b", "v", MEO_T_REAL, "name", MEO_T_TEXT)) { return sub_fail("create b"); }
  if (sub_open_one(c, "a", 0, 0, 1000) != MEO_WIRE_K_SUB_OK) { return sub_fail("subscribe a"); }
  var tabs: MeoWSubTable* = c->ok.tables;
  if (c->ok.n_tables != 1 || tabs[0].name.length != 1 || tabs[0].n_cols != 3
      || tabs[0].cols[0].ty != MEO_T_INT || tabs[0].cols[1].ty != MEO_T_REAL
      || tabs[0].cols[2].ty != MEO_T_TEXT || c->ok.heartbeat_ms != (uint32)SUB_HB_MS) {
    return sub_fail("sub_ok: {c->ok.n_tables} tables, heartbeat {c->ok.heartbeat_ms}");
  }
  var tid: uint32 = tabs[0].id;
  var commit0: uint64 = c->ok.commit_seq;
  if (!ss_insert(w, "a", "v", "name", 1, 1.5, "x")) { return sub_fail("insert a1"); }
  if (!ss_insert(w, "b", "v", "name", 1, 7.5, "b")) { return sub_fail("insert b1"); }
  if (!ss_insert(w, "a", "v", "name", 2, 2.5, "yy")) { return sub_fail("insert a2"); }
  if (!ss_update(w, "a", "v", 9.5, 2)) { return sub_fail("update a2"); }
  if (!ss_delete(w, "a", 1)) { return sub_fail("delete a1"); }
  sub_clear();
  if (sub_collect(c, 4, 2000) != 0 || g_n_ev != 4) { return sub_fail("basic: {g_n_ev} events, want 4 (only table a)"); }
  var e: SubEv* = g_ev;
  if (e[0].kind != MEO_WIRE_EV_INSERT || e[0].table != tid || e[0].rowid != 1 || e[0].n_vals != 3
      || e[0].id != 1 || e[0].v != 1.5 || e[0].tlen != 1 || e[0].n_old != 0) {
    return sub_fail("event 0: kind {e[0].kind} rowid {e[0].rowid} id {e[0].id} v {e[0].v}");
  }
  if (e[1].kind != MEO_WIRE_EV_INSERT || e[1].rowid != 2 || e[1].id != 2 || e[1].v != 2.5 || e[1].tlen != 2) {
    return sub_fail("event 1: kind {e[1].kind} rowid {e[1].rowid} id {e[1].id} v {e[1].v}");
  }
  if (e[2].kind != MEO_WIRE_EV_UPDATE || e[2].rowid != 2 || e[2].old_rowid != 2 || e[2].v != 9.5
      || e[2].n_old != 3 || e[2].ov != 2.5 || e[2].id != 2) {
    return sub_fail("event 2: kind {e[2].kind} v {e[2].v} n_old {e[2].n_old} old v {e[2].ov}");
  }
  if (e[3].kind != MEO_WIRE_EV_DELETE || e[3].rowid != 1 || e[3].n_vals != 3 || e[3].id != 1
      || e[3].v != 1.5 || e[3].n_old != 0) {
    return sub_fail("event 3: kind {e[3].kind} rowid {e[3].rowid} v {e[3].v}");
  }
  var i: int32 = 1;
  while (i < 4) {
    if (e[i].seq <= e[i - 1].seq || e[i].commit <= e[i - 1].commit) { return sub_fail("event {i} out of order"); }
    i += 1;
  }
  if (e[0].commit <= commit0) { return sub_fail("first event commit {e[0].commit} not after SUB_OK commit {commit0}"); }
  if (ss_ack(c, e[3].seq) < 0) { return sub_fail("ack"); }
  if (!sub_unsubscribe(c)) { return sub_fail("unsubscribe"); }
  return 0;
}

// All tables: a table created later is announced before its first row.
fn sub_all_tables(w: SsC*, c: SsC*) -> int32 {
  if (sub_open_one(c, "", 0, 0, 1000) != MEO_WIRE_K_SUB_OK) { return sub_fail("subscribe all"); }
  if (c->ok.n_tables < 2) { return sub_fail("subscribe all lists {c->ok.n_tables} tables"); }
  if (!ss_insert(w, "b", "v", "name", 2, 3.5, "bb")) { return sub_fail("insert b2"); }
  if (!ss_create(w, "c", "v", MEO_T_REAL, "name", MEO_T_TEXT)) { return sub_fail("create c"); }
  if (!ss_insert(w, "c", "v", "name", 5, 4.5, "c")) { return sub_fail("insert c5"); }
  sub_clear();
  if (sub_collect(c, 3, 2000) != 0 || g_n_ev != 3) { return sub_fail("all: {g_n_ev} events, want 3"); }
  var e: SubEv* = g_ev;
  if (e[0].kind != MEO_WIRE_EV_INSERT || e[0].id != 2 || e[0].v != 3.5) { return sub_fail("all: b2 first, got kind {e[0].kind}"); }
  if (e[1].kind != MEO_WIRE_EV_SCHEMA || e[1].name_len != 1 || e[1].name0 != 99 || e[1].n_cols != 3
      || e[1].table != e[2].table) {
    return sub_fail("all: SCHEMA kind {e[1].kind} name_len {e[1].name_len} n_cols {e[1].n_cols}");
  }
  if (e[2].kind != MEO_WIRE_EV_INSERT || e[2].rowid != 5 || e[2].id != 5 || e[2].v != 4.5) { return sub_fail("all: c5 kind {e[2].kind}"); }
  if (e[1].seq < e[0].seq || e[1].seq >= e[2].seq) { return sub_fail("all: SCHEMA seq {e[1].seq} not between {e[0].seq} and {e[2].seq}"); }
  if (!sub_unsubscribe(c)) { return sub_fail("unsubscribe"); }
  return 0;
}

// ADD COLUMN: the next event of the table brings its new shape, and rows written
// before the column read it as NULL.
fn sub_add_column(w: SsC*, c: SsC*) -> int32 {
  if (sub_open_one(c, "a", 0, 0, 1000) != MEO_WIRE_K_SUB_OK) { return sub_fail("subscribe a"); }
  if (!ss_insert(w, "a", "v", "name", 10, 1.0, "old")) { return sub_fail("insert a10"); }
  // The row is delivered before the column exists: the stream shows the schema
  // of the moment each event is read, so without this wait the insert could
  // already come with four values.
  sub_clear();
  if (sub_collect(c, 1, 2000) != 0 || g_n_ev != 1) { return sub_fail("add column: insert not delivered"); }
  if (!ss_add_column(w, "a", "extra", MEO_T_INT)) { return sub_fail("add column"); }
  if (!ss_update(w, "a", "v", 2.0, 10)) { return sub_fail("update a10"); }
  if (sub_collect(c, 4, 2000) != 0 || g_n_ev != 3) { return sub_fail("add column: {g_n_ev} events, want 3"); }
  var e: SubEv* = g_ev;
  if (e[0].kind != MEO_WIRE_EV_INSERT || e[0].n_vals != 3) { return sub_fail("add column: insert had {e[0].n_vals} values"); }
  if (e[1].kind != MEO_WIRE_EV_SCHEMA || e[1].n_cols != 4 || e[1].name0 != 97) { return sub_fail("add column: SCHEMA kind {e[1].kind} n_cols {e[1].n_cols}"); }
  if (e[2].kind != MEO_WIRE_EV_UPDATE || e[2].n_vals != 4 || e[2].n_old != 4 || !e[2].v3_null || e[2].v != 2.0 || e[2].ov != 1.0) {
    return sub_fail("add column: update n_vals {e[2].n_vals} n_old {e[2].n_old} v {e[2].v}");
  }
  if (!sub_unsubscribe(c)) { return sub_fail("unsubscribe"); }
  return 0;
}

// ---- latency ----

fn sub_lat_writer(arg: cstring) -> uint32 {
  var w: SsC* = (SsC*)arg;
  var i: int32 = 1;
  while (i <= SUB_LAT_N) {
    g_tsend[i] = meo_clock_monotonic_us();
    if (!ss_insert(w, "lat", "v", "name", (int64)i, 1.0, "z")) { g_lat_bad += 1; }
    i += 1;
  }
  return 0;
}

fn sub_sort(a: int64*, n: int32) {
  var i: int32 = 1;
  while (i < n) {
    var x: int64 = a[i];
    var j: int32 = i - 1;
    while (j >= 0 && a[j] > x) {
      a[j + 1] = a[j];
      j -= 1;
    }
    a[j + 1] = x;
    i += 1;
  }
}

// 1000 autocommit inserts from another thread: every event reaches the
// subscriber within 50 ms of its statement being sent (p99), in commit order.
fn sub_latency(w: SsC*, c: SsC*) -> int32 {
  if (!ss_create(w, "lat", "v", MEO_T_REAL, "name", MEO_T_TEXT)) { return sub_fail("create lat"); }
  if (sub_open_one(c, "lat", 0, 0, 2000) != MEO_WIRE_K_SUB_OK) { return sub_fail("subscribe lat"); }
  sub_clear();
  g_lat_bad = 0;
  var h: int64 = CreateThread(0, 0, &sub_lat_writer, (cstring)w, 0, 0);
  if (h == 0) { return sub_fail("thread"); }
  var got: int32 = 0;
  var lat: int64[] = new int64[SUB_LAT_N];
  var acked: int32 = 0;
  var bad: int32 = 0;
  while (got < SUB_LAT_N && bad == 0) {
    sub_clear();
    if (sub_collect(c, 1, 5000) != 0 || g_n_ev == 0) {
      bad = sub_fail("latency: only {got} of {SUB_LAT_N} events");
      break;
    }
    var i: int32 = 0;
    while (i < g_n_ev && got < SUB_LAT_N) {
      var e: SubEv* = &g_ev[i];
      if (e->kind != MEO_WIRE_EV_INSERT || e->rowid != (int64)got + 1) {
        bad = sub_fail("latency: event {got} is kind {e->kind} rowid {e->rowid}");
        break;
      }
      lat[got] = e->at - g_tsend[got + 1];
      got += 1;
      i += 1;
    }
    if (bad == 0 && got - acked >= 100) {
      ss_ack(c, g_ev[g_n_ev - 1].seq);
      acked = got;
    }
  }
  thread_join(h, SUB_JOIN_MS);
  thread_close(h);
  if (bad != 0) { return bad; }
  if (g_lat_bad != 0) { return sub_fail("latency: {g_lat_bad} inserts failed"); }
  sub_sort(lat.data, SUB_LAT_N);
  var p50: int64 = lat[SUB_LAT_N / 2];
  var p99: int64 = lat[SUB_LAT_N * 99 / 100];
  var max: int64 = lat[SUB_LAT_N - 1];
  println("latency over {SUB_LAT_N} commits: p50 {p50} us, p99 {p99} us, max {max} us");
  free(lat.data);
  if (p99 > SUB_P99_MS * 1000) { return sub_fail("latency p99 {p99} us"); }
  if (!sub_unsubscribe(c)) { return sub_fail("unsubscribe"); }
  return 0;
}

// ---- flow control ----

// Window 10, 50 rows committed: 10 arrive, no more until an ACK, and never more
// than 10 are unacknowledged.
fn sub_window(w: SsC*, c: SsC*) -> int32 {
  if (!ss_create(w, "win", "v", MEO_T_REAL, "name", MEO_T_TEXT)) { return sub_fail("create win"); }
  if (sub_open_one(c, "win", 0, 0, 10) != MEO_WIRE_K_SUB_OK) { return sub_fail("subscribe win"); }
  var i: int32 = 1;
  while (i <= 50) {
    if (!ss_insert(w, "win", "v", "name", (int64)i, 1.0, "w")) { return sub_fail("insert win {i}"); }
    i += 1;
  }
  sub_clear();
  if (sub_collect(c, 50, 400) != 0 || g_n_ev != 10) { return sub_fail("window: {g_n_ev} events before any ACK, want 10"); }
  var acked: int32 = 0;
  var got: int32 = 10;
  // ACK in steps of 5: each step opens room for exactly five more.
  while (got < 50) {
    if (ss_ack(c, g_ev[acked + 4].seq) < 0) { return sub_fail("ack"); }
    acked += 5;
    if (sub_collect(c, 50, 400) != 0) { return sub_fail("window collect"); }
    if (g_n_ev - acked > 10) { return sub_fail("window: {g_n_ev - acked} unacked in flight"); }
    if (g_n_ev != acked + 10) { return sub_fail("window: {g_n_ev} events after {acked} acked, want {acked + 10}"); }
    got = g_n_ev;
  }
  var j: int32 = 0;
  while (j < 50) {
    if (g_ev[j].rowid != (int64)j + 1) { return sub_fail("window: event {j} is rowid {g_ev[j].rowid}"); }
    j += 1;
  }
  if (!sub_unsubscribe(c)) { return sub_fail("unsubscribe"); }
  return 0;
}

// ---- resume ----

fn sub_resume(w: SsC*, c: SsC*) -> int32 {
  if (!ss_create(w, "r", "v", MEO_T_REAL, "name", MEO_T_TEXT)) { return sub_fail("create r"); }
  if (sub_open_one(c, "r", 0, 0, 100) != MEO_WIRE_K_SUB_OK) { return sub_fail("subscribe r"); }
  var i: int32 = 1;
  while (i <= 5) {
    if (!ss_insert(w, "r", "v", "name", (int64)i, 1.0, "r")) { return sub_fail("insert r"); }
    i += 1;
  }
  sub_clear();
  if (sub_collect(c, 5, 2000) != 0 || g_n_ev != 5) { return sub_fail("resume: {g_n_ev} events, want 5"); }
  var seq3: uint64 = g_ev[2].seq;
  var seq4: uint64 = g_ev[3].seq;
  var seq5: uint64 = g_ev[4].seq;
  ss_close(c);
  if (ss_open(c, g_port, MEO_WIRE_MINOR) != MEO_OK) { return sub_fail("reconnect"); }
  // After the third event: the fourth and fifth, with the seqs they had.
  if (sub_open_one(c, "r", seq3 + 1, 0, 100) != MEO_WIRE_K_SUB_OK) { return sub_fail("resubscribe"); }
  if (c->ok.start_seq != seq3 + 1) { return sub_fail("start_seq {c->ok.start_seq}, want {seq3 + 1}"); }
  sub_clear();
  if (sub_collect(c, 3, 400) != 0 || g_n_ev != 2 || g_ev[0].seq != seq4 || g_ev[1].seq != seq5
      || g_ev[0].rowid != 4 || g_ev[1].rowid != 5) {
    return sub_fail("resume: {g_n_ev} events after seq {seq3}");
  }
  if (!ss_insert(w, "r", "v", "name", 6, 1.0, "r")) { return sub_fail("insert r6"); }
  if (sub_collect(c, 3, 2000) != 0 || g_n_ev != 3 || g_ev[2].rowid != 6 || g_ev[2].seq <= seq5) {
    return sub_fail("resume: row 6 not delivered ({g_n_ev})");
  }
  if (!sub_unsubscribe(c)) { return sub_fail("unsubscribe"); }

  // from_seq 0: only what comes after.
  if (sub_open_one(c, "r", 0, 0, 100) != MEO_WIRE_K_SUB_OK) { return sub_fail("subscribe from now"); }
  sub_clear();
  if (sub_collect(c, 1, 300) != 0 || g_n_ev != 0) { return sub_fail("from_seq 0 replayed {g_n_ev} events"); }
  if (!ss_insert(w, "r", "v", "name", 7, 1.0, "r")) { return sub_fail("insert r7"); }
  if (sub_collect(c, 1, 2000) != 0 || g_n_ev != 1 || g_ev[0].rowid != 7) { return sub_fail("from now: row 7 ({g_n_ev})"); }
  if (!sub_unsubscribe(c)) { return sub_fail("unsubscribe"); }

  // A seq from another life of the server: a GAP first, then the stream.
  if (sub_open_one(c, "r", 1099511627776, 0, 100) != MEO_WIRE_K_SUB_OK) { return sub_fail("subscribe far seq"); }
  sub_clear();
  if (sub_collect(c, 1, 2000) != 0 || g_n_ev != 1 || g_ev[0].kind != MEO_WIRE_EV_GAP || g_ev[0].table != 0) {
    return sub_fail("far from_seq: {g_n_ev} events, first kind {g_ev[0].kind}");
  }
  if (!ss_insert(w, "r", "v", "name", 8, 1.0, "r")) { return sub_fail("insert r8"); }
  if (sub_collect(c, 2, 2000) != 0 || g_n_ev != 2 || g_ev[1].rowid != 8) { return sub_fail("after the GAP: row 8 ({g_n_ev})"); }
  if (!sub_unsubscribe(c)) { return sub_fail("unsubscribe"); }
  return 0;
}

// SCAN, read its commit_seq S, SUBSCRIBE from_commit S: every later commit once.
fn sub_from_commit(w: SsC*, c: SsC*, early: uint64) -> int32 {
  if (!ss_create(w, "fc", "v", MEO_T_REAL, "g", MEO_T_INT)) { return sub_fail("create fc"); }
  if (!ss_insert_bulk(w, "fc", 1, 3)) { return sub_fail("insert fc"); }
  if (ss_scan(c, "fc", "id", "v", "", -1.0e12, 1.0e12, 100) < 0) { return sub_fail("send scan"); }
  if (ss_recv(c) != MEO_WIRE_K_SCAN_ROWS || !c->head.last || c->head.n != 3) { return sub_fail("scan fc"); }
  var s: uint64 = c->head.commit_seq;
  if (!ss_insert_bulk(w, "fc", 4, 2)) { return sub_fail("insert fc 4"); }
  if (!ss_insert_bulk(w, "fc", 6, 1)) { return sub_fail("insert fc 6"); }
  if (sub_open_one(c, "fc", 0, s, 100) != MEO_WIRE_K_SUB_OK) { return sub_fail("subscribe from_commit"); }
  sub_clear();
  if (sub_collect(c, 4, 400) != 0 || g_n_ev != 3) { return sub_fail("from_commit: {g_n_ev} events, want 3"); }
  if (g_ev[0].rowid != 4 || g_ev[1].rowid != 5 || g_ev[2].rowid != 6) { return sub_fail("from_commit rows {g_ev[0].rowid} {g_ev[1].rowid} {g_ev[2].rowid}"); }
  if (g_ev[0].commit <= s) { return sub_fail("from_commit delivered commit {g_ev[0].commit} <= {s}"); }
  // The commit the subscription starts from is in SUB_OK's reach: at S there is nothing to replay.
  if (!ss_insert_bulk(w, "fc", 7, 1)) { return sub_fail("insert fc 7"); }
  if (sub_collect(c, 4, 2000) != 0 || g_n_ev != 4 || g_ev[3].rowid != 7) { return sub_fail("from_commit: live row 7 ({g_n_ev})"); }
  if (!sub_unsubscribe(c)) { return sub_fail("unsubscribe"); }

  // A commit older than the feed itself: commits were missed, so a GAP leads.
  if (sub_open_one(c, "fc", 0, early, 100) != MEO_WIRE_K_SUB_OK) { return sub_fail("subscribe old from_commit"); }
  sub_clear();
  if (sub_collect(c, 1, 2000) != 0 || g_n_ev < 1 || g_ev[0].kind != MEO_WIRE_EV_GAP) {
    return sub_fail("old from_commit: first event kind {g_ev[0].kind}, want GAP");
  }
  if (g_ev[0].commit < s) { return sub_fail("GAP commit_seq {g_ev[0].commit} behind {s}"); }
  if (!sub_unsubscribe(c)) { return sub_fail("unsubscribe"); }
  return 0;
}

// ---- a subscriber that stops reading ----

fn sub_bulk(w: SsC*, table: string, first: int64, stmts: int32, ms_max: int64*) -> int32 {
  var i: int32 = 0;
  ms_max[0] = 0;
  var total: int64 = 0;
  while (i < stmts) {
    var t0: int64 = meo_clock_monotonic_us();
    if (!ss_insert_bulk(w, table, first + (int64)i * 1000, 1000)) { return -1; }
    var ms: int64 = (meo_clock_monotonic_us() - t0) / 1000;
    total += ms;
    if (ms > ms_max[0]) { ms_max[0] = ms; }
    i += 1;
  }
  return (int32)(total / (int64)stmts);
}

// Window 10 and no ACK while 70000 events are committed: the ring (65536)
// wraps. The writer is not slowed; the first event after the ACK is a GAP.
fn sub_slow(w: SsC*, c: SsC*) -> int32 {
  if (!ss_create(w, "s0", "v", MEO_T_REAL, "g", MEO_T_INT)) { return sub_fail("create s0"); }
  if (!ss_create(w, "s", "v", MEO_T_REAL, "g", MEO_T_INT)) { return sub_fail("create s"); }
  var mx: int64 = 0;
  var base: int32 = sub_bulk(w, "s0", 1, 20, &mx);
  if (base < 0) { return sub_fail("baseline inserts"); }
  if (sub_open_one(c, "s", 0, 0, 10) != MEO_WIRE_K_SUB_OK) { return sub_fail("subscribe s"); }
  var avg: int32 = sub_bulk(w, "s", 1, 70, &mx);
  if (avg < 0) { return sub_fail("inserts beside a stalled subscriber"); }
  println("writer: {base} ms per 1000-row commit alone, {avg} ms (max {mx}) beside a subscriber that stopped reading");
  if (avg > base * 3 + 20 || mx > 2000) { return sub_fail("writer slowed by a stalled subscriber: avg {avg} ms vs {base}, max {mx}"); }
  sub_clear();
  if (sub_collect(c, 100, 300) != 0 || g_n_ev != 10) { return sub_fail("slow: {g_n_ev} events with no ACK, want 10"); }
  // The server already holds a batch it read before the ring wrapped; that is
  // still good data and arrives first, in order. Then comes the GAP.
  var gap: int32 = -1;
  var rounds: int32 = 0;
  while (gap < 0 && rounds < 200) {
    if (ss_ack(c, g_ev[g_n_ev - 1].seq) < 0) { return sub_fail("ack"); }
    if (sub_collect(c, g_n_ev + 10, 1000) != 0) { return sub_fail("slow: collect"); }
    var i: int32 = 0;
    while (i < g_n_ev && gap < 0) {
      if (g_ev[i].kind == MEO_WIRE_EV_GAP) { gap = i; }
      i += 1;
    }
    rounds += 1;
  }
  if (gap < 0) { return sub_fail("slow: no GAP in {g_n_ev} events after the ring wrapped"); }
  var j: int32 = 1;
  while (j < gap) {
    if (g_ev[j].seq != g_ev[j - 1].seq + 1 || g_ev[j].kind != MEO_WIRE_EV_INSERT) { return sub_fail("slow: hole before the GAP at event {j}"); }
    j += 1;
  }
  if (ss_ack(c, g_ev[g_n_ev - 1].seq) < 0) { return sub_fail("ack"); }
  if (sub_collect(c, gap + 2, 2000) != 0 || g_n_ev < gap + 2) { return sub_fail("slow: nothing after the GAP"); }
  var g: SubEv* = &g_ev[gap];
  if (g->table != 0 || g->commit == 0 || g->seq <= g_ev[gap - 1].seq) { return sub_fail("slow: GAP table {g->table} commit {g->commit} seq {g->seq}"); }
  if (g_ev[gap + 1].kind != MEO_WIRE_EV_INSERT || g_ev[gap + 1].seq != g->seq + 1 || g_ev[gap + 1].commit > g->commit) {
    return sub_fail("slow: after the GAP: kind {g_ev[gap + 1].kind} seq {g_ev[gap + 1].seq} vs gap {g->seq}");
  }
  if (!sub_unsubscribe(c)) { return sub_fail("unsubscribe"); }
  return 0;
}

// ---- states ----

fn sub_states(w: SsC*, c: SsC*) -> int32 {
  if (sub_open_one(c, "a", 0, 0, 100) != MEO_WIRE_K_SUB_OK) { return sub_fail("subscribe a"); }
  if (!sub_ping_ok(c)) { return sub_fail("ping while subscribed"); }
  meo_wbuf_begin(&c->w);
  meo_wire_begin_put(&c->w, 0);
  ss_send(c, MEO_WIRE_K_BEGIN);
  if (sub_err_code(c) != MEO_ERR_TX) { return sub_fail("begin while subscribed is not a TX error"); }
  var st: MeoWStmt;
  meo_wire_stmt_init(&st);
  st.op = MEO_WIRE_OP_COUNT;
  st.table = "a";
  meo_wbuf_begin(&c->w);
  meo_wire_stmt_put(&c->w, &st);
  ss_send(c, MEO_WIRE_K_QUERY);
  if (sub_err_code(c) != MEO_ERR_TX) { return sub_fail("query while subscribed is not a TX error"); }
  if (sub_open_one(c, "a", 0, 0, 100) < 0 || c->hdr.kind != MEO_WIRE_K_ERROR) { return sub_fail("second subscribe was not refused"); }
  if (c->err.code != MEO_ERR_TX || c->err.fatal) { return sub_fail("second subscribe: code {c->err.code}"); }
  if (ss_scan(c, "a", "id", "v", "", 0.0, 1.0, 10) < 0 || sub_err_code(c) != MEO_ERR_TX) { return sub_fail("scan while subscribed is not a TX error"); }
  // An ACK for an event never sent.
  if (ss_ack(c, 1099511627776) < 0 || sub_err_code(c) != MEO_ERR_USAGE) { return sub_fail("ack beyond what was sent is not USAGE"); }
  if (!sub_ping_ok(c)) { return sub_fail("ping after the refusals"); }
  if (!sub_unsubscribe(c)) { return sub_fail("unsubscribe"); }
  // Back in READY: queries work, and ACK / UNSUBSCRIBE mean nothing.
  if (ss_count(c, "a") < 0) { return sub_fail("count after unsubscribe"); }
  meo_wbuf_begin(&c->w);
  ss_send(c, MEO_WIRE_K_UNSUBSCRIBE);
  if (sub_err_code(c) != MEO_ERR_TX) { return sub_fail("unsubscribe in READY is not a TX error"); }
  if (ss_ack(c, 1) < 0 || sub_err_code(c) != MEO_ERR_TX) { return sub_fail("ack in READY is not a TX error"); }

  // SUBSCRIBE needs READY: not inside a transaction.
  meo_wbuf_begin(&c->w);
  meo_wire_begin_put(&c->w, 0);
  ss_send(c, MEO_WIRE_K_BEGIN);
  if (ss_answer(c) != MEO_WIRE_K_OK) { return sub_fail("begin"); }
  if (sub_open_one(c, "a", 0, 0, 100) < 0 || c->hdr.kind != MEO_WIRE_K_ERROR || c->err.code != MEO_ERR_TX || c->err.fatal) {
    return sub_fail("subscribe inside a transaction");
  }
  if (ss_call(c, MEO_WIRE_K_ROLLBACK) != MEO_WIRE_K_OK) { return sub_fail("rollback"); }

  // Bad subscriptions are refused without ending the session.
  if (sub_open_one(c, "nope", 0, 0, 100) < 0 || c->hdr.kind != MEO_WIRE_K_ERROR || c->err.code != MEO_ERR_SCHEMA || c->err.fatal) {
    return sub_fail("unknown table");
  }
  if (sub_open_one(c, "a", 0, 0, 0) < 0 || c->hdr.kind != MEO_WIRE_K_ERROR || c->err.code != MEO_ERR_USAGE || c->err.fatal) {
    return sub_fail("window 0");
  }
  if (sub_open_one(c, "a", 0, 0, 65537) < 0 || c->hdr.kind != MEO_WIRE_K_ERROR || c->err.code != MEO_ERR_USAGE || c->err.fatal) {
    return sub_fail("window 65537");
  }
  if (!sub_ping_ok(c)) { return sub_fail("ping after bad subscriptions"); }
  return 0;
}

// A client that negotiated minor 0 gets what a v1 server gave it.
fn sub_v1(w: SsC*, c: SsC*) -> int32 {
  if (ss_open(c, g_port, 0) != MEO_OK || c->minor != 0) { return sub_fail("v1 hello: minor {c->minor}"); }
  if (ss_count(c, "a") < 0) { return sub_fail("v1 query"); }
  if (!ss_insert(w, "a", "v", "name", 99, 1.0, "q")) { return sub_fail("insert beside v1"); }
  if (!sub_ping_ok(c)) { return sub_fail("v1 ping (a push would break the rid)"); }
  if (sub_open_one(c, "a", 0, 0, 100) != MEO_WIRE_K_ERROR || c->err.code != MEO_ERR_PROTO || !c->err.fatal) {
    return sub_fail("v1 client: SUBSCRIBE is not a fatal PROTO");
  }
  if (ss_recv(c) != 0) { return sub_fail("v1 client: connection not closed after PROTO"); }
  ss_close(c);
  if (ss_open(c, g_port, 0) != MEO_OK) { return sub_fail("v1 reconnect"); }
  if (ss_scan(c, "a", "id", "v", "", 0.0, 1.0, 10) < 0 || ss_recv(c) != MEO_WIRE_K_ERROR || c->err.code != MEO_ERR_PROTO || !c->err.fatal) {
    return sub_fail("v1 client: SCAN is not a fatal PROTO");
  }
  ss_close(c);
  return 0;
}

// Quiet subscription: an empty EVENTS frame every sub_hb_ms.
fn sub_heartbeat(c: SsC*) -> int32 {
  if (sub_open_one(c, "a", 0, 0, 100) != MEO_WIRE_K_SUB_OK) { return sub_fail("subscribe a"); }
  sub_timeout(c, 5 * SUB_HB_MS);
  var t0: int64 = meo_clock_monotonic_us();
  var k: int32 = ss_recv(c);
  var ms: int64 = (meo_clock_monotonic_us() - t0) / 1000;
  if (k != MEO_WIRE_K_EVENTS || c->hdr.rid != 0 || c->evs.n != 0) { return sub_fail("heartbeat: kind {k} n {c->evs.n} after {ms} ms"); }
  println("heartbeat after {ms} ms");
  if (ms < (int64)SUB_HB_MS / 2 || ms > (int64)SUB_HB_MS * 4) { return sub_fail("heartbeat after {ms} ms, period {SUB_HB_MS}"); }
  if (!sub_unsubscribe(c)) { return sub_fail("unsubscribe"); }
  return 0;
}

fn sub_pre_tables(db: MeoDb*) -> int32 {
  var i: int32 = 0;
  while (i < 3) {
    var q: MeoQuery* = 0;
    var name: string = "pre{i}";
    if (meo_q_create(db, name, &q) != MEO_OK) { return -MEO_ERR_USAGE; }
    meo_q_column_def(q, "id", MEO_T_INT, MEO_COL_PK);
    var rc: int32 = meo_q_step(q);
    meo_q_free(q);
    if (rc < 0) { return rc; }
    i += 1;
  }
  return MEO_OK;
}

fn sub_run(wal: bool) -> int32 {
  var mode: string = "rollback";
  var flag: int32 = MEO_OPEN_NO_WAL;
  if (wal) {
    mode = "wal";
    flag = MEO_OPEN_WAL;
  }
  if (sub_reset(SUB_DB) != MEO_OK) { return sub_fail("reset db"); }
  var db: MeoDb* = 0;
  var rc: int32 = meo_db_open(SUB_DB, MEO_OPEN_CREATE | MEO_OPEN_READ | MEO_OPEN_WRITE | flag, 0, &db);
  if (rc != MEO_OK) { return sub_fail("{mode}: open db rc={rc}"); }
  if (sub_pre_tables(db) != MEO_OK) { return sub_fail("{mode}: pre tables"); }
  var cfg: MeoSrvConfig;
  meo_srv_config_default(&cfg);
  cfg.port = 0;
  cfg.max_frame = SS_FRAME;
  cfg.sub_hb_ms = SUB_HB_MS;
  var srv: MeoSrv* = 0;
  rc = meo_srv_start(db, &cfg, &srv);
  if (rc != MEO_OK) { return sub_fail("{mode}: start rc={rc}"); }
  g_port = meo_srv_port(srv);

  var w: SsC;
  var c: SsC;
  var d: SsC;
  ss_init(&w);
  ss_init(&c);
  ss_init(&d);
  var bad: int32 = 0;
  if (ss_open(&w, g_port, MEO_WIRE_MINOR) != MEO_OK || ss_open(&c, g_port, MEO_WIRE_MINOR) != MEO_OK) {
    bad = sub_fail("{mode}: connect");
  }
  if (bad == 0 && (c.caps & MEO_WIRE_CAP_SUBSCRIBE) == 0) { bad = sub_fail("{mode}: SUBSCRIBE cap not set"); }
  if (bad == 0 && c.minor != 1) { bad = sub_fail("{mode}: server minor {c.minor}"); }
  if (bad == 0) { bad = sub_basic(&w, &c); }
  if (bad == 0) { bad = sub_all_tables(&w, &c); }
  if (bad == 0) { bad = sub_add_column(&w, &c); }
  if (bad == 0) { bad = sub_latency(&w, &c); }
  if (bad == 0) { bad = sub_window(&w, &c); }
  if (bad == 0) { bad = sub_resume(&w, &c); }
  if (bad == 0) { bad = sub_from_commit(&w, &c, 1); }
  if (bad == 0) { bad = sub_slow(&w, &c); }
  if (bad == 0) { bad = sub_states(&w, &c); }
  if (bad == 0) { bad = sub_v1(&w, &d); }
  if (bad == 0) { bad = sub_heartbeat(&c); }
  if (bad == 0) {
    // Stop with a subscriber connected: it ends, the server stops in time.
    if (sub_open_one(&c, "a", 0, 0, 100) != MEO_WIRE_K_SUB_OK) { bad = sub_fail("{mode}: last subscribe"); }
  }
  if (bad != 0) { println("  (in {mode} mode)"); }
  var t0: int64 = meo_clock_monotonic_us();
  rc = meo_srv_stop(srv);
  var ms: int64 = (meo_clock_monotonic_us() - t0) / 1000;
  if (rc != MEO_OK && bad == 0) { bad = sub_fail("{mode}: stop rc={rc}"); }
  if (ms > 2000 && bad == 0) { bad = sub_fail("{mode}: stop took {ms} ms with a subscriber"); }
  ss_free(&w);
  ss_free(&c);
  ss_free(&d);
  if (meo_srv_free(srv) != MEO_OK && bad == 0) { bad = sub_fail("{mode}: free"); }
  rc = meo_db_close(db);
  if (rc != MEO_OK && bad == 0) { bad = sub_fail("{mode}: close rc={rc}"); }
  return bad;
}

fn main() -> int32 {
  g_ev = (SubEv*)malloc((int64)SUB_CAP * (int64)sizeof(SubEv));
  if (sub_run(true) != 0) { return 1; }
  if (sub_run(false) != 0) { return 1; }
  println("PASS srv_sub");
  return 0;
}
