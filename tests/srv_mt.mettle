// srv_mt: the server embedded on 127.0.0.1 port 0, 64 client threads doing a
// mix of INSERT, point SELECT and COUNT through meo_cli_, 8 of them in
// explicit transactions of 10 ops. Afterwards every inserted row is present
// exactly once with its value and the rowid its INSERT reported, no thread
// hung past the deadline, and no op got BUSY under the default timeouts.

import "std/io";
import "std/mem";
import "std/thread";
import "../src/error/status.mettle";
import "../src/platform/file.mettle";
import "../src/platform/file_linux.mettle";
import "../src/meo_server.mettle";
import "../src/meo_client.mettle";

// Red-check switch: 1 expects one row more than was inserted. Must be 0 when
// committed.
const MT_RED: int32 = 0;
// On tmpfs: on disk every autocommit pays its fsyncs and the run tests the disk.
const MT_DB: string = "/dev/shm/meosql_srv_mt.db";
const MT_IP: string = "127.0.0.1";
const MT_THREADS: int32 = 64;
const MT_OPS: int32 = 2000;
const MT_TX_THREADS: int32 = 8;
const MT_DEADLINE_MS: int64 = 300000;

struct MtArg {
  tid: int32;
  err: int32;        // first failing code, 0 = none
  err_op: int32;
  busy: int32;
  n_ins: int32;
  ids: int64*;       // last_id of insert seq, MT_OPS entries
  c: MeoCli*;
}

var g_port: int32 = 0;

fn mt_fail(msg: string) -> int32 {
  println("FAIL srv_mt: {msg}");
  return 1;
}

fn mt_reset(db: string) -> int32 {
  var f: MeoFile = meo_file_open(db, MEO_OPEN_READ | MEO_OPEN_WRITE | MEO_OPEN_CREATE);
  if (!f.is_open) { return -MEO_ERR_IO; }
  var rc: int32 = meo_file_truncate(f, 0);
  meo_file_close(f);
  var jpath: string = db + "-journal";
  meo_file_unlink(jpath);
  free(jpath.chars);
  return rc;
}

fn mt_val(tid: int32, seq: int32) -> int64 {
  return (int64)tid * 1000003 + (int64)seq;
}

// Record a failure; BUSY is counted separately.
fn mt_err(a: MtArg*, rc: int32, op: int32) -> int32 {
  if (rc == -MEO_ERR_BUSY) { a->busy += 1; }
  if (a->err == 0) {
    a->err = rc;
    a->err_op = op;
  }
  return rc;
}

fn mt_col(c: MeoWCol*, name: string) {
  c->name = name;
  c->ty = 0;
  c->flags = 0;
}

fn mt_cell_int(r: MeoCliResult*, row: int32, col: int32) -> int64 {
  var v: MeoValue;
  if (meo_cli_cell(r, row, col, &v) != MEO_OK || v.type != MEO_T_INT) { return -1; }
  return v.i;
}

fn mt_insert(a: MtArg*, op: int32) -> int32 {
  var cols: MeoWCol[3];
  mt_col(&cols[0], "tid");
  mt_col(&cols[1], "seq");
  mt_col(&cols[2], "val");
  var args: MeoValue[3];
  meo_value_set_int(&args[0], (int64)a->tid);
  meo_value_set_int(&args[1], (int64)a->n_ins);
  meo_value_set_int(&args[2], mt_val(a->tid, a->n_ins));
  var st: MeoWStmt;
  meo_wire_stmt_init(&st);
  st.op = MEO_WIRE_OP_INSERT;
  st.table = "m";
  st.cols = &cols[0];
  st.n_cols = 3;
  st.n_rows = 1;
  st.args = &args[0];
  st.n_args = 3;
  var r: MeoCliResult;
  var rc: int32 = meo_cli_query(a->c, &st, &r);
  if (rc != MEO_OK) { return mt_err(a, rc, op); }
  var ch: int32 = meo_cli_affected(&r);
  var id: int64 = meo_cli_last_id(&r);
  meo_cli_result_free(&r);
  if (ch != 1 || id <= 0) { return mt_err(a, -9001, op); }
  a->ids[a->n_ins] = id;
  a->n_ins += 1;
  return MEO_OK;
}

// SELECT tid, seq, val WHERE id = one of this thread's rowids.
fn mt_point(a: MtArg*, op: int32) -> int32 {
  if (a->n_ins == 0) { return MEO_OK; }
  var seq: int32 = (op * 7) % a->n_ins;
  var cols: MeoWCol[3];
  mt_col(&cols[0], "tid");
  mt_col(&cols[1], "seq");
  mt_col(&cols[2], "val");
  var terms: MeoWTerm[1];
  terms[0].col = "id";
  terms[0].op = MEO_WIRE_W_EQ;
  terms[0].arg0 = 0;
  terms[0].n_args = 1;
  var v: MeoValue;
  meo_value_set_int(&v, a->ids[seq]);
  var st: MeoWStmt;
  meo_wire_stmt_init(&st);
  st.op = MEO_WIRE_OP_SELECT;
  st.table = "m";
  st.cols = &cols[0];
  st.n_cols = 3;
  st.terms = &terms[0];
  st.n_terms = 1;
  st.args = &v;
  st.n_args = 1;
  var r: MeoCliResult;
  var rc: int32 = meo_cli_query(a->c, &st, &r);
  if (rc != MEO_OK) { return mt_err(a, rc, op); }
  var ok: bool = meo_cli_row_count(&r) == 1 && meo_cli_col_count(&r) == 3;
  ok = ok && mt_cell_int(&r, 0, 0) == (int64)a->tid && mt_cell_int(&r, 0, 1) == (int64)seq;
  ok = ok && mt_cell_int(&r, 0, 2) == mt_val(a->tid, seq);
  meo_cli_result_free(&r);
  if (!ok) { return mt_err(a, -9002, op); }
  return MEO_OK;
}

// COUNT WHERE tid = mine (nobody else writes those rows) every 100th op; it
// scans the table, so the rest count WHERE id = my latest rowid instead.
fn mt_count(a: MtArg*, op: int32) -> int32 {
  var by_tid: bool = op % 100 == 8 || a->n_ins == 0;
  var terms: MeoWTerm[1];
  terms[0].col = "tid";
  terms[0].op = MEO_WIRE_W_EQ;
  terms[0].arg0 = 0;
  terms[0].n_args = 1;
  var v: MeoValue;
  meo_value_set_int(&v, (int64)a->tid);
  var want: int64 = (int64)a->n_ins;
  if (!by_tid) {
    terms[0].col = "id";
    meo_value_set_int(&v, a->ids[a->n_ins - 1]);
    want = 1;
  }
  var st: MeoWStmt;
  meo_wire_stmt_init(&st);
  st.op = MEO_WIRE_OP_COUNT;
  st.table = "m";
  st.terms = &terms[0];
  st.n_terms = 1;
  st.args = &v;
  st.n_args = 1;
  var r: MeoCliResult;
  var rc: int32 = meo_cli_query(a->c, &st, &r);
  if (rc != MEO_OK) { return mt_err(a, rc, op); }
  var n: int64 = -1;
  if (meo_cli_row_count(&r) == 1) { n = mt_cell_int(&r, 0, 0); }
  meo_cli_result_free(&r);
  if (n != want) { return mt_err(a, -9003, op); }
  return MEO_OK;
}

fn mt_op(a: MtArg*, op: int32) -> int32 {
  var k: int32 = op % 10;
  if (k <= 5) { return mt_insert(a, op); }
  if (k <= 7) { return mt_point(a, op); }
  return mt_count(a, op);
}

fn mt_worker(arg: cstring) -> uint32 {
  var a: MtArg* = (MtArg*)arg;
  var rc: int32 = meo_cli_connect(MT_IP, g_port, 0, 0, 0, &a->c);
  if (rc != MEO_OK) {
    mt_err(a, rc, -1);
    return 0;
  }
  var tx: bool = a->tid < MT_TX_THREADS;
  var op: int32 = 0;
  while (op < MT_OPS && a->err == 0) {
    if (tx && op % 10 == 0) {
      var b: int32 = meo_cli_begin(a->c, 0);
      if (b != MEO_OK) {
        mt_err(a, b, op);
        break;
      }
    }
    rc = mt_op(a, op);
    if (tx && (op % 10 == 9 || rc != MEO_OK)) {
      // A failed op ends the run; roll back so the lock is released.
      var c: int32 = MEO_OK;
      if (rc == MEO_OK) { c = meo_cli_commit(a->c); } else { meo_cli_rollback(a->c); }
      if (c != MEO_OK) { mt_err(a, c, op); }
    }
    op += 1;
  }
  meo_cli_close(a->c);
  a->c = 0;
  return 0;
}

fn mt_setup(db: MeoDb*) -> int32 {
  var q: MeoQuery* = 0;
  meo_q_create(db, "m", &q);
  meo_q_column_def(q, "id", MEO_T_INT, MEO_COL_PK);
  meo_q_column_def(q, "tid", MEO_T_INT, MEO_COL_NOT_NULL);
  meo_q_column_def(q, "seq", MEO_T_INT, MEO_COL_NOT_NULL);
  meo_q_column_def(q, "val", MEO_T_INT, MEO_COL_NOT_NULL);
  var rc: int32 = meo_q_step(q);
  meo_q_free(q);
  if (rc != MEO_DONE) { return mt_fail("create m rc={rc}"); }
  return 0;
}

// Every row exactly once, with its value and the rowid its insert reported.
fn mt_verify(db: MeoDb*, args: MtArg**) -> int32 {
  var want: int64 = (int64)MT_RED;
  var i: int32 = 0;
  while (i < MT_THREADS) {
    want += (int64)args[i]->n_ins;
    i += 1;
  }
  var seen: uint8[] = new uint8[MT_THREADS * MT_OPS];
  defer free(seen.data);
  i = 0;
  while (i < MT_THREADS * MT_OPS) {
    seen[i] = 0;
    i += 1;
  }
  var q: MeoQuery* = 0;
  meo_q_select(db, "m", &q);
  meo_q_pick(q, "id");
  meo_q_pick(q, "tid");
  meo_q_pick(q, "seq");
  meo_q_pick(q, "val");
  var n: int64 = 0;
  var bad: int32 = 0;
  var rc: int32 = 0;
  while (bad == 0) {
    rc = meo_q_step(q);
    if (rc != MEO_ROW) { break; }
    var id: int64 = meo_q_column_int64(q, 0);
    var tid: int64 = meo_q_column_int64(q, 1);
    var seq: int64 = meo_q_column_int64(q, 2);
    if (tid < 0 || tid >= (int64)MT_THREADS || seq < 0 || seq >= (int64)args[tid]->n_ins) {
      bad = 1;
    } else if (seen[tid * (int64)MT_OPS + seq] != 0) {
      bad = 2;
    } else if (meo_q_column_int64(q, 3) != mt_val((int32)tid, (int32)seq)) {
      bad = 3;
    } else if (args[tid]->ids[seq] != id) {
      bad = 4;
    } else {
      seen[tid * (int64)MT_OPS + seq] = 1;
    }
    n += 1;
  }
  meo_q_free(q);
  if (bad != 0) { return mt_fail("row {n}: check {bad} (1 range, 2 twice, 3 value, 4 last_id)"); }
  if (rc != MEO_DONE) { return mt_fail("final select rc={rc}"); }
  if (n != want) { return mt_fail("{n} rows, {want} inserted"); }
  println("srv_mt: {n} rows, each once with its value and last_id");
  return 0;
}

fn mt_main() -> int32 {
  var rc: int32 = mt_reset(MT_DB);
  if (rc != MEO_OK) { return mt_fail("reset rc={rc}"); }
  var db: MeoDb* = 0;
  rc = meo_db_open(MT_DB, MEO_OPEN_CREATE | MEO_OPEN_READ | MEO_OPEN_WRITE, 0, &db);
  if (rc != MEO_OK) { return mt_fail("open rc={rc}"); }
  if (mt_setup(db) != 0) { return 1; }
  var cfg: MeoSrvConfig;
  meo_srv_config_default(&cfg);
  cfg.ip = MT_IP;
  cfg.port = 0;
  var srv: MeoSrv* = 0;
  rc = meo_srv_start(db, &cfg, &srv);
  if (rc != MEO_OK) { return mt_fail("start rc={rc}"); }
  g_port = meo_srv_port(srv);

  var args: MtArg*[] = new MtArg*[64];
  var hs: int64[] = new int64[64];
  var t0: int64 = meo_srv_now_ms();
  var i: int32 = 0;
  while (i < MT_THREADS) {
    args[i] = new MtArg;
    args[i]->tid = i;
    args[i]->err = 0;
    args[i]->err_op = 0;
    args[i]->busy = 0;
    args[i]->n_ins = 0;
    args[i]->ids = (int64*)malloc((int64)MT_OPS * 8);
    args[i]->c = 0;
    hs[i] = CreateThread(0, 0, &mt_worker, (cstring)args[i], 0, 0);
    if (hs[i] == 0) { return mt_fail("thread {i} did not start"); }
    i += 1;
  }
  i = 0;
  while (i < MT_THREADS) {
    var left: int64 = MT_DEADLINE_MS - (meo_srv_now_ms() - t0);
    if (left < 1) { left = 1; }
    if (thread_join(hs[i], (uint32)left) != WAIT_OBJECT_0()) {
      mt_fail("thread {i} still running after {MT_DEADLINE_MS} ms (deadlock?)");
      syscall(231, (int64)1);
    }
    thread_close(hs[i]);
    i += 1;
  }
  var ms: int64 = meo_srv_now_ms() - t0;
  var busy: int32 = 0;
  var bad: int32 = 0;
  i = 0;
  while (i < MT_THREADS) {
    busy += args[i]->busy;
    if (args[i]->err != 0 && bad == 0) {
      bad = mt_fail("thread {i} op {args[i]->err_op}: rc={args[i]->err}");
    }
    i += 1;
  }
  if (bad == 0 && busy != 0) { bad = mt_fail("{busy} ops got BUSY"); }
  rc = meo_srv_stop(srv);
  if (bad == 0 && rc != MEO_OK) { bad = mt_fail("stop rc={rc}"); }
  meo_srv_free(srv);
  if (bad == 0) { bad = mt_verify(db, args.data); }
  rc = meo_db_close(db);
  if (bad == 0 && rc != MEO_OK) { bad = mt_fail("close rc={rc}"); }
  if (bad == 0) { println("srv_mt: {MT_THREADS} clients x {MT_OPS} ops in {ms} ms"); }
  i = 0;
  while (i < MT_THREADS) {
    free(args[i]->ids);
    free(args[i]);
    i += 1;
  }
  free(args.data);
  free(hs.data);
  meo_file_unlink(MT_DB);
  return bad;
}

fn main() -> int32 {
  if (mt_main() != 0) { return 1; }
  println("PASS srv_mt");
  return 0;
}
