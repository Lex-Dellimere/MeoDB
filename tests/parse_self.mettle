// parse_self: sql/lexer + sql/parser against the statement grammar.
//
//   p_create      CREATE TABLE [IF NOT EXISTS], every type and constraint
//   p_insert      column list, multi-row, every literal kind, ? numbering
//   p_select      SELECT * and the full clause set: WHERE (=, IN, IS [NOT]
//                 NULL), ORDER BY ASC/DESC, LIMIT, OFFSET
//   p_update      SET list then WHERE; ? numbered SET first
//   p_delete      with and without WHERE
//   p_escapes     "a""b" and 'it''s' unescaped; plain quoted names are views
//                 into the SQL bytes
//   p_case        lower / mixed case keywords, trailing ';'
//   p_flux        every statement shape flux_orm emits, verbatim
//   p_errors      code and err_off for malformed and unsupported SQL
//
// Prints PASS per case, FAIL <label> on a failure, and exits non-zero if
// anything failed.

import "std/io";
import "../src/error/status.mettle";
import "../src/record/value.mettle";
import "../src/mem/arena.mettle";
import "../src/sql/ast.mettle";
import "../src/sql/parser.mettle";

// Red-check switch: 1 expects the wrong ORDER BY flag. Must be 0 when committed.
const P_RED: int32 = 0;

var p_failures: int32 = 0;
var p_arena: MeoArena* = 0;

fn p_ok(cond: bool, label: string) -> bool {
  if (cond) { return true; }
  println("FAIL {label}");
  p_failures += 1;
  return false;
}

fn p_i32(got: int32, want: int32, label: string) -> bool {
  if (got == want) { return true; }
  println("FAIL {label}: expected {want}, got {got}");
  p_failures += 1;
  return false;
}

fn p_i64(got: int64, want: int64, label: string) -> bool {
  if (got == want) { return true; }
  println("FAIL {label}: expected {want}, got {got}");
  p_failures += 1;
  return false;
}

fn p_bytes(p: uint8*, n: int32, want: string) -> bool {
  if ((int64)n != (int64)want.length) { return false; }
  var i: int32 = 0;
  while (i < n) {
    if (p[i] != want.chars[i]) { return false; }
    i += 1;
  }
  return true;
}

fn p_name(nm: MeoAstName, want: string, label: string) -> bool {
  return p_ok(p_bytes(nm.p, nm.n, want), label);
}

fn p_parse(sql: string, ast: MeoAst*, off: int32*) -> int32 {
  meo_arena_reset(p_arena);
  return meo_sql_parse(sql.chars, (int32)sql.length, p_arena, ast, off);
}

// Parses `sql`, which must succeed.
fn p_good(sql: string, ast: MeoAst*, label: string) -> bool {
  var off: int32 = -1;
  var rc: int32 = p_parse(sql, ast, &off);
  if (rc == MEO_OK) { return true; }
  println("FAIL {label}: rc {rc} at offset {off}");
  p_failures += 1;
  return false;
}

// Parses `sql`, which must fail with `code` at byte `want_off`.
fn p_bad(sql: string, code: int32, want_off: int32, label: string) {
  var ast: MeoAst;
  var off: int32 = -1;
  var rc: int32 = p_parse(sql, &ast, &off);
  if (p_i32(rc, code, label + " rc")) { p_i32(off, want_off, label + " err_off"); }
}

fn p_param(o: MeoAstOperand, n: int32, label: string) -> bool {
  return p_i32(o.kind, MEO_AST_OPND_PARAM, label + " kind") && p_i32(o.param, n, label + " no");
}

fn p_create() {
  var a: MeoAst;
  var sql: string = "CREATE TABLE IF NOT EXISTS \"users\" (\"id\" INTEGER PRIMARY KEY, "
    + "email TEXT NOT NULL UNIQUE, \"score\" REAL, data BLOB UNIQUE NOT NULL)";
  if (!p_good(sql, &a, "p_create")) { return; }
  p_i32(a.kind, MEO_AST_CREATE, "p_create kind");
  p_ok(a.if_not_exists, "p_create if_not_exists");
  p_name(a.table, "users", "p_create table");
  if (!p_i32(a.n_cols, 4, "p_create n_cols")) { return; }
  p_name(a.cols[0].name, "id", "p_create col0");
  p_name(a.cols[1].name, "email", "p_create col1");
  p_name(a.cols[2].name, "score", "p_create col2");
  p_name(a.cols[3].name, "data", "p_create col3");
  p_i32(a.cols[0].affinity, MEO_T_INT, "p_create aff0");
  p_i32(a.cols[1].affinity, MEO_T_TEXT, "p_create aff1");
  p_i32(a.cols[2].affinity, MEO_T_REAL, "p_create aff2");
  p_i32(a.cols[3].affinity, MEO_T_BLOB, "p_create aff3");
  p_i32(a.cols[0].cflags, MEO_AST_C_PK, "p_create cflags0");
  p_i32(a.cols[1].cflags, MEO_AST_C_NOT_NULL | MEO_AST_C_UNIQUE, "p_create cflags1");
  p_i32(a.cols[2].cflags, 0, "p_create cflags2");
  p_i32(a.cols[3].cflags, MEO_AST_C_NOT_NULL | MEO_AST_C_UNIQUE, "p_create cflags3");
  p_i32(a.n_params, 0, "p_create n_params");

  if (!p_good("CREATE TABLE t (a INTEGER)", &a, "p_create plain")) { return; }
  p_ok(!a.if_not_exists, "p_create plain if_not_exists");
  p_i32(a.n_cols, 1, "p_create plain n_cols");
  println("PASS p_create");
}

fn p_insert() {
  var a: MeoAst;
  if (!p_good("INSERT INTO \"t\" (\"a\", b) VALUES (?, ?), (?, ?), (?, ?)", &a, "p_insert")) {
    return;
  }
  p_i32(a.kind, MEO_AST_INSERT, "p_insert kind");
  p_name(a.table, "t", "p_insert table");
  if (!p_i32(a.n_names, 2, "p_insert n_names")) { return; }
  p_name(a.names[0], "a", "p_insert name0");
  p_name(a.names[1], "b", "p_insert name1");
  p_i32(a.n_rows, 3, "p_insert n_rows");
  p_i32(a.row_width, 2, "p_insert row_width");
  p_i32(a.n_params, 6, "p_insert n_params");
  var i: int32 = 0;
  while (i < 6) {
    p_param(a.values[i], i + 1, "p_insert value {i}");
    i += 1;
  }

  var sql: string = "INSERT INTO t VALUES (-5, 2.5, 'it''s', NULL, -9223372036854775808, "
    + "9223372036854775807, -0.25, 0.1, 123.456, '')";
  if (!p_good(sql, &a, "p_insert lits")) { return; }
  p_i32(a.n_names, 0, "p_insert lits n_names");
  p_i32(a.n_rows, 1, "p_insert lits n_rows");
  if (!p_i32(a.row_width, 10, "p_insert lits width")) { return; }
  p_i32(a.n_params, 0, "p_insert lits n_params");
  var v: MeoAstOperand* = a.values;
  i = 0;
  while (i < 10) {
    p_i32(v[i].kind, MEO_AST_OPND_LITERAL, "p_insert lit kind {i}");
    i += 1;
  }
  p_ok(v[0].val.type == MEO_T_INT && v[0].val.i == (int64)-5, "p_insert -5");
  p_ok(v[1].val.type == MEO_T_REAL && v[1].val.f == 2.5, "p_insert 2.5");
  p_ok(v[2].val.type == MEO_T_TEXT && p_bytes(v[2].val.p, v[2].val.n, "it's"), "p_insert it's");
  p_i32(v[3].val.type, MEO_T_NULL, "p_insert NULL");
  var lo: int64 = (int64)((uint64)1 << 63);
  p_ok(v[4].val.type == MEO_T_INT && v[4].val.i == lo, "p_insert int64 min");
  p_ok(v[5].val.type == MEO_T_INT && v[5].val.i == lo - (int64)1, "p_insert int64 max");
  p_ok(v[6].val.type == MEO_T_REAL && v[6].val.f == -0.25, "p_insert -0.25");
  p_ok(v[7].val.f == 0.1, "p_insert 0.1");
  p_ok(v[8].val.f == 123.456, "p_insert 123.456");
  p_ok(v[9].val.type == MEO_T_TEXT && v[9].val.n == 0, "p_insert empty text");
  println("PASS p_insert");
}

fn p_select() {
  var a: MeoAst;
  if (!p_good("SELECT * FROM t", &a, "p_select star")) { return; }
  p_i32(a.kind, MEO_AST_SELECT, "p_select star kind");
  p_ok(a.select_star, "p_select star flag");
  p_i32(a.n_names, 0, "p_select star n_names");
  p_i32(a.n_where, 0, "p_select star n_where");
  p_i32(a.n_order, 0, "p_select star n_order");
  p_i64(a.limit, -1, "p_select star limit");
  p_i64(a.offset, 0, "p_select star offset");

  var sql: string = "SELECT a, \"b\" FROM \"t\" WHERE a = ? AND \"b\" IN (1, ?, 'x') "
    + "AND c IS NULL AND d IS NOT NULL ORDER BY a ASC, b DESC, c LIMIT 10 OFFSET 5";
  if (!p_good(sql, &a, "p_select full")) { return; }
  p_ok(!a.select_star, "p_select full star");
  if (!p_i32(a.n_names, 2, "p_select n_names")) { return; }
  p_name(a.names[0], "a", "p_select name0");
  p_name(a.names[1], "b", "p_select name1");
  p_name(a.table, "t", "p_select table");
  if (!p_i32(a.n_where, 4, "p_select n_where")) { return; }
  var w: MeoAstTerm* = a.where_terms;
  p_i32(w[0].kind, MEO_AST_T_EQ, "p_select w0 kind");
  p_name(w[0].col, "a", "p_select w0 col");
  p_param(w[0].rhs, 1, "p_select w0 rhs");
  p_i32(w[1].kind, MEO_AST_T_IN, "p_select w1 kind");
  p_name(w[1].col, "b", "p_select w1 col");
  if (p_i32(w[1].n_list, 3, "p_select w1 n_list")) {
    p_ok(w[1].list[0].kind == MEO_AST_OPND_LITERAL && w[1].list[0].val.i == (int64)1,
      "p_select w1 list0");
    p_param(w[1].list[1], 2, "p_select w1 list1");
    p_ok(p_bytes(w[1].list[2].val.p, w[1].list[2].val.n, "x"), "p_select w1 list2");
  }
  p_i32(w[2].kind, MEO_AST_T_IS_NULL, "p_select w2 kind");
  p_name(w[2].col, "c", "p_select w2 col");
  p_i32(w[3].kind, MEO_AST_T_NOT_NULL, "p_select w3 kind");
  p_name(w[3].col, "d", "p_select w3 col");
  if (p_i32(a.n_order, 3, "p_select n_order")) {
    p_name(a.order[0].col, "a", "p_select o0 col");
    p_name(a.order[1].col, "b", "p_select o1 col");
    p_name(a.order[2].col, "c", "p_select o2 col");
    p_ok(!a.order[0].desc, "p_select o0 asc");
    p_ok(a.order[1].desc == (P_RED == 0), "p_select o1 desc");
    p_ok(!a.order[2].desc, "p_select o2 default asc");
  }
  p_i64(a.limit, 10, "p_select limit");
  p_i64(a.offset, 5, "p_select offset");
  p_i32(a.n_params, 2, "p_select n_params");

  if (!p_good("SELECT * FROM t OFFSET 3", &a, "p_select offset only")) { return; }
  p_i64(a.limit, -1, "p_select offset only limit");
  p_i64(a.offset, 3, "p_select offset only offset");
  println("PASS p_select");
}

fn p_update() {
  var a: MeoAst;
  if (!p_good("UPDATE \"t\" SET \"a\" = ?, b = 'z', c = NULL WHERE \"id\" = ?", &a, "p_update")) {
    return;
  }
  p_i32(a.kind, MEO_AST_UPDATE, "p_update kind");
  p_name(a.table, "t", "p_update table");
  if (!p_i32(a.n_sets, 3, "p_update n_sets")) { return; }
  p_name(a.sets[0].col, "a", "p_update set0 col");
  p_param(a.sets[0].val, 1, "p_update set0 val");
  p_name(a.sets[1].col, "b", "p_update set1 col");
  p_ok(p_bytes(a.sets[1].val.val.p, a.sets[1].val.val.n, "z"), "p_update set1 val");
  p_i32(a.sets[2].val.val.type, MEO_T_NULL, "p_update set2 NULL");
  if (p_i32(a.n_where, 1, "p_update n_where")) {
    p_name(a.where_terms[0].col, "id", "p_update w0 col");
    p_param(a.where_terms[0].rhs, 2, "p_update w0 rhs");
  }
  p_i32(a.n_params, 2, "p_update n_params");

  if (!p_good("UPDATE t SET a = 1", &a, "p_update no where")) { return; }
  p_i32(a.n_where, 0, "p_update no where n_where");
  println("PASS p_update");
}

fn p_delete() {
  var a: MeoAst;
  if (!p_good("DELETE FROM \"t\" WHERE id IN (?, ?) AND v IS NOT NULL", &a, "p_delete")) {
    return;
  }
  p_i32(a.kind, MEO_AST_DELETE, "p_delete kind");
  p_name(a.table, "t", "p_delete table");
  if (p_i32(a.n_where, 2, "p_delete n_where")) {
    p_i32(a.where_terms[0].n_list, 2, "p_delete in n_list");
    p_i32(a.where_terms[1].kind, MEO_AST_T_NOT_NULL, "p_delete w1 kind");
  }
  p_i32(a.n_params, 2, "p_delete n_params");

  if (!p_good("DELETE FROM t", &a, "p_delete all")) { return; }
  p_i32(a.n_where, 0, "p_delete all n_where");
  println("PASS p_delete");
}

fn p_escapes() {
  var a: MeoAst;
  var sql: string = "SELECT \"a\"\"b\", \"plain\" FROM \"x\"\"y\" WHERE \"q\" = 'it''s'";
  if (!p_good(sql, &a, "p_escapes")) { return; }
  p_name(a.table, "x\"y", "p_escapes table");
  if (p_i32(a.n_names, 2, "p_escapes n_names")) {
    p_name(a.names[0], "a\"b", "p_escapes name0");
    p_name(a.names[1], "plain", "p_escapes name1");
    // No escape, no copy: the view is the bytes inside the quotes.
    p_ok(a.names[1].p == sql.chars + a.names[1].off + 1, "p_escapes view");
    p_i32(a.names[1].off, 15, "p_escapes name1 off");
  }
  var v: MeoValue = a.where_terms[0].rhs.val;
  p_ok(p_bytes(v.p, v.n, "it's"), "p_escapes text");
  println("PASS p_escapes");
}

fn p_case() {
  var a: MeoAst;
  if (!p_good("select * from t where a is not null order by a desc limit 3", &a, "p_case low")) {
    return;
  }
  p_i32(a.n_where, 1, "p_case low n_where");
  p_i64(a.limit, 3, "p_case low limit");
  p_ok(a.n_order == 1 && a.order[0].desc, "p_case low desc");
  if (!p_good("InSeRt InTo t VaLuEs (1)", &a, "p_case mixed")) { return; }
  p_i32(a.kind, MEO_AST_INSERT, "p_case mixed kind");
  if (!p_good("CREATE table T (A integer primary key not null);", &a, "p_case create")) { return; }
  p_i32(a.cols[0].cflags, MEO_AST_C_PK | MEO_AST_C_NOT_NULL, "p_case create cflags");
  p_good("SELECT * FROM t;", &a, "p_case semi");
  p_good("  SELECT * FROM t ;  \n", &a, "p_case semi spaced");
  p_good("-- note\nSELECT * FROM t -- trailing\n", &a, "p_case comments");
  println("PASS p_case");
}

// Statement text exactly as flux_orm builds it (migration/ddl, migration/version,
// core/persist, query/builder).
fn p_flux() {
  var a: MeoAst;
  p_good("CREATE TABLE IF NOT EXISTS \"users\" (\"id\" INTEGER PRIMARY KEY, \"email\" TEXT NOT NULL "
    + "UNIQUE, \"name\" TEXT, \"score\" REAL, \"avatar\" BLOB)", &a, "p_flux ddl");
  p_i32(a.n_cols, 5, "p_flux ddl n_cols");
  p_good("CREATE TABLE IF NOT EXISTS \"_flux_orm_migrations\" (\"version\" INTEGER PRIMARY KEY, "
    + "\"name\" TEXT NOT NULL, \"applied_at\" INTEGER NOT NULL)", &a, "p_flux ledger ddl");
  p_good("SELECT \"version\" FROM \"_flux_orm_migrations\" ORDER BY \"version\" ASC", &a,
    "p_flux ledger select");
  p_good("INSERT INTO \"_flux_orm_migrations\" (\"version\", \"name\", \"applied_at\") VALUES "
    + "(?, ?, ?)", &a, "p_flux ledger insert");
  p_i32(a.n_params, 3, "p_flux ledger insert n_params");
  p_good("INSERT INTO \"users\" (\"email\", \"name\") VALUES (?, ?)", &a, "p_flux insert");
  p_good("INSERT INTO \"users\" (\"email\", \"name\") VALUES (?, ?), (?, ?)", &a,
    "p_flux insert many");
  p_i32(a.n_rows, 2, "p_flux insert many n_rows");
  p_good("SELECT \"id\", \"email\", \"name\" FROM \"users\" WHERE \"id\" = ? LIMIT 1", &a,
    "p_flux get");
  p_i64(a.limit, 1, "p_flux get limit");
  p_good("DELETE FROM \"users\" WHERE \"id\" = ?", &a, "p_flux delete");
  p_good("DELETE FROM \"users\" WHERE \"id\" = ? AND \"version\" = ?", &a, "p_flux delete ver");
  p_i32(a.n_params, 2, "p_flux delete ver n_params");
  p_good("UPDATE \"users\" SET \"name\" = ?, \"age\" = ? WHERE \"id\" = ?", &a, "p_flux update");
  p_good("UPDATE \"users\" SET \"name\" = ?, \"version\" = ? WHERE \"id\" = ? AND \"version\" = ?",
    &a, "p_flux update ver");
  p_i32(a.n_params, 4, "p_flux update ver n_params");
  p_good("SELECT \"id\", \"email\" FROM \"users\" WHERE \"id\" IN (?, ?) AND \"deleted_at\" IS NULL "
    + "AND \"email\" IS NOT NULL ORDER BY \"id\" ASC, \"email\" DESC LIMIT 10 OFFSET 5", &a,
    "p_flux query");
  p_i32(a.n_where, 3, "p_flux query n_where");
  p_good("SELECT \"id\", \"user_id\" FROM \"posts\" WHERE \"user_id\" IN (?, ?, ?)", &a,
    "p_flux preload");
  // Comparisons and joins are valid SQL the AST cannot hold yet.
  p_bad("SELECT \"id\" FROM \"users\" WHERE \"age\" < ?", -MEO_ERR_UNSUPPORTED, 37, "p_flux lt");
  p_bad("SELECT \"id\" FROM \"users\" WHERE \"age\" <= ?", -MEO_ERR_UNSUPPORTED, 37, "p_flux le");
  p_bad("SELECT \"id\" FROM \"users\" WHERE \"age\" <> ?", -MEO_ERR_UNSUPPORTED, 37, "p_flux ne");
  p_bad("SELECT \"id\" FROM \"users\" WHERE \"a\" = ? AND \"age\" >= ?", -MEO_ERR_UNSUPPORTED, 49,
    "p_flux ge");
  p_bad("SELECT \"id\" FROM \"users\" JOIN \"posts\" ON \"users\".\"id\" = \"posts\".\"user_id\"",
    -MEO_ERR_UNSUPPORTED, 25, "p_flux join");
  p_bad("SELECT \"id\" FROM \"users\" LEFT JOIN \"posts\" ON \"users\".\"id\" = \"posts\".\"user_id\"",
    -MEO_ERR_UNSUPPORTED, 25, "p_flux left join");
  println("PASS p_flux");
}

fn p_errors() {
  p_bad("SELECT * \"t\"", -MEO_ERR_SQL, 9, "p_errors missing FROM");
  p_bad("SELECT FROM t", -MEO_ERR_SQL, 7, "p_errors no columns");
  p_bad("CREATE TABLE t (a VARCHAR)", -MEO_ERR_SQL, 18, "p_errors unknown type");
  p_bad("CREATE TABLE t ()", -MEO_ERR_SQL, 16, "p_errors no coldefs");
  p_bad("INSERT INTO t VALUES ('abc)", -MEO_ERR_SQL, 22, "p_errors unterminated string");
  p_bad("SELECT \"a FROM t", -MEO_ERR_SQL, 7, "p_errors unterminated name");
  p_bad("SELECT * FROM t; SELECT * FROM u", -MEO_ERR_SQL, 17, "p_errors two statements");
  p_bad("SELECT * FROM t;;", -MEO_ERR_SQL, 16, "p_errors two semis");
  p_bad("SELECT * FROM a JOIN b ON a.x = b.y", -MEO_ERR_UNSUPPORTED, 16, "p_errors JOIN");
  p_bad("SELECT * FROM a LEFT JOIN b", -MEO_ERR_UNSUPPORTED, 16, "p_errors LEFT");
  p_bad("SELECT * FROM t garbage", -MEO_ERR_SQL, 16, "p_errors trailing garbage");
  p_bad("SELECT * FROM t WHERE a = 1 OR b = 2", -MEO_ERR_SQL, 28, "p_errors OR");
  p_bad("SELECT * FROM t LIMIT 9223372036854775808", -MEO_ERR_SQL, 22, "p_errors limit overflow");
  p_bad("INSERT INTO t VALUES (9223372036854775808)", -MEO_ERR_SQL, 22, "p_errors int overflow");
  p_bad("INSERT INTO t VALUES (-9223372036854775809)", -MEO_ERR_SQL, 23,
    "p_errors neg int overflow");
  p_bad("SELECT * FROM t LIMIT ?", -MEO_ERR_SQL, 22, "p_errors limit param");
  p_bad("SELECT * FROM t LIMIT -1", -MEO_ERR_SQL, 22, "p_errors limit negative");
  p_bad("INSERT INTO t VALUES (1, 2), (3)", -MEO_ERR_SQL, 29, "p_errors ragged rows");
  p_bad("INSERT INTO t (a, b) VALUES (1)", -MEO_ERR_SQL, 28, "p_errors width vs names");
  p_bad("SELECT * FROM t WHERE a IN ()", -MEO_ERR_SQL, 28, "p_errors empty IN");
  p_bad("SELECT * FROM t WHERE a = @", -MEO_ERR_SQL, 26, "p_errors bad byte");
  p_bad("SELECT * FROM t WHERE a IS 1", -MEO_ERR_SQL, 27, "p_errors IS 1");
  p_bad("UPDATE t a = 1", -MEO_ERR_SQL, 9, "p_errors missing SET");
  p_bad("DELETE t", -MEO_ERR_SQL, 7, "p_errors missing FROM in DELETE");
  p_bad("DROP TABLE t", -MEO_ERR_SQL, 0, "p_errors DROP");
  p_bad("", -MEO_ERR_SQL, 0, "p_errors empty");
  println("PASS p_errors");
}

fn main() -> int32 {
  p_arena = meo_arena_new(4096);
  if (p_arena == 0) {
    println("FAIL parse_self: no arena");
    return 1;
  }
  p_create();
  p_insert();
  p_select();
  p_update();
  p_delete();
  p_escapes();
  p_case();
  p_flux();
  p_errors();
  meo_arena_free(p_arena);
  if (p_failures != 0) {
    println("FAIL parse_self: {p_failures} failure(s)");
    return 1;
  }
  println("PASS parse_self");
  return 0;
}
