// cli_sub: the client's subscribe and scan calls against the server embedded on
// 127.0.0.1 port 0, once on a WAL database and once on a rollback-journal one.
// Events with their values (the old row of an UPDATE, the deleted row, a SCHEMA
// event), the table filter, a caller buffer that is too small, the window,
// heartbeats, a scan followed by a subscription from its commit_seq while a
// second connection keeps writing (no row lost, none twice), a GAP after the
// subscriber fell behind the ring and the rescan and resubscribe that follow,
// chunked and grouped scans, a scan in a transaction, the refusals while
// subscribed, UNSUPPORTED against a server without the capabilities, and a
// normal query after UNSUBSCRIBE.

import "std/io";
import "std/mem";
import "std/thread";
import "../src/error/status.mettle";
import "../src/platform/file.mettle";
import "../src/platform/file_linux.mettle";
import "../src/platform/clock_linux.mettle";
import "../src/meo_server.mettle";
import "../src/meo_client.mettle";
import "../src/wire/sub.mettle";

const CL_DB: string = "build/cli_sub.db";
const CL_IP: string = "127.0.0.1";
const CL_HB_MS: int32 = 300;
const CL_CAP: int32 = 8192;              // events a test keeps
const CL_PER: int32 = 64;                // events per meo_cli_events call
const CL_BUF: int32 = 1048576;
const CL_BASE: int64 = 20000;
const CL_FAR: float64 = 1000000000000.0;
const CL_W_FIRST: int64 = 100000;        // first row id the concurrent writer uses
const CL_W_ROWS: int32 = 2000;
const CL_JOIN_MS: uint32 = 120000;

// What the tests look at in one event.
struct ClEv {
  seq: uint64;
  commit: uint64;
  kind: int32;
  table: uint32;
  rowid: int64;
  old_rowid: int64;
  n_vals: int32;
  n_old: int32;
  id: int64;           // vals[0]
  v: float64;          // vals[1]
  tlen: int32;         // vals[2], a TEXT
  t0: int32;           // its first byte
  v3_null: bool;       // vals[3] is NULL
  ov: float64;         // old[1]
  oid: int64;          // old[0]
  name_len: int32;     // SCHEMA
  name0: int32;
  n_cols: int32;
  col1_0: int32;       // first byte of the second column's name
  col2_ty: int32;
}

// What a scan callback saw.
struct ClScan {
  n: int64;
  ordered: bool;       // x strictly increasing
  y_ok: bool;          // y == x / 2
  g_ok: bool;          // g == x % 3
  first: float64;
  last: float64;
  w_n: int64;          // points with x >= CL_W_FIRST
  stop_at: int64;      // stop after this many points, 0 = never
}

var g_port: int32 = 0;
var g_ev: ClEv* = 0;
var g_n: int32 = 0;
var g_out: MeoWEvent* = 0;
var g_buf: uint8* = 0;
var g_phase: int32 = 0;
var g_wrote: int32 = 0;
var g_w_bad: int32 = 0;

fn cl_fail(msg: string) -> int32 {
  println("FAIL cli_sub: {msg}");
  return 1;
}

fn cl_reset(db: string) -> int32 {
  var f: MeoFile = meo_file_open(db, MEO_OPEN_READ | MEO_OPEN_WRITE | MEO_OPEN_CREATE);
  if (!f.is_open) { return -MEO_ERR_IO; }
  var rc: int32 = meo_file_truncate(f, 0);
  meo_file_close(f);
  var jpath: string = db + "-journal";
  meo_file_unlink(jpath);
  free(jpath.chars);
  var wpath: string = db + "-wal";
  meo_file_unlink(wpath);
  free(wpath.chars);
  return rc;
}

// ---- statements ----

fn cl_col(col: MeoWCol*, name: string, ty: int32, flags: int32) {
  col->name = name;
  col->ty = ty;
  col->flags = flags;
}

fn cl_run(c: MeoCli*, st: MeoWStmt*) -> bool {
  var r: MeoCliResult;
  var rc: int32 = meo_cli_query(c, st, &r);
  if (rc == MEO_OK) { meo_cli_result_free(&r); }
  return rc == MEO_OK;
}

// CREATE TABLE t(id INTEGER PRIMARY KEY, v REAL, <b> <tb>).
fn cl_create(c: MeoCli*, table: string, b: string, tb: int32) -> bool {
  var cols: MeoWCol[3];
  cl_col(&cols[0], "id", MEO_T_INT, MEO_WIRE_CF_PK);
  cl_col(&cols[1], "v", MEO_T_REAL, 0);
  cl_col(&cols[2], b, tb, 0);
  var st: MeoWStmt;
  meo_wire_stmt_init(&st);
  st.op = MEO_WIRE_OP_CREATE;
  st.table = table;
  st.cols = &cols[0];
  st.n_cols = 3;
  return cl_run(c, &st);
}

// INSERT INTO t(id, v, name) VALUES (id, v, name).
fn cl_insert(c: MeoCli*, table: string, id: int64, v: float64, name: string) -> bool {
  var cols: MeoWCol[3];
  cl_col(&cols[0], "id", 0, 0);
  cl_col(&cols[1], "v", 0, 0);
  cl_col(&cols[2], "name", 0, 0);
  var args: MeoValue[3];
  meo_value_set_int(&args[0], id);
  meo_value_set_real(&args[1], v);
  meo_value_set_text(&args[2], name.chars, (int32)name.length);
  var st: MeoWStmt;
  meo_wire_stmt_init(&st);
  st.op = MEO_WIRE_OP_INSERT;
  st.table = table;
  st.cols = &cols[0];
  st.n_cols = 3;
  st.n_rows = 1;
  st.args = &args[0];
  st.n_args = 3;
  return cl_run(c, &st);
}

fn cl_update(c: MeoCli*, table: string, v: float64, id: int64) -> bool {
  var cols: MeoWCol[1];
  cl_col(&cols[0], "v", 0, 0);
  var terms: MeoWTerm[1];
  terms[0].col = "id";
  terms[0].op = MEO_WIRE_W_EQ;
  terms[0].arg0 = 1;
  terms[0].n_args = 1;
  var args: MeoValue[2];
  meo_value_set_real(&args[0], v);
  meo_value_set_int(&args[1], id);
  var st: MeoWStmt;
  meo_wire_stmt_init(&st);
  st.op = MEO_WIRE_OP_UPDATE;
  st.table = table;
  st.cols = &cols[0];
  st.n_cols = 1;
  st.terms = &terms[0];
  st.n_terms = 1;
  st.args = &args[0];
  st.n_args = 2;
  return cl_run(c, &st);
}

fn cl_delete(c: MeoCli*, table: string, id: int64) -> bool {
  var terms: MeoWTerm[1];
  terms[0].col = "id";
  terms[0].op = MEO_WIRE_W_EQ;
  terms[0].arg0 = 0;
  terms[0].n_args = 1;
  var args: MeoValue[1];
  meo_value_set_int(&args[0], id);
  var st: MeoWStmt;
  meo_wire_stmt_init(&st);
  st.op = MEO_WIRE_OP_DELETE;
  st.table = table;
  st.terms = &terms[0];
  st.n_terms = 1;
  st.args = &args[0];
  st.n_args = 1;
  return cl_run(c, &st);
}

fn cl_count(c: MeoCli*, table: string) -> int64 {
  var st: MeoWStmt;
  meo_wire_stmt_init(&st);
  st.op = MEO_WIRE_OP_COUNT;
  st.table = table;
  var r: MeoCliResult;
  if (meo_cli_query(c, &st, &r) != MEO_OK) { return -1; }
  var v: MeoValue;
  var n: int64 = -1;
  if (meo_cli_row_count(&r) == 1 && meo_cli_cell(&r, 0, 0, &v) == MEO_OK) { n = v.i; }
  meo_cli_result_free(&r);
  return n;
}

// CREATE TABLE t(id INTEGER PRIMARY KEY, v REAL, g INTEGER).
fn cl_create_g(c: MeoCli*, table: string) -> bool {
  return cl_create(c, table, "g", MEO_T_INT);
}

// Rows (id, v, g) in one autocommit INSERT: id = first .. first + n - 1,
// v = id / 2, g = id % 3.
fn cl_bulk(c: MeoCli*, table: string, first: int64, n: int32) -> bool {
  var cols: MeoWCol[3];
  cl_col(&cols[0], "id", 0, 0);
  cl_col(&cols[1], "v", 0, 0);
  cl_col(&cols[2], "g", 0, 0);
  var args: MeoValue* = (MeoValue*)malloc((int64)n * (int64)3 * (int64)sizeof(MeoValue));
  var i: int32 = 0;
  while (i < n) {
    var id: int64 = first + (int64)i;
    meo_value_set_int(&args[i * 3], id);
    meo_value_set_real(&args[i * 3 + 1], (float64)id / 2.0);
    meo_value_set_int(&args[i * 3 + 2], id % 3);
    i += 1;
  }
  var st: MeoWStmt;
  meo_wire_stmt_init(&st);
  st.op = MEO_WIRE_OP_INSERT;
  st.table = table;
  st.cols = &cols[0];
  st.n_cols = 3;
  st.n_rows = n;
  st.args = args;
  st.n_args = n * 3;
  var ok: bool = cl_run(c, &st);
  free((rawptr)args);
  return ok;
}

fn cl_add_column(c: MeoCli*, table: string, name: string, ty: int32) -> bool {
  var cols: MeoWCol[1];
  cl_col(&cols[0], name, ty, 0);
  var st: MeoWStmt;
  meo_wire_stmt_init(&st);
  st.op = MEO_WIRE_OP_ADD_COLUMN;
  st.table = table;
  st.cols = &cols[0];
  st.n_cols = 1;
  return cl_run(c, &st);
}

// ---- events ----

fn cl_note(e: MeoWEvent*, o: ClEv*) {
  o->seq = e->seq;
  o->commit = e->commit_seq;
  o->kind = e->kind;
  o->table = e->table_id;
  o->rowid = e->rowid;
  o->old_rowid = e->old_rowid;
  o->n_vals = e->n_vals;
  o->n_old = e->n_old;
  o->id = 0;
  o->v = 0.0;
  o->tlen = 0;
  o->t0 = 0;
  o->v3_null = false;
  o->ov = 0.0;
  o->oid = 0;
  o->name_len = (int32)e->name.length;
  o->name0 = 0;
  if (e->name.length > 0) { o->name0 = (int32)e->name.chars[0]; }
  o->n_cols = e->n_cols;
  o->col1_0 = 0;
  o->col2_ty = 0;
  if (e->n_cols >= 3) {
    o->col1_0 = (int32)e->cols[1].name.chars[0];
    o->col2_ty = e->cols[2].ty;
  }
  if (e->n_vals >= 3) {
    o->id = e->vals[0].i;
    o->v = e->vals[1].f;
    o->tlen = e->vals[2].n;
    if (e->vals[2].type == MEO_T_TEXT && e->vals[2].n > 0) { o->t0 = (int32)e->vals[2].p[0]; }
  }
  if (e->n_vals >= 4) { o->v3_null = e->vals[3].type == MEO_T_NULL; }
  if (e->n_old >= 2) {
    o->oid = e->old[0].i;
    o->ov = e->old[1].f;
  }
}

// One meo_cli_events call, its events appended to g_ev: the count or a
// negative code.
fn cl_pump(c: MeoCli*, per: int32, timeout_ms: int32) -> int32 {
  var n: int32 = meo_cli_events(c, g_out, per, g_buf, CL_BUF, timeout_ms);
  if (n <= 0) { return n; }
  var i: int32 = 0;
  while (i < n && g_n < CL_CAP) {
    cl_note(&g_out[i], &g_ev[g_n]);
    g_n += 1;
    i += 1;
  }
  return n;
}

// Pump until `want` events are held or timeout_ms has passed. 0, or a
// negative code from the client.
fn cl_collect(c: MeoCli*, want: int32, per: int32, timeout_ms: int32) -> int32 {
  var end: int64 = meo_clock_monotonic_us() + (int64)timeout_ms * (int64)1000;
  while (g_n < want) {
    var left: int64 = (end - meo_clock_monotonic_us()) / 1000;
    if (left < 1) { return 0; }
    var n: int32 = cl_pump(c, per, (int32)left);
    if (n < 0) { return n; }
  }
  return 0;
}

fn cl_clear() {
  g_n = 0;
}

// Subscribe to one table (or all, name ""): the client's code.
fn cl_sub(c: MeoCli*, table: string, from_seq: uint64, from_commit: uint64, window: int32,
          info: MeoWSubOk*) -> int32 {
  var names: string[1];
  names[0] = table;
  var n: int32 = 1;
  if (table.length == 0) { n = 0; }
  return meo_cli_subscribe(c, &names[0], n, from_seq, from_commit, window, info);
}

// The code the last failed call left in the client.
fn cl_err(c: MeoCli*) -> int32 {
  return meo_cli_err_code(c);
}

// ---- subscribe ----

fn cl_basic(w: MeoCli*, c: MeoCli*) -> int32 {
  if (!cl_create(w, "a", "name", MEO_T_TEXT) || !cl_create(w, "b", "name", MEO_T_TEXT)) { return cl_fail("create a, b"); }
  var info: MeoWSubOk;
  var rc: int32 = cl_sub(c, "a", 0, 0, 1000, &info);
  if (rc != MEO_OK) { return cl_fail("subscribe a rc={rc}"); }
  if (info.n_tables != 1 || info.tables[0].name != "a" || info.tables[0].n_cols != 3
      || info.tables[0].cols[1].name != "v" || info.tables[0].cols[1].ty != MEO_T_REAL
      || info.tables[0].cols[2].name != "name" || info.tables[0].cols[2].ty != MEO_T_TEXT
      || info.heartbeat_ms != (uint32)CL_HB_MS || info.commit_seq == 0) {
    return cl_fail("info: {info.n_tables} tables, heartbeat {info.heartbeat_ms}");
  }
  var tid: uint32 = info.tables[0].id;
  var commit0: uint64 = info.commit_seq;
  // The caller's buffer too small for the first event: nothing is lost.
  if (!cl_insert(w, "a", 1, 1.5, "x") || !cl_insert(w, "b", 1, 7.5, "b")) { return cl_fail("insert a1, b1"); }
  var tiny: uint8[16];
  rc = meo_cli_events(c, g_out, 4, &tiny[0], 16, 2000);
  if (rc != -MEO_ERR_TOOBIG || cl_err(c) != MEO_ERR_TOOBIG || meo_cli_err_fatal(c)) {
    return cl_fail("small buffer: rc={rc}");
  }
  cl_clear();
  if (cl_collect(c, 1, 1, 2000) != 0 || g_n != 1) { return cl_fail("basic: {g_n} events after TOOBIG, want 1"); }
  if (!cl_insert(w, "a", 2, 2.5, "yy") || !cl_update(w, "a", 9.5, 2) || !cl_delete(w, "a", 1)) {
    return cl_fail("insert a2, update, delete");
  }
  // Two at a time: the rest of a frame waits for the next call.
  if (cl_collect(c, 4, 2, 2000) != 0 || g_n != 4) { return cl_fail("basic: {g_n} events, want 4 (table b is not covered)"); }
  var e: ClEv* = g_ev;
  if (e[0].kind != MEO_WIRE_EV_INSERT || e[0].table != tid || e[0].rowid != 1 || e[0].n_vals != 3
      || e[0].id != 1 || e[0].v != 1.5 || e[0].tlen != 1 || e[0].t0 != 120 || e[0].n_old != 0) {
    return cl_fail("event 0: kind {e[0].kind} rowid {e[0].rowid} id {e[0].id} v {e[0].v}");
  }
  if (e[1].kind != MEO_WIRE_EV_INSERT || e[1].rowid != 2 || e[1].id != 2 || e[1].v != 2.5
      || e[1].tlen != 2 || e[1].t0 != 121) {
    return cl_fail("event 1: kind {e[1].kind} rowid {e[1].rowid} v {e[1].v}");
  }
  if (e[2].kind != MEO_WIRE_EV_UPDATE || e[2].rowid != 2 || e[2].old_rowid != 2 || e[2].v != 9.5
      || e[2].n_old != 3 || e[2].ov != 2.5 || e[2].oid != 2 || e[2].id != 2) {
    return cl_fail("event 2: kind {e[2].kind} v {e[2].v} n_old {e[2].n_old} old v {e[2].ov}");
  }
  if (e[3].kind != MEO_WIRE_EV_DELETE || e[3].rowid != 1 || e[3].n_vals != 3 || e[3].id != 1
      || e[3].v != 1.5 || e[3].tlen != 1 || e[3].n_old != 0) {
    return cl_fail("event 3: kind {e[3].kind} rowid {e[3].rowid} v {e[3].v}");
  }
  var i: int32 = 1;
  while (i < 4) {
    if (e[i].seq <= e[i - 1].seq || e[i].commit <= e[i - 1].commit) { return cl_fail("event {i} out of order"); }
    i += 1;
  }
  if (e[0].commit <= commit0) { return cl_fail("first event commit {e[0].commit} not after the subscribe's {commit0}"); }
  if (meo_cli_ack(c, e[3].seq) != MEO_OK) { return cl_fail("ack"); }
  if (meo_cli_unsubscribe(c) != MEO_OK) { return cl_fail("unsubscribe"); }
  return 0;
}

// Events outlive the call that returned them: they sit in the caller's buffer
// until it is reused.
fn cl_buffer(w: MeoCli*, c: MeoCli*) -> int32 {
  if (cl_sub(c, "a", 0, 0, 100, 0) != MEO_OK) { return cl_fail("subscribe a"); }
  if (!cl_insert(w, "a", 5, 5.5, "first") || !cl_insert(w, "a", 6, 6.5, "second")) { return cl_fail("insert"); }
  var got: int32 = 0;
  var end: int64 = meo_clock_monotonic_us() + (int64)2000000;
  var out: MeoWEvent[2];
  var buf: uint8[512];
  while (got < 2 && meo_clock_monotonic_us() < end) {
    // One event per call, each into its own half of buf.
    var n: int32 = meo_cli_events(c, &out[got], 1, &buf[got * 256], 256, 100);
    if (n < 0) { return cl_fail("buffer: rc={n}"); }
    got += n;
  }
  if (got != 2) { return cl_fail("buffer: {got} events"); }
  // The first is still good after the second call.
  if (out[0].vals[2].n != 5 || out[0].vals[2].p[0] != 102 || out[0].vals[2].p[4] != 116
      || out[1].vals[2].n != 6 || out[1].vals[2].p[0] != 115 || out[1].vals[1].f != 6.5) {
    return cl_fail("buffer: copied values are wrong");
  }
  if (meo_cli_unsubscribe(c) != MEO_OK) { return cl_fail("unsubscribe"); }
  return 0;
}

// All tables: a table created later is announced before its first row.
fn cl_all_tables(w: MeoCli*, c: MeoCli*) -> int32 {
  var info: MeoWSubOk;
  if (cl_sub(c, "", 0, 0, 1000, &info) != MEO_OK) { return cl_fail("subscribe all"); }
  if (info.n_tables < 2) { return cl_fail("subscribe all lists {info.n_tables} tables"); }
  if (!cl_insert(w, "b", 2, 3.5, "bb") || !cl_create(w, "c", "name", MEO_T_TEXT) || !cl_insert(w, "c", 5, 4.5, "c")) {
    return cl_fail("writes");
  }
  cl_clear();
  if (cl_collect(c, 3, CL_PER, 2000) != 0 || g_n != 3) { return cl_fail("all: {g_n} events, want 3"); }
  var e: ClEv* = g_ev;
  if (e[0].kind != MEO_WIRE_EV_INSERT || e[0].id != 2 || e[0].v != 3.5) { return cl_fail("all: b2 first, got kind {e[0].kind}"); }
  if (e[1].kind != MEO_WIRE_EV_SCHEMA || e[1].name_len != 1 || e[1].name0 != 99 || e[1].n_cols != 3
      || e[1].col1_0 != 118 || e[1].col2_ty != MEO_T_TEXT || e[1].table != e[2].table) {
    return cl_fail("all: SCHEMA kind {e[1].kind} name_len {e[1].name_len} n_cols {e[1].n_cols}");
  }
  if (e[2].kind != MEO_WIRE_EV_INSERT || e[2].rowid != 5 || e[2].id != 5 || e[2].v != 4.5) { return cl_fail("all: c5 kind {e[2].kind}"); }
  // ADD COLUMN: rows written before it read the new column as NULL.
  if (!cl_add_column(w, "c", "extra", MEO_T_INT) || !cl_update(w, "c", 2.0, 5)) { return cl_fail("add column, update"); }
  cl_clear();
  if (cl_collect(c, 2, CL_PER, 2000) != 0 || g_n != 2) { return cl_fail("add column: {g_n} events, want 2"); }
  if (e[0].kind != MEO_WIRE_EV_SCHEMA || e[0].n_cols != 4 || e[0].name0 != 99) { return cl_fail("add column: SCHEMA kind {e[0].kind} n_cols {e[0].n_cols}"); }
  if (e[1].kind != MEO_WIRE_EV_UPDATE || e[1].n_vals != 4 || e[1].n_old != 4 || !e[1].v3_null || e[1].v != 2.0 || e[1].ov != 4.5) {
    return cl_fail("add column: update n_vals {e[1].n_vals} n_old {e[1].n_old} v {e[1].v}");
  }
  if (meo_cli_unsubscribe(c) != MEO_OK) { return cl_fail("unsubscribe"); }
  return 0;
}

// Window 5 and no ACK: five events arrive and no more; each ACK of five opens
// room for exactly five.
fn cl_window(w: MeoCli*, c: MeoCli*) -> int32 {
  if (!cl_create(w, "win", "name", MEO_T_TEXT)) { return cl_fail("create win"); }
  if (cl_sub(c, "win", 0, 0, 5, 0) != MEO_OK) { return cl_fail("subscribe win"); }
  var i: int32 = 1;
  while (i <= 30) {
    if (!cl_insert(w, "win", (int64)i, 1.0, "w")) { return cl_fail("insert win {i}"); }
    i += 1;
  }
  cl_clear();
  if (cl_collect(c, 30, CL_PER, 400) != 0 || g_n != 5) { return cl_fail("window: {g_n} events before any ACK, want 5"); }
  var acked: int32 = 0;
  while (g_n < 30) {
    if (meo_cli_ack(c, g_ev[g_n - 1].seq) != MEO_OK) { return cl_fail("ack"); }
    acked = g_n;
    if (cl_collect(c, 30, CL_PER, 400) != 0) { return cl_fail("window collect"); }
    if (g_n != acked + 5) { return cl_fail("window: {g_n} events after {acked} acked, want {acked + 5}"); }
  }
  var j: int32 = 0;
  while (j < 30) {
    if (g_ev[j].rowid != (int64)j + 1) { return cl_fail("window: event {j} is rowid {g_ev[j].rowid}"); }
    j += 1;
  }
  if (meo_cli_unsubscribe(c) != MEO_OK) { return cl_fail("unsubscribe"); }
  return 0;
}

// Several heartbeat periods with nothing to say: events returns 0 and the
// stream is still alive.
fn cl_heartbeat(w: MeoCli*, c: MeoCli*) -> int32 {
  if (cl_sub(c, "a", 0, 0, 100, 0) != MEO_OK) { return cl_fail("subscribe a"); }
  var t0: int64 = meo_clock_monotonic_us();
  var n: int32 = meo_cli_events(c, g_out, CL_PER, g_buf, CL_BUF, CL_HB_MS * 3);
  var ms: int64 = (meo_clock_monotonic_us() - t0) / 1000;
  if (n != 0) { return cl_fail("heartbeat: events returned {n}"); }
  if (ms < (int64)CL_HB_MS * 2) { return cl_fail("heartbeat: returned after {ms} ms, asked for {CL_HB_MS * 3}"); }
  if (!meo_cli_connected(c)) { return cl_fail("heartbeat: connection lost"); }
  if (!cl_insert(w, "a", 77, 7.5, "hb")) { return cl_fail("insert"); }
  cl_clear();
  if (cl_collect(c, 1, CL_PER, 2000) != 0 || g_n != 1 || g_ev[0].id != 77) { return cl_fail("heartbeat: event after the quiet period"); }
  if (meo_cli_unsubscribe(c) != MEO_OK) { return cl_fail("unsubscribe"); }
  return 0;
}

// ---- scan ----

fn cl_scan_cb(ctx: rawptr, g: int64, x: float64, y: float64) -> int32 {
  var s: ClScan* = (ClScan*)ctx;
  if (s->n == 0) {
    s->first = x;
  } else if (x <= s->last) {
    s->ordered = false;
  }
  s->last = x;
  if (y != x / 2.0) { s->y_ok = false; }
  if (g != (int64)x % 3) { s->g_ok = false; }
  if (x >= (float64)CL_W_FIRST) { s->w_n += 1; }
  s->n += 1;
  if (s->stop_at > 0 && s->n == s->stop_at) { return 7; }
  return 0;
}

fn cl_scan_init(s: ClScan*) {
  s->n = 0;
  s->ordered = true;
  s->y_ok = true;
  s->g_ok = true;
  s->first = 0.0;
  s->last = 0.0;
  s->w_n = 0;
  s->stop_at = 0;
}

fn cl_scan(c: MeoCli*, table: string, group: string, lo: float64, hi: float64, chunk: int32,
           s: ClScan*, seq: uint64*) -> int32 {
  cl_scan_init(s);
  return meo_cli_scan_xy(c, table, "id", "v", group, lo, hi, chunk, &cl_scan_cb, (rawptr)s, seq);
}

fn cl_scans(w: MeoCli*, c: MeoCli*) -> int32 {
  if (!cl_create_g(w, "sc")) { return cl_fail("create sc"); }
  var i: int32 = 0;
  while (i < 20) {
    if (!cl_bulk(w, "sc", 1 + (int64)i * 1000, 1000)) { return cl_fail("bulk {i}"); }
    i += 1;
  }
  var s: ClScan;
  var seq: uint64 = 0;
  var rc: int32 = cl_scan(c, "sc", "", 100.0, 15000.0, 1000, &s, &seq);
  if (rc != MEO_OK || s.n != 14901 || !s.ordered || !s.y_ok || s.first != 100.0 || s.last != 15000.0 || seq == 0) {
    return cl_fail("scan: rc={rc} n={s.n} ordered={s.ordered} y_ok={s.y_ok} seq={seq}");
  }
  // The chunk size changes the frames, not the points.
  var sizes: int32[4];
  sizes[0] = 1;
  sizes[1] = 7;
  sizes[2] = 15000;
  sizes[3] = 1048576;
  i = 0;
  while (i < 4) {
    var seq2: uint64 = 0;
    rc = cl_scan(c, "sc", "", 100.0, 15000.0, sizes[i], &s, &seq2);
    if (rc != MEO_OK || s.n != 14901 || !s.ordered || !s.y_ok || seq2 != seq) {
      return cl_fail("scan chunk {sizes[i]}: rc={rc} n={s.n} seq={seq2} vs {seq}");
    }
    i += 1;
  }
  rc = cl_scan(c, "sc", "g", 1.0, CL_FAR, 4096, &s, 0);
  if (rc != MEO_OK || s.n != CL_BASE || !s.ordered || !s.y_ok || !s.g_ok) {
    return cl_fail("grouped scan: rc={rc} n={s.n} g_ok={s.g_ok}");
  }
  rc = cl_scan(c, "sc", "", 30000.0, 40000.0, 100, &s, &seq);
  if (rc != MEO_OK || s.n != 0 || seq == 0) { return cl_fail("empty window: rc={rc} n={s.n} seq={seq}"); }
  // The commit_seq a scan reports is the one a subscription continues from.
  var info: MeoWSubOk;
  rc = cl_scan(c, "sc", "", 1.0, CL_FAR, 5000, &s, &seq);
  if (rc != MEO_OK || cl_sub(c, "sc", 0, seq, 100, &info) != MEO_OK || info.commit_seq != seq) {
    return cl_fail("scan seq {seq} vs subscribe commit {info.commit_seq}");
  }
  if (meo_cli_unsubscribe(c) != MEO_OK) { return cl_fail("unsubscribe"); }
  // Refusals leave the connection usable.
  rc = meo_cli_scan_xy(c, "sc", "id", "nope", "", 1.0, 2.0, 10, &cl_scan_cb, (rawptr)&s, 0);
  if (rc != -MEO_ERR_SCHEMA || cl_err(c) != MEO_ERR_SCHEMA || meo_cli_err_fatal(c)) { return cl_fail("unknown column: rc={rc}"); }
  rc = meo_cli_scan_xy(c, "sc", "id", "v", "", 1.0, 2.0, 0, &cl_scan_cb, (rawptr)&s, 0);
  if (rc != -MEO_ERR_USAGE) { return cl_fail("chunk 0: rc={rc}"); }
  if (meo_cli_ping(c) != MEO_OK) { return cl_fail("ping after refusals"); }
  // A callback that stops: its answer comes back and the rest of the reply is
  // dropped, so the next request is answered correctly.
  cl_scan_init(&s);
  s.stop_at = 10;
  rc = meo_cli_scan_xy(c, "sc", "id", "v", "", 1.0, CL_FAR, 100, &cl_scan_cb, (rawptr)&s, &seq);
  if (rc != 7 || s.n != 10 || seq == 0) { return cl_fail("stopped scan: rc={rc} n={s.n}"); }
  if (cl_count(c, "sc") != CL_BASE) { return cl_fail("count after a stopped scan"); }
  // In a transaction a scan reads the transaction's own writes.
  if (meo_cli_begin(c, 0) != MEO_OK || !cl_bulk(c, "sc", 50000, 3)) { return cl_fail("begin, insert"); }
  rc = cl_scan(c, "sc", "", 40000.0, CL_FAR, 100, &s, 0);
  if (rc != MEO_OK || s.n != 3 || s.first != 50000.0) { return cl_fail("scan in a transaction: rc={rc} n={s.n}"); }
  if (meo_cli_rollback(c) != MEO_OK) { return cl_fail("rollback"); }
  rc = cl_scan(c, "sc", "", 40000.0, CL_FAR, 100, &s, 0);
  if (rc != MEO_OK || s.n != 0) { return cl_fail("scan after rollback: n={s.n}"); }
  return 0;
}

// ---- scan, then subscribe, under a writer ----

fn cl_writer(arg: cstring) -> uint32 {
  var w: MeoCli* = (MeoCli*)arg;
  var i: int32 = 0;
  while (i < CL_W_ROWS) {
    if (!cl_bulk(w, "cc", CL_W_FIRST + (int64)i, 1)) { g_w_bad += 1; }
    g_wrote = i + 1;
    i += 1;
  }
  return 0;
}

// Scan while rows are being committed, subscribe from the scan's commit_seq:
// the writer's rows are split between the scan and the stream with no row in
// both and none in neither, and the unacknowledged events never pass the window.
fn cl_concurrent(w: MeoCli*, w2: MeoCli*, c: MeoCli*) -> int32 {
  if (!cl_create_g(w, "cc")) { return cl_fail("create cc"); }
  if (!cl_bulk(w, "cc", 1, 1000) || !cl_bulk(w, "cc", 1001, 1000)) { return cl_fail("cc base rows"); }
  g_wrote = 0;
  g_w_bad = 0;
  var h: int64 = CreateThread(0, 0, &cl_writer, (cstring)w2, 0, 0);
  if (h == 0) { return cl_fail("thread"); }
  var bad: int32 = 0;
  var waited: int32 = 0;
  while (g_wrote < 200 && waited < 20000) {
    Sleep(1);
    waited += 1;
  }
  var s: ClScan;
  var seq: uint64 = 0;
  var rc: int32 = cl_scan(c, "cc", "", 1.0, CL_FAR, 500, &s, &seq);
  var in_scan: int64 = s.w_n;
  if (rc != MEO_OK || !s.ordered || s.n != 2000 + in_scan || in_scan < 200) {
    bad = cl_fail("concurrent scan: rc={rc} n={s.n} writer rows {in_scan}");
  }
  var window: int32 = 200;
  if (bad == 0 && cl_sub(c, "cc", 0, seq, window, 0) != MEO_OK) { bad = cl_fail("concurrent subscribe"); }
  var want: int32 = CL_W_ROWS - (int32)in_scan;
  cl_clear();
  var acked: int32 = 0;
  var end: int64 = meo_clock_monotonic_us() + (int64)30000000;
  while (bad == 0 && g_n < want && meo_clock_monotonic_us() < end) {
    var n: int32 = cl_pump(c, CL_PER, 200);
    if (n < 0) { bad = cl_fail("concurrent events rc={n}"); }
    if (bad == 0 && g_n - acked > window) { bad = cl_fail("{g_n - acked} events in flight, window {window}"); }
    if (bad == 0 && g_n - acked >= 50) {
      if (meo_cli_ack(c, g_ev[g_n - 1].seq) != MEO_OK) { bad = cl_fail("ack"); }
      acked = g_n;
    }
  }
  thread_join(h, CL_JOIN_MS);
  thread_close(h);
  if (bad != 0) { return bad; }
  if (g_w_bad != 0) { return cl_fail("{g_w_bad} writer inserts failed"); }
  println("scan took {in_scan} of {CL_W_ROWS} writer rows, the stream {g_n}");
  if (g_n != want) { return cl_fail("concurrent: {g_n} events, want {want}"); }
  var i: int32 = 0;
  while (i < g_n) {
    if (g_ev[i].kind != MEO_WIRE_EV_INSERT || g_ev[i].rowid != CL_W_FIRST + in_scan + (int64)i) {
      return cl_fail("concurrent: event {i} is kind {g_ev[i].kind} rowid {g_ev[i].rowid}, want {CL_W_FIRST + in_scan + (int64)i}");
    }
    i += 1;
  }
  // Nothing more, in particular no repeat of a row the scan held.
  var extra: int32 = cl_pump(c, CL_PER, 300);
  if (extra != 0) { return cl_fail("concurrent: {extra} more events after the last row"); }
  if (meo_cli_unsubscribe(c) != MEO_OK) { return cl_fail("unsubscribe"); }
  return 0;
}

// ---- falling behind ----

// Window 10 and no ACK while 70000 events are committed: the ring (65536)
// wraps and the stream says GAP. Reload (unsubscribe, scan), resubscribe from
// the scan's commit_seq: the next rows arrive once.
fn cl_gap(w: MeoCli*, c: MeoCli*) -> int32 {
  if (!cl_create_g(w, "gp")) { return cl_fail("create gp"); }
  if (cl_sub(c, "gp", 0, 0, 10, 0) != MEO_OK) { return cl_fail("subscribe gp"); }
  var i: int32 = 0;
  while (i < 70) {
    if (!cl_bulk(w, "gp", 1 + (int64)i * 1000, 1000)) { return cl_fail("gp bulk {i}"); }
    i += 1;
  }
  cl_clear();
  if (cl_collect(c, 100, CL_PER, 300) != 0 || g_n != 10) { return cl_fail("gap: {g_n} events with no ACK, want 10"); }
  var gap: int32 = -1;
  var rounds: int32 = 0;
  while (gap < 0 && rounds < 200) {
    if (meo_cli_ack(c, g_ev[g_n - 1].seq) != MEO_OK) { return cl_fail("ack"); }
    if (cl_collect(c, g_n + 10, CL_PER, 1000) != 0) { return cl_fail("gap: collect"); }
    var j: int32 = 0;
    while (j < g_n && gap < 0) {
      if (g_ev[j].kind == MEO_WIRE_EV_GAP) { gap = j; }
      j += 1;
    }
    rounds += 1;
  }
  if (gap < 0) { return cl_fail("gap: no GAP in {g_n} events after the ring wrapped"); }
  if (g_ev[gap].table != 0 || g_ev[gap].commit == 0 || g_ev[gap].n_vals != 0) { return cl_fail("gap: table {g_ev[gap].table} commit {g_ev[gap].commit}"); }
  if (meo_cli_unsubscribe(c) != MEO_OK) { return cl_fail("unsubscribe after the GAP"); }
  var s: ClScan;
  var seq: uint64 = 0;
  var rc: int32 = cl_scan(c, "gp", "", 0.0, CL_FAR, 8192, &s, &seq);
  if (rc != MEO_OK || s.n != 70000 || seq < g_ev[gap].commit) { return cl_fail("rescan: rc={rc} n={s.n} seq={seq} gap commit {g_ev[gap].commit}"); }
  if (cl_sub(c, "gp", 0, seq, 100, 0) != MEO_OK) { return cl_fail("resubscribe"); }
  if (!cl_bulk(w, "gp", 100000, 5)) { return cl_fail("insert after resubscribe"); }
  cl_clear();
  if (cl_collect(c, 5, CL_PER, 2000) != 0 || g_n != 5) { return cl_fail("after resubscribe: {g_n} events, want 5"); }
  i = 0;
  while (i < 5) {
    if (g_ev[i].kind != MEO_WIRE_EV_INSERT || g_ev[i].rowid != 100000 + (int64)i) { return cl_fail("after resubscribe: event {i} kind {g_ev[i].kind} rowid {g_ev[i].rowid}"); }
    i += 1;
  }
  if (cl_pump(c, CL_PER, 200) != 0) { return cl_fail("after resubscribe: an event more"); }
  if (meo_cli_unsubscribe(c) != MEO_OK) { return cl_fail("unsubscribe"); }
  return 0;
}

// ---- states and refusals ----

fn cl_states(w: MeoCli*, c: MeoCli*) -> int32 {
  var names: string[1];
  names[0] = "nope";
  var rc: int32 = meo_cli_subscribe(c, &names[0], 1, 0, 0, 10, 0);
  if (rc != -MEO_ERR_SCHEMA || cl_err(c) != MEO_ERR_SCHEMA || meo_cli_err_fatal(c)) { return cl_fail("unknown table: rc={rc}"); }
  if (meo_cli_subscribe(c, &names[0], 1, 0, 0, 0, 0) != -MEO_ERR_USAGE) { return cl_fail("window 0"); }
  if (meo_cli_subscribe(c, &names[0], 1, 0, 0, 65537, 0) != -MEO_ERR_USAGE) { return cl_fail("window 65537"); }
  if (meo_cli_unsubscribe(c) != -MEO_ERR_USAGE || meo_cli_ack(c, 1) != -MEO_ERR_USAGE) { return cl_fail("unsubscribe or ack while not subscribed"); }
  if (meo_cli_events(c, g_out, 1, g_buf, CL_BUF, 10) != -MEO_ERR_USAGE) { return cl_fail("events while not subscribed"); }
  if (meo_cli_ping(c) != MEO_OK) { return cl_fail("ping after refusals"); }
  // A subscription inside a transaction is the server's refusal.
  if (meo_cli_begin(c, 0) != MEO_OK) { return cl_fail("begin"); }
  rc = cl_sub(c, "a", 0, 0, 10, 0);
  if (rc != -MEO_ERR_TX || meo_cli_err_fatal(c) || meo_cli_tx_state(c) != MEO_CLI_TX_OPEN) { return cl_fail("subscribe in a transaction: rc={rc}"); }
  if (meo_cli_rollback(c) != MEO_OK) { return cl_fail("rollback"); }

  if (cl_sub(c, "a", 0, 0, 100, 0) != MEO_OK) { return cl_fail("subscribe a"); }
  // Only the stream calls work on a subscribed connection.
  if (meo_cli_ping(c) != -MEO_ERR_TX || cl_err(c) != MEO_ERR_TX) { return cl_fail("ping while subscribed"); }
  if (meo_cli_begin(c, 0) != -MEO_ERR_TX) { return cl_fail("begin while subscribed"); }
  if (cl_sub(c, "a", 0, 0, 100, 0) != -MEO_ERR_TX) { return cl_fail("second subscribe"); }
  var s: ClScan;
  if (cl_scan(c, "a", "", 0.0, 1.0, 10, &s, 0) != -MEO_ERR_TX) { return cl_fail("scan while subscribed"); }
  var st: MeoWStmt;
  meo_wire_stmt_init(&st);
  st.op = MEO_WIRE_OP_COUNT;
  st.table = "a";
  var r: MeoCliResult;
  if (meo_cli_query(c, &st, &r) != -MEO_ERR_TX) { return cl_fail("query while subscribed"); }
  // An ACK for an event never sent: a non-fatal error that events reports.
  if (meo_cli_ack(c, 1099511627776) != MEO_OK) { return cl_fail("ack send"); }
  rc = meo_cli_events(c, g_out, 1, g_buf, CL_BUF, 2000);
  if (rc != -MEO_ERR_USAGE || meo_cli_err_fatal(c) || !meo_cli_connected(c)) { return cl_fail("ack beyond what was sent: rc={rc}"); }
  if (!cl_insert(w, "a", 90, 1.0, "z")) { return cl_fail("insert"); }
  cl_clear();
  if (cl_collect(c, 1, CL_PER, 2000) != 0 || g_n != 1 || g_ev[0].id != 90) { return cl_fail("stream after the refused ack"); }
  // Events pending when the caller unsubscribes are dropped, then queries work.
  if (!cl_insert(w, "a", 91, 1.0, "z") || !cl_insert(w, "a", 92, 1.0, "z")) { return cl_fail("insert"); }
  if (meo_cli_unsubscribe(c) != MEO_OK) { return cl_fail("unsubscribe"); }
  if (meo_cli_events(c, g_out, 1, g_buf, CL_BUF, 10) != -MEO_ERR_USAGE) { return cl_fail("events after unsubscribe"); }
  if (meo_cli_ping(c) != MEO_OK) { return cl_fail("ping after unsubscribe"); }
  var n: int64 = cl_count(c, "a");
  if (n != 7) { return cl_fail("count after unsubscribe: {n}"); }
  // And a new subscription starts clean.
  if (cl_sub(c, "a", 0, 0, 100, 0) != MEO_OK) { return cl_fail("resubscribe"); }
  if (cl_pump(c, CL_PER, 100) != 0) { return cl_fail("stale events after resubscribe"); }
  if (meo_cli_unsubscribe(c) != MEO_OK) { return cl_fail("unsubscribe"); }

  // A server without the capabilities: the client does not send the new kinds.
  var caps: uint32 = c->caps;
  c->caps = MEO_WIRE_CAP_COUNT;
  rc = cl_sub(c, "a", 0, 0, 100, 0);
  if (rc != -MEO_ERR_UNSUPPORTED || cl_err(c) != MEO_ERR_UNSUPPORTED) { return cl_fail("subscribe without the cap: rc={rc}"); }
  rc = cl_scan(c, "a", "", 0.0, 1.0, 10, &s, 0);
  if (rc != -MEO_ERR_UNSUPPORTED) { return cl_fail("scan without the cap: rc={rc}"); }
  if (meo_cli_ping(c) != MEO_OK) { return cl_fail("ping after UNSUPPORTED"); }
  c->caps = caps;
  return 0;
}

// ---- run ----

fn cl_run_mode(wal: bool) -> int32 {
  var mode: string = "rollback";
  var flag: int32 = MEO_OPEN_NO_WAL;
  if (wal) {
    mode = "wal";
    flag = MEO_OPEN_WAL;
  }
  if (cl_reset(CL_DB) != MEO_OK) { return cl_fail("reset db"); }
  var db: MeoDb* = 0;
  var rc: int32 = meo_db_open(CL_DB, MEO_OPEN_CREATE | MEO_OPEN_READ | MEO_OPEN_WRITE | flag, 0, &db);
  if (rc != MEO_OK) { return cl_fail("{mode}: open db rc={rc}"); }
  var cfg: MeoSrvConfig;
  meo_srv_config_default(&cfg);
  cfg.ip = CL_IP;
  cfg.port = 0;
  cfg.sub_hb_ms = CL_HB_MS;
  var srv: MeoSrv* = 0;
  rc = meo_srv_start(db, &cfg, &srv);
  if (rc != MEO_OK) { return cl_fail("{mode}: start rc={rc}"); }
  g_port = meo_srv_port(srv);

  var w: MeoCli* = 0;
  var w2: MeoCli* = 0;
  var c: MeoCli* = 0;
  var bad: int32 = 0;
  if (meo_cli_connect(CL_IP, g_port, 0, 0, 0, &w) != MEO_OK || meo_cli_connect(CL_IP, g_port, 0, 0, 0, &w2) != MEO_OK
      || meo_cli_connect(CL_IP, g_port, 0, 0, 0, &c) != MEO_OK) {
    bad = cl_fail("{mode}: connect");
  }
  if (bad == 0 && ((meo_cli_caps(c) & MEO_WIRE_CAP_SUBSCRIBE) == 0 || (meo_cli_caps(c) & MEO_WIRE_CAP_SCAN) == 0 || c->minor != 1)) {
    bad = cl_fail("{mode}: caps {meo_cli_caps(c)} minor {c->minor}");
  }
  if (bad == 0) { bad = cl_basic(w, c); }
  if (bad == 0) { bad = cl_buffer(w, c); }
  if (bad == 0) { bad = cl_all_tables(w, c); }
  if (bad == 0) { bad = cl_window(w, c); }
  if (bad == 0) { bad = cl_heartbeat(w, c); }
  if (bad == 0) { bad = cl_scans(w, c); }
  if (bad == 0) { bad = cl_concurrent(w, w2, c); }
  if (bad == 0) { bad = cl_gap(w, c); }
  if (bad == 0) { bad = cl_states(w, c); }
  if (bad == 0) {
    // The server stops under a subscriber: events reports the lost stream.
    if (cl_sub(c, "a", 0, 0, 100, 0) != MEO_OK) { bad = cl_fail("{mode}: last subscribe"); }
  }
  if (bad != 0) { println("  (in {mode} mode)"); }
  rc = meo_srv_stop(srv);
  if (rc != MEO_OK && bad == 0) { bad = cl_fail("{mode}: stop rc={rc}"); }
  if (bad == 0) {
    var n: int32 = meo_cli_events(c, g_out, 1, g_buf, CL_BUF, 3000);
    if (n >= 0 || meo_cli_connected(c)) { bad = cl_fail("{mode}: events after the stop: {n}"); }
    n = meo_cli_events(c, g_out, 1, g_buf, CL_BUF, 10);
    if (n != -MEO_ERR_IO) { bad = cl_fail("{mode}: events on the lost stream: {n}"); }
  }
  if (w != 0) { meo_cli_close(w); }
  if (w2 != 0) { meo_cli_close(w2); }
  if (c != 0) { meo_cli_close(c); }
  if (meo_srv_free(srv) != MEO_OK && bad == 0) { bad = cl_fail("{mode}: free"); }
  rc = meo_db_close(db);
  if (rc != MEO_OK && bad == 0) { bad = cl_fail("{mode}: close rc={rc}"); }
  return bad;
}

fn main() -> int32 {
  g_ev = (ClEv*)malloc((int64)CL_CAP * (int64)sizeof(ClEv));
  g_out = (MeoWEvent*)malloc((int64)CL_PER * (int64)sizeof(MeoWEvent));
  g_buf = (uint8*)malloc((int64)CL_BUF);
  if (cl_run_mode(true) != 0) { return 1; }
  if (cl_run_mode(false) != 0) { return 1; }
  println("PASS cli_sub");
  return 0;
}
