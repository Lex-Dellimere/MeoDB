// wal_sync_self: the WAL's concurrency layer on raw files (no pager): group
// commit, fsync failure, read marks, checkpoint, restart, and a stress run.
//
// A program, not @test functions: every case needs real files in build/ and
// threads. It is a concurrency test, so run it many times.
//
//   mettle --build tests/wal_sync_self.mettle -o build/wal_sync_self
//   ./build/wal_sync_self
//
// Prints "PASS wal_sync_self" when every case passes, "FAIL <case>: <detail>"
// per failing check. Cases, each with the bug it exists to catch:
//   g1_group     20 published commits, 20 threads waiting, a slow fsync: all
//                return OK after at most 3 fsyncs and the notes come once each
//                in order. Catches a leader that syncs per waiter, a lost
//                wake-up, or a note delivered twice or out of order.
//   g2_failure   the first fsync fails: the waiter gets -IO, one FAILED note,
//                the WAL stays failed, new commits are refused, and a reopen
//                still recovers. Catches a failure that is retried or swallowed.
//   g3_marks     checkpoint stops at the oldest snapshot and at a db-file-only
//                reader, and writes the right page versions into the db file.
//   g4_restart   restart needs a fully copied log, no snapshot above the db
//                file, and the sync lock; the new generation survives a reopen.
//   g5_stress    one writer, 8 snapshot readers, auto-checkpoint and restarts:
//                a reader never sees a counter go backwards or ahead.
//   g6_pcache    a checkpoint drops the cached db-file copy of the pages it
//                rewrites and leaves other entries alone.

import "std/io";
import "std/mem";
import "std/thread";
import "../src/error/status.mettle";
import "../src/format/bytes.mettle";
import "../src/format/page.mettle";
import "../src/format/meta.mettle";
import "../src/platform/file.mettle";
import "../src/platform/file_linux.mettle";
import "../src/pager/pcache.mettle";
import "../src/pager/wal.mettle";
import "tinytest.mettle";

const WS_DB: string = "build/wal_sync_self.dat";
const WS_WAL: string = "build/wal_sync_self.dat-wal";
const WS_FRAME: int64 = 4120;
const WS_DEADLINE_MS: uint32 = 120000;
const WS_COMMITS: int32 = 2000;
const WS_READERS: int32 = 8;

var ws_note_lock: int32 = 0;
var ws_note_n: int32 = 0;
var ws_note_failed: int32 = 0;
var ws_notes: uint64[64];

fn ws_note(ctx: rawptr, kind: int32, seq: uint64) {
  spin_lock(&ws_note_lock);
  if (kind == MEO_WAL_NOTE_DURABLE) {
    if (ws_note_n < 64) { ws_notes[ws_note_n] = seq; }
    ws_note_n += 1;
  } else {
    ws_note_failed += 1;
  }
  spin_unlock(&ws_note_lock);
}

fn eq(a: int64, b: int64, name: string) -> bool {
  return meo_t_check_i64(a, b, name);
}

fn ws_load(p: int32*) -> int32 {
  return atomic_compare_exchange_i32(p, 0, 0);
}

// --- builders ---------------------------------------------------------------

// A sealed data page whose bytes depend on (page_no, tag).
fn ws_page(buf: uint8*, page_no: uint32, tag: uint32) {
  meo_page_init(buf, MEO_PAGE_BTREE_LEAF);
  meo_put_u32le(buf, 200, page_no);
  meo_put_u32le(buf, 204, tag);
  meo_page_seal(buf);
}

fn ws_page0(buf: uint8*, db_size: uint32, commit_seq: uint64) {
  meo_page_init(buf, MEO_PAGE_META);
  var m: MeoMeta;
  m.valid = true;
  m.magic = MEO_MAGIC;
  m.version = MEO_FORMAT_VERSION;
  m.page_size = MEO_PAGE_SIZE;
  m.page_count = db_size;
  m.flags = MEO_META_F_WAL;
  m.commit_seq = commit_seq;
  meo_meta_write(buf, m);
}

// Remove any WAL and make the db file empty. The handle is closed by the case.
fn ws_fresh() -> MeoFile {
  meo_file_unlink(WS_WAL);
  var f: MeoFile = meo_file_open(WS_DB,
    MEO_OPEN_READ | MEO_OPEN_WRITE | MEO_OPEN_CREATE);
  if (f.is_open) { meo_file_truncate(f, 0); }
  meo_wal_test_ctl(MEO_WAL_T_RESET, 0);
  ws_note_n = 0;
  ws_note_failed = 0;
  return f;
}

fn ws_open(db: MeoFile) -> MeoWal* {
  var w: MeoWal* = 0;
  var rc: int32 = meo_wal_open(WS_DB, db, false, &w);
  if (rc != MEO_OK) {
    println("FAIL open: rc {rc}");
    return 0;
  }
  return w;
}

fn ws_append(w: MeoWal*, page_no: uint32, tag: uint32) -> int32 {
  var b: uint8[4096];
  ws_page(&b[0], page_no, tag);
  return meo_wal_append(w, page_no, &b[0]);
}

// Write and publish a commit frame; returns its ticket, 0 on failure.
fn ws_commit(w: MeoWal*, db_size: uint32, seq: uint64) -> uint64 {
  var b: uint8[4096];
  ws_page0(&b[0], db_size, seq);
  var fr: uint32 = 0;
  var rc: int32 = meo_wal_commit_write(w, &b[0], db_size, &fr);
  if (rc != MEO_OK) {
    println("FAIL commit_write: rc {rc}");
    return 0;
  }
  var ticket: uint64 = 0;
  meo_wal_commit_publish(w, fr, seq, &ticket);
  return ticket;
}

// Page `pg` of the db file, into out. False when the file is too short.
fn ws_db_page(db: MeoFile, pg: uint32, out: uint8*) -> bool {
  var n: int32 = meo_file_read_at(db, (int64)pg * 4096, out, 4096);
  return n == 4096;
}

// Frame `fr` of the WAL file, page bytes only.
fn ws_frame_page(fr: uint32, out: uint8*) {
  var f: MeoFile = meo_file_open(WS_WAL, MEO_OPEN_READ);
  meo_file_read_at(f, 32 + ((int64)fr - 1) * WS_FRAME + 24, out, 4096);
  meo_file_close(f);
}

// Does db page `pg` equal the page held by WAL frame `fr`?
fn ws_db_has(db: MeoFile, pg: uint32, fr: uint32, name: string) -> bool {
  var a: uint8[4096];
  var b: uint8[4096];
  if (!ws_db_page(db, pg, &a[0])) {
    meo_t_check(false, "{name}: db page {pg} unreadable");
    return false;
  }
  ws_frame_page(fr, &b[0]);
  return meo_t_check_bytes(&a[0], &b[0], 4096, name);
}

// --- G1 ---------------------------------------------------------------------

struct WsWait {
  w: MeoWal*;
  ticket: uint64;
  rc: int32;
}

fn ws_waiter(arg: cstring) -> uint32 {
  var a: WsWait* = (WsWait*)arg;
  a->rc = meo_wal_wait(a->w, a->ticket);
  return 0;
}

fn ws_join(h: int64, what: string) {
  if (thread_join(h, WS_DEADLINE_MS) != WAIT_OBJECT_0()) {
    println("FAIL {what}: thread still running (hang?)");
    syscall(231, (int64)1);
  }
  thread_close(h);
}

fn g1_group() -> bool {
  var db: MeoFile = ws_fresh();
  var w: MeoWal* = ws_open(db);
  if (w == 0) { return false; }
  meo_wal_set_note(w, 0, &ws_note);
  meo_wal_test_ctl(MEO_WAL_T_SYNC_DELAY_US, 3000);
  var args: WsWait*[] = new WsWait*[20];
  var i: int32 = 0;
  while (i < 20) {
    if (!eq(ws_append(w, (uint32)(i % 5 + 1), (uint32)i), 0, "g1: append")) { return false; }
    var t: uint64 = ws_commit(w, 8, (uint64)(i + 1));
    if (t == 0) { return false; }
    args[i] = new WsWait;
    args[i]->w = w;
    args[i]->ticket = t;
    args[i]->rc = -1;
    i += 1;
  }
  if (!eq(meo_wal_durable(w), 0, "g1: nothing durable before the waits")) { return false; }
  var hs: int64[] = new int64[20];
  i = 0;
  while (i < 20) {
    hs[i] = CreateThread(0, 0, &ws_waiter, (cstring)args[i], 0, 0);
    if (hs[i] == 0) {
      println("FAIL g1: thread {i} did not start");
      return false;
    }
    i += 1;
  }
  i = 0;
  while (i < 20) {
    ws_join(hs[i], "g1");
    i += 1;
  }
  var ok: bool = true;
  i = 0;
  while (i < 20) {
    if (!eq((int64)args[i]->rc, 0, "g1: wait rc")) { ok = false; }
    i += 1;
  }
  if (!ok) { return false; }
  if (meo_wal_n_syncs(w) > 3) {
    meo_t_check(false, "g1: {meo_wal_n_syncs(w)} fsyncs for 20 commits");
    return false;
  }
  if (!eq((int64)meo_wal_durable(w), 40, "g1: durable edge")) { return false; }
  if (!eq((int64)ws_note_n, 20, "g1: note count")) { return false; }
  if (!eq((int64)ws_note_failed, 0, "g1: no failed note")) { return false; }
  i = 0;
  while (i < 20) {
    if (!eq((int64)ws_notes[i], (int64)(i + 1), "g1: note order")) { return false; }
    i += 1;
  }
  // Waiting for a durable ticket, and for ticket 0, is immediate.
  if (!eq((int64)meo_wal_wait(w, args[3]->ticket), 0, "g1: re-wait")) { return false; }
  if (!eq((int64)meo_wal_wait(w, 0), 0, "g1: ticket 0")) { return false; }
  meo_wal_test_ctl(MEO_WAL_T_RESET, 0);
  meo_wal_close(w, false);
  meo_file_close(db);
  println("PASS g1_group");
  return true;
}

// --- G2 ---------------------------------------------------------------------

fn g2_failure() -> bool {
  var db: MeoFile = ws_fresh();
  var w: MeoWal* = ws_open(db);
  if (w == 0) { return false; }
  meo_wal_set_note(w, 0, &ws_note);
  meo_wal_test_ctl(MEO_WAL_T_FAIL_SYNC_AT, 1);
  if (!eq(ws_append(w, 1, 1), 0, "g2: append")) { return false; }
  var t: uint64 = ws_commit(w, 4, 1);
  if (t == 0) { return false; }
  if (!eq((int64)meo_wal_wait(w, t), (int64)-MEO_ERR_IO, "g2: wait fails")) { return false; }
  if (!eq((int64)ws_note_failed, 1, "g2: one failed note")) { return false; }
  if (!eq((int64)ws_note_n, 0, "g2: no durable note")) { return false; }
  if (!meo_t_check(meo_wal_failed(w), "g2: failed flag")) { return false; }
  if (!eq((int64)meo_wal_durable(w), 0, "g2: durable stays")) { return false; }
  var b: uint8[4096];
  ws_page0(&b[0], 4, 2);
  var fr: uint32 = 0;
  if (!eq((int64)meo_wal_commit_write(w, &b[0], 4, &fr), (int64)-MEO_ERR_IO,
      "g2: commit refused")) { return false; }
  if (!eq((int64)meo_wal_wait(w, t), (int64)-MEO_ERR_IO, "g2: wait fails again")) { return false; }
  if (!eq((int64)meo_wal_sync(w), (int64)-MEO_ERR_IO, "g2: sync fails")) { return false; }
  if (!eq((int64)ws_note_failed, 1, "g2: still one failed note")) { return false; }
  meo_wal_close(w, false);

  // The frames reached the file (no real crash), so recovery finds them.
  meo_wal_test_ctl(MEO_WAL_T_RESET, 0);
  var w2: MeoWal* = ws_open(db);
  if (w2 == 0) { return false; }
  if (!eq((int64)meo_wal_last_commit(w2), 2, "g2: reopen last commit")) { return false; }
  if (!eq((int64)meo_wal_failed(w2), 0, "g2: reopen not failed")) { return false; }
  meo_wal_close(w2, false);
  meo_file_close(db);
  println("PASS g2_failure");
  return true;
}

// --- G3 ---------------------------------------------------------------------

// One commit of pages 1 and 2 with the given tags, made durable.
fn ws_step(w: MeoWal*, tag1: uint32, tag2: uint32, seq: uint64) -> bool {
  if (ws_append(w, 1, tag1) != 0) { return false; }
  if (ws_append(w, 2, tag2) != 0) { return false; }
  if (ws_commit(w, 4, seq) == 0) { return false; }
  return meo_wal_wait_all(w) == MEO_OK;
}

fn g3_marks() -> bool {
  var db: MeoFile = ws_fresh();
  var w: MeoWal* = ws_open(db);
  if (w == 0) { return false; }
  meo_wal_set_autockpt(w, 0);
  if (!meo_t_check(ws_step(w, 1, 2, 1), "g3: commit A")) { return false; }
  if (!meo_t_check(ws_step(w, 3, 4, 2), "g3: commit B")) { return false; }
  if (!eq((int64)meo_wal_durable(w), 6, "g3: durable 6")) { return false; }
  var s1: MeoWalSnap;
  meo_wal_snap_begin(w, &s1);
  if (!eq((int64)s1.mx, 6, "g3: s1 mx")) { return false; }
  if (!meo_t_check(s1.slot > 0, "g3: s1 slot")) { return false; }
  if (!meo_t_check(ws_step(w, 5, 6, 3), "g3: commit C")) { return false; }
  var s2: MeoWalSnap;
  meo_wal_snap_begin(w, &s2);
  if (!eq((int64)s2.mx, 9, "g3: s2 mx")) { return false; }
  if (!meo_t_check(s2.slot != s1.slot, "g3: s2 own slot")) { return false; }
  var s2b: MeoWalSnap;
  meo_wal_snap_begin(w, &s2b);
  if (!eq((int64)s2b.slot, (int64)s2.slot, "g3: same mark shares a slot")) { return false; }
  if (!eq((int64)meo_wal_readers(w), 3, "g3: readers")) { return false; }
  meo_wal_snap_end(w, &s2b);

  if (!eq((int64)meo_wal_checkpoint(w, MEO_CKPT_PASSIVE), 3, "g3: ckpt left")) { return false; }
  if (!eq((int64)meo_wal_backfilled(w), 6, "g3: backfilled 6")) { return false; }
  if (!ws_db_has(db, 0, 6, "g3: db page 0 = frame 6")) { return false; }
  if (!ws_db_has(db, 1, 4, "g3: db page 1 = frame 4")) { return false; }
  if (!ws_db_has(db, 2, 5, "g3: db page 2 = frame 5")) { return false; }

  meo_wal_snap_end(w, &s1);
  if (!eq((int64)meo_wal_checkpoint(w, MEO_CKPT_PASSIVE), 0, "g3: ckpt left 2")) { return false; }
  if (!eq((int64)meo_wal_backfilled(w), 9, "g3: backfilled 9")) { return false; }
  if (!ws_db_has(db, 0, 9, "g3: db page 0 = frame 9")) { return false; }
  if (!ws_db_has(db, 1, 7, "g3: db page 1 = frame 7")) { return false; }
  if (!ws_db_has(db, 2, 8, "g3: db page 2 = frame 8")) { return false; }

  // Everything durable is in the db file: a new reader needs no WAL.
  var s3: MeoWalSnap;
  meo_wal_snap_begin(w, &s3);
  if (!eq((int64)s3.mx, 0, "g3: s3 mx")) { return false; }
  if (!eq((int64)s3.slot, 0, "g3: s3 slot")) { return false; }
  meo_wal_snap_end(w, &s2);
  if (!meo_t_check(ws_step(w, 7, 8, 4), "g3: commit D")) { return false; }
  if (!eq((int64)meo_wal_checkpoint(w, MEO_CKPT_PASSIVE), 3, "g3: ckpt blocked")) { return false; }
  if (!eq((int64)meo_wal_backfilled(w), 9, "g3: slot-0 reader blocks")) { return false; }
  meo_wal_snap_end(w, &s3);
  if (!eq((int64)meo_wal_readers(w), 0, "g3: no readers")) { return false; }
  if (!eq((int64)meo_wal_checkpoint(w, MEO_CKPT_PASSIVE), 0, "g3: ckpt after")) { return false; }
  if (!eq((int64)meo_wal_backfilled(w), 12, "g3: backfilled 12")) { return false; }
  if (!ws_db_has(db, 1, 10, "g3: db page 1 = frame 10")) { return false; }

  if (!eq((int64)meo_wal_set_autockpt(w, -1), (int64)-MEO_ERR_USAGE, "g3: negative autockpt")) { return false; }
  meo_wal_close(w, false);
  meo_file_close(db);
  println("PASS g3_marks");
  return true;
}

// --- G4 ---------------------------------------------------------------------

fn g4_restart() -> bool {
  var db: MeoFile = ws_fresh();
  var w: MeoWal* = ws_open(db);
  if (w == 0) { return false; }
  meo_wal_set_autockpt(w, 0);
  var gen0: uint32 = meo_wal_gen(w);
  if (!meo_t_check(ws_append(w, 1, 1) == 0 && ws_commit(w, 4, 1) != 0, "g4: first commit")) { return false; }
  if (!eq((int64)meo_wal_wait_all(w), 0, "g4: sync")) { return false; }
  // Not yet copied into the db file: no restart.
  if (!meo_t_check_false(meo_wal_try_restart(w), "g4: restart before checkpoint")) { return false; }
  if (!eq((int64)meo_wal_checkpoint(w, MEO_CKPT_FULL), 0, "g4: full checkpoint")) { return false; }
  var sz: int64 = meo_file_size(db);
  if (!eq(sz, 4 * 4096, "g4: db file sized to the commit")) { return false; }
  if (!meo_t_check(meo_wal_try_restart(w), "g4: restart")) { return false; }
  if (!eq((int64)meo_wal_gen(w), (int64)gen0 + 1, "g4: gen")) { return false; }
  if (!eq((int64)meo_wal_end(w), 0, "g4: end")) { return false; }
  if (!eq((int64)meo_wal_durable(w), 0, "g4: durable")) { return false; }
  if (!eq((int64)meo_wal_last_commit(w), 0, "g4: appended")) { return false; }
  if (!eq((int64)meo_wal_backfilled(w), 0, "g4: backfilled")) { return false; }
  if (!eq((int64)meo_wal_find(w, 1, 1), 0, "g4: index empty")) { return false; }
  // A restart with nothing in the log is a no-op.
  if (!meo_t_check_false(meo_wal_try_restart(w), "g4: restart of an empty log")) { return false; }

  // A snapshot above the db file blocks it, even after the checkpoint.
  if (!meo_t_check(ws_append(w, 1, 2) == 0 && ws_commit(w, 4, 2) != 0, "g4: second commit")) { return false; }
  if (!eq((int64)meo_wal_wait_all(w), 0, "g4: sync 2")) { return false; }
  var s: MeoWalSnap;
  meo_wal_snap_begin(w, &s);
  if (!meo_t_check(s.mx > 0, "g4: snapshot mark")) { return false; }
  if (!eq((int64)meo_wal_checkpoint(w, MEO_CKPT_PASSIVE), 0, "g4: checkpoint under a reader")) { return false; }
  if (!meo_t_check_false(meo_wal_try_restart(w), "g4: restart under a reader")) { return false; }
  meo_wal_snap_end(w, &s);

  // So does a held sync lock.
  meo_wal_sync_lock(w);
  if (!meo_t_check_false(meo_wal_try_restart(w), "g4: restart under sync lock")) { return false; }
  meo_wal_sync_unlock(w);

  // And a frame written after the last commit.
  if (!eq(ws_append(w, 1, 3), 0, "g4: uncommitted frame")) { return false; }
  if (!meo_t_check_false(meo_wal_try_restart(w), "g4: restart with an open transaction")) { return false; }
  meo_wal_tx_rollback(w);
  if (!meo_t_check(meo_wal_try_restart(w), "g4: second restart")) { return false; }
  if (!eq((int64)meo_wal_gen(w), (int64)gen0 + 2, "g4: gen 2")) { return false; }

  // The new generation's frames survive a reopen.
  if (!meo_t_check(ws_append(w, 1, 9) == 0 && ws_commit(w, 4, 3) != 0, "g4: third commit")) { return false; }
  if (!eq((int64)meo_wal_wait_all(w), 0, "g4: sync 3")) { return false; }
  meo_wal_close(w, false);
  var w2: MeoWal* = ws_open(db);
  if (w2 == 0) { return false; }
  if (!eq((int64)meo_wal_last_commit(w2), 2, "g4: reopen last commit")) { return false; }
  if (!eq((int64)meo_wal_gen(w2), (int64)gen0 + 2, "g4: reopen gen")) { return false; }
  if (!eq((int64)meo_wal_find(w2, 1, 2), 1, "g4: reopen find")) { return false; }
  meo_wal_close(w2, false);
  meo_file_close(db);
  println("PASS g4_restart");
  return true;
}

// --- G5 ---------------------------------------------------------------------

// Counters shared by the writer and the readers (atomic words).
var ws_started: int32 = 0;    // the commit the writer is working on
var ws_committed: int32 = 0;  // the last commit known durable
var ws_stop: int32 = 0;

struct WsReader {
  w: MeoWal*;
  db: MeoFile;
  snaps: int32;
  bad: int32;
  first: int32;   // code of the first violation
}

fn ws_reader(arg: cstring) -> uint32 {
  var a: WsReader* = (WsReader*)arg;
  var buf: uint8* = malloc(4096);
  var prev: int32 = 0;
  while (ws_load(&ws_stop) == 0) {
    var lo: int32 = ws_load(&ws_committed);
    var s: MeoWalSnap;
    meo_wal_snap_begin(a->w, &s);
    var f: uint32 = meo_wal_find(a->w, 1, s.mx);
    var rc: int32 = MEO_OK;
    if (f > 0) {
      rc = meo_wal_read_page(a->w, f, buf);
    } else if (!ws_db_page(a->db, 1, buf)) {
      rc = -MEO_ERR_CORRUPT;
    }
    meo_wal_snap_end(a->w, &s);
    var hi: int32 = ws_load(&ws_started);
    var code: int32 = 0;
    if (rc != MEO_OK) {
      code = 1;
    } else if (meo_page_verify(buf) != MEO_OK) {
      code = 2;
    } else if (meo_get_u32le(buf, 200) != (uint32)1) {
      code = 3;
    } else {
      var tag: int32 = (int32)meo_get_u32le(buf, 204);
      if (tag < prev) { code = 4; }
      if (tag < lo) { code = 5; }
      if (tag > hi) { code = 6; }
      prev = tag;
    }
    if (code != 0) {
      a->bad += 1;
      if (a->first == 0) { a->first = code; }
    }
    a->snaps += 1;
  }
  free(buf);
  return 0;
}

fn g5_stress() -> bool {
  var db: MeoFile = ws_fresh();
  var w: MeoWal* = ws_open(db);
  if (w == 0) { return false; }
  // Page 1 starts at counter 0 in the db file, so a reader that needs the db
  // file always finds a valid page.
  var b: uint8[4096];
  var z: uint8[4096];
  ws_page(&z[0], 1, 0);
  meo_file_write_at(db, 4096, &z[0], 4096);
  meo_wal_set_autockpt(w, 50);
  meo_atomic_store_i32(&ws_started, 0);
  meo_atomic_store_i32(&ws_committed, 0);
  meo_atomic_store_i32(&ws_stop, 0);

  var args: WsReader*[] = new WsReader*[WS_READERS];
  var hs: int64[] = new int64[WS_READERS];
  var i: int32 = 0;
  while (i < WS_READERS) {
    args[i] = new WsReader;
    args[i]->w = w;
    args[i]->db = db;
    hs[i] = CreateThread(0, 0, &ws_reader, (cstring)args[i], 0, 0);
    if (hs[i] == 0) {
      println("FAIL g5: reader {i} did not start");
      return false;
    }
    i += 1;
  }

  var restarts: int32 = 0;
  var gen0: uint32 = meo_wal_gen(w);
  var ok: bool = true;
  var c: int32 = 1;
  while (c <= WS_COMMITS && ok) {
    meo_atomic_store_i32(&ws_started, c);
    if (meo_wal_try_restart(w)) { restarts += 1; }
    if (ws_append(w, 1, (uint32)c) != 0) { ok = false; }
    var t: uint64 = 0;
    if (ok) { t = ws_commit(w, 4, (uint64)c); }
    if (ok && t == 0) { ok = false; }
    if (ok && meo_wal_wait(w, t) != MEO_OK) {
      println("FAIL g5: wait at commit {c}");
      ok = false;
    }
    if (ok) { meo_atomic_store_i32(&ws_committed, c); }
    if (ok && c % 3 == 0) { meo_wal_checkpoint(w, MEO_CKPT_PASSIVE); }
    c += 1;
  }
  meo_atomic_store_i32(&ws_stop, 1);
  i = 0;
  while (i < WS_READERS) {
    ws_join(hs[i], "g5 reader");
    i += 1;
  }
  if (!ok) { return false; }
  var snaps: int64 = 0;
  i = 0;
  while (i < WS_READERS) {
    snaps += (int64)args[i]->snaps;
    if (args[i]->bad != 0) {
      meo_t_check(false, "g5: reader {i}: {args[i]->bad} bad snapshots, first code {args[i]->first}");
      ok = false;
    }
    i += 1;
  }
  if (!ok) { return false; }
  if (!meo_t_check(snaps > 0, "g5: readers ran")) { return false; }
  if (!meo_t_check(meo_wal_gen(w) == gen0 + (uint32)restarts, "g5: gen counts restarts")) { return false; }

  // With the readers gone everything can be copied; page 1 ends at the last
  // counter, wherever it lives.
  if (!eq((int64)meo_wal_checkpoint(w, MEO_CKPT_FULL), 0, "g5: final checkpoint")) { return false; }
  if (!ws_db_page(db, 1, &b[0])) {
    meo_t_check(false, "g5: final db page unreadable");
    return false;
  }
  if (!eq((int64)meo_get_u32le(&b[0], 204), (int64)WS_COMMITS, "g5: final counter")) { return false; }
  meo_wal_close(w, false);
  meo_file_close(db);
  println("PASS g5_stress ({snaps} snapshots, {restarts} restarts)");
  return true;
}

// --- G6 ---------------------------------------------------------------------

fn ws_fill(ctx: rawptr, page_no: uint32, src: uint64, out: uint8*) -> int32 {
  meo_bytes_zero(out, 4096);
  meo_put_u32le(out, 0, page_no);
  return MEO_OK;
}

fn ws_cached(c: MeoPcache*, page_no: uint32) -> bool {
  var err: int32 = 0;
  var f: MeoPcFrame* = meo_pcache_get(c, page_no, (uint64)0, &ws_fill, 0, &err);
  if (f == 0) { return false; }
  return meo_pcache_unpin(c, f) == MEO_OK;
}

fn g6_pcache() -> bool {
  var db: MeoFile = ws_fresh();
  var w: MeoWal* = ws_open(db);
  if (w == 0) { return false; }
  meo_wal_set_autockpt(w, 0);
  var c: MeoPcache* = meo_pcache_new(MEO_PCACHE_MIN_FRAMES);
  if (c == 0) {
    println("FAIL g6: pcache_new");
    return false;
  }
  meo_wal_set_pcache(w, c);
  if (!meo_t_check(ws_cached(c, 1) && ws_cached(c, 2) && ws_cached(c, 7), "g6: fill cache")) { return false; }
  if (!meo_t_check(ws_append(w, 1, 1) == 0 && ws_append(w, 2, 2) == 0, "g6: append")) { return false; }
  if (!meo_t_check(ws_commit(w, 8, 1) != 0, "g6: commit")) { return false; }
  if (!eq((int64)meo_wal_wait_all(w), 0, "g6: sync")) { return false; }
  // Nothing is copied yet, so nothing may be dropped.
  if (!eq((int64)meo_pcache_drop(c, 1, 0), 1, "g6: entry kept before checkpoint")) { return false; }
  if (!meo_t_check(ws_cached(c, 1), "g6: refill")) { return false; }
  if (!eq((int64)meo_wal_checkpoint(w, MEO_CKPT_PASSIVE), 0, "g6: checkpoint")) { return false; }
  if (!eq((int64)meo_pcache_drop(c, 1, 0), 0, "g6: page 1 dropped")) { return false; }
  if (!eq((int64)meo_pcache_drop(c, 2, 0), 0, "g6: page 2 dropped")) { return false; }
  if (!eq((int64)meo_pcache_drop(c, 7, 0), 1, "g6: page 7 untouched")) { return false; }
  meo_wal_close(w, false);
  meo_pcache_free(c);
  meo_file_close(db);
  println("PASS g6_pcache");
  return true;
}

fn main() -> int32 {
  if (!g1_group()) { return meo_t_report() + 1; }
  if (!g2_failure()) { return meo_t_report() + 1; }
  if (!g3_marks()) { return meo_t_report() + 1; }
  if (!g4_restart()) { return meo_t_report() + 1; }
  if (!g5_stress()) { return meo_t_report() + 1; }
  if (!g6_pcache()) { return meo_t_report() + 1; }
  println("PASS wal_sync_self");
  return meo_t_report();
}
