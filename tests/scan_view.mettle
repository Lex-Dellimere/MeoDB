// scan_view: the engine helpers the server builds on: waiting for the feed,
// scanning a snapshot view, the commit_seq a scan read, the old row of an
// UPDATE event and decoding a record into values.
//
// A program, not @test functions: every case needs real files in build/ and
// some run threads. Run it with
//
//   mbuild run scan_view
//
// It prints "PASS scan_view" when every case passes and "FAIL V<n>: ..." per
// failing check. Cases:
//   V1  meo_feed_wait returns 1 at once with events pending, 0 after the
//       timeout without, and wakes within 100 ms of a commit from another
//       thread (both modes).
//   V2  meo_db_snap_commit_seq matches the pager's after a commit, stays put
//       while later commits land, and is 0 for a non-view.
//   V3  a scan on a view sees the view's data, not a later commit, and takes
//       no lock.
//   V4  meo_q_scan_xy_seq / xyg_seq report the commit_seq read (both modes).
//   V5  an UPDATE event carries the new and the old row; INSERT and DELETE
//       carry no old row; key + val + old_val over the cap is a GAP.
//   V6  meo_tbl_row_values: alias column, a row written before ADD COLUMN,
//       and the argument checks.

import "std/io";
import "std/mem";
import "std/thread";
import "../src/error/status.mettle";
import "../src/platform/file.mettle";
import "../src/platform/file_linux.mettle";
import "../src/platform/clock_linux.mettle";
import "../src/platform/futex_linux.mettle";
import "../src/feed/feed.mettle";
import "../src/meodb.mettle";
import "tinytest.mettle";

const SV_OUT_CAP: int32 = 64;
const SV_KEY_CAP: int32 = 65536;

var g_out: MeoChange* = 0;
var g_kb: uint8* = 0;

fn eq(a: int64, b: int64, name: string) -> bool {
  return meo_t_check_i64(a, b, name);
}

// --- helpers ----------------------------------------------------------------

fn sv_open(path: string, wal: bool, db: MeoDb**) -> bool {
  var f: MeoFile = meo_file_open(path,
    MEO_OPEN_READ | MEO_OPEN_WRITE | MEO_OPEN_CREATE);
  if (!f.is_open) { return false; }
  meo_file_truncate(f, 0);
  meo_file_close(f);
  var jpath: string = path + "-journal";
  var wpath: string = path + "-wal";
  meo_file_unlink(jpath);
  meo_file_unlink(wpath);
  free(jpath.chars);
  free(wpath.chars);
  var flags: int32 = MEO_OPEN_READ | MEO_OPEN_WRITE | MEO_OPEN_CREATE;
  if (wal) { flags = flags | MEO_OPEN_WAL; }
  return eq(meo_db_open(path, flags, 0, db), MEO_OK, "open");
}

fn sv_run(q: MeoQuery*) -> int32 {
  var rc: int32 = meo_q_step(q);
  meo_q_free(q);
  if (rc == MEO_DONE) { return MEO_OK; }
  return rc;
}

// CREATE TABLE <name> (id INTEGER PRIMARY KEY, v INTEGER).
fn sv_create(db: MeoDb*, name: string) -> int32 {
  var q: MeoQuery* = 0;
  var rc: int32 = meo_q_create(db, name, &q);
  if (rc != MEO_OK) { return rc; }
  meo_q_column_def(q, "id", MEO_T_INT, MEO_COL_PK);
  meo_q_column_def(q, "v", MEO_T_INT, 0);
  return sv_run(q);
}

fn sv_ins(db: MeoDb*, k: int64, v: int64) -> int32 {
  var q: MeoQuery* = 0;
  var rc: int32 = meo_q_insert(db, "t", &q);
  if (rc != MEO_OK) { return rc; }
  meo_q_into(q, "id");
  meo_q_into(q, "v");
  var x: MeoValue;
  meo_value_set_int(&x, k);
  meo_q_value(q, &x);
  meo_value_set_int(&x, v);
  meo_q_value(q, &x);
  return sv_run(q);
}

fn sv_upd(db: MeoDb*, k: int64, v: int64) -> int32 {
  var q: MeoQuery* = 0;
  var rc: int32 = meo_q_update(db, "t", &q);
  if (rc != MEO_OK) { return rc; }
  var x: MeoValue;
  meo_value_set_int(&x, v);
  meo_q_assign(q, "v", &x);
  meo_value_set_int(&x, k);
  meo_q_where(q, "id", MEO_Q_EQ, &x);
  return sv_run(q);
}

fn sv_del(db: MeoDb*, k: int64) -> int32 {
  var q: MeoQuery* = 0;
  var rc: int32 = meo_q_delete(db, "t", &q);
  if (rc != MEO_OK) { return rc; }
  var x: MeoValue;
  meo_value_set_int(&x, k);
  meo_q_where(q, "id", MEO_Q_EQ, &x);
  return sv_run(q);
}

var g_scan_n: int64 = 0;
var g_scan_sum: float64 = 0.0;
var g_scan_gsum: int64 = 0;

fn sv_cb(ctx: rawptr, x: float64, y: float64) -> int32 {
  g_scan_n += 1;
  g_scan_sum += y;
  return 0;
}

fn sv_gcb(ctx: rawptr, g: int64, x: float64, y: float64) -> int32 {
  g_scan_n += 1;
  g_scan_gsum += g;
  return 0;
}

fn sv_scan(db: MeoDb*) -> int32 {
  g_scan_n = 0;
  g_scan_sum = 0.0;
  return meo_q_scan_xy(db, "t", "id", "v", 0.0, 1.0e9, &sv_cb, 0);
}

fn sv_read(f: MeoFeed*, cur: MeoFeedCursor*) -> int32 {
  return meo_feed_read(f, cur, g_out, SV_OUT_CAP, g_kb, SV_KEY_CAP);
}

// --- V1: meo_feed_wait --------------------------------------------------------

var g_db: MeoDb* = 0;
var g_t_commit: int64 = 0;

fn sv_late_writer(arg: cstring) -> uint32 {
  meo_sleep_us(50000);
  g_t_commit = meo_clock_monotonic_us();
  sv_ins(g_db, 1, 1);
  return 0;
}

fn v1_mode(wal: bool, name: string) -> int32 {
  if (!sv_open("build/scan_view_v1.dat", wal, &g_db)) { return 1; }
  if (!eq(sv_create(g_db, "t"), 0, "V1 {name}: create")) { return 1; }
  var f: MeoFeed* = meo_feed_new(64);
  if (!eq(meo_feed_attach(g_db->pager, f), MEO_OK, "V1 {name}: attach")) { return 1; }
  var cur: MeoFeedCursor;
  meo_feed_cursor_end(f, &cur);

  var t0: int64 = meo_clock_monotonic_us();
  var rc: int32 = meo_feed_wait(f, &cur, 60);
  var ms: int64 = (meo_clock_monotonic_us() - t0) / 1000;
  if (!eq(rc, 0, "V1 {name}: timeout answer")) { return 1; }
  if (!meo_t_check(ms >= 55 && ms < 250, "V1 {name}: timed out after ~60 ms ({ms} ms)")) {
    return 1;
  }
  if (!eq(meo_feed_wait(f, &cur, 0), 0, "V1 {name}: zero timeout")) { return 1; }
  if (!eq(meo_feed_wait(0, &cur, 0), -MEO_ERR_USAGE, "V1 {name}: null feed")) { return 1; }

  var h: int64 = CreateThread(0, 0, &sv_late_writer, 0, 0, 0);
  if (h == 0) { return 1; }
  rc = meo_feed_wait(f, &cur, 5000);
  var woke: int64 = meo_clock_monotonic_us();
  thread_join(h, 10000);
  thread_close(h);
  if (!eq(rc, 1, "V1 {name}: woken by a commit")) { return 1; }
  var lag: int64 = (woke - g_t_commit) / 1000;
  if (!meo_t_check(lag < 100, "V1 {name}: woke within 100 ms of the commit ({lag} ms)")) {
    return 1;
  }

  // Pending already: no waiting. The cursor did not move.
  t0 = meo_clock_monotonic_us();
  rc = meo_feed_wait(f, &cur, 5000);
  ms = (meo_clock_monotonic_us() - t0) / 1000;
  if (!eq(rc, 1, "V1 {name}: pending answer")) { return 1; }
  if (!meo_t_check(ms < 50, "V1 {name}: pending returns at once ({ms} ms)")) { return 1; }
  if (!eq(sv_read(f, &cur), 1, "V1 {name}: the event")) { return 1; }
  if (!eq(meo_feed_wait(f, &cur, 20), 0, "V1 {name}: drained")) { return 1; }

  // A rolled-back transaction publishes nothing and wakes nothing for good.
  meo_db_begin(g_db, MEO_TX_DEFAULT);
  sv_ins(g_db, 2, 2);
  meo_db_rollback(g_db);
  if (!eq(meo_feed_wait(f, &cur, 20), 0, "V1 {name}: rollback")) { return 1; }
  meo_db_close(g_db);
  meo_feed_free(f);
  return 0;
}

fn v1() -> int32 {
  if (v1_mode(true, "wal") != 0) { return 1; }
  if (v1_mode(false, "rollback") != 0) { return 1; }
  println("PASS V1: feed wait");
  return 0;
}

// --- V2 / V3: snapshot views ---------------------------------------------------

fn v2() -> int32 {
  var db: MeoDb* = 0;
  if (!sv_open("build/scan_view_v2.dat", true, &db)) { return 1; }
  if (!eq(sv_create(db, "t"), 0, "V2: create")) { return 1; }
  sv_ins(db, 1, 1);
  sv_ins(db, 2, 2);
  var v: MeoDb* = 0;
  if (!eq(meo_db_snap_begin(db, &v), MEO_OK, "V2: snap")) { return 1; }
  var s: uint64 = meo_db_snap_commit_seq(v);
  if (!meo_t_check(s != 0, "V2: nonzero")) { return 1; }
  if (!eq((int64)s, (int64)meo_pager_commit_seq(db->pager), "V2: matches the pager")) {
    return 1;
  }
  sv_ins(db, 3, 3);
  if (!meo_t_check(meo_pager_commit_seq(db->pager) > s, "V2: pager moved on")) { return 1; }
  if (!eq((int64)meo_db_snap_commit_seq(v), (int64)s, "V2: view stays put")) { return 1; }
  meo_db_snap_end(v);
  var v2: MeoDb* = 0;
  meo_db_snap_begin(db, &v2);
  if (!eq((int64)meo_db_snap_commit_seq(v2), (int64)meo_pager_commit_seq(db->pager),
      "V2: new view is current")) {
    return 1;
  }
  meo_db_snap_end(v2);
  if (!eq((int64)meo_db_snap_commit_seq(db), 0, "V2: non-view")) { return 1; }
  if (!eq((int64)meo_db_snap_commit_seq(0), 0, "V2: null")) { return 1; }
  meo_db_close(db);
  println("PASS V2: snapshot commit_seq");
  return 0;
}

fn v3() -> int32 {
  var db: MeoDb* = 0;
  if (!sv_open("build/scan_view_v3.dat", true, &db)) { return 1; }
  if (!eq(sv_create(db, "t"), 0, "V3: create")) { return 1; }
  var k: int64 = 1;
  while (k <= 10) {
    sv_ins(db, k, k * 10);
    k += 1;
  }
  var v: MeoDb* = 0;
  meo_db_snap_begin(db, &v);
  sv_ins(db, 11, 110);
  sv_upd(db, 1, 999);
  // A transaction holding the db lock does not matter to a view.
  if (!eq(meo_db_begin(db, MEO_TX_DEFAULT), MEO_OK, "V3: begin")) { return 1; }
  sv_ins(db, 12, 120);
  var rc: int32 = sv_scan(v);
  meo_db_rollback(db);
  if (!eq(rc, 0, "V3: scan view")) { return 1; }
  if (!eq(g_scan_n, 10, "V3: the view's rows only")) { return 1; }
  if (!meo_t_check(g_scan_sum == 550.0, "V3: the view's values")) { return 1; }
  var seq: uint64 = 0;
  rc = meo_q_scan_xy_seq(v, "t", "id", "v", 0.0, 1.0e9, &sv_cb, 0, &seq);
  if (!eq(rc, 0, "V3: scan view seq")) { return 1; }
  if (!eq((int64)seq, (int64)meo_db_snap_commit_seq(v), "V3: seq is the view's")) { return 1; }
  meo_db_snap_end(v);
  if (!eq(sv_scan(db), 0, "V3: scan base")) { return 1; }
  if (!eq(g_scan_n, 11, "V3: base sees the commit")) { return 1; }
  meo_db_close(db);
  println("PASS V3: scan on a view");
  return 0;
}

// --- V4: *_seq ----------------------------------------------------------------

fn v4_mode(wal: bool, name: string) -> int32 {
  var db: MeoDb* = 0;
  if (!sv_open("build/scan_view_v4.dat", wal, &db)) { return 1; }
  if (!eq(sv_create(db, "t"), 0, "V4 {name}: create")) { return 1; }
  var k: int64 = 1;
  while (k <= 5) {
    sv_ins(db, k, k % 2);
    k += 1;
  }
  var seq: uint64 = 0;
  g_scan_n = 0;
  var rc: int32 = meo_q_scan_xy_seq(db, "t", "id", "v", 0.0, 1.0e9, &sv_cb, 0, &seq);
  if (!eq(rc, 0, "V4 {name}: xy")) { return 1; }
  if (!eq(g_scan_n, 5, "V4 {name}: xy rows")) { return 1; }
  if (!meo_t_check(seq != 0, "V4 {name}: nonzero")) { return 1; }
  if (!eq((int64)seq, (int64)meo_pager_commit_seq(db->pager), "V4 {name}: xy seq")) {
    return 1;
  }
  sv_ins(db, 6, 0);
  var seq2: uint64 = 0;
  g_scan_n = 0;
  g_scan_gsum = 0;
  rc = meo_q_scan_xyg_seq(db, "t", "id", "v", "v", 0.0, 1.0e9, &sv_gcb, 0, &seq2);
  if (!eq(rc, 0, "V4 {name}: xyg")) { return 1; }
  if (!eq(g_scan_n, 6, "V4 {name}: xyg rows")) { return 1; }
  if (!eq(g_scan_gsum, 3, "V4 {name}: xyg groups")) { return 1; }
  if (!meo_t_check(seq2 > seq, "V4 {name}: seq advanced")) { return 1; }
  if (!eq((int64)seq2, (int64)meo_pager_commit_seq(db->pager), "V4 {name}: xyg seq")) {
    return 1;
  }
  // An unknown column is a SCHEMA error.
  seq = 77;
  rc = meo_q_scan_xy_seq(db, "t", "id", "nope", 0.0, 1.0e9, &sv_cb, 0, &seq);
  if (!eq(rc, -MEO_ERR_SCHEMA, "V4 {name}: unknown column")) { return 1; }
  if (!eq(sv_scan(db), 0, "V4 {name}: plain scan")) { return 1; }
  meo_db_close(db);
  return 0;
}

fn v4() -> int32 {
  if (v4_mode(true, "wal") != 0) { return 1; }
  if (v4_mode(false, "rollback") != 0) { return 1; }
  println("PASS V4: scan reports its commit_seq");
  return 0;
}

// --- V5: the old row of an UPDATE ---------------------------------------------

fn sv_text_row(db: MeoDb*, id: int64, n: int32, ch: uint8, update: bool) -> int32 {
  var buf: uint8[] = new uint8[n];
  memset(buf.data, (int32)ch, (int64)n);
  var q: MeoQuery* = 0;
  var rc: int32 = 0;
  var x: MeoValue;
  var s: MeoValue;
  meo_value_set_text(&s, buf.data, n);
  if (update) {
    rc = meo_q_update(db, "u", &q);
    if (rc != MEO_OK) { free(buf.data); return rc; }
    meo_q_assign(q, "s", &s);
    meo_value_set_int(&x, id);
    meo_q_where(q, "id", MEO_Q_EQ, &x);
  } else {
    rc = meo_q_insert(db, "u", &q);
    if (rc != MEO_OK) { free(buf.data); return rc; }
    meo_q_into(q, "id");
    meo_q_into(q, "s");
    meo_value_set_int(&x, id);
    meo_q_value(q, &x);
    meo_q_value(q, &s);
  }
  rc = sv_run(q);
  free(buf.data);
  return rc;
}

fn v5_mode(wal: bool, name: string) -> int32 {
  var db: MeoDb* = 0;
  if (!sv_open("build/scan_view_v5.dat", wal, &db)) { return 1; }
  if (!eq(sv_create(db, "t"), 0, "V5 {name}: create")) { return 1; }
  var cq: MeoQuery* = 0;
  meo_q_create(db, "u", &cq);
  meo_q_column_def(cq, "id", MEO_T_INT, MEO_COL_PK);
  meo_q_column_def(cq, "s", MEO_T_TEXT, 0);
  if (!eq(sv_run(cq), 0, "V5 {name}: create u")) { return 1; }
  var tt: MeoTable* = meo_cat_find(db->cat, "t".chars, 1);
  var f: MeoFeed* = meo_feed_new(64);
  if (!eq(meo_feed_attach(db->pager, f), MEO_OK, "V5 {name}: attach")) { return 1; }
  var cur: MeoFeedCursor;
  meo_feed_cursor_end(f, &cur);
  sv_ins(db, 7, 10);
  sv_upd(db, 7, 20);
  sv_del(db, 7);
  if (!eq(meo_feed_wait(f, &cur, 2000), 1, "V5 {name}: events")) { return 1; }
  if (!eq(sv_read(f, &cur), 3, "V5 {name}: three events")) { return 1; }
  var vals: MeoValue[2];
  var c: MeoChange* = &g_out[0];
  if (!eq(c->kind, MEO_CHANGE_INSERT, "V5 {name}: insert")) { return 1; }
  if (!eq(c->old_val_len, 0, "V5 {name}: insert has no old row")) { return 1; }
  if (!meo_t_check(c->old_val == 0, "V5 {name}: insert old_val")) { return 1; }
  c = &g_out[1];
  if (!eq(c->kind, MEO_CHANGE_REPLACE, "V5 {name}: update")) { return 1; }
  if (!meo_t_check(c->old_val != 0 && c->old_val_len > 0, "V5 {name}: old row present")) {
    return 1;
  }
  if (!eq(meo_tbl_row_values(tt, 7, c->val, c->val_len, &vals[0], 2), 0,
      "V5 {name}: new row")) {
    return 1;
  }
  if (!eq(vals[1].i, 20, "V5 {name}: new value")) { return 1; }
  if (!eq(meo_tbl_row_values(tt, 7, c->old_val, c->old_val_len, &vals[0], 2), 0,
      "V5 {name}: old row decode")) {
    return 1;
  }
  if (!eq(vals[0].i, 7, "V5 {name}: old alias")) { return 1; }
  if (!eq(vals[1].i, 10, "V5 {name}: old value")) { return 1; }
  c = &g_out[2];
  if (!eq(c->kind, MEO_CHANGE_DELETE, "V5 {name}: delete")) { return 1; }
  if (!eq(c->old_val_len, 0, "V5 {name}: delete has no old row")) { return 1; }

  // Two 1500-byte rows fit one event; two 2500-byte rows do not.
  sv_text_row(db, 1, 1500, 65, false);
  sv_text_row(db, 1, 1500, 66, true);
  if (!eq(sv_read(f, &cur), 2, "V5 {name}: text events")) { return 1; }
  c = &g_out[1];
  if (!eq(c->kind, MEO_CHANGE_REPLACE, "V5 {name}: text update")) { return 1; }
  if (!meo_t_check(c->old_val_len > 1500 && c->val_len > 1500, "V5 {name}: both rows kept")) {
    return 1;
  }
  sv_text_row(db, 2, 2500, 65, false);
  sv_text_row(db, 2, 2500, 66, true);
  if (!eq(sv_read(f, &cur), 2, "V5 {name}: big events")) { return 1; }
  if (!eq(g_out[0].kind, MEO_CHANGE_INSERT, "V5 {name}: big insert fits")) { return 1; }
  if (!eq(g_out[1].kind, MEO_CHANGE_GAP, "V5 {name}: big update is a GAP")) { return 1; }
  if (!eq(g_out[1].old_val_len, 0, "V5 {name}: GAP has no old row")) { return 1; }
  if (!eq(sv_read(f, &cur), 0, "V5 {name}: drained")) { return 1; }

  // Reused ring slots must not leak an old row into a later INSERT.
  var k: int64 = 0;
  while (k < 70) {
    sv_ins(db, 100 + k, k);
    k += 1;
  }
  var n: int32 = sv_read(f, &cur);
  while (n > 0) {
    var i: int32 = 0;
    while (i < n) {
      if (!meo_t_check_false(g_out[i].kind == MEO_CHANGE_INSERT && g_out[i].old_val_len != 0,
          "V5 {name}: INSERT with an old row")) {
        return 1;
      }
      i += 1;
    }
    n = sv_read(f, &cur);
  }
  meo_db_close(db);
  meo_feed_free(f);
  return 0;
}

fn v5() -> int32 {
  if (v5_mode(true, "wal") != 0) { return 1; }
  if (v5_mode(false, "rollback") != 0) { return 1; }
  println("PASS V5: update events carry the old row");
  return 0;
}

// --- V6: meo_tbl_row_values ---------------------------------------------------

fn v6() -> int32 {
  var db: MeoDb* = 0;
  if (!sv_open("build/scan_view_v6.dat", false, &db)) { return 1; }
  var cq: MeoQuery* = 0;
  meo_q_create(db, "w", &cq);
  meo_q_column_def(cq, "id", MEO_T_INT, MEO_COL_PK);
  meo_q_column_def(cq, "a", MEO_T_TEXT, 0);
  meo_q_column_def(cq, "b", MEO_T_REAL, 0);
  if (!eq(sv_run(cq), 0, "V6: create")) { return 1; }
  var ins: MeoQuery* = 0;
  meo_q_insert(db, "w", &ins);
  meo_q_into(ins, "id");
  meo_q_into(ins, "a");
  meo_q_into(ins, "b");
  var x: MeoValue;
  meo_value_set_int(&x, 41);
  meo_q_value(ins, &x);
  meo_value_set_text(&x, "hello".chars, 5);
  meo_q_value(ins, &x);
  meo_value_set_real(&x, 2.5);
  meo_q_value(ins, &x);
  if (!eq(sv_run(ins), 0, "V6: insert")) { return 1; }
  var aq: MeoQuery* = 0;
  meo_q_add_column(db, "w", &aq);
  meo_q_column_def(aq, "c", MEO_T_INT, 0);
  if (!eq(sv_run(aq), 0, "V6: add column")) { return 1; }
  var ins2: MeoQuery* = 0;
  meo_q_insert(db, "w", &ins2);
  meo_q_into(ins2, "id");
  meo_q_into(ins2, "c");
  meo_value_set_int(&x, 42);
  meo_q_value(ins2, &x);
  meo_value_set_int(&x, 9);
  meo_q_value(ins2, &x);
  if (!eq(sv_run(ins2), 0, "V6: insert 2")) { return 1; }

  var t: MeoTable* = meo_cat_find(db->cat, "w".chars, 1);
  if (!meo_t_check(t != 0, "V6: find")) { return 1; }
  if (!eq(t->n_cols, 4, "V6: four columns")) { return 1; }
  var vals: MeoValue[4];
  var buf: MeoTblBuf;
  meo_tbl_buf_init(&buf);
  var row: MeoTblRow;
  meo_db_enter(db);
  if (!eq(meo_tbl_lookup_rowid(db, t, 41, &buf, &row), 0, "V6: lookup 41")) { return 1; }
  var rc: int32 = meo_tbl_row_values(t, row.rowid, row.rec, row.rec_len, &vals[0], 4);
  if (!eq(rc, 0, "V6: old row")) { return 1; }
  if (!eq(vals[0].type, MEO_T_INT, "V6: alias type")) { return 1; }
  if (!eq(vals[0].i, 41, "V6: alias is the rowid")) { return 1; }
  if (!eq(vals[1].type, MEO_T_TEXT, "V6: a type")) { return 1; }
  if (!eq(vals[1].n, 5, "V6: a length")) { return 1; }
  if (!eq((int64)vals[1].p[0], 104, "V6: a bytes")) { return 1; }
  if (!meo_t_check(vals[2].type == MEO_T_REAL && vals[2].f == 2.5, "V6: b")) { return 1; }
  if (!eq(vals[3].type, MEO_T_NULL, "V6: missing column is NULL")) { return 1; }
  if (!eq(meo_tbl_lookup_rowid(db, t, 42, &buf, &row), 0, "V6: lookup 42")) { return 1; }
  rc = meo_tbl_row_values(t, row.rowid, row.rec, row.rec_len, &vals[0], 4);
  if (!eq(rc, 0, "V6: new row")) { return 1; }
  if (!eq(vals[0].i, 42, "V6: new alias")) { return 1; }
  if (!eq(vals[1].type, MEO_T_NULL, "V6: a NULL")) { return 1; }
  if (!eq(vals[3].i, 9, "V6: c")) { return 1; }
  // Bad arguments.
  if (!eq(meo_tbl_row_values(t, 1, row.rec, row.rec_len, &vals[0], 3), -MEO_ERR_USAGE,
      "V6: wrong n")) {
    return 1;
  }
  if (!eq(meo_tbl_row_values(0, 1, row.rec, row.rec_len, &vals[0], 4), -MEO_ERR_USAGE,
      "V6: null table")) {
    return 1;
  }
  if (!eq(meo_tbl_row_values(t, 1, 0, 0, &vals[0], 4), -MEO_ERR_CORRUPT,
      "V6: empty record")) {
    return 1;
  }
  meo_db_leave(db);
  meo_tbl_buf_free(&buf);
  meo_db_close(db);
  println("PASS V6: record to values");
  return 0;
}

fn main() -> int32 {
  var outs: MeoChange[] = new MeoChange[SV_OUT_CAP];
  var kbs: uint8[] = new uint8[SV_KEY_CAP];
  g_out = outs.data;
  g_kb = kbs.data;
  if (v1() != 0) { meo_t_report(); return 1; }
  if (v2() != 0) { meo_t_report(); return 1; }
  if (v3() != 0) { meo_t_report(); return 1; }
  if (v4() != 0) { meo_t_report(); return 1; }
  if (v5() != 0) { meo_t_report(); return 1; }
  if (v6() != 0) { meo_t_report(); return 1; }
  var rc: int32 = meo_t_report();
  if (rc == 0) { println("PASS scan_view"); }
  return rc;
}
