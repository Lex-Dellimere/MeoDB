// journal_self: the rollback journal and recovery (PHASE3.md 3B/3C).
//
// A program, not @test functions: every case needs real files in build/ and a
// pager, neither of which the compile-time interpreter provides.
//
//   ./tools/mettle --build tests/journal_self.mettle -o build/laneJ/j
//   ./build/laneJ/j
//
// Prints "PASS <case>" per case and "FAIL <case>: <detail>" per failing check,
// and returns non-zero on the first failure. tests/tinytest.mettle is the
// reporting layer; every check short-circuits its case.
//
// Cases, each with the bug it exists to catch:
//   j2_commit          begin/modify/commit: the new content is durable, the
//                      journal is gone. Catches a commit that deletes the
//                      journal before the database is durable.
//   j3_rollback        begin/overwrite/rollback: the old content and the old
//                      page_count come back. Catches a rollback that restores
//                      data but not page_count.
//   j4_crash           a real fork/_exit death after the journal is fsynced:
//                      reopen replays the before-images and removes the
//                      journal. Catches replay that is not idempotent, or that
//                      runs after the database was already fine.
//   j5_torn            a journal truncated mid-record: reopen is CORRUPT and
//                      the database is not touched. Catches a replay that
//                      trusts n_records past what the file holds.
//   j6_checksum        a flipped header byte: reopen is CORRUPT and the
//                      database is not touched. Catches a replay that starts
//                      before validating the checksum.
//   j7_capacity        a cap of 4 and a fifth distinct page: NOSPC, then a
//                      rollback that leaves the database unchanged. Catches a
//                      journal that silently drops a before-image.
//   j8_first_touch     a page written twice in one transaction gets one
//                      before-image. Catches a duplicate that would make
//                      rollback restore the wrong state.
//   j9_page0_nonresident
//                      page 0 flushed while it is not resident still gets a
//                      before-image through the non-resident flush branch.
//
// J4 uses fork(57) and _exit(60) rather than a second bin: it is a genuine
// process death with no unwinding, and it needs no manifest change. This is
// Linux-only, and it is the platform's own syscall, not a portability claim.

import "std/io";
import "std/mem";
import "../src/error/status.mettle";
import "../src/format/page.mettle";
import "../src/format/meta.mettle";
import "../src/platform/file.mettle";
import "../src/platform/file_linux.mettle";
import "../src/pager/pager.mettle";
import "tinytest.mettle";

const J_DB: string = "build/journal_self.dat";

// --- file helpers ----------------------------------------------------------

// "<db>-journal", owned by the caller (free(path.chars)).
fn jrn_jpath(db: string) -> string {
  var out: string = db + "-journal";
  return out;
}

// Make `db` a zero-byte file and remove any journal beside it, so a run is
// repeatable. A missing journal is not an error.
fn jrn_reset(db: string) -> int32 {
  var f: MeoFile = meo_file_open(db,
    MEO_OPEN_READ | MEO_OPEN_WRITE | MEO_OPEN_CREATE);
  if (!f.is_open) { return -MEO_ERR_IO; }
  var rc: int32 = meo_file_truncate(f, 0);
  meo_file_close(f);
  var jpath: string = jrn_jpath(db);
  meo_file_unlink(jpath);
  free(jpath.chars);
  return rc;
}

// Seed a database with `n` data pages, each carrying its page number in byte
// 20, and leave it closed and durable.
fn jrn_seed(db: string, n: int32) -> int32 {
  var p: MeoPager* = meo_pager_open(db, 16, MEO_PAGER_CREATE);
  if (p == 0) { return -MEO_ERR_IO; }
  var i: int32 = 0;
  while (i < n) {
    var f: MeoFrame* = meo_pager_alloc(p);
    if (f == 0) {
      meo_pager_close(p);
      meo_pager_free(p);
      return -MEO_ERR_NOMEM;
    }
    f->data[20] = (uint8)(i + 1);
    if (meo_pager_release(p, f, true) != MEO_OK) {
      meo_pager_close(p);
      meo_pager_free(p);
      return -MEO_ERR_IO;
    }
    i += 1;
  }
  var rc: int32 = meo_pager_flush(p);
  if (rc == MEO_OK) { rc = meo_pager_close(p); }
  meo_pager_free(p);
  return rc;
}

fn jrn_read_byte(db: string, page_no: uint32, off: int64) -> int32 {
  var f: MeoFile = meo_file_open(db, MEO_OPEN_READ);
  if (!f.is_open) { return -1; }
  var one: uint8[1];
  var rc: int32 = meo_file_read_at(f,
    (int64)page_no * (int64)MEO_PAGE_SIZE + off, &one[0], 1);
  meo_file_close(f);
  if (rc != 1) { return -1; }
  return (int32)one[0];
}

fn jrn_file_size(path: string) -> int64 {
  var f: MeoFile = meo_file_open(path, MEO_OPEN_READ);
  if (!f.is_open) { return -1; }
  var n: int64 = meo_file_size(f);
  meo_file_close(f);
  return n;
}

fn jrn_exists(path: string) -> bool {
  var f: MeoFile = meo_file_open(path, MEO_OPEN_READ);
  if (!f.is_open) { return false; }
  meo_file_close(f);
  return true;
}

fn jrn_flip_byte(path: string, off: int64) -> int32 {
  var f: MeoFile = meo_file_open(path, MEO_OPEN_READ | MEO_OPEN_WRITE);
  if (!f.is_open) { return -MEO_ERR_IO; }
  var one: uint8[1];
  var rc: int32 = meo_file_read_at(f, off, &one[0], 1);
  if (rc != 1) {
    meo_file_close(f);
    return -MEO_ERR_IO;
  }
  one[0] = (uint8)(one[0] ^ 0xFF);
  rc = meo_file_write_at(f, off, &one[0], 1);
  meo_file_close(f);
  return rc;
}

fn jrn_truncate(path: string, size: int64) -> int32 {
  var f: MeoFile = meo_file_open(path, MEO_OPEN_READ | MEO_OPEN_WRITE);
  if (!f.is_open) { return -MEO_ERR_IO; }
  var rc: int32 = meo_file_truncate(f, size);
  meo_file_close(f);
  return rc;
}

// --- the crash child -------------------------------------------------------

// Fork, and in the child open `db`, begin, overwrite pages 1..pages with
// `value`, flush (which appends and fsyncs the before-images), fsync the
// database, and _exit(42). The child never closes or frees the pager: _exit
// skips every atexit path, which is the point. The parent wait4s and answers
// the child's exit status, or a negative value when the fork/wait failed.
fn jrn_crash(db: string, pages: int32, value: uint8) -> int32 {
  var pid: int64 = syscall(57);
  if (pid < 0) { return -1; }
  if (pid == 0) {
    var p: MeoPager* = meo_pager_open(db, 8, 0);
    if (p == 0) { syscall(60, (int64)90); }
    if (meo_pager_begin(p) != MEO_OK) { syscall(60, (int64)91); }
    var i: int32 = 1;
    while (i <= pages) {
      var f: MeoFrame* = meo_pager_get(p, (uint32)i, true);
      if (f == 0) { syscall(60, (int64)92); }
      f->data[20] = value;
      if (meo_pager_release(p, f, true) != MEO_OK) { syscall(60, (int64)93); }
      i += 1;
    }
    if (meo_pager_flush(p) != MEO_OK) { syscall(60, (int64)94); }
    if (meo_pager_sync(p) != MEO_OK) { syscall(60, (int64)95); }
    syscall(60, (int64)42);
  }
  var status: int32 = 0;
  var w: int64 = syscall(61, pid, (int64)&status, (int64)0, (int64)0);
  if (w < 0) { return -1; }
  // WIFEXITED: the low seven bits are zero. WEXITSTATUS: bits 8..15.
  if ((status & 0x7F) != 0) { return -2; }
  return (status >> 8) & 0xFF;
}

// --- J2: begin / modify / commit -------------------------------------------

fn j2_commit() -> int32 {
  if (!meo_t_check(jrn_reset(J_DB) == MEO_OK, "j2: reset")) { return 1; }
  if (!meo_t_check(jrn_seed(J_DB, 4) == MEO_OK, "j2: seed four pages")) {
    return 1;
  }
  var p: MeoPager* = meo_pager_open(J_DB, 8, 0);
  if (!meo_t_check(p != 0, "j2: open")) { return 1; }
  if (!meo_t_check(meo_pager_begin(p) == MEO_OK, "j2: begin")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  if (!meo_t_check(meo_pager_journal_attached(p), "j2: the journal is attached")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  var i: uint32 = 1;
  while (i <= 4) {
    var f: MeoFrame* = meo_pager_get(p, i, true);
    if (!meo_t_check(f != 0, "j2: get a page for write")) {
      meo_pager_close(p);
      meo_pager_free(p);
      return 1;
    }
    f->data[20] = (uint8)(0xA0 + i);
    if (!meo_t_check(meo_pager_release(p, f, true) == MEO_OK,
        "j2: release it dirty")) {
      meo_pager_close(p);
      meo_pager_free(p);
      return 1;
    }
    i += 1;
  }
  if (!meo_t_check(meo_pager_commit(p) == MEO_OK, "j2: commit")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  if (!meo_t_check_false(meo_pager_journal_attached(p),
      "j2: commit detached the journal")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  var jpath: string = jrn_jpath(J_DB);
  if (!meo_t_check_false(jrn_exists(jpath), "j2: no journal file remains")) {
    free(jpath.chars);
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  free(jpath.chars);
  if (!meo_t_check(meo_pager_close(p) == MEO_OK, "j2: close")) { return 1; }
  meo_pager_free(p);

  var q: MeoPager* = meo_pager_open(J_DB, 8, 0);
  if (!meo_t_check(q != 0, "j2: reopen")) { return 1; }
  i = 1;
  while (i <= 4) {
    var f: MeoFrame* = meo_pager_get(q, i, false);
    if (!meo_t_check(f != 0, "j2: get a committed page")) {
      meo_pager_close(q);
      meo_pager_free(q);
      return 1;
    }
    if (!meo_t_check_i64((int64)f->data[20], (int64)(0xA0 + i),
        "j2: the committed content is durable")) {
      meo_pager_release(q, f, false);
      meo_pager_close(q);
      meo_pager_free(q);
      return 1;
    }
    meo_pager_release(q, f, false);
    i += 1;
  }
  if (!meo_t_check(meo_pager_close(q) == MEO_OK, "j2: close the reopen")) {
    return 1;
  }
  meo_pager_free(q);
  println("PASS j2_commit");
  return 0;
}

// --- J3: rollback ----------------------------------------------------------

fn j3_rollback() -> int32 {
  if (!meo_t_check(jrn_reset(J_DB) == MEO_OK, "j3: reset")) { return 1; }
  if (!meo_t_check(jrn_seed(J_DB, 4) == MEO_OK, "j3: seed four pages")) {
    return 1;
  }
  var p: MeoPager* = meo_pager_open(J_DB, 8, 0);
  if (!meo_t_check(p != 0, "j3: open")) { return 1; }
  if (!meo_t_check(meo_pager_begin(p) == MEO_OK, "j3: begin")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  var i: uint32 = 1;
  while (i <= 2) {
    var f: MeoFrame* = meo_pager_get(p, i, true);
    if (!meo_t_check(f != 0, "j3: get a page for write")) {
      meo_pager_close(p);
      meo_pager_free(p);
      return 1;
    }
    f->data[20] = (uint8)0xEE;
    if (!meo_t_check(meo_pager_release(p, f, true) == MEO_OK,
        "j3: release it dirty")) {
      meo_pager_close(p);
      meo_pager_free(p);
      return 1;
    }
    i += 1;
  }
  // Allocate a page too: the transaction grows the file, so rollback has to
  // restore page_count AND truncate the file back to it, or the next open
  // refuses a size that disagrees with the meta.
  var nf: MeoFrame* = meo_pager_alloc(p);
  if (!meo_t_check(nf != 0, "j3: allocate a page in the transaction")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  nf->data[20] = (uint8)0x99;
  if (!meo_t_check(meo_pager_release(p, nf, true) == MEO_OK,
      "j3: release the new page dirty")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  // Force the new content to disk before the rollback, so the test proves the
  // before-images restore it rather than the cache never having written it.
  if (!meo_t_check(meo_pager_flush(p) == MEO_OK, "j3: flush the new content")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  if (!meo_t_check_i64((int64)meo_pager_page_count(p), 6,
      "j3: the transaction grew page_count")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  if (!meo_t_check(meo_pager_rollback(p) == MEO_OK, "j3: rollback")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  if (!meo_t_check_false(meo_pager_journal_attached(p),
      "j3: rollback detached the journal")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  if (!meo_t_check_i64((int64)meo_pager_page_count(p), 5,
      "j3: rollback restored page_count")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  var jpath: string = jrn_jpath(J_DB);
  if (!meo_t_check_false(jrn_exists(jpath), "j3: no journal file remains")) {
    free(jpath.chars);
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  free(jpath.chars);
  if (!meo_t_check(meo_pager_close(p) == MEO_OK, "j3: close")) { return 1; }
  meo_pager_free(p);

  var q: MeoPager* = meo_pager_open(J_DB, 8, 0);
  if (!meo_t_check(q != 0, "j3: reopen")) { return 1; }
  if (!meo_t_check_i64((int64)meo_pager_page_count(q), 5,
      "j3: page_count is unchanged after reopen")) {
    meo_pager_close(q);
    meo_pager_free(q);
    return 1;
  }
  i = 1;
  while (i <= 2) {
    var f: MeoFrame* = meo_pager_get(q, i, false);
    if (!meo_t_check(f != 0, "j3: get a rolled-back page")) {
      meo_pager_close(q);
      meo_pager_free(q);
      return 1;
    }
    if (!meo_t_check_i64((int64)f->data[20], (int64)i,
        "j3: the old content is back")) {
      meo_pager_release(q, f, false);
      meo_pager_close(q);
      meo_pager_free(q);
      return 1;
    }
    meo_pager_release(q, f, false);
    i += 1;
  }
  if (!meo_t_check(meo_pager_close(q) == MEO_OK, "j3: close the reopen")) {
    return 1;
  }
  meo_pager_free(q);
  println("PASS j3_rollback");
  return 0;
}

// --- J4: a real crash ------------------------------------------------------

fn j4_crash() -> int32 {
  if (!meo_t_check(jrn_reset(J_DB) == MEO_OK, "j4: reset")) { return 1; }
  if (!meo_t_check(jrn_seed(J_DB, 4) == MEO_OK, "j4: seed four pages")) {
    return 1;
  }
  var st: int32 = jrn_crash(J_DB, 3, (uint8)0xCC);
  if (!meo_t_check_i64((int64)st, 42,
      "j4: the child died with _exit(42), not an early failure")) {
    return 1;
  }
  // The journal must still be on disk at the moment of death, or the reopen
  // below proves nothing about recovery.
  var jpath: string = jrn_jpath(J_DB);
  var jsize: int64 = jrn_file_size(jpath);
  if (!meo_t_check(jsize > 64,
      "j4: the journal is on disk and non-empty after the crash")) {
    free(jpath.chars);
    return 1;
  }
  free(jpath.chars);

  var p: MeoPager* = meo_pager_open(J_DB, 8, 0);
  if (!meo_t_check(p != 0, "j4: reopen after the crash")) { return 1; }
  var i: uint32 = 1;
  while (i <= 3) {
    var f: MeoFrame* = meo_pager_get(p, i, false);
    if (!meo_t_check(f != 0, "j4: get a restored page")) {
      meo_pager_close(p);
      meo_pager_free(p);
      return 1;
    }
    if (!meo_t_check_i64((int64)f->data[20], (int64)i,
        "j4: the pre-transaction content is back")) {
      meo_pager_release(p, f, false);
      meo_pager_close(p);
      meo_pager_free(p);
      return 1;
    }
    meo_pager_release(p, f, false);
    i += 1;
  }
  if (!meo_t_check(meo_pager_close(p) == MEO_OK, "j4: close")) { return 1; }
  meo_pager_free(p);
  var jpath2: string = jrn_jpath(J_DB);
  if (!meo_t_check_false(jrn_exists(jpath2),
      "j4: replay removed the journal")) {
    free(jpath2.chars);
    return 1;
  }
  free(jpath2.chars);
  println("PASS j4_crash");
  return 0;
}

// --- J5: a torn journal ----------------------------------------------------

fn j5_torn() -> int32 {
  if (!meo_t_check(jrn_reset(J_DB) == MEO_OK, "j5: reset")) { return 1; }
  if (!meo_t_check(jrn_seed(J_DB, 3) == MEO_OK, "j5: seed three pages")) {
    return 1;
  }
  var st: int32 = jrn_crash(J_DB, 3, (uint8)0xDD);
  if (!meo_t_check_i64((int64)st, 42, "j5: the crash child ran")) { return 1; }
  // The header still says three records; the file holds two and a fragment.
  var jpath: string = jrn_jpath(J_DB);
  var cut: int64 = (int64)MEO_JRN_HDR + 2 * (int64)MEO_JRN_RECORD + 100;
  if (!meo_t_check(jrn_truncate(jpath, cut) == MEO_OK,
      "j5: truncate the journal mid-record")) {
    free(jpath.chars);
    return 1;
  }
  free(jpath.chars);

  var p: MeoPager* = meo_pager_open(J_DB, 8, 0);
  if (!meo_t_check(p == 0, "j5: a torn journal refuses the open")) { return 1; }
  if (!meo_t_check_i64((int64)meo_pager_err(0), (int64)MEO_ERR_CORRUPT,
      "j5: the refusal is CORRUPT")) {
    return 1;
  }
  // The database was not touched: the crashed transaction's bytes are still
  // there, because replay never started.
  if (!meo_t_check_i64((int64)jrn_read_byte(J_DB, 1, 20), 0xDD,
      "j5: the database was not replayed")) {
    return 1;
  }
  var jpath2: string = jrn_jpath(J_DB);
  if (!meo_t_check(jrn_exists(jpath2),
      "j5: a refused journal is left for inspection")) {
    free(jpath2.chars);
    return 1;
  }
  free(jpath2.chars);
  println("PASS j5_torn");
  return 0;
}

// --- J6: a bad checksum ----------------------------------------------------

fn j6_checksum() -> int32 {
  if (!meo_t_check(jrn_reset(J_DB) == MEO_OK, "j6: reset")) { return 1; }
  if (!meo_t_check(jrn_seed(J_DB, 3) == MEO_OK, "j6: seed three pages")) {
    return 1;
  }
  var st: int32 = jrn_crash(J_DB, 3, (uint8)0xEE);
  if (!meo_t_check_i64((int64)st, 42, "j6: the crash child ran")) { return 1; }
  // Byte 20 is inside db_size_pages, which the checksum covers but the
  // structure does not depend on, so only the checksum can catch it.
  var jpath: string = jrn_jpath(J_DB);
  if (!meo_t_check(jrn_flip_byte(jpath, 20) == MEO_OK,
      "j6: flip a header byte")) {
    free(jpath.chars);
    return 1;
  }
  free(jpath.chars);

  var p: MeoPager* = meo_pager_open(J_DB, 8, 0);
  if (!meo_t_check(p == 0, "j6: a bad checksum refuses the open")) { return 1; }
  if (!meo_t_check_i64((int64)meo_pager_err(0), (int64)MEO_ERR_CORRUPT,
      "j6: the refusal is CORRUPT")) {
    return 1;
  }
  if (!meo_t_check_i64((int64)jrn_read_byte(J_DB, 1, 20), 0xEE,
      "j6: the database was not touched")) {
    return 1;
  }
  var jpath2: string = jrn_jpath(J_DB);
  if (!meo_t_check(jrn_exists(jpath2),
      "j6: a refused journal is left for inspection")) {
    free(jpath2.chars);
    return 1;
  }
  free(jpath2.chars);
  println("PASS j6_checksum");
  return 0;
}

// --- J7: capacity ----------------------------------------------------------

fn j7_capacity() -> int32 {
  if (!meo_t_check(jrn_reset(J_DB) == MEO_OK, "j7: reset")) { return 1; }
  if (!meo_t_check(jrn_seed(J_DB, 4) == MEO_OK, "j7: seed four pages")) {
    return 1;
  }
  var p: MeoPager* = meo_pager_open(J_DB, 8, 0);
  if (!meo_t_check(p != 0, "j7: open")) { return 1; }
  if (!meo_t_check(meo_pager_set_journal_cap(p, 4) == MEO_OK,
      "j7: lower the cap to four records")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  if (!meo_t_check(meo_pager_begin(p) == MEO_OK, "j7: begin")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  var i: uint32 = 1;
  while (i <= 4) {
    var f: MeoFrame* = meo_pager_get(p, i, true);
    if (!meo_t_check(f != 0, "j7: get a page for write")) {
      meo_pager_close(p);
      meo_pager_free(p);
      return 1;
    }
    f->data[20] = (uint8)0xAB;
    if (!meo_t_check(meo_pager_release(p, f, true) == MEO_OK,
        "j7: release it dirty")) {
      meo_pager_close(p);
      meo_pager_free(p);
      return 1;
    }
    i += 1;
  }
  // Page 0 is the fifth distinct page the flush will write.
  meo_pager_set_txn_id(p, 1);
  var rc: int32 = meo_pager_flush(p);
  if (!meo_t_check_i64((int64)rc, (int64)(0 - MEO_ERR_NOSPC),
      "j7: the fifth before-image is NOSPC, not dropped")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  if (!meo_t_check_i64((int64)meo_pager_err(p), (int64)MEO_ERR_NOSPC,
      "j7: the pager records NOSPC")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  if (!meo_t_check(meo_pager_rollback(p) == MEO_OK,
      "j7: rollback after the aborted transaction")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  if (!meo_t_check(meo_pager_close(p) == MEO_OK, "j7: close")) { return 1; }
  meo_pager_free(p);

  var q: MeoPager* = meo_pager_open(J_DB, 8, 0);
  if (!meo_t_check(q != 0, "j7: reopen")) { return 1; }
  if (!meo_t_check_i64((int64)meo_pager_page_count(q), 5,
      "j7: page_count is unchanged")) {
    meo_pager_close(q);
    meo_pager_free(q);
    return 1;
  }
  i = 1;
  while (i <= 4) {
    var f: MeoFrame* = meo_pager_get(q, i, false);
    if (!meo_t_check(f != 0, "j7: get a page after the aborted transaction")) {
      meo_pager_close(q);
      meo_pager_free(q);
      return 1;
    }
    if (!meo_t_check_i64((int64)f->data[20], (int64)i,
        "j7: the aborted transaction left no partial commit")) {
      meo_pager_release(q, f, false);
      meo_pager_close(q);
      meo_pager_free(q);
      return 1;
    }
    meo_pager_release(q, f, false);
    i += 1;
  }
  if (!meo_t_check(meo_pager_close(q) == MEO_OK, "j7: close the reopen")) {
    return 1;
  }
  meo_pager_free(q);
  println("PASS j7_capacity");
  return 0;
}

// --- J8: first touch only --------------------------------------------------

fn j8_first_touch() -> int32 {
  if (!meo_t_check(jrn_reset(J_DB) == MEO_OK, "j8: reset")) { return 1; }
  if (!meo_t_check(jrn_seed(J_DB, 4) == MEO_OK, "j8: seed four pages")) {
    return 1;
  }
  var p: MeoPager* = meo_pager_open(J_DB, 8, 0);
  if (!meo_t_check(p != 0, "j8: open")) { return 1; }
  if (!meo_t_check(meo_pager_begin(p) == MEO_OK, "j8: begin")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  var f: MeoFrame* = meo_pager_get(p, 1, true);
  if (!meo_t_check(f != 0, "j8: get page 1")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  f->data[20] = (uint8)0x11;
  if (!meo_t_check(meo_pager_release(p, f, true) == MEO_OK,
      "j8: release page 1 dirty")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  if (!meo_t_check(meo_pager_flush(p) == MEO_OK, "j8: first flush")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  f = meo_pager_get(p, 1, true);
  if (!meo_t_check(f != 0, "j8: get page 1 again")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  f->data[20] = (uint8)0x22;
  if (!meo_t_check(meo_pager_release(p, f, true) == MEO_OK,
      "j8: release page 1 dirty again")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  if (!meo_t_check(meo_pager_flush(p) == MEO_OK, "j8: second flush")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  // One record, not two: the second write must not append a second
  // before-image, or rollback would restore the first write's content.
  var jpath: string = jrn_jpath(J_DB);
  var jsize: int64 = jrn_file_size(jpath);
  if (!meo_t_check_i64(jsize,
      (int64)MEO_JRN_HDR + (int64)MEO_JRN_RECORD,
      "j8: a page written twice has one before-image")) {
    free(jpath.chars);
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  free(jpath.chars);
  if (!meo_t_check(meo_pager_rollback(p) == MEO_OK, "j8: rollback")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  if (!meo_t_check(meo_pager_close(p) == MEO_OK, "j8: close")) { return 1; }
  meo_pager_free(p);

  var q: MeoPager* = meo_pager_open(J_DB, 8, 0);
  if (!meo_t_check(q != 0, "j8: reopen")) { return 1; }
  var g: MeoFrame* = meo_pager_get(q, 1, false);
  if (!meo_t_check(g != 0, "j8: get page 1 after rollback")) {
    meo_pager_close(q);
    meo_pager_free(q);
    return 1;
  }
  if (!meo_t_check_i64((int64)g->data[20], 1,
      "j8: rollback restored the original content")) {
    meo_pager_release(q, g, false);
    meo_pager_close(q);
    meo_pager_free(q);
    return 1;
  }
  meo_pager_release(q, g, false);
  if (!meo_t_check(meo_pager_close(q) == MEO_OK, "j8: close the reopen")) {
    return 1;
  }
  meo_pager_free(q);
  println("PASS j8_first_touch");
  return 0;
}

// --- J9: page 0 flushed while not resident ---------------------------------

fn j9_page0_nonresident() -> int32 {
  if (!meo_t_check(jrn_reset(J_DB) == MEO_OK, "j9: reset")) { return 1; }
  if (!meo_t_check(jrn_seed(J_DB, 12) == MEO_OK, "j9: seed twelve pages")) {
    return 1;
  }
  var p: MeoPager* = meo_pager_open(J_DB, 8, 0);
  if (!meo_t_check(p != 0, "j9: open with 8 frames")) { return 1; }
  if (!meo_t_check(meo_pager_begin(p) == MEO_OK, "j9: begin")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  // Churn twelve pages through eight frames so page 0 is evicted.
  var i: uint32 = 1;
  while (i <= 12) {
    var f: MeoFrame* = meo_pager_get(p, i, false);
    if (!meo_t_check(f != 0, "j9: churn the cache")) {
      meo_pager_close(p);
      meo_pager_free(p);
      return 1;
    }
    if (!meo_t_check(meo_pager_release(p, f, false) == MEO_OK,
        "j9: release the churn")) {
      meo_pager_close(p);
      meo_pager_free(p);
      return 1;
    }
    i += 1;
  }
  // Page 0 is not resident now; this marks the meta dirty, so the flush takes
  // the non-resident page-0 branch of meo_pager_write_planned.
  meo_pager_set_txn_id(p, 99);
  if (!meo_t_check(meo_pager_flush(p) == MEO_OK, "j9: flush page 0")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  var jpath: string = jrn_jpath(J_DB);
  var jsize: int64 = jrn_file_size(jpath);
  if (!meo_t_check_i64(jsize,
      (int64)MEO_JRN_HDR + (int64)MEO_JRN_RECORD,
      "j9: the non-resident page-0 write appended its before-image")) {
    free(jpath.chars);
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  free(jpath.chars);
  if (!meo_t_check(meo_pager_rollback(p) == MEO_OK, "j9: rollback")) {
    meo_pager_close(p);
    meo_pager_free(p);
    return 1;
  }
  if (!meo_t_check(meo_pager_close(p) == MEO_OK, "j9: close")) { return 1; }
  meo_pager_free(p);

  var q: MeoPager* = meo_pager_open(J_DB, 8, 0);
  if (!meo_t_check(q != 0, "j9: reopen")) { return 1; }
  if (!meo_t_check_i64((int64)meo_pager_txn_id(q), 0,
      "j9: rollback restored the old txn_id")) {
    meo_pager_close(q);
    meo_pager_free(q);
    return 1;
  }
  if (!meo_t_check_i64((int64)meo_pager_page_count(q), 13,
      "j9: page_count is unchanged")) {
    meo_pager_close(q);
    meo_pager_free(q);
    return 1;
  }
  if (!meo_t_check(meo_pager_close(q) == MEO_OK, "j9: close the reopen")) {
    return 1;
  }
  meo_pager_free(q);
  println("PASS j9_page0_nonresident");
  return 0;
}

fn main() -> int32 {
  var rc: int32 = j2_commit();
  if (rc != 0) { return meo_t_report(); }
  rc = j3_rollback();
  if (rc != 0) { return meo_t_report(); }
  rc = j4_crash();
  if (rc != 0) { return meo_t_report(); }
  rc = j5_torn();
  if (rc != 0) { return meo_t_report(); }
  rc = j6_checksum();
  if (rc != 0) { return meo_t_report(); }
  rc = j7_capacity();
  if (rc != 0) { return meo_t_report(); }
  rc = j8_first_touch();
  if (rc != 0) { return meo_t_report(); }
  rc = j9_page0_nonresident();
  if (rc != 0) { return meo_t_report(); }
  println("PASS journal_self");
  return meo_t_report();
}
