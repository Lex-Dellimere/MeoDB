// repro_else_break: mettle v0.17.0 release miscompile (debug is right).
//
// An outer `while` over a field read through a pointer (lx->pos), with an
// else-if branch whose inner `while` advances that same field, and a final
// `else` that leaves the loop. Under --release the program never returns.
//
//   $ mettle --build repro_else_break.mettle -o rd && ./rd; echo "exit $?"
//   pos 5 (want 5)
//   exit 0
//   $ mettle --build --release repro_else_break.mettle -o rr && timeout 3 ./rr; echo "exit $?"
//   exit 124            (hangs; killed by timeout)
//
// (mettle = /home/nox/Projects/mettle/Mettle/bin/mettle)
// Controls, all --release:
//   final `else { return lx->pos; }` instead of break   -> still hangs
//   inner while replaced by `lx->pos += 4;`              -> pos 5, exit 0
//   loop flag (`while (go && ...)`, else `go = false;`)  -> pos 5, exit 0
//   inner while on a local `j`, then `lx->pos = j;`      -> pos 5, exit 0
// So the trigger is the inner while on the pointer field plus an exit branch,
// not `break` itself. --release --verify reports OK (main is not validated).

import "std/io";

struct Lx {
  src: uint8*;
  n: int32;
  pos: int32;
}

fn is_space(c: uint8) -> bool {
  return c == (uint8)32 || c == (uint8)10;
}

// Skip spaces and `--` comments; answers where the next token starts.
fn skip(lx: Lx*) -> int32 {
  while (lx->pos < lx->n) {
    var c0: uint8 = lx->src[lx->pos];
    if (is_space(c0)) {
      lx->pos += 1;
    } else if (c0 == (uint8)45 && lx->pos + 1 < lx->n && lx->src[lx->pos + 1] == (uint8)45) {
      while (lx->pos < lx->n && lx->src[lx->pos] != (uint8)10) { lx->pos += 1; }
    } else {
      break;
    }
  }
  return lx->pos;
}

fn main() -> int32 {
  var s: string = "-- c\nX";
  var lx: Lx;
  lx.src = s.chars;
  lx.n = (int32)s.length;
  lx.pos = 0;
  var p: int32 = skip(&lx);
  println("pos {p} (want 5)");
  if (p != 5) { return 1; }
  return 0;
}
